  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "auto-import.d.ts",
    "auto-import.js",
    "dist",
    "vite.d.ts",
    "vite.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "svelte-package -i src/lib",
    "dev": "svelte-package -i src/lib --watch",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node ../../scripts/typecheck.mjs --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rimraf dist .turbo"
  },
  "peerDependencies": {
    "svelte": "catalog:"
  },
  "dependencies": {
    "@h-ai/core": "workspace:*",
    "@internationalized/date": "catalog:",
    "@shikijs/langs": "catalog:",
    "bits-ui": "catalog:",
    "driver.js": "catalog:",
    "html2canvas": "catalog:",
    "jspdf": "catalog:",
    "layerchart": "catalog:",
    "marked": "catalog:",
    "mermaid": "catalog:",
    "shiki": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "rimraf": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
