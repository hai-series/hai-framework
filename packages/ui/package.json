{
  "name": "@h-ai/ui",
  "type": "module",
  "version": "0.1.0-alpha.68",
  "description": "Hai Framework UI component library for Svelte 5 Runes.",
  "license": "Apache-2.0",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./auto-import": {
      "types": "./auto-import.d.ts",
      "import": "./auto-import.js"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "import": "./vite.js"
    },
    "./i18n": {
      "types": "./dist/i18n.svelte.d.ts",
      "svelte": "./dist/i18n.svelte.js",
      "import": "./dist/i18n.svelte.js"
    },
    "./theme": {
      "types": "./dist/theme-config.d.ts",
      "import": "./dist/theme-config.js"
    },
    "./guide": {
      "types": "./dist/guide.d.ts",
      "svelte": "./dist/guide.js",
      "import": "./dist/guide.js"
    },
    "./components/compounds/index": {
      "types": "./dist/components/compounds/index.d.ts",
      "svelte": "./dist/components/compounds/index.js",
      "import": "./dist/components/compounds/index.js"
    },
    "./components/index": {
      "types": "./dist/components/index.d.ts",
