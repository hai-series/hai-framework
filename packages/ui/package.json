    },
    "./components/scenes/error/index": {
      "types": "./dist/components/scenes/error/index.d.ts",
      "svelte": "./dist/components/scenes/error/index.js",
      "import": "./dist/components/scenes/error/index.js"
    },
    "./components/scenes/guide/index": {
      "types": "./dist/components/scenes/guide/index.d.ts",
      "svelte": "./dist/components/scenes/guide/index.js",
      "import": "./dist/components/scenes/guide/index.js"
    },
    "./components/scenes/iam/index": {
      "types": "./dist/components/scenes/iam/index.d.ts",
      "svelte": "./dist/components/scenes/iam/index.js",
      "import": "./dist/components/scenes/iam/index.js"
    },
    "./components/scenes/index": {
      "types": "./dist/components/scenes/index.d.ts",
