{
  "name": "@h-ai/ui",
  "type": "module",
  "version": "0.1.0-alpha.45",
  "description": "Hai Framework UI component library for Svelte 5 Runes.",
  "license": "Apache-2.0",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./auto-import": {
      "types": "./auto-import.d.ts",
      "import": "./auto-import.js"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "import": "./vite.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "svelte": "./dist/components/*.js",
      "import": "./dist/components/*.js"
    },
    "./styles/*": "./dist/styles/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "auto-import.d.ts",
    "auto-import.js",
    "dist",
    "vite.d.ts",
    "vite.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "svelte-package -i src/lib",
    "dev": "svelte-package -i src/lib --watch",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rimraf dist .turbo"
  },
  "peerDependencies": {
    "svelte": "catalog:"
  },
  "dependencies": {
    "@h-ai/core": "workspace:*",
    "@internationalized/date": "catalog:",
    "@shikijs/langs": "catalog:",
    "bits-ui": "catalog:",
    "html2canvas": "catalog:",
    "jspdf": "catalog:",
    "layerchart": "catalog:",
    "marked": "catalog:",
    "mermaid": "catalog:",
    "shiki": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "rimraf": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
