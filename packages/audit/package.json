{
  "name": "@h-ai/audit",
  "type": "module",
  "version": "0.1.0-alpha.74",
  "description": "Hai Framework audit logging module.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node ../../scripts/typecheck.mjs --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rimraf dist .turbo",
    "build:clean": "rimraf dist"
  },
  "peerDependencies": {
    "@h-ai/reach": "workspace:*",
    "@h-ai/scheduler": "workspace:*",
    "@h-ai/storage": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@h-ai/reach": {
      "optional": true
    },
    "@h-ai/scheduler": {
      "optional": true
    },
    "@h-ai/storage": {
      "optional": true
    }
  },
  "dependencies": {
    "@h-ai/core": "workspace:*",
    "@h-ai/reldb": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@h-ai/reach": "workspace:*",
    "@h-ai/scheduler": "workspace:*",
    "@h-ai/storage": "workspace:*",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "testcontainers": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
