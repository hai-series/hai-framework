@@ -0,0 +1,84 @@
+<script setup lang="ts">
+import { computed, inject } from 'vue'
+import type { ComponentDefinition } from '../../types'
+
+const props = defineProps<{
+  definition: ComponentDefinition
+  surfaceId: string
+}>()
+
+const dataModel = inject('a2ui-data-model') as any
+
+function resolve(val: any): any {
+  if (val === null || val === undefined)
+    return val
+  if (typeof val === 'string' || typeof val === 'number' || typeof val === 'boolean')
+    return val
+  if (val.path)
+    return dataModel?.getPath(props.surfaceId, val.path)
+  return val
+}
+
+const colors = ['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#14b8a6', '#f97316']
+const size = 180
+const r = 72
+const c = size / 2
+
+const series = computed(() => {
+  const data = resolve((props.definition as any).data ?? [])
+  if (!Array.isArray(data))
+    return [] as Array<{ label: string, value: number }>
+  return data
+    .map((d: any, i: number) => ({
+      label: String(d?.label ?? d?.name ?? i + 1),
+      value: Math.max(0, Number(d?.value ?? d?.y ?? 0)),
+    }))
+    .filter(d => Number.isFinite(d.value))
+})
+
+const total = computed(() => Math.max(series.value.reduce((s, it) => s + it.value, 0), 1))
+
+function arcPath(start: number, end: number): string {
+  const x1 = c + r * Math.cos(start)
+  const y1 = c + r * Math.sin(start)
+  const x2 = c + r * Math.cos(end)
+  const y2 = c + r * Math.sin(end)
+  const large = end - start > Math.PI ? 1 : 0
+  return `M ${c} ${c} L ${x1} ${y1} A ${r} ${r} 0 ${large} 1 ${x2} ${y2} Z`
+}
+
+const slices = computed(() => {
+  let angle = -Math.PI / 2
+  return series.value.map((it, idx) => {
+    const span = (it.value / total.value) * Math.PI * 2
+    const start = angle
+    const end = angle + span
+    angle = end
+    return { ...it, color: colors[idx % colors.length], path: arcPath(start, end) }
+  })
+})
+</script>
+
+<template>
+  <div class="a2-pie-wrap">
+    <svg :viewBox="`0 0 ${size} ${size}`" width="180" height="180" role="img" aria-label="pie-chart">
+      <path v-for="(s, i) in slices" :key="`slice_${i}`" :d="s.path" :fill="s.color" />
+    </svg>
+    <div class="a2-pie-legend">
+      <div v-for="(s, i) in slices" :key="`legend_${i}`" class="a2-pie-item">
+        <span class="a2-dot" :style="{ background: s.color }" />
+        <span class="a2-name">{{ s.label }}</span>
+        <span class="a2-val">{{ s.value }}</span>
+      </div>
+    </div>
+  </div>
+</template>
+
+<style scoped>
+.a2-pie-wrap { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
+.a2-pie-legend { display: flex; flex-direction: column; gap: 6px; min-width: 120px; }
+.a2-pie-item { display: grid; grid-template-columns: 12px 1fr auto; gap: 8px; align-items: center; font-size: 12px; color: var(--a2ui-text); }
+.a2-dot { width: 10px; height: 10px; border-radius: 999px; display: inline-block; }
+.a2-name { color: var(--a2ui-text-secondary); }
+.a2-val { font-weight: 600; }
+</style>
