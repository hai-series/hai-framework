+        <i class="a2-dot" :style="{ background: s.color }" />
+        {{ s.name }}
+      </button>
+    </div>
+  <div class="a2-line-chart">
+    <svg :viewBox="`0 0 ${width} ${height}`" width="100%" height="180" role="img" aria-label="line-chart">
+      <line
+        v-for="(tick, i) in yTicks"
+        :key="`gy_${i}`"
+        :x1="pad"
+        :x2="width - pad"
+        :y1="pad + (i * (height - 2 * pad)) / (yTicks.length - 1)"
+        :y2="pad + (i * (height - 2 * pad)) / (yTicks.length - 1)"
+        stroke="var(--a2ui-border)"
+        stroke-dasharray="3 3"
+      />
+      <line :x1="pad" :y1="height - pad" :x2="width - pad" :y2="height - pad" stroke="var(--a2ui-border)" />
+      <line :x1="pad" :y1="pad" :x2="pad" :y2="height - pad" stroke="var(--a2ui-border)" />
+      <text
+        v-for="(tick, i) in yTicks"
+        :key="`tick_${i}`"
+        :x="pad - 4"
+        :y="pad + (i * (height - 2 * pad)) / (yTicks.length - 1) + 4"
+        text-anchor="end"
+        class="a2-line-y-label"
+      >
+        {{ tick }}
+      </text>
+      <polyline
+        v-for="s in lineNodes"
+        :key="`ln_${s.key}`"
+        fill="none"
+        :stroke="s.color"
+        stroke-width="2.5"
+        :points="s.polyline"
+      />
+      <circle
+        v-for="(pt, i) in lineNodes.flatMap(s => s.points.map(p => ({ ...p, seriesName: s.name, color: s.color, idx: s.key })))"
+        :key="`pt_${pt.idx}_${i}`"
+        :cx="pt.x"
+        :cy="pt.y"
