+      >
+        <title>{{ `${pt.seriesName} | ${pt.label}: ${pt.value}` }}</title>
+      </circle>
+    </svg>
+    <svg :viewBox="`0 0 ${width} 28`" width="100%" height="28" role="presentation" aria-hidden="true">
+      <text
+        v-for="(lb, i) in categories"
+        :key="`lb_${i}`"
+        :x="categories.length === 1 ? width / 2 : pad + (i * (width - 2 * pad)) / (categories.length - 1)"
+        y="20"
+        text-anchor="middle"
+        class="a2-line-x-label"
+      >
+        {{ lb }}
+      </text>
+    </svg>
+    <div class="a2-line-meta">min: {{ min }} / max: {{ max }}</div>
+  </div>
+  </div>
+</template>
+
+<style scoped>
+.a2-line-chart-wrap { width: 100%; }
+.a2-legend { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 8px; font-size: 12px; color: var(--a2ui-text-secondary); }
