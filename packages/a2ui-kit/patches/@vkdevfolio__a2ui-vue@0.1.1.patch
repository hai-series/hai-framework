+++ b/src/components/content/A2Table.vue
@@ -0,0 +1,104 @@
+<script setup lang="ts">
+import { computed, inject } from 'vue'
+import type { ComponentDefinition } from '../../types'
+
+const props = defineProps<{
+  definition: ComponentDefinition
+  surfaceId: string
+}>()
+
+const dataModel = inject('a2ui-data-model') as any
+
+function resolve(val: any): any {
+  if (val === null || val === undefined)
+    return val
+  if (typeof val === 'string' || typeof val === 'number' || typeof val === 'boolean')
+    return val
+  if (val.path)
+    return dataModel?.getPath(props.surfaceId, val.path)
+  if (val.literalString !== undefined)
+    return val.literalString
+  return val
+}
+
+const rows = computed<Record<string, any>[]>(() => {
+  const v = resolve((props.definition as any).rows ?? (props.definition as any).data ?? [])
+  if (Array.isArray(v))
+    return v as Record<string, any>[]
+  if (typeof v === 'string') {
+    try {
+      const parsed = JSON.parse(v)
+      return Array.isArray(parsed) ? parsed : []
+    }
+    catch {
+      return []
+    }
+  }
+  return []
+})
+
+const columns = computed<string[]>(() => {
+  const explicit = resolve((props.definition as any).columns ?? [])
+  if (Array.isArray(explicit) && explicit.length > 0)
+    return explicit.map(String)
+  const first = rows.value[0]
+  return first ? Object.keys(first) : []
+})
+
+const maxRows = computed(() => {
+  const n = Number(resolve((props.definition as any).maxRows ?? 100))
+  return Number.isFinite(n) && n > 0 ? Math.min(n, 500) : 100
+})
+
+const displayRows = computed(() => rows.value.slice(0, maxRows.value))
+</script>
+
+<template>
+  <div class="a2-table-wrap">
+    <table class="a2-table">
+      <thead>
+        <tr>
+          <th v-for="c in columns" :key="`h_${c}`">
+            {{ c }}
+          </th>
+        </tr>
+      </thead>
+      <tbody>
+        <tr v-if="displayRows.length === 0">
+          <td :colspan="Math.max(columns.length, 1)">
+            (no data)
+          </td>
+        </tr>
+        <tr v-for="(row, i) in displayRows" :key="`r_${i}`">
+          <td v-for="c in columns" :key="`c_${i}_${c}`">
+            {{ row?.[c] ?? '' }}
+          </td>
+        </tr>
+      </tbody>
+    </table>
+  </div>
+</template>
+
+<style scoped>
+.a2-table-wrap {
+  width: 100%;
+  overflow: auto;
+}
+.a2-table {
+  width: 100%;
+  border-collapse: collapse;
+  font-size: 13px;
+  color: var(--a2ui-text);
+}
+.a2-table th,
+.a2-table td {
+  border: 1px solid var(--a2ui-border);
+  padding: 6px 8px;
+  text-align: left;
+  white-space: nowrap;
+}
+.a2-table th {
+  background: color-mix(in srgb, var(--a2ui-primary) 8%, transparent);
+  font-weight: 600;
+}
+</style>
