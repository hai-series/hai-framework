+<script setup lang="ts">
+import { computed, inject, ref } from 'vue'
+import type { ComponentDefinition } from '../../types'
+
+const props = defineProps<{
+  definition: ComponentDefinition
+  surfaceId: string
+}>()
+
+const dataModel = inject('a2ui-data-model') as any
+const colors = ['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#06b6d4', '#64748b']
+const W = 720
+const H = 260
+const PAD = { t: 18, r: 16, b: 44, l: 48 }
+
+function resolve(val: any): any {
+  if (val === null || val === undefined)
+    return val
+  if (typeof val === 'string' || typeof val === 'number' || typeof val === 'boolean')
+    return val
+  if (val.path)
+    return dataModel?.getPath(props.surfaceId, val.path)
+  return val
+}
+
+const rawRows = computed(() => {
+  const data = resolve((props.definition as any).data ?? [])
+  return Array.isArray(data) ? data as Array<Record<string, any>> : []
+})
+
+const categories = computed(() => rawRows.value.map((d, i) => String(d?.label ?? d?.name ?? d?.x ?? i + 1)))
+const metricKeys = computed(() => {
+  const first = rawRows.value[0] || {}
+  if ('value' in first || 'y' in first)
+    return ['value']
+  return Object.keys(first).filter(k => !['label', 'name', 'x'].includes(k))
+})
+const series = computed(() => metricKeys.value.map((key, idx) => ({
+  key,
+  name: key === 'value' ? String((props.definition as any).seriesName ?? '值') : key,
+  color: colors[idx % colors.length],
+  values: rawRows.value.map(d => Number((key === 'value' ? (d?.value ?? d?.y) : d?.[key]) ?? 0)),
+})))
+const hiddenSeries = ref<Set<string>>(new Set())
+const visibleSeries = computed(() => series.value.filter(s => !hiddenSeries.value.has(s.key)))
+const max = computed(() => Math.max(1, ...visibleSeries.value.flatMap(s => s.values)))
+const ticks = computed(() => [1, 0.75, 0.5, 0.25, 0].map(r => Math.round(max.value * r)))
+
+const plotW = computed(() => W - PAD.l - PAD.r)
+const plotH = computed(() => H - PAD.t - PAD.b)
+const groupW = computed(() => categories.value.length > 0 ? plotW.value / categories.value.length : 0)
+const barW = computed(() => {
+  const n = Math.max(visibleSeries.value.length, 1)
+  return Math.max(8, Math.min(18, (groupW.value - 14) / n))
+})
+const bars = computed(() => {
+  const out: Array<{ x: number, y: number, w: number, h: number, color: string, label: string, value: number, seriesName: string }> = []
+  categories.value.forEach((label, i) => {
+    const x0 = PAD.l + i * groupW.value + (groupW.value - (visibleSeries.value.length * barW.value)) / 2
+    visibleSeries.value.forEach((s, j) => {
+      const v = s.values[i] ?? 0
+      const h = (v / max.value) * plotH.value
+      out.push({
+        x: x0 + j * barW.value,
+        y: PAD.t + plotH.value - h,
+        w: barW.value - 2,
+        h,
+        color: s.color,
+        label,
+        value: v,
+        seriesName: s.name,
+      })
+    })
+  })
+  return out
+})
+
+function toggleSeries(key: string) {
+  const next = new Set(hiddenSeries.value)
+  if (next.has(key))
+    next.delete(key)
+  else
+    next.add(key)
+  hiddenSeries.value = next
+}
+</script>
+
+<template>
+  <div class="a2-bar-wrap">
+    <div class="a2-legend">
+      <button v-for="s in series" :key="`lg_${s.key}`" class="a2-legend-item" type="button" :class="{ off: hiddenSeries.has(s.key) }" @click="toggleSeries(s.key)">
+        <i class="a2-dot" :style="{ background: s.color }" />
+        {{ s.name }}
+      </button>
+    </div>
+    <svg :viewBox="`0 0 ${W} ${H}`" width="100%" height="260" role="img" aria-label="bar-chart">
+      <line
+        v-for="(t, i) in ticks"
+        :key="`grid_${i}`"
+        :x1="PAD.l"
+        :x2="W - PAD.r"
+        :y1="PAD.t + (i * plotH) / (ticks.length - 1)"
+        :y2="PAD.t + (i * plotH) / (ticks.length - 1)"
+        stroke="var(--a2ui-border)"
+        stroke-dasharray="3 3"
+      />
+      <line :x1="PAD.l" :y1="PAD.t" :x2="PAD.l" :y2="H - PAD.b" stroke="var(--a2ui-border)" />
+      <line :x1="PAD.l" :y1="H - PAD.b" :x2="W - PAD.r" :y2="H - PAD.b" stroke="var(--a2ui-border)" />
+      <text
+        v-for="(t, i) in ticks"
+        :key="`tick_${i}`"
+        :x="PAD.l - 6"
+        :y="PAD.t + (i * plotH) / (ticks.length - 1) + 4"
+        text-anchor="end"
+        class="tick"
+      >
+        {{ t }}
+      </text>
+      <rect v-for="(b, i) in bars" :key="`bar_${i}`" :x="b.x" :y="b.y" :width="b.w" :height="Math.max(0, b.h)" :fill="b.color">
+        <title>{{ `${b.seriesName} | ${b.label}: ${b.value}` }}</title>
+      </rect>
+      <text
+        v-for="(lb, i) in categories"
+        :key="`x_${i}`"
+        :x="PAD.l + i * groupW + groupW / 2"
+        :y="H - PAD.b + 18"
+        text-anchor="middle"
+        class="xlabel"
+      >
+        {{ lb }}
+      </text>
+    </svg>
+  </div>
+</template>
+
+<style scoped>
+.a2-bar-wrap { width: 100%; }
+.a2-legend { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 8px; font-size: 12px; color: var(--a2ui-text-secondary); }
+.a2-legend-item { display: inline-flex; align-items: center; gap: 6px; border: 0; background: transparent; color: inherit; cursor: pointer; padding: 0; }
+.a2-legend-item.off { opacity: 0.35; }
+.a2-dot { width: 10px; height: 10px; border-radius: 999px; display: inline-block; }
+.tick { font-size: 11px; fill: var(--a2ui-text-secondary); }
+.xlabel { font-size: 12px; fill: var(--a2ui-text-secondary); }
+</style>
