+
+const dataModel = inject('a2ui-data-model') as any
+const colors = ['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#06b6d4', '#64748b']
+
+function resolve(val: any): any {
+  if (val === null || val === undefined)
+    return val
+  if (typeof val === 'string' || typeof val === 'number' || typeof val === 'boolean')
+    return val
+  if (val.path)
+    return dataModel?.getPath(props.surfaceId, val.path)
+  return val
+}
+
+const width = 420
+const height = 180
+const pad = 18
+
+const rawRows = computed(() => {
+  const data = resolve((props.definition as any).data ?? [])
+  if (!Array.isArray(data))
+    return [] as Array<Record<string, any>>
+  return data as Array<Record<string, any>>
+})
+
+const categories = computed(() => rawRows.value.map((d, i) => String(d?.label ?? d?.name ?? d?.x ?? i + 1)))
+const metricKeys = computed(() => {
+  const first = rawRows.value[0] || {}
+  if ('value' in first || 'y' in first)
+    return ['value']
+  return Object.keys(first).filter(k => !['label', 'name', 'x'].includes(k))
+})
+const series = computed(() => metricKeys.value.map((key, idx) => ({
+  key,
+  name: key === 'value' ? String((props.definition as any).seriesName ?? '值') : key,
+  color: colors[idx % colors.length],
+  values: rawRows.value.map(d => Number((key === 'value' ? (d?.value ?? d?.y) : d?.[key]) ?? 0)),
+})))
+const hiddenSeries = ref<Set<string>>(new Set())
+const visibleSeries = computed(() => series.value.filter(s => !hiddenSeries.value.has(s.key)))
+
+const max = computed(() => Math.max(1, ...visibleSeries.value.flatMap(s => s.values)))
+const min = computed(() => Math.min(0, ...visibleSeries.value.flatMap(s => s.values)))
+const yTicks = computed(() => {
+  const m = max.value
+  const n = min.value
+  return [m, (m * 3 + n) / 4, (m + n) / 2, (m + n * 3) / 4, n].map(v => Math.round(v))
+})
+
+const lineNodes = computed(() => {
+  const n = categories.value.length
+  const range = Math.max(max.value - min.value, 1)
+  return visibleSeries.value.map((s) => {
+    const points = s.values.map((v, i) => {
+      const x = n === 1 ? width / 2 : pad + (i * (width - 2 * pad)) / (n - 1)
+      const y = height - pad - ((v - min.value) / range) * (height - 2 * pad)
+      return { x, y, value: v, label: categories.value[i] ?? String(i + 1) }
+    })
+    return { ...s, points, polyline: points.map(p => `${p.x},${p.y}`).join(' ') }
+  })
+})
+
+function toggleSeries(key: string) {
+  const next = new Set(hiddenSeries.value)
+  if (next.has(key))
+    next.delete(key)
+  else
+    next.add(key)
+  hiddenSeries.value = next
+}
+</script>
