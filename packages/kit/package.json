{
  "name": "@h-ai/kit",
  "type": "module",
  "version": "0.1.0-alpha.68",
  "description": "Hai Framework SvelteKit integration module.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./crypto": {
      "types": "./dist/modules/crypto/index.d.ts",
      "import": "./dist/modules/crypto/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.ts",
      "import": "./dist/adapter/index.js"
    },
    "./a2a": {
      "types": "./dist/modules/a2a/index.d.ts",
      "import": "./dist/modules/a2a/index.js"
    }
  },
  "main": "./dist/index.js",
  "browser": "./dist/browser.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node ../../scripts/typecheck.mjs --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rimraf dist .turbo",
    "build:clean": "rimraf dist"
  },
  "peerDependencies": {
    "@sveltejs/adapter-node": "catalog:",
    "@sveltejs/adapter-static": "catalog:",
    "@sveltejs/kit": "catalog:",
    "svelte": "catalog:"
  },
  "peerDependenciesMeta": {
    "@sveltejs/adapter-node": {
      "optional": true
    },
    "@sveltejs/adapter-static": {
      "optional": true
    }
  },
  "dependencies": {
    "@h-ai/api-contract": "workspace:*",
    "@h-ai/core": "workspace:*",
    "@h-ai/crypto": "workspace:*",
    "@h-ai/iam": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@h-ai/cache": "workspace:*",
    "@sveltejs/kit": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "svelte": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
