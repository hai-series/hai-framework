{
  "name": "@h-ai/tools",
  "type": "module",
  "version": "1.0.0-beta.30",
  "description": "Model-neutral tools, validation, authorization and execution for hai-framework",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "jobs"],
  "publishConfig": { "access": "public" },
  "engines": { "node": "^22.23.4 || ^24.22.1 || ^26.12.1" },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "node ../../scripts/typecheck.mjs --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:jobs": "python3 -B -m unittest discover -s jobs/tests",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "build:clean": "rimraf dist"
  },
  "dependencies": {
    "@h-ai/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "rimraf": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
