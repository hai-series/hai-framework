{
  "name": "@h-ai/tools",
  "type": "module",
  "version": "1.0.0-beta.36",
  "description": "Model-neutral tools, validation, authorization and execution for hai-framework",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "jobs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "node ../../scripts/typecheck.mjs --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:jobs": "python3 -B -m unittest discover -s jobs/tests",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "build:clean": "rimraf dist"
  },
  "peerDependencies": {
    "@h-ai/runner": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@h-ai/runner": {
      "optional": true
    }
  },
  "dependencies": {
    "@h-ai/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@h-ai/reldb": "workspace:*",
    "@h-ai/runner": "workspace:*",
    "rimraf": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
