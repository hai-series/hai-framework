{
  "name": "@h-ai/cli",
  "type": "module",
  "version": "0.1.0-alpha.54",
  "description": "Hai Framework CLI for project scaffolding and code generation.",
  "license": "Apache-2.0",
  "keywords": [
    "hai",
    "cli",
    "scaffold",
    "generator"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "hai": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:e2e": "pnpm test:scaffold-gates",
    "test:scaffold-gates": "pnpm build && node tests/run-scaffold-gates.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist .turbo",
    "build:clean": "rimraf dist"
  },
  "dependencies": {
    "@h-ai/core": "workspace:*",
    "cac": "catalog:",
    "chalk": "catalog:",
    "fs-extra": "catalog:",
    "handlebars": "catalog:",
    "ora": "catalog:",
    "prompts": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@h-ai/cache": "workspace:*",
    "@h-ai/deploy": "workspace:*",
    "@h-ai/reach": "workspace:*",
    "@h-ai/reldb": "workspace:*",
    "@h-ai/storage": "workspace:*",
    "@types/fs-extra": "catalog:",
    "@types/node": "catalog:",
    "@types/prompts": "catalog:",
    "rimraf": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
