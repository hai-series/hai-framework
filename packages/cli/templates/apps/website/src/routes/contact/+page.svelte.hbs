{{!-- 联系页面 --}}
<script lang='ts'>
  /**
   * 联系我们页面
   */
{{#if hasI18n}}
  import * as m from '$lib/paraglide/messages'
{{/if}}
  import { Button, Card, FormField, FormLayout, Input, notifyWarning, PageHeader, Textarea } from '@h-ai/ui'

  let name = $state('')
  let email = $state('')
  let message = $state('')

  function handleSubmit(event: SubmitEvent) {
    event.preventDefault()
{{#if hasI18n}}
    notifyWarning(m.page_contact_unavailable())
{{else}}
    notifyWarning('在线留言尚未开通，请使用其他联系方式。您的输入已保留。')
{{/if}}
  }
</script>

<svelte:head>
{{#if hasI18n}}
  <title>{m.page_contact_title()}</title>
{{else}}
  <title>联系我们</title>
{{/if}}
</svelte:head>

<section class='py-16 px-4 max-w-2xl mx-auto'>
{{#if hasI18n}}
  <PageHeader title={m.page_contact_title()} description={m.page_contact_desc()} />
{{else}}
  <PageHeader title='联系我们' description='有任何疑问？欢迎联系我们。' />
{{/if}}

  <Card shadow='sm' class='bg-base-100'>
    <form onsubmit={handleSubmit}>
      <FormLayout columns={2} labelPosition='top'>
{{#if hasI18n}}
        <FormField for='name' label={m.page_contact_name()} required>
          <Input id='name' type='text' bind:value={name} required />
        </FormField>
        <FormField for='email' label={m.page_contact_email()} required>
          <Input id='email' type='email' bind:value={email} required />
        </FormField>
        <FormField for='message' label={m.page_contact_message()} required>
          <Textarea id='message' rows={4} bind:value={message} required />
        </FormField>
        <Button type='submit' variant='primary' class='w-full'>{m.page_contact_submit()}</Button>
{{else}}
        <FormField for='name' label='姓名' required>
          <Input id='name' type='text' bind:value={name} required />
        </FormField>
        <FormField for='email' label='邮箱' required>
          <Input id='email' type='email' bind:value={email} required />
        </FormField>
        <FormField for='message' label='留言' required>
          <Textarea id='message' rows={4} bind:value={message} required />
        </FormField>
        <Button type='submit' variant='primary' class='w-full'>发送</Button>
{{/if}}
      </FormLayout>
    </form>
  </Card>
</section>
