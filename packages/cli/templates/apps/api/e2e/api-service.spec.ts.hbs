import { expect, test } from '@playwright/test'

test('service health endpoint returns ok', async ({ request }) => {
  const response = await request.get('/health')

  expect(response.status()).toBe(200)
  await expect(response.json()).resolves.toEqual({ status: 'ok' })
})

test('service app.info endpoint returns HaiResult', async ({ request }) => {
  const response = await request.post('/api/v1/app/info')
  const body = await response.json()

  expect(response.status()).toBe(200)
  expect(body.success).toBe(true)
  expect(body.data.name).toContain('{{projectName}}')
  expect(typeof body.data.transportEnabled).toBe('boolean')
})
