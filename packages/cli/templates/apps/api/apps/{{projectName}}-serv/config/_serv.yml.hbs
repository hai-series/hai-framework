# =============================================================================
# {{projectName}} API Service - Serv / HTTP 入口配置
# =============================================================================

server:
  host: 127.0.0.1
  port: 3000

http:
  # auto 仅在受管私有 Compose 代理中采用容器网段；普通宿主忽略转发头。
  trustedProxies: auto
  access: false
  # 独立文件与下方内联规则二选一，用所选配置块替换 access: false。
  # access:
  #   file: ./config/security/request-access.yml
  # access:
  #   global:
  #     timezone: UTC # 可用 HAI_SERV_HTTP_ACCESS_GLOBAL_TIMEZONE=Asia/Shanghai
  #     allowIps: []
  #     denyIps: []
  #     windows: []
  #   rules: []
  apiPrefix: /api/v1
  openapi:
    path: /openapi.json
  # HAI_SERV_HTTP_DOCS=false 关闭文档；开启时再配置 path/requireAuth。
  docs:
    path: /docs
    # requireAuth: true
  health:
    path: /health
    readyPath: /ready

cors:
  origin: ${HAI_SERV_CORS_ORIGIN:*}
  nativeOrigins: ${HAI_SERV_CORS_NATIVEORIGINS:http://localhost,https://tauri.localhost,tauri://localhost,capacitor://localhost}
{{#if features.iam}}  credentials: ${HAI_SERV_CORS_CREDENTIALS:true}
{{else}}  credentials: ${HAI_SERV_CORS_CREDENTIALS:false}
{{/if}}  allowedHeaders:
    - Authorization
    - Content-Type
{{#if features.crypto}}    - X-Client-Id
    - X-Encrypted
    - X-Hai-Transport
{{/if}}    - X-Hai-Locale
    - X-Request-Id
    - X-Requested-With
  exposedHeaders:
{{#if features.crypto}}    - X-Encrypted
    - X-Hai-Transport
{{/if}}    - X-Request-Id

{{#if features.crypto}}transport:
  # 双向业务明文 UTF-8 字节；默认 {{#if features.feedback}}auto（按反馈预算推导）{{else}}1 MiB{{/if}}，范围 1 KiB～64 MiB，密文容量自动推导。
{{#if features.feedback}}
  maxPlaintextBytes: ${HAI_SERV_TRANSPORT_MAXPLAINTEXTBYTES:auto}
{{else}}
  maxPlaintextBytes: ${HAI_SERV_TRANSPORT_MAXPLAINTEXTBYTES:1048576}
{{/if}}
  # HAI_SERV_TRANSPORT_ROUTEPLAINTEXTBYTES 可填 JSON 路径映射。
  routePlaintextBytes: {}
  # 单条路径需要更大请求体时填写字节数，* 只匹配一段路径。
  # routePlaintextBytes:
  #   /api/v1/uploads/*: 8388608
  keyExchangePath: /_hai/key-exchange
  excludePaths:
    - /health
    - /ready
    - /openapi.json
    - /docs
    - /_hai/scalar.js
{{else}}transport: false
{{/if}}
