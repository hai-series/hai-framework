import type { CoreConfig } from '@h-ai/core'
import type { ServConfig{{#if features.crypto}}, ServTransportConfig{{/if}} } from '@h-ai/serv'
{{#if features.crypto}}
import process from 'node:process'
{{/if}}
{{#if features.feedback}}
import { apiContract } from '@h-ai/api-contract/feedback'
{{/if}}
{{#if features.crypto}}
import { cache } from '@h-ai/cache'
{{/if}}
import { core } from '@h-ai/core'
{{#if features.crypto}}
import { crypto } from '@h-ai/crypto'
{{/if}}
{{#if features.iam}}
import { iam } from '@h-ai/iam'
{{/if}}
import { serv } from '@h-ai/serv'
import { {{api.contractExportName}} } from '{{api.contractPackageName}}'
import { {{api.serviceProceduresFactoryName}} } from './server/procedures/index.js'

const startedAt = Date.now()

interface CreateApiServiceAppOptions {
  transport?: 'config' | 'disabled'
  refreshCookie?: 'enabled' | 'disabled'
}

/** 创建 API Service HTTP 应用。 */
export function {{api.serviceAppFactoryName}}(_options: CreateApiServiceAppOptions = {}) {
  const servConfig = core.config.getOrThrow<ServConfig>('serv')
  const coreConfig = core.config.getOrThrow<CoreConfig>('core')
  const security = serv.createRuntimeSecurityPolicy({
    environment: coreConfig.env,
    corsOrigin: servConfig.cors.origin,
    nativeOrigins: servConfig.cors.nativeOrigins,
  })
{{#if features.crypto}}
  const transportMode = _options.transport ?? 'config'
  let transport: ServTransportConfig | undefined
  if (transportMode !== 'disabled' && servConfig.transport !== false) {
    const ring = crypto.transport.parseServerKeyRing(process.env.HAI_CRYPTO_TRANSPORT_SERVERKEYRING)
    if (!ring.success)
      throw new Error(`HAI_CRYPTO_TRANSPORT_SERVERKEYRING: ${ring.error.message} (${ring.error.code})`)
    transport = {
      crypto,
      serverKeyRing: ring.data,
      keyStore: crypto.transport.createKeyStore({ cache }),
      keyExchangePath: servConfig.transport.keyExchangePath,
      maxPlaintextBytes: servConfig.transport.maxPlaintextBytes,
      maxFutureSkewSeconds: servConfig.transport.maxFutureSkewSeconds,
      maxRequestAgeSeconds: servConfig.transport.maxRequestAgeSeconds,
{{#if features.feedback}}
      routePlaintextBytes: {
        ...apiContract.feedbackTransportRoutes(servConfig.http.apiPrefix),
        ...servConfig.transport.routePlaintextBytes,
      },
{{else}}
routePlaintextBytes: servConfig.transport.routePlaintextBytes,
{{/if}}
      excludePaths: [
        ...new Set([
          ...servConfig.transport.excludePaths,
          ...(servConfig.http.health
            ? [servConfig.http.health.path, servConfig.http.health.readyPath].filter((path): path is `/${string}` => Boolean(path))
            : []),
          ...(servConfig.http.openapi && security.exposeApiDocs
            ? [servConfig.http.openapi.path]
            : []),
          ...(servConfig.http.docs && security.exposeApiDocs
            ? [servConfig.http.docs.path, `${servConfig.http.docs.path.slice(0, servConfig.http.docs.path.lastIndexOf('/') + 1)}_hai/scalar.js`]
            : []),
        ]),
      ],
    }
  }
{{else}}
  const transport = undefined
{{/if}}
{{#if features.iam}}
  const refreshCookie = _options.refreshCookie === 'disabled'
    ? undefined
    : {
        secure: security.secureRefreshCookie,
        nativeTokenTransport: {
          isRequest: (request: Request) => request.headers.get('x-hai-token-transport') === 'body'
            && ['hai-mobile-app', 'hai-desktop-app'].includes(request.headers.get('x-request-client') ?? '')
            && security.isNativeOrigin(request.headers.get('origin') ?? ''),
        },
      }
{{/if}}

  const appOptions: Parameters<typeof serv.createApp>[0] = {
    contract: {{api.contractExportName}},
    procedures: {{api.serviceProceduresFactoryName}}({
      app: {
        info: {
          name: coreConfig.name,
          version: coreConfig.version,
          env: coreConfig.env,
          defaultLocale: coreConfig.defaultLocale,
          transportEnabled: transport !== undefined,
        },
        startedAt,
      },
    }),
    http: {
      ...servConfig.http,
      openapi: security.exposeApiDocs ? servConfig.http.openapi : false,
      docs: security.exposeApiDocs ? servConfig.http.docs : false,
    },
{{#if features.iam}}
    iam,
    refreshCookie,
{{/if}}
{{#if features.crypto}}
    transport,
{{/if}}
    middlewares: [
      {
        middleware: serv.cors({
          origin: security.allowOrigin,
          credentials: servConfig.cors.credentials,
          allowedHeaders: [
            ...new Set([
              ...servConfig.cors.allowedHeaders,
              'x-request-client',
              'x-hai-token-transport',
            ]),
          ],
          exposedHeaders: [...servConfig.cors.exposedHeaders],
        }),
      },
    ],
  }

  return serv.createApp(appOptions)
}
