import type { CoreConfig } from '@h-ai/core'
import type { {{#if features.feedback}}CreateServContext, {{/if}}ServConfig{{#if features.crypto}}, ServTransportConfig{{/if}} } from '@h-ai/serv'
{{#if features.crypto}}import process from 'node:process'
{{/if}}
{{#if features.feedback}}import { resolveFeedbackBudget } from '@h-ai/api-contract/feedback'
{{/if}}import { core } from '@h-ai/core'
{{#if features.crypto}}import { {{#if features.db}}createReldbTransportKeyStore{{else}}createInMemoryKeyStore{{/if}}, crypto, parseTransportServerKeyRing } from '@h-ai/crypto'
{{/if}}{{#if features.feedback}}import { FeedbackConfigSchema } from '@h-ai/feedback'
{{/if}}{{#if features.iam}}import { iam } from '@h-ai/iam'
{{/if}}{{#if features.crypto}}{{#if features.db}}import { reldb } from '@h-ai/reldb'
{{/if}}{{/if}}import { serv } from '@h-ai/serv'
import { {{api.contractExportName}} } from '{{api.contractPackageName}}'
import { {{api.serviceProceduresFactoryName}} } from './server/procedures/index.js'

const startedAt = Date.now()

interface CreateApiServiceAppOptions {
  transport?: 'config' | 'disabled'
  refreshCookie?: 'enabled' | 'disabled'
}

/** 创建 API Service HTTP 应用。 */
export function {{api.serviceAppFactoryName}}(_options: CreateApiServiceAppOptions = {}) {
  const servConfig = core.config.getOrThrow<ServConfig>('serv')
  const coreConfig = core.config.getOrThrow<CoreConfig>('core')
  const security = serv.createRuntimeSecurityPolicy({
    environment: coreConfig.env,
    corsOrigin: servConfig.cors.origin,
    nativeOrigins: servConfig.cors.nativeOrigins,
  })
{{#if features.crypto}}  const transportMode = _options.transport ?? 'config'
  let transport: ServTransportConfig | undefined
  if (transportMode !== 'disabled' && servConfig.transport !== false) {
{{#unless features.db}}    if (coreConfig.env !== 'development' && coreConfig.env !== 'test')
      throw new Error('Production transport requires a shared registry; enable the db feature and configure a shared database')
{{/unless}}
    const ring = parseTransportServerKeyRing(process.env.HAI_CRYPTO_TRANSPORT_SERVERKEYRING)
    if (!ring.success)
      throw new Error(`HAI_CRYPTO_TRANSPORT_SERVERKEYRING: ${ring.error.message} (${ring.error.code})`)
{{#if features.feedback}}    // 可选反馈故障重试期间仍使用配置预算，避免缓存默认容量。
    const feedbackSettings = FeedbackConfigSchema.safeParse(core.config.get('feedback'))
    const feedbackBudget = resolveFeedbackBudget(feedbackSettings.success ? feedbackSettings.data : {})
{{/if}}    transport = {
      crypto,
      serverKeyRing: ring.data,
{{#if features.db}}      keyStore: createReldbTransportKeyStore({ reldb, ttlSeconds: 3600 }),
{{else}}      keyStore: createInMemoryKeyStore(), // 无 db 的模板仅在 development/test 使用内存 registry。
{{/if}}
      keyExchangePath: servConfig.transport.keyExchangePath,
      maxPlaintextBytes: servConfig.transport.maxPlaintextBytes,
{{#if features.feedback}}      routePlaintextBytes: {
        [`${servConfig.http.apiPrefix}/feedback/reports`]: feedbackBudget.maxTransportBytes,
        [`${servConfig.http.apiPrefix}/feedback/reports/*/evidence`]: feedbackBudget.maxTransportBytes,
        [`${servConfig.http.apiPrefix}/feedback/reports/*/attachments/*`]: feedbackBudget.maxTransportBytes,
        [`${servConfig.http.apiPrefix}/feedback/reports/*/exports/*`]: feedbackBudget.maxTransportBytes,
        ...servConfig.transport.routePlaintextBytes,
      },
{{else}}      routePlaintextBytes: servConfig.transport.routePlaintextBytes,
{{/if}}
      excludePaths: [...servConfig.transport.excludePaths],
    }
  }
{{else}}  const transport = undefined
{{/if}}
{{#if features.iam}}
  const refreshCookie = _options.refreshCookie === 'disabled' ? undefined : { secure: security.secureRefreshCookie }
{{/if}}
{{#if features.feedback}}
  // 普通业务日志与反馈使用同一可信应用范围；身份仍由 IAM 验证。
  const authenticatedContext = serv.buildAuthContextFactory(token => iam.auth.verifyToken(token))
  const createContext: CreateServContext = async input => ({
    ...await authenticatedContext(input),
    scopeId: '{{projectName}}',
  })
{{/if}}

  const appOptions: Parameters<typeof serv.createApp>[0] = {
    contract: {{api.contractExportName}},
    procedures: {{api.serviceProceduresFactoryName}}({
      app: {
        info: {
          name: coreConfig.name,
          version: coreConfig.version,
          env: coreConfig.env,
          defaultLocale: coreConfig.defaultLocale,
          transportEnabled: transport !== undefined,
        },
        startedAt,
      },
    }),
    http: {
      ...servConfig.http,
      openapi: security.exposeApiDocs ? servConfig.http.openapi : false,
      docs: security.exposeApiDocs ? servConfig.http.docs : false,
    },
{{#if features.iam}}
    iam,
    refreshCookie,
{{/if}}
{{#if features.feedback}}
    createContext,
{{/if}}
{{#if features.crypto}}
    transport,
{{/if}}
    middlewares: [
      {
        middleware: serv.cors({
          origin: security.allowOrigin,
          credentials: servConfig.cors.credentials,
          allowedHeaders: [...servConfig.cors.allowedHeaders],
          exposedHeaders: [...servConfig.cors.exposedHeaders],
        }),
      },
    ],
  }

  return serv.createApp(appOptions)
}
