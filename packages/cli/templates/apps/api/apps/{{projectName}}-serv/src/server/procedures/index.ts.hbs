import type { AppProcedureDeps } from './app-procedures.js'
{{#if features.ai}}
import { ai } from '@h-ai/ai'
{{/if}}
{{#if features.feedback}}
import { feedback } from '@h-ai/feedback'
{{/if}}
{{#if features.iam}}
import { iam } from '@h-ai/iam'
{{/if}}
{{#if features.ai}}
import { serv } from '@h-ai/serv'
{{else if features.feedback}}
import { serv } from '@h-ai/serv'
{{else if features.iam}}
import { serv } from '@h-ai/serv'
{{else if features.storage}}
import { serv } from '@h-ai/serv'
{{/if}}
{{#if features.storage}}
import { storage } from '@h-ai/storage'
{{/if}}
import { createAppProcedures } from './app-procedures.js'

// @hai-generator:procedures:imports

/** 创建应用级 procedures 聚合。 */
export function {{api.serviceProceduresFactoryName}}(deps: { app: AppProcedureDeps }) {
  return {
    // @hai-generator:procedures:entries
{{#if features.iam}}
    iam: serv.createIamProcedures({ iam }),
{{/if}}
{{#if features.storage}}
    storage: serv.createStorageProcedures({
      storage,
      authorize: ({ context, keys }) => keys.every(key =>
        key.startsWith(`users/${encodeURIComponent(context.session.userId)}/`)),
    }),
{{/if}}
{{#if features.ai}}
    // AI 默认绑定可信 session.userId，跨主体访问需另行提供 authorizeObject 策略。
    ai: serv.createAiProcedures({ ai }),
{{/if}}
{{#if features.feedback}}
    feedback: serv.createFeedbackProcedures({
      feedback,
      resolveContext: ({ session }) => ({
        scopeId: '{{projectName}}',
        userId: session.userId,
        // 示例角色映射；实际产品应从可信租户与资源权限确定范围。
        permissions: session.roles.includes('admin')
          ? [
              'feedback:create',
              'feedback:read',
              'feedback:process',
              'feedback:reopen',
              'feedback:export',
            ]
          : ['feedback:create'],
      }),
    }),
{{/if}}
    app: createAppProcedures(deps.app),
  }
}
