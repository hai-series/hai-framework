{
  "engines": { "node": "^22.23.4 || ^24.22.1 || ^26.12.1" },
  "name": "{{api.servPackageName}}",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "config",
    "data",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "check": "pnpm typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo",
    "dev": "pnpm build && node --env-file=.env --env-file=.env.dev --env-file-if-exists=.env.local dist/index.js",
    "start": "node --env-file=.env --env-file=.env.prod --env-file-if-exists=.env.local dist/index.js",
    "dev:test": "pnpm build && node --env-file=.env --env-file=.env.test --env-file-if-exists=.env.local dist/index.js",
    "dev:prod": "pnpm build && pnpm start",
    "start:test": "node --env-file=.env --env-file=.env.test --env-file-if-exists=.env.local dist/index.js",
    "start:prod": "pnpm start"
  },
  "dependencies": {
    "pino-pretty": "{{api.packageSpecifiers.pinoPretty}}",
    "@h-ai/core": "{{haiPackageSpecifier}}",
    "@h-ai/serv": "{{haiPackageSpecifier}}",
    "{{api.contractPackageName}}": "workspace:*"{{#if features.ai}},
    "@h-ai/ai": "{{haiPackageSpecifier}}"{{/if}}{{#if features.audit}},
    "@h-ai/audit": "{{haiPackageSpecifier}}"{{/if}}{{#if features.cache}},
    "@h-ai/cache": "{{haiPackageSpecifier}}"{{/if}}{{#if features.crypto}},
    "@h-ai/crypto": "{{haiPackageSpecifier}}"{{/if}}{{#if features.datapipe}},
    "@h-ai/datapipe": "{{haiPackageSpecifier}}"{{/if}}{{#if features.iam}},
    "@h-ai/iam": "{{haiPackageSpecifier}}"{{/if}}{{#if features.feedback}},
    "@h-ai/api-contract": "{{haiPackageSpecifier}}",
    "@h-ai/feedback": "{{haiPackageSpecifier}}"{{/if}}{{#if features.payment}},
    "@h-ai/payment": "{{haiPackageSpecifier}}"{{/if}}{{#if features.reach}},
    "@h-ai/reach": "{{haiPackageSpecifier}}"{{/if}}{{#if features.db}},
    "@h-ai/reldb": "{{haiPackageSpecifier}}"{{/if}}{{#if features.scheduler}},
    "@h-ai/scheduler": "{{haiPackageSpecifier}}"{{/if}}{{#if features.storage}},
    "@h-ai/storage": "{{haiPackageSpecifier}}"{{/if}}{{#if features.vecdb}},
    "@h-ai/vecdb": "{{haiPackageSpecifier}}"{{/if}}
  },
  "devDependencies": {
    "@h-ai/api-client": "{{haiPackageSpecifier}}",
    "@types/node": "{{api.packageSpecifiers.nodeTypes}}",
    "rimraf": "{{api.packageSpecifiers.rimraf}}",
    "tsup": "{{api.packageSpecifiers.tsup}}",
    "typescript": "{{api.packageSpecifiers.typescript}}",
    "vitest": "{{api.packageSpecifiers.vitest}}"
  }
}
