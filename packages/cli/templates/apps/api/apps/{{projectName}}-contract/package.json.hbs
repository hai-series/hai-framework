{
  "engines": { "node": "^22.23.4 || ^24.22.1 || ^26.12.1" },
  "name": "{{api.contractPackageName}}",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "check": "pnpm typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@h-ai/api-contract": "{{haiPackageSpecifier}}",
    "zod": "{{api.packageSpecifiers.zod}}"
  },
  "devDependencies": {
    "@types/node": "{{api.packageSpecifiers.nodeTypes}}",
    "rimraf": "{{api.packageSpecifiers.rimraf}}",
    "tsup": "{{api.packageSpecifiers.tsup}}",
    "typescript": "{{api.packageSpecifiers.typescript}}",
    "vitest": "{{api.packageSpecifiers.vitest}}"
  }
}
