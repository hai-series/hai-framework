# =============================================================================
# {{projectName}} API Service - 应用配置
# =============================================================================

name: {{projectName}} API Service
version: 0.1.0
env: ${HAI_CORE_ENV:development}
debug: ${HAI_CORE_DEBUG:false}

logging:
  level: info
  format: json
  redact:
    - password
    - token
    - secret

defaultLocale: {{defaultLocale}}
supportedLocales:
  - {{defaultLocale}}
{{#if_eq defaultLocale 'zh-CN'}}{{else}}  - zh-CN
{{/if_eq}}{{#if_eq defaultLocale 'en-US'}}{{else}}  - en-US
{{/if_eq}}{{#if_eq defaultLocale 'ja-JP'}}{{else}}  - ja-JP
{{/if_eq}}

features:
  apiAccess: true
