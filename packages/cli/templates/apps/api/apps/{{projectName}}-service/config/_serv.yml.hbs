# =============================================================================
# {{projectName}} API Service - Serv / HTTP 入口配置
# =============================================================================

http:
  apiPrefix: /api/v1
  openapi:
    path: /openapi.json
  docs:
    path: /docs
  health:
    path: /health
    readyPath: /ready
  rpc: false

cors:
  origin: '*'
  nativeOrigins: http://localhost,https://tauri.localhost,tauri://localhost,capacitor://localhost
{{#if features.iam}}  credentials: true
{{else}}  credentials: false
{{/if}}  allowedHeaders:
    - Authorization
    - Content-Type
{{#if features.crypto}}    - X-Client-Id
    - X-Encrypted
{{/if}}    - X-Hai-Locale
    - X-Request-Id
    - X-Requested-With
  exposedHeaders:
{{#if features.crypto}}    - X-Encrypted
{{/if}}    - X-Request-Id

{{#if features.crypto}}transport:
  keyExchangePath: /_hai/key-exchange
  excludePaths:
    - /health
    - /ready
    - /openapi.json
    - /docs
    - /_hai/scalar.js
  maxClients: 10000
{{else}}transport: false
{{/if}}
