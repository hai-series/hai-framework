# =============================================================================
# {{projectName}} API Service - Serv / HTTP 入口配置
# =============================================================================

server:
  host: 127.0.0.1
  port: 3000

http:
  apiPrefix: /api/v1
  openapi:
    path: /openapi.json
  docs:
    path: /docs
  health:
    path: /health
    readyPath: /ready
  rpc: false

cors:
  origin: ${HAI_SERV_CORS_ORIGIN:*}
  nativeOrigins: ${HAI_SERV_CORS_NATIVEORIGINS:http://localhost,https://tauri.localhost,tauri://localhost,capacitor://localhost}
{{#if features.iam}}  credentials: ${HAI_SERV_CORS_CREDENTIALS:true}
{{else}}  credentials: ${HAI_SERV_CORS_CREDENTIALS:false}
{{/if}}  allowedHeaders:
    - Authorization
    - Content-Type
{{#if features.crypto}}    - X-Client-Id
    - X-Encrypted
    - X-Hai-Transport
{{/if}}    - X-Hai-Locale
    - X-Request-Id
    - X-Requested-With
  exposedHeaders:
{{#if features.crypto}}    - X-Encrypted
    - X-Hai-Transport
{{/if}}    - X-Request-Id

{{#if features.crypto}}transport:
  # 双向业务明文 UTF-8 字节；默认 {{#if features.feedback}}8 MiB（容纳反馈附件的 base64 与 JSON）{{else}}1 MiB{{/if}}，范围 1 KiB～64 MiB，密文容量自动推导。
{{#if features.feedback}}
  maxPlaintextBytes: ${HAI_SERV_TRANSPORT_MAXPLAINTEXTBYTES:8388608}
{{else}}
  maxPlaintextBytes: ${HAI_SERV_TRANSPORT_MAXPLAINTEXTBYTES:1048576}
{{/if}}
  keyExchangePath: /_hai/key-exchange
  excludePaths:
    - /health
    - /ready
    - /openapi.json
    - /docs
    - /_hai/scalar.js
{{else}}transport: false
{{/if}}
