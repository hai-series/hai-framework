# =============================================================================
# {{projectName}} API Service - Serv / HTTP 入口配置
# =============================================================================

server:
  host: 127.0.0.1
  port: 3000

http:
  apiPrefix: /api/v1
  openapi:
    path: /openapi.json
  docs:
    path: /docs
  health:
    path: /health
    readyPath: /ready
  rpc: false

cors:
  origin: ${HAI_CORS_ORIGIN:*}
  nativeOrigins: ${HAI_CORS_NATIVEORIGINS:http://localhost,https://tauri.localhost,tauri://localhost,capacitor://localhost}
{{#if features.iam}}  credentials: ${HAI_CORS_CREDENTIALS:true}
{{else}}  credentials: ${HAI_CORS_CREDENTIALS:false}
{{/if}}  allowedHeaders:
    - Authorization
    - Content-Type
{{#if features.crypto}}    - X-Client-Id
    - X-Encrypted
{{/if}}    - X-Hai-Locale
    - X-Request-Id
    - X-Requested-With
  exposedHeaders:
{{#if features.crypto}}    - X-Encrypted
{{/if}}    - X-Request-Id

{{#if features.crypto}}transport:
  keyExchangePath: /_hai/key-exchange
  excludePaths:
    - /health
    - /ready
    - /openapi.json
    - /docs
    - /_hai/scalar.js
  maxClients: 10000
{{else}}transport: false
{{/if}}
