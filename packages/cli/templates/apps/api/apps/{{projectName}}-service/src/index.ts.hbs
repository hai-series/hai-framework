import type { CoreConfig } from '@h-ai/core'
import type { ServConfig } from '@h-ai/serv'
import process from 'node:process'
import { core } from '@h-ai/core'
import { serv } from '@h-ai/serv'
import { {{api.serviceAppFactoryName}} } from './app.js'
import { closeApp, initApp } from './lib/server/init.js'

async function main(): Promise<void> {
  await initApp()
  const config = core.config.getOrThrow<CoreConfig>('core')
  const logger = core.logger.child({ app: config.name, scope: 'entrypoint' })

  // host/port 来自 config/_serv.yml 的 server（HOST/PORT 环境变量高于配置文件）。
  const { server } = core.config.getOrThrow<ServConfig>('serv')
  serv.listen({{api.serviceAppFactoryName}}(), {
    host: server.host,
    port: server.port,
    onListening: info => logger.info('API service listening', { address: info.address, port: info.port }),
    onClose: closeApp,
  })
}

main().catch((error: unknown) => {
  core.logger.error('API service failed to start', { error })
  process.exitCode = 1
})
