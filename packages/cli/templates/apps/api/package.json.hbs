{
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "name": "{{projectName}}",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "description": "Typed hai API workspace with separated contract and service packages.",
  "scripts": {
    "dev": "pnpm --filter {{api.servicePackageName}} dev",
    "start": "pnpm --filter {{api.servicePackageName}} start",
    "start:test": "pnpm --filter {{api.servicePackageName}} start:test",
    "start:prod": "pnpm --filter {{api.servicePackageName}} start:prod",
    "dev:test": "pnpm --filter {{api.servicePackageName}} dev:test",
    "dev:prod": "pnpm --filter {{api.servicePackageName}} dev:prod",
    "compile": "pnpm --filter {{api.contractPackageName}} build && pnpm -r --if-present build",
    "build": "hai build",
{{#if features.deploy}}
    "deploy": "hai deploy apps/{{projectName}}-service",
{{/if}}
    "check": "pnpm typecheck",
    "typecheck": "pnpm --filter {{api.contractPackageName}} build && pnpm -r --if-present typecheck",
    "lint": "eslint *.js *.ts e2e && pnpm -r --if-present lint",
    "lint:fix": "eslint *.js *.ts e2e --fix && pnpm -r --if-present lint:fix",
    "test": "pnpm --filter {{api.contractPackageName}} build && pnpm -r --if-present test",
    "test:watch": "pnpm -r --parallel --if-present test:watch",
    "test:e2e": "pnpm compile && node scripts/run-e2e.mjs",
    "clean": "pnpm -r --if-present clean && rimraf node_modules .turbo"
  },
  "dependencies": {
    "@h-ai/api-contract": "{{haiPackageSpecifier}}",
    "{{api.contractPackageName}}": "workspace:*"
  },
  "devDependencies": {
{{#if features.deploy}}
    "@h-ai/deploy": "{{haiPackageSpecifier}}",
{{/if}}
    "@h-ai/cli": "{{haiPackageSpecifier}}",
    "@h-ai/api-client": "{{haiPackageSpecifier}}",
{{#if features.crypto}}
    "@h-ai/crypto": "{{haiPackageSpecifier}}",
{{/if}}
    "@antfu/eslint-config": "{{api.packageSpecifiers.antfuEslintConfig}}",
    "@playwright/test": "{{api.packageSpecifiers.playwright}}",
    "@types/node": "{{api.packageSpecifiers.nodeTypes}}",
    "eslint": "{{api.packageSpecifiers.eslint}}",
    "eslint-plugin-format": "{{api.packageSpecifiers.eslintPluginFormat}}",
    "rimraf": "{{api.packageSpecifiers.rimraf}}",
    "tsup": "{{api.packageSpecifiers.tsup}}",
    "typescript": "{{api.packageSpecifiers.typescript}}",
    "vitest": "{{api.packageSpecifiers.vitest}}"
  }
}
