import { describe, expect, it } from 'vitest'
import { GET } from '../src/routes/api/v1/health/+server'

interface HealthResponseBody {
  success: boolean
  data?: {
    status?: string
    service?: string
  }
  requestId?: string
}

describe('api health endpoint', () => {
  it('returns a successful HaiResult response', async () => {
    const response = await GET({
      locals: { requestId: 'test-request' },
    } as Parameters<typeof GET>[0])
    const body = await response.json() as HealthResponseBody

    expect(response.status).toBe(200)
    expect(body.success).toBe(true)
    expect(body.data?.status).toBe('ok')
    expect(body.data?.service).toBe('api-service')
    expect(body.requestId).toBe('test-request')
  })
})