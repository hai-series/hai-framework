{{!-- 后台管理布局（侧边栏 + 内容区） --}}
<script lang='ts'>
  /**
   * 后台管理布局（侧边栏 + 内容区）
   */
  import type { Snippet } from 'svelte'
  import { resolve } from '$app/paths'
  import { page } from '$app/state'
{{#if hasI18n}}
  import * as m from '$lib/paraglide/messages'
{{/if}}
  import { WorkspaceLayout } from '@h-ai/ui'

  interface Props {
    children: Snippet
  }

  const { children }: Props = $props()
  let drawerOpen = $state(false)
  let menuButton: HTMLButtonElement

  function closeDrawer() {
    drawerOpen = false
    menuButton?.focus()
  }

  function handleDrawerKeydown(event: KeyboardEvent) {
    if (drawerOpen && event.key === 'Escape')
      closeDrawer()
  }

  const navItems = $derived([
{{#if hasI18n}}
    { path: '/admin', label: m.nav_dashboard(), icon: 'icon-[tabler--layout-dashboard]' },
    { path: '/admin/settings', label: m.nav_settings(), icon: 'icon-[tabler--settings]' },
{{else}}
    { path: '/admin', label: '仪表盘', icon: 'icon-[tabler--layout-dashboard]' },
    { path: '/admin/settings', label: '设置', icon: 'icon-[tabler--settings]' },
{{/if}}
  ] as const)
</script>

<svelte:window onkeydown={handleDrawerKeydown} />

<div class='drawer min-h-0 flex-1 lg:drawer-open'>
  <input id='admin-drawer' type='checkbox' class='drawer-toggle' bind:checked={drawerOpen} />
  <div class='drawer-content flex min-h-0 min-w-0 flex-col overflow-hidden'>
    <button bind:this={menuButton} type='button' class='btn btn-ghost btn-sm drawer-button m-1 shrink-0 self-start lg:hidden' aria-label={{#if hasI18n}}{m.nav_open_sidebar()}{{else}}'打开侧栏'{{/if}} aria-expanded={drawerOpen} aria-controls='admin-sidebar' onclick={() => drawerOpen = !drawerOpen}>
      <span class='icon-[tabler--menu-2] size-5'></span>
    </button>
    <WorkspaceLayout>{@render children()}</WorkspaceLayout>
  </div>
  <div id='admin-sidebar' class='drawer-side'>
    <button type='button' class='drawer-overlay' aria-label={{#if hasI18n}}{m.nav_close_sidebar()}{{else}}'关闭侧栏'{{/if}} onclick={closeDrawer}></button>
    <nav class='menu p-4 w-64 min-h-full gap-1 bg-base-100 text-base-content border-r border-base-300/60'>
      <div class='flex items-center gap-2 px-2 mb-6 text-xl font-bold'>
        <span class='icon-[tabler--cube] size-6 text-primary'></span>
{{#if hasI18n}}
        {page.data.appConfig.name}
{{else}}
        {page.data.appConfig.name}
{{/if}}
      </div>
      <ul class='gap-1'>
        {#each navItems as item (item.path)}
          <li>
            <a href={resolve(item.path, {})} class:menu-active={page.url.pathname === resolve(item.path, {})} onclick={closeDrawer}>
              <span class='{item.icon} size-5'></span>
              {item.label}
            </a>
          </li>
        {/each}
      </ul>
    </nav>
  </div>
</div>
