{{!-- H5 应用根布局 --}}
<script lang='ts'>
  /**
   * H5 应用根布局
   */
  import type { BottomNavItem } from '@h-ai/ui'
  import type { Snippet } from 'svelte'
  import { browser } from '$app/env'
  import { goto } from '$app/navigation'
  import { resolve } from '$app/paths'
  import { page } from '$app/state'
{{#if features.crypto}}
  import { crypto } from '@h-ai/crypto'
  import { kit } from '@h-ai/kit'
{{else}}
{{#if features.iam}}
  import { kit } from '@h-ai/kit'
{{/if}}
{{/if}}
{{#if hasI18n}}
  import { AppBar, BottomNav, LanguageSwitch, setGlobalLocale, ThemeSelector } from '@h-ai/ui'
{{else}}
  import { AppBar, BottomNav, ThemeSelector } from '@h-ai/ui'
{{/if}}
  import { applyTheme, getSavedTheme } from '@h-ai/ui/theme'
{{#if features.crypto}}
  import { untrack } from 'svelte'
{{/if}}
{{#if hasI18n}}
  import * as m from '#lib/paraglide/messages.js'
  import { getLocale, setLocale } from '#lib/paraglide/runtime.js'
{{/if}}
  import '../app.css'

  interface Props {
    children: Snippet
  }

  const { children }: Props = $props()
  const initialTheme = browser
    ? getSavedTheme()
    : 'light'
  let currentTheme = $state(initialTheme)
  if (browser)
    applyTheme(initialTheme, false)

  function handleThemeChange(theme: string) {
    currentTheme = theme
    applyTheme(theme)
  }
{{#if features.crypto}}
  if (browser) {
    kit.client.installBrowserTransport(untrack(() => page.data.kitConfig), {
      crypto,
      basePath: resolve('/').replace(/\/$/, ''),
    })
  }
{{/if}}
{{#if features.iam}}
  const authActions = kit.client.createAuthActions({ basePath: `${resolve('/').replace(/\/$/, '')}/api/auth` })
  $effect(() => authActions.bindPageExit({ enabled: page.data.iamPublicConfig?.session.endOnPageHide }))
{{/if}}

  const navItems: (BottomNavItem & { path: ReturnType<typeof resolve> })[] = [
{{#if hasI18n}}
    {
      id: 'home',
      path: resolve('/'),
      label: m.nav_home(),
      iconClass: 'icon-[tabler--home]',
    },
    {
      id: 'discover',
      path: resolve('discover'),
      label: m.nav_discover(),
      iconClass: 'icon-[tabler--compass]',
    },
    {
      id: 'profile',
      path: resolve('profile'),
      label: m.nav_profile(),
      iconClass: 'icon-[tabler--user]',
    },
{{else}}
    {
      id: 'home',
      path: resolve('/'),
      label: '首页',
      iconClass: 'icon-[tabler--home]',
    },
    {
      id: 'discover',
      path: resolve('discover'),
      label: '发现',
      iconClass: 'icon-[tabler--compass]',
    },
    {
      id: 'profile',
      path: resolve('profile'),
      label: '我的',
      iconClass: 'icon-[tabler--user]',
    },
{{/if}}
  ]

  const localPath = $derived(page.url.pathname.slice(resolve('/').replace(/\/$/, '').length) || '/')
  const activeNav = $derived(navItems.find(item => item.path === page.url.pathname)?.id)
  // 所有页面共用页头页脚；仅业务页面显示底部导航。
  const isAuthPage = $derived(localPath.startsWith('/auth'))

  function handleNavigation(id: string) {
    const item = navItems.find(item => item.id === id)
    if (item)
      // eslint-disable-next-line svelte/no-navigation-without-resolve -- path 仅来自上方 resolve 构造的导航表，不能二次添加挂载前缀。
      void goto(item.path)
  }
{{#if hasI18n}}

  function handleLanguageChange(language: string) {
    setGlobalLocale(language)
    setLocale(language as Parameters<typeof setLocale>[0])
  }

  if (browser) {
    const paraglideLocale = getLocale()
    setGlobalLocale(paraglideLocale)
  }
{{/if}}
</script>

<svelte:head>
  <title>{page.data.appConfig.name}</title>
</svelte:head>

<div class='hai-mobile-viewport'>
  <div class='hai-mobile-shell min-w-0'>
    <AppBar title={page.data.appConfig.name} safeArea fixed={false}>
      {#snippet trailing()}
        <div class='flex items-center gap-1'>
{{#if hasI18n}}
          <LanguageSwitch currentLanguage={getLocale()} onchange={handleLanguageChange} compact />
{{/if}}
          <ThemeSelector {currentTheme} onchange={handleThemeChange} compact grouped={false} />
        </div>
      {/snippet}
    </AppBar>
    <main class='hai-mobile-main'>{@render children()}</main>
    <footer class='border-t border-base-300 bg-base-100 p-2 text-center text-xs text-base-content/60'>
      {page.data.appConfig.name} · {page.data.appConfig.version} · {page.data.appConfig.env}
    </footer>
    {#if !isAuthPage}
      <BottomNav items={navItems} active={activeNav} onchange={handleNavigation} centered maxWidth='none' safeArea />
    {/if}
  </div>
</div>
<ToastContainer />
