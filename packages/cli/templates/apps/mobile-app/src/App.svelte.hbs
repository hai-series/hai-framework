<script lang='ts'>
{{#if features.iam}}
  import type { IamPublicConfig } from '@h-ai/api-contract'
{{/if}}
  import type { Component } from 'svelte'
{{#if features.iam}}
  import { apiClient } from '@h-ai/api-client'
{{/if}}
  import { applyTheme, getSavedTheme, LanguageSwitch, setGlobalLocale } from '@h-ai/ui'
{{#if features.iam}}
  import { AuthPanel } from '@h-ai/ui/components/scenes/iam/index'
  import { authErrorMessage } from '@h-ai/ui/i18n'
{{/if}}
  import { onMount } from 'svelte'

  import { closeApi, initApi, usesNativeTokenStorage } from './lib/api.js'
  import { appConfig, initClientCore } from './lib/app-config.js'
  import { initCapacitor, isNativeApp } from './lib/capacitor.js'
  import { HashRouter } from './lib/navigation/hash-router.svelte.js'
  import * as m from './lib/paraglide/messages.js'
  import { getLocale, setLocale } from './lib/paraglide/runtime.js'

{{#if features.iam}}
  const authActions = apiClient.createAuthActions(apiClient)
  let authConfig = $state<IamPublicConfig | null>(null)
  let authenticated = $state(false)
  let resetToken = $state('')

  function handleAuthenticated() {
    if (resetToken) {
      const url = new URL(location.href)
      url.searchParams.delete('token')
      history.replaceState(history.state, '', url)
    }
    resetToken = ''
    authenticated = true
  }
{{/if}}

  const pages = import.meta.glob<{ default: Component<{ nativeRuntime: boolean, nativeTokenStorage: boolean }> }>('./lib/pages/**/*.svelte')
  const router = new HashRouter(Object.keys(pages), '/home')
  const pageComponent = $derived(pages[router.file]())

  let booting = $state(true)
  let bootError = $state<string | null>(null)
  let nativeRuntime = $state(false)
  let nativeTokenStorage = $state(false)

  const navItems = $derived([
    { id: 'home', label: m.nav_home(), iconClass: 'icon-[tabler--layout-dashboard]' },
    { id: 'tasks', label: m.nav_tasks(), iconClass: 'icon-[tabler--checkbox]' },
    { id: 'profile', label: m.nav_profile(), iconClass: 'icon-[tabler--user-circle]' },
  ])

  async function bootstrap(): Promise<void> {
    try {
      initClientCore()
      document.title = appConfig.name
      applyTheme(getSavedTheme(), false)
      setGlobalLocale(getLocale())
      document.documentElement.lang = getLocale()
      await initCapacitor()
      await initApi()
{{#if features.iam}}
      const config = await authActions.publicConfig()
      if (!config.success)
        throw new Error(authErrorMessage(config.error))
      authConfig = config.data
      if (!authConfig)
        throw new Error(m.boot_failed_title())
      const me = await apiClient.iam.auth.currentUser()
      authenticated = !resetToken && me.success
{{/if}}
      nativeRuntime = await isNativeApp()
      nativeTokenStorage = await usesNativeTokenStorage()
    }
    catch (error) {
      bootError = error instanceof Error ? error.message : String(error)
    }
    finally {
      booting = false
    }
  }

  function handleLanguageChange(language: string): void {
    setGlobalLocale(language)
    setLocale(language as Parameters<typeof setLocale>[0])
  }

  /** 切换底部导航；例如 handleTabChange('tasks') 会写入 #/tasks。 */
  function handleTabChange(id: string): void {
    router.navigate(`/${id}`)
  }

  onMount(() => {
    const stopRouting = router.start()
{{#if features.iam}}
    resetToken = new URL(location.href).searchParams.get('token') ?? ''
{{/if}}
    void bootstrap()

    return () => {
      stopRouting()
      void closeApi()
    }
  })
</script>

<div class='hai-mobile-viewport'>
  <div class='hai-mobile-shell min-w-0'>
    <AppBar title={appConfig.name} safeArea fixed={false} class='bg-base-100/95 backdrop-blur border-base-content/8'>
      {#snippet trailing()}
        <LanguageSwitch currentLanguage={getLocale()} onchange={handleLanguageChange} compact />
      {/snippet}
    </AppBar>
    <main class='hai-mobile-main'>
      {#if booting}
        <div class='grid min-h-64 place-items-center'><span class='loading loading-spinner loading-lg'></span></div>
      {:else if bootError}
        <section class='flex min-h-64 flex-col items-center justify-center gap-3 p-6 text-center'>
          <h1 class='text-lg font-bold'>{m.boot_failed_title()}</h1>
          <p class='text-base-content/60 text-sm'>{bootError}</p>
          <Button variant='primary' size='sm' onclick={() => location.reload()}>{m.common_retry()}</Button>
        </section>
{{#if features.iam}}
      {:else if !authenticated}
        <AuthPanel config={authConfig} actions={authActions} {resetToken} initialMode={resetToken ? 'reset' : 'login'} onauthenticated={handleAuthenticated} />
{{/if}}
      {:else}
        {#await pageComponent}
          <div class='grid min-h-64 place-items-center'><span class='loading loading-spinner'></span></div>
        {:then { default: Page }}
          <Page {nativeRuntime} {nativeTokenStorage} />
        {/await}
      {/if}
    </main>
    <footer class='border-t border-base-content/8 bg-base-100 p-2 text-center text-xs text-base-content/50'>
      {appConfig.name} · {appConfig.version} · {appConfig.env}
    </footer>
{{#if features.iam}}
    {#if authenticated && !booting && !bootError}
{{/if}}
      <BottomNav items={navItems} active={router.path.slice(1)} onchange={handleTabChange} safeArea centered maxWidth='none' />
{{#if features.iam}}
    {/if}
{{/if}}
  </div>
</div>
<ToastContainer />
