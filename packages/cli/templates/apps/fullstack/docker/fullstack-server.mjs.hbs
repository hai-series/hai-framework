{{! @skipIfEmpty }}
{{#if fullstack.frontends.web}}
import { spawn } from 'node:child_process'
import { createReadStream } from 'node:fs'
import { readFile, stat } from 'node:fs/promises'
import { createServer, request as createProxyRequest } from 'node:http'
import { extname, relative, resolve, sep } from 'node:path'
import process from 'node:process'

const serviceRoot = '/app/service'
const webRoot = '/app/web'
const publicPort = readPort('HAI_WEB_PORT', 8080)
const servicePort = readPort('HAI_SERV_PORT', 3000)
const indexHtml = await readFile(resolve(webRoot, 'index.html'), 'utf8')
const indexWithRuntimeApi = injectRuntimeApiOrigin(indexHtml)
let shuttingDown = false

// 服务进程只监听容器回环地址，所有外部流量统一经过同源 Web 入口。
const service = spawn(process.execPath, ['dist/index.js'], {
  cwd: serviceRoot,
  env: {
    ...process.env,
    HOST: '127.0.0.1',
    PORT: String(servicePort),
  },
  stdio: 'inherit',
})

const server = createServer(async (request, response) => {
  const requestUrl = new URL(request.url ?? '/', `http://${request.headers.host ?? 'localhost'}`)

  if (isServicePath(requestUrl.pathname)) {
    proxyToService(request, response)
    return
  }

  if (request.method !== 'GET' && request.method !== 'HEAD') {
    response.writeHead(405, { Allow: 'GET, HEAD' })
    response.end()
    return
  }

  await serveWebAsset(requestUrl.pathname, request.method === 'HEAD', response)
})

server.listen(publicPort, '0.0.0.0', () => {
  process.stdout.write(`Fullstack container listening on 0.0.0.0:${publicPort}\n`)
})

service.once('error', (error) => {
  process.stderr.write(`Service process failed to start: ${error.message}\n`)
  void shutdown('service-error')
})

service.once('exit', (code, signal) => {
  if (shuttingDown)
    return
  process.stderr.write(`Service process exited unexpectedly (code=${String(code)}, signal=${String(signal)})\n`)
  process.exitCode = code ?? 1
  server.close()
})

for (const signal of ['SIGINT', 'SIGTERM']) {
  process.once(signal, () => {
    void shutdown(signal)
  })
}

function readPort(name, fallback) {
  const raw = process.env[name]
  if (raw === undefined || raw === '')
    return fallback
  const value = Number(raw)
  if (!Number.isInteger(value) || value < 1 || value > 65535)
    throw new Error(`${name} must be an integer between 1 and 65535`)
  return value
}

function isServicePath(pathname) {
  return pathname === '/health'
    || pathname === '/ready'
    || pathname === '/openapi.json'
    || pathname.startsWith('/api/')
    || pathname.startsWith('/docs')
    || pathname.startsWith('/_hai/')
}

function proxyToService(request, response) {
  const proxyRequest = createProxyRequest({
    host: '127.0.0.1',
    port: servicePort,
    method: request.method,
    path: request.url,
    headers: {
      ...request.headers,
      host: `127.0.0.1:${servicePort}`,
      'x-forwarded-host': request.headers.host ?? '',
      'x-forwarded-proto': request.headers['x-forwarded-proto'] ?? 'http',
    },
  }, (proxyResponse) => {
    response.writeHead(proxyResponse.statusCode ?? 502, proxyResponse.headers)
    proxyResponse.pipe(response)
  })

  proxyRequest.once('error', (error) => {
    if (response.headersSent) {
      response.destroy(error)
      return
    }
    response.writeHead(502, { 'content-type': 'text/plain; charset=utf-8' })
    response.end('Service unavailable')
  })
  request.pipe(proxyRequest)
}

async function serveWebAsset(pathname, headOnly, response) {
  let decodedPath
  try {
    decodedPath = decodeURIComponent(pathname)
  }
  catch {
    response.writeHead(400)
    response.end()
    return
  }

  const candidate = resolve(webRoot, `.${decodedPath}`)
  const relativePath = relative(webRoot, candidate)
  if (relativePath.startsWith(`..${sep}`) || relativePath === '..') {
    response.writeHead(403)
    response.end()
    return
  }

  try {
    const file = await stat(candidate)
    if (file.isFile()) {
      response.writeHead(200, {
        'content-length': file.size,
        'content-type': contentType(candidate),
        'x-content-type-options': 'nosniff',
      })
      if (headOnly)
        response.end()
      else
        createReadStream(candidate).pipe(response)
      return
    }
  }
  catch {
    // SPA 路由没有对应静态文件时回退到 index.html。
  }

  const body = Buffer.from(indexWithRuntimeApi)
  response.writeHead(200, {
    'content-length': body.length,
    'content-type': 'text/html; charset=utf-8',
    'x-content-type-options': 'nosniff',
  })
  response.end(headOnly ? undefined : body)
}

function injectRuntimeApiOrigin(html) {
  const script = `<script>(()=>{const p=new URLSearchParams(location.search);if(!p.has('apiBase')){p.set('apiBase',location.origin);history.replaceState(null,'',location.pathname+'?'+p+location.hash)}})()</script>`
  return html.includes('<head>') ? html.replace('<head>', `<head>${script}`) : `${script}${html}`
}

function contentType(file) {
  return {
    '.css': 'text/css; charset=utf-8',
    '.html': 'text/html; charset=utf-8',
    '.ico': 'image/x-icon',
    '.js': 'text/javascript; charset=utf-8',
    '.json': 'application/json; charset=utf-8',
    '.map': 'application/json; charset=utf-8',
    '.png': 'image/png',
    '.svg': 'image/svg+xml',
    '.webp': 'image/webp',
    '.woff': 'font/woff',
    '.woff2': 'font/woff2',
  }[extname(file).toLowerCase()] ?? 'application/octet-stream'
}

async function shutdown(signal) {
  if (shuttingDown)
    return
  shuttingDown = true
  process.stdout.write(`Stopping fullstack container (${signal})\n`)
  server.close()
  service.kill('SIGTERM')
  const forceExit = setTimeout(() => service.kill('SIGKILL'), 10_000)
  forceExit.unref()
}
{{/if}}
