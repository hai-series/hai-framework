import type { Page } from '@playwright/test'
import process from 'node:process'
import { expect, test } from '@playwright/test'

const configAdminPassword = process.env.E2E_CONFIG_ADMIN_PASSWORD || 'Scaffold-test-Config123!'

async function dismissToasts(page: Page) {
  const dismiss = page.locator('.hai-toast-layer').getByRole('button', { name: /^(关闭|Dismiss|閉じる)$/ })
  for (let count = 0; count < 10 && await dismiss.count(); count++)
    await dismiss.click()
}

async function login(page: Page, username = 'admin', initialPassword = process.env.E2E_ADMIN_PASSWORD || 'Scaffold-test-Admin123!') {
  await page.goto('/')
  await page.locator('#login-username').fill(username)
  await page.getByTestId('login-form').locator('input[type=password]').fill(initialPassword)
  await page.getByTestId('login-form').locator('button[type=submit]').click()
  // 每例使用独立初始账号，真实完成服务端限制下的首次改密后才能建立普通会话。
  await expect(page.locator('#old-password')).toBeVisible()
  await expect(page.getByTestId('logout')).toHaveCount(0)
  await page.screenshot({ path: test.info().outputPath('initial-password-renewal.png'), fullPage: true })
  const form = page.locator('form').filter({ has: page.locator('#old-password') })
  const error = page.locator('.hai-toast-item[data-variant=error]')
  await dismissToasts(page)
  // 同密码仍由服务端拒绝，显示安全原因与关联编号；本地确认不一致则直接提示字段。
  await page.locator('#old-password').fill(initialPassword)
  await page.locator('#new-password').fill(initialPassword)
  await page.locator('#confirm-password').fill(initialPassword)
  await form.locator('button[type=submit]').click()
  await expect(error).toContainText(/新密码不能与当前密码相同|different from your current password/)
  await expect(error).not.toContainText('traceId:')
  await error.getByRole('button', { name: /^(查看排查信息|View diagnostic details|調査情報を表示)$/ }).click()
  await expect(error.locator('code')).toHaveText(/^[\w.:-]{1,128}$/)
  await expect(page.getByTestId('logout')).toHaveCount(0)
  await page.screenshot({ path: test.info().outputPath('initial-password-same.png'), fullPage: true })
  await expect(form.locator('.alert-error')).toHaveCount(0)
  await dismissToasts(page)
  const password = `${initialPassword}-Renewed!`
  await page.locator('#old-password').fill('Incorrect-test-password!')
  await page.locator('#new-password').fill(password)
  await page.locator('#confirm-password').fill(password)
  await form.locator('button[type=submit]').click()
  await expect(error).toContainText(/用户名或密码不正确|Username or password is incorrect/)
  await expect(error).not.toContainText(/原密码错误|Original password/)
  await dismissToasts(page)
  await page.locator('#old-password').fill(initialPassword)
  await page.locator('#confirm-password').fill(`${password}-mismatch`)
  await expect(form).toContainText(/两次密码输入不一致|do not match/)
  await expect(form.locator('button[type=submit]')).toBeDisabled()
  await page.locator('#confirm-password').fill(password)
  await form.locator('button[type=submit]').click()
  await expect(page.locator('#login-username')).toBeVisible()
  await page.locator('#login-username').fill(username)
  await page.getByTestId('login-form').locator('input[type=password]').fill(password)
  await page.getByTestId('login-form').locator('button[type=submit]').click()
  await expect(page.getByTestId('logout')).toBeVisible()
  if (await page.getByTestId('guide-later').isVisible())
    await page.getByTestId('guide-later').click()
  return password
}

test('configured page exit revokes the actual server session, while BFCache keeps it', async ({ page, context }) => {
  await login(page)
  let closes = 0
  page.on('request', (request) => {
    if (new URL(request.url()).pathname.endsWith('/auth/session/close'))
      closes++
  })
  await page.evaluate(() => window.dispatchEvent(new PageTransitionEvent('pagehide', { persisted: true })))
  expect(closes).toBe(0)
  const revoked = page.waitForResponse(response => new URL(response.url()).pathname.endsWith('/auth/session/close'))
  // 浏览器关闭事件本身不保证送达；明确触发同一原生事件，验证已送达的请求确实撤销。
  await page.evaluate(() => window.dispatchEvent(new PageTransitionEvent('pagehide', { persisted: false })))
  const response = await revoked
  expect(response.status()).toBe(200)
  await response.body()
  expect(closes).toBe(1)
  await page.close()
  const reopened = await context.newPage()
  await reopened.goto('/')
  await expect(reopened.getByTestId('login-form')).toBeVisible()
  await expect(reopened.getByTestId('logout')).toHaveCount(0)
})

test('server idle expiry opens normal login in place and resumes one rejected save without losing the draft', async ({ page }) => {
  const password = await login(page, 'config_admin', configAdminPassword)
  await page.getByTestId('nav-configuration').click()
  const draft = 'Draft preserved across server idle expiry'
  await page.getByTestId('business-notice-input').locator('textarea').fill(draft)
  // 此等待是被测的真实服务端闲置期限；期间不发业务保活请求。
  await page.waitForTimeout(6500)
  const statuses: number[] = []
  page.on('response', (response) => {
    if (new URL(response.url()).pathname.endsWith('/admin/configuration/update'))
      statuses.push(response.status())
  })
  await page.getByTestId('configuration-page').locator('button[type=submit]').click()
  const dialog = page.getByTestId('session-recovery-dialog')
  await expect(dialog).toBeVisible()
  await expect(page.getByTestId('business-notice-input').locator('textarea')).toHaveValue(draft)
  await page.screenshot({ path: test.info().outputPath('idle-session-recovery.png'), fullPage: true })
  const form = dialog.locator('form.login-form')
  await form.locator('input[type=password]').fill('Incorrect-test-password!')
  await form.locator('button[type=submit]').click()
  await expect(page.locator('.hai-toast-item[data-variant=error]')).toBeVisible()
  await expect(page.locator('.hai-toast-item[data-variant=error]')).toBeInViewport({ ratio: 1 })
  await page.screenshot({ path: test.info().outputPath('idle-session-recovery-error-toast.png'), fullPage: true })
  expect(statuses).toHaveLength(1)
  await form.locator('input[type=password]').fill(password)
  await form.locator('button[type=submit]').click()
  await expect(dialog).toHaveCount(0)
  await expect.poll(() => statuses.length).toBe(2)
  await expect(page.getByTestId('notice')).toBeVisible()
  await expect(page.getByTestId('business-notice-input').locator('textarea')).toHaveValue(draft)
  await expect(page.getByTestId('logout')).toBeVisible()
})
