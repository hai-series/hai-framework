    throw new Error('The exported masked attachment is missing')
  expect(bundle.files[masked.path]).toEqual(new Uint8Array(maskedPreview.bytes))
  const largeLog = bundle.manifest.files.find(file => file.kind === 'attachment' && file.name === 'attached-large-log.txt')
  expect(largeLog?.contentType).toBe('text/plain')
  if (!largeLog)
    throw new Error('The exported large log attachment is missing')
  expect(bundle.files[largeLog.path]).toEqual(new Uint8Array(feedbackLog))
  expect(bundle.manifest.files.some(file => file.name === 'discarded.txt')).toBe(false)
  await testInfo.attach('feedback-export-masked', { body: Buffer.from(bundle.files[masked.path]!), contentType: 'image/png' })
