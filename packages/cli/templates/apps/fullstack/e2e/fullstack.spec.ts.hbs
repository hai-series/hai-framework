test('hash routing and responsive workspace preserve usable content width', async ({ page }, testInfo) => {
  await page.goto('/#/roles?source=direct')
  await login(page, 'admin', adminPassword)
  await expect(page.getByTestId('roles-page')).toBeVisible()
  await expect(page).toHaveURL(/#\/roles\?source=direct$/)
  await page.reload()
  await expect(page.getByTestId('roles-page')).toBeVisible()
  await expect(page.locator('header')).toBeVisible()
  await expect(page.locator('footer')).toBeVisible()
  for (const width of [1440, 1920, 2560, 3840, 390]) {
    await page.setViewportSize({ width, height: 960 })
    expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth)).toBe(true)
    const main = await page.locator('main').boundingBox()
    const content = await page.getByTestId('roles-page').boundingBox()
    expect(content!.width).toBeGreaterThan(main!.width - 80)
    if (width === 1920)
      await capture(page, '{{projectName}}-wide.png', testInfo.outputPath('wide-1920.png'))
  }
  await page.setViewportSize({ width: 1440, height: 960 })
  await page.getByTestId('nav-settings').click()
  await expect(page).toHaveURL(/#\/settings$/)
  await page.goBack()
  await expect(page.getByTestId('roles-page')).toBeVisible()
  await page.goForward()
  await expect(page.getByTestId('profile-form')).toBeVisible()
  await page.goto('/#/unknown-page')
  await expect(page).toHaveURL(/#\/users$/)
  await expect(page.getByTestId('users-page')).toBeVisible()
  const usersPage = page.getByTestId('users-page')
  const accountHeader = usersPage.locator('th').first()
  await accountHeader.getByRole('button').click()
  await expect(accountHeader).toHaveAttribute('aria-sort', 'ascending')
  const search = usersPage.getByTestId('users-search').locator('input')
  await search.fill('unsubmitted-query-draft')
  const sorted = page.waitForResponse(response => new URL(response.url()).pathname.endsWith('/admin/users/list'))
  await accountHeader.getByRole('button').click()
  await sorted
  await expect(usersPage.locator('tbody')).toContainText('admin')
  await search.press('Enter')
  await expect(usersPage.locator('tbody')).not.toContainText('admin')
  const reset = page.waitForResponse(response => new URL(response.url()).pathname.endsWith('/admin/users/list'))
  await usersPage.getByRole('button', { name: /重置|Reset|リセット/, exact: true }).click()
  await reset
  await expect(search).toHaveValue('')
  await expect(usersPage.locator('tbody')).toContainText('admin')
  for (const width of [390, 1440, 1920, 2560, 3840]) {
    await page.setViewportSize({ width, height: 900 })
    expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth)).toBe(true)
    await expect(usersPage.locator('.hai-pagination__navigation')).toBeVisible()
    await capture(page, `users-unified-${width}.png`, testInfo.outputPath(`users-unified-${width}.png`))
  }
})

test('branded authentication, profile layout and blur validation work across screen sizes', async ({ page }, testInfo) => {
