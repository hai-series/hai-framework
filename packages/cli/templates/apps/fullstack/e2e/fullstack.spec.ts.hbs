test('feedback submits an empty description and business operator can process and reopen it', async ({ page }, testInfo) => {
  await page.goto('/')
  await login(page, 'business_operator', 'Scaffold-test-Operator123!')
  const feedbackImage = Buffer.from(await page.evaluate(() => {
    const canvas = document.createElement('canvas')
    canvas.width = canvas.height = 64
    const context = canvas.getContext('2d')!
    context.fillStyle = '#ef4444'
    context.fillRect(0, 0, 64, 64)
    return canvas.toDataURL('image/png').split(',')[1]!
  }), 'base64')
  // 大于框架默认 1 MiB 的真实日志必须经加密 HTTP 上传，并从服务端问题包逐字节取回。
  const feedbackLog = Buffer.from('INFO feedback diagnostic: operation completed successfully\n'.repeat(36 * 1024))
  expect(feedbackLog.byteLength).toBeGreaterThan(1024 * 1024)
  expect(feedbackLog.byteLength).toBeLessThan(5 * 1024 * 1024)
  await page.getByTestId('feedback-open').click()
  const dialog = page.getByRole('dialog')
  const desktopViewport = page.viewportSize()
  if (!desktopViewport)
    throw new Error('Feedback browser viewport is missing')
  async function expectUncovered(target: typeof dialog, fractions = [0.1, 0.5, 0.9]) {
    await expect.poll(() => target.evaluate((element, samples) => {
      const rect = element.getBoundingClientRect()
      return samples.every(x => samples.every((y) => {
        const top = document.elementFromPoint(rect.left + rect.width * x, rect.top + rect.height * y)
        return top !== null && (top === element || element.contains(top))
      }))
    }, fractions), { message: 'Feedback content must not be covered by the background header or table' }).toBe(true)
  }
  async function expectDialogViewport() {
    await expect.poll(() => dialog.evaluate((element) => {
      const rect = element.getBoundingClientRect()
      return rect.left >= 0 && rect.top >= 0 && rect.right <= innerWidth && rect.bottom <= innerHeight
    }), { message: 'The entire feedback dialog must stay inside the viewport' }).toBe(true)
    await expectUncovered(dialog.getByRole('heading').first())
    // 关闭按钮为圆形，采样点须位于圆内；标题与图片仍检查原有九点范围。
    await expectUncovered(dialog.getByRole('button', { name: /关闭|Close|閉じる/ }).first(), [0.25, 0.5, 0.75])
  }
  await expectDialogViewport()
  await capture(page, 'feedback-collect-desktop.png', testInfo.outputPath('feedback-collect-desktop.png'))
  await page.setViewportSize({ width: 390, height: 844 })
  await expectDialogViewport()
  await capture(page, 'feedback-collect-mobile.png', testInfo.outputPath('feedback-collect-mobile.png'))
  await page.setViewportSize(desktopViewport)
  await expectDialogViewport()
  await dialog.locator('summary').filter({ hasText: /更多选项|More options|その他のオプション/ }).click()
  await dialog.locator('input[type=file]').setInputFiles([
    { name: 'attached-preview.png', mimeType: 'image/png', buffer: feedbackImage },
    { name: 'attached-large-log.txt', mimeType: 'text/plain', buffer: feedbackLog },
    { name: 'discarded.txt', mimeType: 'text/plain', buffer: Buffer.from('discarded local material') },
  ])
  const uploaded = dialog.locator('img[alt="attached-preview.png"]')
  await expect(uploaded).toBeVisible()
  await uploaded.scrollIntoViewIfNeeded()
  await expectDialogViewport()
  await expectUncovered(uploaded)
  await capture(page, 'feedback-image-before-mask.png', testInfo.outputPath('feedback-image-before-mask.png'))
  await uploaded.screenshot({ path: testInfo.outputPath('feedback-image-before-mask-detail.png'), animations: 'disabled' })
  const originalPreview = await uploaded.getAttribute('src')
  await dialog.getByRole('button', { name: /遮挡敏感区域|Mask sensitive area|機密情報を隠す/ }).last().click()
  await dialog.getByRole('button', { name: /应用标注|Apply annotation|注釈を適用/ }).last().click()
  await expect(uploaded).not.toHaveAttribute('src', originalPreview ?? '')
  // 读取烧录后的实际像素与字节，后续核对服务端 ZIP 携带的是同一张脱敏图片。
  const maskedPreview = await uploaded.evaluate(async (image: HTMLImageElement) => {
    await image.decode()
    const canvas = document.createElement('canvas')
    canvas.width = image.naturalWidth
    canvas.height = image.naturalHeight
    const context = canvas.getContext('2d')!
    context.drawImage(image, 0, 0)
    return {
      pixel: Array.from(context.getImageData(12, 12, 1, 1).data),
      bytes: Array.from(new Uint8Array(await (await fetch(image.src)).arrayBuffer())),
    }
  })
  expect(maskedPreview.pixel).toEqual([17, 17, 17, 255])
  await dialog.getByRole('button', { name: /^(删除|Remove|削除) discarded.txt$/ }).click()
  await expect(dialog.getByText('discarded.txt', { exact: true })).toHaveCount(0)
  await uploaded.scrollIntoViewIfNeeded()
