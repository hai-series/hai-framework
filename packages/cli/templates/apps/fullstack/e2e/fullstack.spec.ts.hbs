  const browserMetadata: { appVersion: string, buildId: string, commit: string } = JSON.parse(await readFile(path.resolve('apps/{{projectName}}-{{fullstack.e2eFrontend.target}}/dist/build-metadata.json'), 'utf8'))
  const serverMetadata: { appVersion: string, buildId: string, commit: string } = JSON.parse(await readFile(path.resolve('packages/{{projectName}}-serv/dist/build-metadata.json'), 'utf8'))
