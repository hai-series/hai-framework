  expect(bundle.manifest.evidenceRevision).toBe(bundle.report.evidenceRevision)
  expect(bundle.manifest.files.map(file => file.path)).toEqual(expect.arrayContaining(['report.json', 'summary.md', 'viewer/index.html']))
  const masked = bundle.manifest.files.find(file => file.kind === 'attachment' && file.name === 'attached-preview.png')
  expect(masked?.contentType).toBe('image/png')
