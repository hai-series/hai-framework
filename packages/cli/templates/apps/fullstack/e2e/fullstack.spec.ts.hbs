  await expect(page.locator('footer')).toBeVisible()
  await capture(page, '{{projectName}}-login-desktop.png', testInfo.outputPath('login-desktop.png'))
  await page.getByRole('button', { name: /立即注册|Register now/, exact: true }).click()
  await expect(page.locator('.register-form')).toBeVisible()
  await capture(page, '{{projectName}}-register-desktop.png', testInfo.outputPath('register-desktop.png'))
  await page.setViewportSize({ width: 390, height: 844 })
  await capture(page, '{{projectName}}-register-mobile.png', testInfo.outputPath('register-mobile.png'))
  expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth)).toBe(true)
  await page.reload()
  await expect(page.getByTestId('login-form')).toBeVisible()
  await capture(page, '{{projectName}}-login-mobile.png', testInfo.outputPath('login-mobile.png'))
  await page.setViewportSize({ width: 1440, height: 960 })
  await login(page, 'admin', adminPassword)
  await page.getByTestId('nav-settings').click()
  const profile = page.getByTestId('profile-form')
  await expect(profile).toBeVisible()
  const email = profile.locator('input[name="email"]')
  await email.fill('invalid-email')
  await email.press('Tab')
  await expect(email).toHaveAttribute('aria-invalid', 'true')
  await capture(page, '{{projectName}}-profile-blur-error.png', testInfo.outputPath('profile-blur-error.png'))
  await email.fill('')
  await expect(email).not.toHaveAttribute('aria-invalid')
  await capture(page, '{{projectName}}-settings-desktop.png', testInfo.outputPath('settings-desktop.png'))
  for (const width of [768, 390]) {
    await page.setViewportSize({ width, height: 960 })
    const fields = await profile.locator('.hai-form-field').evaluateAll(elements => elements.map((field) => {
      const label = field.querySelector('label')!.getBoundingClientRect()
      const control = field.querySelector('input')!.getBoundingClientRect()
      return { labelBottom: label.bottom, controlTop: control.top, controlRight: control.right }
    }))
    for (const field of fields) {
      expect(field.labelBottom).toBeLessThanOrEqual(field.controlTop)
      expect(field.controlRight).toBeLessThanOrEqual(width)
    }
    expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth)).toBe(true)
    await capture(page, `{{projectName}}-settings-${width}.png`, testInfo.outputPath(`settings-${width}.png`))
  }
  await page.getByTestId('password-form').scrollIntoViewIfNeeded()
  await capture(page, '{{projectName}}-password-mobile.png', testInfo.outputPath('password-mobile.png'))
  await page.setViewportSize({ width: 1440, height: 960 })
  await page.getByTestId('nav-users').click()
  await page.getByTestId('create-user').click()
  const username = page.getByTestId('user-username').locator('input')
  await username.focus()
  await username.press('Tab')
  await expect(username).not.toHaveAttribute('aria-invalid')
  await username.fill('draft')
  await username.fill('')
  await username.press('Tab')
  await expect(username).toHaveAttribute('aria-invalid', 'true')
  await username.fill('a')
  await expect(username).toHaveAttribute('aria-invalid', 'true')
  await page.getByTestId('user-password').locator('input').fill('short')
  await page.getByTestId('user-password').locator('input').press('Tab')
  await expect(page.getByTestId('user-password').locator('input')).toHaveAttribute('aria-invalid', 'true')
  await capture(page, '{{projectName}}-create-blur-error.png', testInfo.outputPath('create-blur-error.png'))
  await page.getByTestId('user-editor').getByRole('button', { name: /取消|Cancel/, exact: true }).click()
  await page.getByTestId('create-user').click()
  await expect(page.getByTestId('user-editor').locator('[aria-invalid="true"]')).toHaveCount(0)
