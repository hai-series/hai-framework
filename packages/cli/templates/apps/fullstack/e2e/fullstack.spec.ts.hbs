  const serverManifest: { version: string } = JSON.parse(await readFile(path.resolve('packages/{{projectName}}-serv/package.json'), 'utf8'))
  let expectedCommit = 'unknown'
  try {
    execFileSync('git', ['ls-files', '--error-unmatch', '--', 'package.json'], { stdio: 'pipe', windowsHide: true })
    expectedCommit = execFileSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8', stdio: 'pipe', windowsHide: true }).trim()
  }
  catch { /* 无 Git 的源码归档必须明确保留 unknown，不冒用父工程提交。 */ }
  if (process.env.E2E_BUILD_COMMIT) {
    expect(expectedCommit).toBe(process.env.E2E_BUILD_COMMIT)
    expect(expectedCommit).toMatch(/^(?:[a-f\d]{40}|[a-f\d]{64})$/i)
    expect(browserManifest.version).not.toBe(serverManifest.version)
  }
  for (const [metadata, version] of [[browserMetadata, browserManifest.version], [serverMetadata, serverManifest.version]] as const) {
    expect(Object.keys(metadata).sort()).toEqual(['appVersion', 'buildId', 'commit'])
    expect(metadata.appVersion).toBe(version)
    expect(metadata.buildId).toMatch(/^[\w.+-]{1,160}$/)
    expect(metadata.buildId).not.toBe('unknown')
    expect(metadata.commit).toBe(expectedCommit)
  }
  const browserEnvironment = bundle.evidence.find(item => item.kind === 'environment' && item.source.startsWith('browser:'))
