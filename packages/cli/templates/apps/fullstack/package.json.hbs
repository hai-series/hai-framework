{
  "name": "{{projectName}}",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "description": "Full-stack hai workspace with separated contract, service and frontends.",
  "scripts": {
    "i18n:compile": "pnpm --filter {{fullstack.sharedPackageName}} paraglide:compile{{#each fullstack.frontendApps}} && pnpm --filter {{packageName}} paraglide:compile{{/each}}",
    "postinstall": "pnpm i18n:compile",
    "dev": "pnpm --filter {{fullstack.contractPackageName}} build && pnpm i18n:compile && pnpm --parallel --filter {{fullstack.servPackageName}}{{#each fullstack.frontendApps}} --filter {{packageName}}{{/each}} dev",
    "compile": "pnpm typecheck && pnpm build",
    "build": "pnpm --filter {{fullstack.contractPackageName}} build && pnpm i18n:compile && pnpm -r --if-present build",
    "docker:build": "docker build --target runtime -t {{projectName}}:latest .",
    "docker:build:data": "docker build --target runtime-with-data --build-context embedded-data=./packages/{{projectName}}-serv/data -t {{projectName}}:latest ."{{#if fullstack.frontends.web}},
    "docker:build:web": "docker build --target web -t {{projectName}}-web:latest ."{{/if}},
    "podman:build": "podman build --format docker --jobs=1 --target runtime -t {{projectName}}:latest .",
    "podman:build:data": "podman build --format docker --jobs=1 --target runtime-with-data --build-context embedded-data=./packages/{{projectName}}-serv/data -t {{projectName}}:latest ."{{#if fullstack.frontends.web}},
    "podman:build:web": "podman build --format docker --jobs=1 --target web -t {{projectName}}-web:latest ."{{/if}},
    "package": "pnpm build{{#if fullstack.frontends.web}} && pnpm --filter {{projectName}}-web package{{/if}}{{#if fullstack.frontends.app}} && pnpm --filter {{projectName}}-app package{{/if}}{{#if fullstack.frontends.desktop}} && pnpm --filter {{projectName}}-desktop package{{/if}}",
    "deploy": "pnpm package",
    "typecheck": "pnpm --filter {{fullstack.contractPackageName}} build && pnpm i18n:compile && pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm --filter {{fullstack.contractPackageName}} build && pnpm i18n:compile && pnpm -r --if-present test",
    "test:e2e": "pnpm build && playwright test",
    "clean": "pnpm -r --if-present clean && rimraf node_modules .turbo"
  },
  "dependencies": {
    "@h-ai/api-contract": "{{haiPackageSpecifier}}",
    "{{fullstack.contractPackageName}}": "workspace:*",
    "{{fullstack.sharedPackageName}}": "workspace:*"
  },
  "devDependencies": {
    "@antfu/eslint-config": "{{fullstack.packageSpecifiers.antfuEslintConfig}}",
    "@playwright/test": "{{fullstack.packageSpecifiers.playwright}}",
    "@sveltejs/vite-plugin-svelte": "{{fullstack.packageSpecifiers.sveltePlugin}}",
    "@types/node": "{{fullstack.packageSpecifiers.nodeTypes}}",
    "eslint": "{{fullstack.packageSpecifiers.eslint}}",
    "eslint-plugin-format": "{{fullstack.packageSpecifiers.eslintPluginFormat}}",
    "eslint-plugin-svelte": "{{fullstack.packageSpecifiers.eslintPluginSvelte}}",
    "rimraf": "{{fullstack.packageSpecifiers.rimraf}}",
    "svelte": "{{fullstack.packageSpecifiers.svelte}}",
    "svelte-check": "{{fullstack.packageSpecifiers.svelteCheck}}",
    "svelte-eslint-parser": "{{fullstack.packageSpecifiers.svelteEslintParser}}",
    "tsup": "{{fullstack.packageSpecifiers.tsup}}",
    "typescript": "{{fullstack.packageSpecifiers.typescript}}",
    "vite": "{{fullstack.packageSpecifiers.vite}}",
    "vitest": "{{fullstack.packageSpecifiers.vitest}}"
  }
}
