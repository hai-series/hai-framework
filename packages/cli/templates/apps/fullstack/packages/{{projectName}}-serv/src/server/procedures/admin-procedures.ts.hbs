import type { ServContext } from '@h-ai/serv'
import { audit, AuditInitConfigSchema } from '@h-ai/audit'
import { core, err, HaiCommonError, ok } from '@h-ai/core'
import { iam } from '@h-ai/iam'
import { serv } from '@h-ai/serv'
import { createIamProcedures } from '@h-ai/serv/features/iam'
import { adminContract, profileContract } from '{{fullstack.contractPackageName}}'
import {
  createAdminUser,
  getAdminRoles,
  inviteAdminUser,
  isRoleCode,
  recordAudit,
  toAdminUser,
  updateAdminUser,
  updateProfile,
  uploadAvatar,
  withAdminMutation,
} from '../admin-service.js'
import { readBusinessSettings, saveBusinessSettings } from '../business-settings.js'
import { serverM } from '../messages.js'
import { checkManagedUser } from '../security-roles.js'

/** 身份认证沿用框架公共契约与 refresh-cookie 传输。 */
export function createAuthProcedures() {
  return createIamProcedures({ iam }).auth
}

export function createAdminProcedures() {
  return serv.implement(adminContract).context<ServContext>().route('permissions.list').permission('app.roles.manage').handle(async ({ input }) => {
    const result = await iam.authz.getAllPermissions(input)
    return result.success ? ok({ total: result.data.total, items: result.data.items.map(item => ({ id: item.id, code: item.code, name: item.name, sensitiveOperations: item.sensitiveOperations ?? [] })) }) : result
  }).route('permissions.update').permission('app.roles.manage').handle(({ input, context }) => withAdminMutation(context, 'iam.permissions.sensitiveOperations', async () => {
    const result = await iam.authz.setPermissionSensitiveOperations(input.id, input.sensitiveOperations)
    return result.success ? ok({ saved: true as const }) : result
  })).route('configuration.get').permission('app.config.manage').handle(() => readBusinessSettings()).route('configuration.update').permission('app.config.manage').handle(async ({ input, context }) => {
    const checked = await iam.auth.checkSensitiveOperation(context.accessToken ?? '', 'business.settings.update', context.request.headers.get('x-hai-reauthentication') ?? undefined)
    return checked.success ? saveBusinessSettings(input) : checked
  }).route('users.list').permission('app.users.manage').handle(async ({ input }) => {
    const users = await iam.user.listUsers(input)
    if (!users.success)
      return users
    const roles = await iam.authz.getUserRolesForMany(users.data.items.map(user => user.id))
    if (!roles.success)
      return roles
    return ok({ ...users.data, items: users.data.items.map(user => toAdminUser(user, roles.data.get(user.id) ?? [])) })
  }).route('users.invite').permission('app.users.manage').handle(({ input, context }) => withAdminMutation(context, 'iam.users.invite', () => inviteAdminUser(input, context))).route('users.create').permission('app.users.manage').handle(({ input, context }) => withAdminMutation(context, 'iam.users.create', () => createAdminUser(input, context))).route('users.update').permission('app.users.manage').handle(({ input, context }) => withAdminMutation(context, 'iam.users.update', () => updateAdminUser(input, context))).route('users.delete').permission('app.users.manage').handle(({ input, context }) => withAdminMutation(context, 'iam.users.delete', async () => {
    if (context.session.userId === input.id)
      return err(HaiCommonError.FORBIDDEN, serverM('selfProtection', { locale: context.locale }))
    const manageable = await checkManagedUser(input.id)
    if (!manageable.success)
      return manageable
    const result = await iam.user.deleteUser(input.id)
    if (!result.success)
      return result
    await recordAudit(context, 'delete', 'users', input.id)
    return ok({ deleted: true as const })
  })).route('users.avatar').permission('app.users.manage').handle(({ input, context }) => withAdminMutation(context, 'iam.users.avatar', () => uploadAvatar(input.id, input, context))).route('roles.list').permission('app.roles.manage').handle(() => getAdminRoles()).route('roles.update').permission('app.roles.manage').handle(({ input, context }) => withAdminMutation(context, 'iam.roles.update', async () => {
    const role = await iam.authz.getRole(input.id)
    if (!role.success)
      return role
    if (!role.data || !isRoleCode(role.data.code))
      return err(HaiCommonError.NOT_FOUND, serverM('notFound', { locale: context.locale }))
    if (role.data.code !== 'admin' && role.data.code !== 'user')
      return err(HaiCommonError.FORBIDDEN, serverM('dutyProtected', { locale: context.locale }))
    const updated = await iam.authz.updateRole(input.id, { description: input.description })
    if (!updated.success)
      return updated
    const roles = await getAdminRoles()
    if (!roles.success)
      return roles
    const result = roles.data.items.find(item => item.id === input.id)
    if (!result)
      return err(HaiCommonError.NOT_FOUND, serverM('notFound', { locale: context.locale }))
    await recordAudit(context, 'update', 'roles', input.id, { fields: ['description'] })
    return ok(result)
  })).route('audit.backup').permission('audit:backup').handle(async ({ input, context }) => {
    const checked = await iam.auth.checkSensitiveOperation(context.accessToken ?? '', 'audit.backup', context.request.headers.get('x-hai-reauthentication') ?? undefined)
    if (!checked.success)
      return checked
    const result = await audit.backup.run({ ...input, signal: context.request.signal })
    return result.success ? ok({ ...result.data, createdAt: result.data.createdAt.toISOString(), cutoff: result.data.cutoff.toISOString() }) : result
  }).route('audit.list').permission('audit:read').handle(async ({ input, context }) => {
    if (input.startDate && input.endDate && input.startDate > input.endDate)
      return err(HaiCommonError.VALIDATION_ERROR, serverM('invalidDateRange', { locale: context.locale }))
    const result = await audit.list({ ...input, startDate: input.startDate ? new Date(input.startDate) : undefined, endDate: input.endDate ? new Date(input.endDate) : undefined })
    if (!result.success)
      return result
    const stats = await audit.getStats(7, { category: input.category, outcome: input.outcome, severity: input.severity, resource: input.resource, scopeId: input.scopeId, userId: input.userId })
    if (!stats.success)
      return stats
    return ok({ ...result.data, stats: stats.data, backupEnabled: AuditInitConfigSchema.parse(core.config.get('audit') ?? {}).backup.enabled, items: result.data.items.map(item => ({ ...item, createdAt: new Date(item.createdAt).toISOString() })) })
  }).build()
}

export function createProfileProcedures() {
  return serv.implement(profileContract).context<ServContext>().route('update').auth().handle(async ({ input, context }) => {
    const checked = await iam.auth.checkSensitiveOperation(context.accessToken ?? '', 'iam.profile.update', context.request.headers.get('x-hai-reauthentication') ?? undefined)
    return checked.success ? updateProfile(input, context) : checked
  }).route('avatar').auth().handle(async ({ input, context }) => {
    const checked = await iam.auth.checkSensitiveOperation(context.accessToken ?? '', 'iam.profile.avatar', context.request.headers.get('x-hai-reauthentication') ?? undefined)
    return checked.success ? uploadAvatar(context.session.userId, input, context) : checked
  }).build()
}
