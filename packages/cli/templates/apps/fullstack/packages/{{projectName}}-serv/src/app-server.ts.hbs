import type { ServConfigInput } from '@h-ai/serv'
import { core } from '@h-ai/core'
import { serv, ServConfigSchema } from '@h-ai/serv'
import { ENABLED_FRONTENDS, {{fullstack.contractExportName}} } from '{{fullstack.contractPackageName}}'
import { createServerProcedures } from './server/procedures/index.js'

const STARTED_AT = new Date().toISOString()

/** `_core.yml` 中的应用元信息（由 core.config 加载，未初始化时回退到默认值）。 */
interface AppCoreConfig {
  name?: string
  version?: string
  env?: string
}

/** 应用侧最小 HTTP App 抽象；不把底层 Hono 类型暴露给项目代码。 */
export interface ServerApp {
  readonly fetch: (request: Request) => Response | Promise<Response>
  readonly request: (input: RequestInfo | URL, init?: RequestInit) => Response | Promise<Response>
}

/** 创建后端 HTTP App；与 @h-ai/serv 的 createApp 返回语义保持一致。 */
export function createServerApp(): ServerApp {
  // 配置来自 config/_core.yml 与 config/_serv.yml。
  // 单元测试可不初始化 core，此时回退到内置默认值。
  const coreConfig = core.config.get<AppCoreConfig>('core')
  const servConfig = ServConfigSchema.parse(core.config.get<ServConfigInput>('serv') ?? {})
  const appName = coreConfig?.name ?? '{{fullstack.servPackageName}}'
  const appVersion = coreConfig?.version ?? '0.1.0'
  const security = serv.createRuntimeSecurityPolicy({
    environment: coreConfig?.env,
    corsOrigin: servConfig.cors.origin,
    nativeOrigins: servConfig.cors.nativeOrigins,
  })

  return serv.createApp({
    contract: {{fullstack.contractExportName}},
    procedures: createServerProcedures({
      app: {
        name: appName,
        version: appVersion,
        startedAt: STARTED_AT,
        frontends: [...ENABLED_FRONTENDS],
      },
    }),
    http: {
      ...servConfig.http,
      openapi: security.exposeApiDocs ? servConfig.http.openapi : false,
      docs: security.exposeApiDocs ? servConfig.http.docs : false,
    },
    middlewares: [{
      middleware: serv.cors({
        origin: security.allowOrigin,
        credentials: servConfig.cors.credentials,
        allowedHeaders: [...servConfig.cors.allowedHeaders],
        exposedHeaders: [...servConfig.cors.exposedHeaders],
      }),
    }],
  })
}
