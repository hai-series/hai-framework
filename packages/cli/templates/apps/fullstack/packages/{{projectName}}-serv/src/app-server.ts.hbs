import type { CoreConfig } from '@h-ai/core'
import type { {{#if features.feedback}}CreateServContext, {{/if}}ServHttpApp } from '@h-ai/serv'
import process from 'node:process'
{{#if features.feedback}}import { resolveFeedbackBudget } from '@h-ai/api-contract/feedback'
{{/if}}import { core } from '@h-ai/core'
import { createReldbTransportKeyStore, crypto, parseTransportServerKeyRing } from '@h-ai/crypto'
{{#if features.feedback}}
import { FeedbackConfigSchema } from '@h-ai/feedback'
{{/if}}
import { iam } from '@h-ai/iam'
import { reldb } from '@h-ai/reldb'
import { serv, ServConfigSchema } from '@h-ai/serv'
import { storage } from '@h-ai/storage'
import * as contracts from '{{fullstack.contractPackageName}}'
import { createServerProcedures } from './server/procedures/index.js'

const STARTED_AT = new Date().toISOString()

/** 创建后端 HTTP App；与 @h-ai/serv 的 createApp 返回语义保持一致。 */
export function createServerApp(): ServHttpApp {
  const coreConfig = core.config.getOrThrow<CoreConfig>('core')
  const servConfig = ServConfigSchema.parse(core.config.getOrThrow('serv'))
  if (servConfig.transport === false)
    throw new Error('Fullstack management requires transport encryption; configure scoped access.rules[].encryption: disabled for plaintext external endpoints')
  const ring = parseTransportServerKeyRing(process.env.HAI_CRYPTO_TRANSPORT_SERVERKEYRING)
  if (!ring.success)
    throw new Error(`HAI_CRYPTO_TRANSPORT_SERVERKEYRING: ${ring.error.message} (${ring.error.code})`)
{{#if features.feedback}}  // 可选反馈故障重试期间仍使用配置预算，避免缓存默认容量。
  const feedbackSettings = FeedbackConfigSchema.safeParse(core.config.get('feedback'))
  const feedbackBudget = resolveFeedbackBudget(feedbackSettings.success ? feedbackSettings.data : {})
{{/if}}  const security = serv.createRuntimeSecurityPolicy({
    environment: coreConfig.env,
    corsOrigin: servConfig.cors.origin,
    nativeOrigins: servConfig.cors.nativeOrigins,
  })
  const publicPaths = [
    `${servConfig.http.apiPrefix}/assets`,
    ...(servConfig.http.health ? [servConfig.http.health.path, servConfig.http.health.readyPath].filter((path): path is `/${string}` => Boolean(path)) : []),
    ...(servConfig.http.openapi && security.exposeApiDocs ? [servConfig.http.openapi.path] : []),
    ...(servConfig.http.docs && security.exposeApiDocs ? [servConfig.http.docs.path, `${servConfig.http.docs.path.slice(0, servConfig.http.docs.path.lastIndexOf('/') + 1)}_hai/scalar.js`] : []),
  ]
{{#if features.feedback}}
  // 普通业务日志与反馈使用同一可信应用范围；身份仍由 IAM 验证。
  const authenticatedContext = serv.buildAuthContextFactory(token => iam.auth.verifyToken(token))
  const createContext: CreateServContext = async input => ({
    ...await authenticatedContext(input),
    scopeId: '{{projectName}}',
  })
{{/if}}

  return serv.createApp({
    contract: contracts.{{fullstack.contractExportName}},
    procedures: createServerProcedures({
      app: {
        name: coreConfig.name,
        version: coreConfig.version,
        env: coreConfig.env,
        defaultLocale: coreConfig.defaultLocale,
        supportedLocales: contracts.SUPPORTED_LOCALES,
        startedAt: STARTED_AT,
        frontends: [...contracts.ENABLED_FRONTENDS],
      },
    }),
    iam,
{{#if features.feedback}}
    createContext,
{{/if}}
    refreshCookie: {
      secure: security.secureRefreshCookie,
      nativeTokenTransport: { isRequest: request => request.headers.get('x-hai-token-transport') === 'body'
        && ['{{projectName}}-app', '{{projectName}}-desktop'].includes(request.headers.get('x-request-client') ?? '')
        && security.isNativeOrigin(request.headers.get('origin') ?? '') },
    },
    // 管理业务默认强制双向加密；各节点复用受管服务端密钥环与共享 reldb 客户端 registry。
    transport: {
      ...servConfig.transport,
{{#if features.feedback}}
      routePlaintextBytes: {
        [`${servConfig.http.apiPrefix}/feedback/reports`]: feedbackBudget.maxTransportBytes,
        [`${servConfig.http.apiPrefix}/feedback/reports/*/evidence`]: feedbackBudget.maxTransportBytes,
        [`${servConfig.http.apiPrefix}/feedback/reports/*/attachments/*`]: feedbackBudget.maxTransportBytes,
        [`${servConfig.http.apiPrefix}/feedback/reports/*/exports/*`]: feedbackBudget.maxTransportBytes,
        ...servConfig.transport.routePlaintextBytes,
      },
{{/if}}
      excludePaths: [...new Set([...publicPaths, ...servConfig.transport.excludePaths])],
      crypto,
      serverKeyRing: ring.data,
      keyStore: createReldbTransportKeyStore({ reldb, ttlSeconds: 3600 }),
    },
    http: {
      ...servConfig.http,
      openapi: security.exposeApiDocs ? servConfig.http.openapi : false,
      docs: security.exposeApiDocs ? servConfig.http.docs : false,
    },
    middlewares: [{
      middleware: serv.cors({
        origin: security.allowOrigin,
        credentials: servConfig.cors.credentials,
        allowedHeaders: [...new Set([...servConfig.cors.allowedHeaders, 'X-Client-Id', 'X-Encrypted', 'X-Hai-Transport', 'X-Request-Client', 'X-HAI-Token-Transport', 'X-Hai-Reauthentication', 'X-Hai-Terminal'])],
        exposedHeaders: [...new Set([...servConfig.cors.exposedHeaders, 'X-Encrypted', 'X-Hai-Transport'])],
      }),
    }, {
      path: `${servConfig.http.apiPrefix}/assets/*`,
      middleware: serv.storageAssets({
        storage,
        pathPrefix: `${servConfig.http.apiPrefix}/assets/`,
        keyPattern: /^avatars\/[\w-]+\/[\w-]+\.(png|jpg|webp)$/,
        allowedContentTypes: ['image/png', 'image/jpeg', 'image/webp'],
        cacheControl: 'public, max-age=31536000, immutable',
        crossOriginResourcePolicy: 'cross-origin',
      }),
    }],
  })
}
