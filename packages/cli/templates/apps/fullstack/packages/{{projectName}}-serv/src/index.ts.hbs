import type { CoreConfig } from '@h-ai/core'
import type { ServConfigInput } from '@h-ai/serv'
import process from 'node:process'
import { core } from '@h-ai/core'
import { serv, ServConfigSchema } from '@h-ai/serv'
import { createServerApp } from './app-server.js'
import { closeModules, initializeModules } from './server/runtime.js'

async function startServer(): Promise<void> {
  // 运行时先注册模块 Schema 并加载配置，再按依赖顺序初始化；日志设置沿用 _core.yml。
  await initializeModules()
  try {
    // HOST/PORT 环境变量优先于 config/_serv.yml。
    const { server } = ServConfigSchema.parse(core.config.getOrThrow<ServConfigInput>('serv'))
    const app = createServerApp()
    await new Promise<void>((resolve, reject) => {
      const listener = serv.listen(app, {
        host: server.host,
        port: server.port,
        onListening: (info) => {
          core.logger.info('Application listening', { name: core.config.getOrThrow<CoreConfig>('core').name, host: server.host, port: info.port })
          resolve()
        },
        onClose: closeModules,
      })
      listener.server.once('error', reject)
      listener.server.once('listening', () => listener.server.off('error', reject))
    })
  }
  catch (error) {
    await closeModules()
    throw error
  }
}

void startServer().catch((error: unknown) => {
  core.logger.fatal('Application startup failed', { error })
  process.exitCode = 1
})
