# =============================================================================
# {{fullstack.servPackageName}} - 应用配置
# =============================================================================
#
# 后端服务的应用级配置，由 core.config 在启动时加载。
# 每个叶子项都可由约定式 HAI 环境变量覆盖，敏感值不要写入文件。
# =============================================================================

{{yaml 'name' fullstack.appName}}
version: 0.1.0
env: development
debug: false

defaultLocale: {{fullstack.i18n.baseLocale}}
logging:
  level: info
  format: json
  # context:
  #   service: api
  redact:
    - password
    - token
    - secret

# 短 ID 生成配置；未设置时采用框架默认值。
# id:
#   prefix: app_
#   length: 21
