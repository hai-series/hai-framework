login:
  password: true
  otp: false
  ldap: false
  apikey: false
password:
  minLength: 8
  maxLength: 128
  requireUppercase: false
  requireLowercase: false
  requireNumber: false
  requireSpecialChar: false
session:
  maxAge: 86400
  sliding: true
  singleDevice: false
  refreshTokenMaxAge: 604800
rbac:
  defaultRole: user
# 仅由应用创建 admin/user，避免生成无业务用途的默认角色与权限。
seedDefaultData: false

# 注册与登录安全
register:
  enabled: true
  defaultEnabled: true
security:
  maxLoginAttempts: 5
  lockoutDuration: 900

# LDAP 可选：安装 ldapts 后开启 login.ldap，并声明 ldap 连接配置或注入工厂。
# OTP 需启用 login.otp，并选择 Reach 标准模板或自定义发送回调。
otp:
  email: true
  sms: true
  length: 6
  expiresIn: 300
  maxAttempts: 3
  resendInterval: 60
passwordReset:
  enabled: true
  mode: email # phone 使用 password_reset_sms 模板
  tokenExpiresIn: 3600
  maxAttempts: 3
  # resetUrl: https://example.com/auth/reset-password
agreements:
  showOnRegister: true
  showOnLogin: false
  # Markdown 正文由公开配置传给所有客户端，在弹窗内安全渲染。
  userAgreementMarkdown: |
    # 用户协议示例

    请妥善保管账户凭据，并按应用提供的功能使用服务。
  privacyPolicyMarkdown: |
    # 隐私政策示例

    注册资料用于账户管理，会话信息用于身份认证。
  # userAgreementUrl: https://example.com/terms
  # privacyPolicyUrl: https://example.com/privacy
ui:
  variant: card
  # title: Account center
  # subtitle: Welcome back
  # brandTitle: Your application
  # brandText: Sign in securely
  # logoUrl: /logo.svg
  # illustrationUrl: /auth-illustration.svg
