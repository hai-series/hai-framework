# 开发触达示例；生产环境改为 SMTP、短信或 API Provider。
providers:
  - name: email
    type: console
  - name: sms
    type: console
# 生产示例：用下面 providers 整段替换上方控制台列表；保留需要的项。
# 数组索引从 0 开始，删掉某项后同步修改其余环境变量中的索引。
# providers:
  # SMTP 邮件；名称 email 与下方通知模板对应。
  # - name: email
  #   type: smtp
  #   host: ${HAI_REACH_PROVIDERS_0_HOST:smtp.example.com}
  #   port: ${HAI_REACH_PROVIDERS_0_PORT:465}
  #   secure: true
  #   user: ${HAI_REACH_PROVIDERS_0_USER:}
  #   pass: ${HAI_REACH_PROVIDERS_0_PASS:}
  #   from: ${HAI_REACH_PROVIDERS_0_FROM:noreply@example.com}
  # 阿里云短信替换 sms 控制台 Provider。
  # - name: sms
  #   type: aliyun-sms
  #   accessKeyId: ${HAI_REACH_PROVIDERS_1_ACCESSKEYID}
  #   accessKeySecret: ${HAI_REACH_PROVIDERS_1_ACCESSKEYSECRET}
  #   signName: MyApp
  #   endpoint: dysmsapi.aliyuncs.com
  # 自有发送服务：按需将 template.provider 改为 custom。
  # - name: custom
  #   type: api
  #   url: https://notify.example.com/send
  #   method: POST # POST | PUT
  #   headers:
  #     Authorization: '${HAI_REACH_PROVIDERS_2_HEADERS_AUTHORIZATION}'
  #   timeout: 10000
  #   idempotent: ${HAI_REACH_PROVIDERS_2_IDEMPOTENT:false} # 仅接收端具备原子持久去重时启用；默认在途不明结果转 unknown
templates:
  - name: otp_email
    provider: email
    subject: Verification code
    body: 'Your verification code is {code}.'
  - name: otp_sms
    provider: sms
    body: 'Your verification code is {code}.'
  - name: password_reset
    provider: email
    subject: Password reset
    body: 'Reset your password: {resetUrl}. Expires at {expiresAt}.'
  - name: password_reset_sms
    provider: sms
    body: 'Reset your password: {resetUrl}. Expires at {expiresAt}.'

# 免打扰可选；验证码应避免 delay，以免延迟到失效后投递。
# dnd:
#   enabled: false
#   strategy: discard # discard | delay
#   start: '22:00'
#   end: '08:00'

# 消息发送失败后最多尝试 5 次。首次重试等待 1 分钟，以后每次加倍，最长等待 1 小时。
# 尝试次数用完后停止，交给管理员处理；若无法确认对方是否已收到，先核对结果，避免重复发送。
queue:
  maxAttempts: ${HAI_REACH_QUEUE_MAXATTEMPTS:5}
  retryDelayMs: ${HAI_REACH_QUEUE_RETRYDELAYMS:60000}
  maxRetryDelayMs: ${HAI_REACH_QUEUE_MAXRETRYDELAYMS:3600000}
