# =============================================================================
# {{fullstack.servPackageName}} - Serv / HTTP 入口配置
# =============================================================================
#
# 业务接口路径直接写在对应 *-contract.ts；公共 HTTP 传输配置以本文件为准。
# =============================================================================

server:
  host: 127.0.0.1
  port: 3000

http:
  # auto 仅在受管私有 Compose 代理中采用容器网段；普通宿主忽略转发头。
  # 自建代理填写明确 IP/CIDR；[] 显式忽略转发头。
  trustedProxies: auto
  access: false
  # access:
  #   file: ./config/security/request-access.yml
  # 或将 access: false 替换为下列内联配置；与 file 二选一。
  # access:
  #   global:
  #     timezone: UTC # 可用 HAI_SERV_HTTP_ACCESS_GLOBAL_TIMEZONE=Asia/Shanghai
  #     allowIps: []
  #     denyIps: []
  #     windows: []
  #   rules: []
  apiPrefix: /api/v1
  openapi:
    path: /openapi.json
  # HAI_SERV_HTTP_DOCS=false 关闭文档；开启时再配置 path/requireAuth。
  docs:
    path: /docs
    # requireAuth: true
  health:
    path: /health
    readyPath: /ready

cors:
  origin: ${HAI_SERV_CORS_ORIGIN:*}
  nativeOrigins: ${HAI_SERV_CORS_NATIVEORIGINS:http://localhost,https://localhost,http://tauri.localhost,https://tauri.localhost,tauri://localhost,capacitor://localhost}
  credentials: ${HAI_SERV_CORS_CREDENTIALS:true}
  allowedHeaders:
    - Authorization
    - Content-Type
    - X-Request-Id
    - X-Requested-With
    - X-Request-Client
    - X-Hai-Terminal
    - X-HAI-Token-Transport
    - X-Client-Id
    - X-Encrypted
    - X-Hai-Transport
  exposedHeaders:
    - X-Request-Id
    - X-Encrypted
    - X-Hai-Transport

transport:
  # 双向业务明文 UTF-8 字节；默认 {{#if features.feedback}}auto（按反馈预算推导）{{else}}1 MiB{{/if}}，范围 1 KiB～64 MiB，密文容量自动推导。
{{#if features.feedback}}
  maxPlaintextBytes: ${HAI_SERV_TRANSPORT_MAXPLAINTEXTBYTES:auto}
{{else}}
  maxPlaintextBytes: ${HAI_SERV_TRANSPORT_MAXPLAINTEXTBYTES:1048576}
{{/if}}
  # HAI_SERV_TRANSPORT_ROUTEPLAINTEXTBYTES 可填 JSON，例如 {"/api/v1/uploads/*":8388608}。
  routePlaintextBytes: {}
  keyExchangePath: /_hai/key-exchange
  # excludePaths: [/health, /ready]
  # 单条路径需要更大请求体时填写字节数，* 只匹配一段路径。
  # routePlaintextBytes: # HAI_SERV_TRANSPORT_ROUTEPLAINTEXTBYTES 可填 JSON 路径映射
  #   /api/v1/uploads/*: 8388608
