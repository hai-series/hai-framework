# =============================================================================
# {{fullstack.servPackageName}} - Serv / HTTP 入口配置
# =============================================================================
#
# 业务接口路径直接写在对应 *-contract.ts；公共 HTTP 传输配置以本文件为准。
# =============================================================================

server:
  host: 127.0.0.1
  port: 3000

http:
  # 仅列出会清洗/追加转发头的代理 IP/CIDR；空数组忽略 X-Forwarded-For/X-Real-IP。
  trustedProxies: []
  apiPrefix: /api/v1
  openapi:
    path: /openapi.json
  docs:
    path: /docs
    # requireAuth: true
  health:
    path: /health
    readyPath: /ready
  rpc: false
  # 内部 RPC 可选；启用时用对象替换 false，gateway-only 必须配置网关密钥。
  # rpc:
  #   prefix: /api/rpc
  #   access: gateway-only # loopback | private-network | gateway-only
  #   gatewayHeader: X-Gateway-Key
  #   gatewaySecret: ${HAI_SERV_HTTP_RPC_GATEWAYSECRET}

cors:
  origin: ${HAI_SERV_CORS_ORIGIN:*}
  nativeOrigins: ${HAI_SERV_CORS_NATIVEORIGINS:http://localhost,https://localhost,http://tauri.localhost,https://tauri.localhost,tauri://localhost,capacitor://localhost}
  credentials: ${HAI_SERV_CORS_CREDENTIALS:true}
  allowedHeaders:
    - Authorization
    - Content-Type
    - X-Request-Id
    - X-Requested-With
    - X-Request-Client
    - X-HAI-Token-Transport
    - X-Client-Id
    - X-Encrypted
    - X-Hai-Transport
  exposedHeaders:
    - X-Request-Id
    - X-Encrypted
    - X-Hai-Transport

transport:
  keyExchangePath: /_hai/key-exchange
  # excludePaths: [/health, /ready]
