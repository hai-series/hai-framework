# =============================================================================
# {{fullstack.servPackageName}} - Serv / HTTP 入口配置
# =============================================================================
#
# 业务接口路径直接写在对应 *-contract.ts；公共 HTTP 传输配置以本文件为准。
# =============================================================================

server:
  host: 127.0.0.1
  port: 3000

http:
  apiPrefix: /api/v1
  openapi:
    path: /openapi.json
  docs:
    path: /docs
  health:
    path: /health
    readyPath: /ready
  rpc: false

cors:
  origin: '*'
  nativeOrigins: http://localhost,https://tauri.localhost,tauri://localhost,capacitor://localhost
  credentials: false
  allowedHeaders:
    - Authorization
    - Content-Type
    - X-Request-Id
    - X-Requested-With
  exposedHeaders:
    - X-Request-Id

transport: false
