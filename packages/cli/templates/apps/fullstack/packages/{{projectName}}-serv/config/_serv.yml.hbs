# =============================================================================
# {{fullstack.servPackageName}} - Serv / HTTP 入口配置
# =============================================================================
#
# HTTP 路由路径（apiPrefix / health / openapi / docs）由共享 contract
# 统一定义，作为前后端唯一事实来源，因此不在此重复声明。
# 本文件仅声明服务端运行时设置。
# =============================================================================

# CORS 允许的来源。
# 开发环境放开为 *，生产环境应收敛为前端域名（如 https://app.example.com）。
cors:
  origin: ${HAI_CORS_ORIGIN:*}
