import { apiContract } from '@h-ai/api-contract'
import { {{fullstack.contractExportName}} } from '{{fullstack.contractPackageName}}'
import { describe, expect, it } from 'vitest'
import { createServerApp } from '../src/app-server.js'

const API_PREFIX = '/api/v1'

describe('{{fullstack.servPackageName}}', () => {
  it('returns health status', async () => {
    const app = createServerApp()
    const response = await app.request('/health')

    expect(response.status).toBe(200)
    await expect(response.json()).resolves.toEqual({ status: 'ok' })
  })

  it('returns app info as HaiResult', async () => {
    const app = createServerApp()
    const response = await app.request(`${API_PREFIX}${apiContract.pathOf({{fullstack.contractExportName}}.app.info)}`, { method: 'POST' })
    const body = await response.json()

    expect(response.status).toBe(200)
    expect(body.success).toBe(true)
    expect(body.data.name).toBe('{{fullstack.servPackageName}}')
  })

  it('validates echo input', async () => {
    const app = createServerApp()
    const response = await app.request(`${API_PREFIX}${apiContract.pathOf({{fullstack.contractExportName}}.app.echo)}`, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ message: '' }),
    })

    expect(response.status).toBe(400)
  })

  it('returns echo result as HaiResult', async () => {
    const app = createServerApp()
    const response = await app.request(`${API_PREFIX}${apiContract.pathOf({{fullstack.contractExportName}}.app.echo)}`, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ message: 'hello unit' }),
    })
    const body = await response.json()

    expect(response.status).toBe(200)
    expect(body.success).toBe(true)
    expect(body.data.message).toBe('hello unit')
    expect(body.data.requestId).toBeDefined()
  })
})
