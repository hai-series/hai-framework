{
  "engines": { "node": "^22.23.4 || ^24.22.1 || ^26.12.1" },
  "name": "{{fullstack.servPackageName}}",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "config",
    "data",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "check": "pnpm typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo",
    "dev": "pnpm build && node --env-file=../../.env --env-file=../../.env.dev --env-file-if-exists=../../.env.local dist/index.js",
    "start": "node --env-file=../../.env --env-file=../../.env.prod --env-file-if-exists=../../.env.local dist/index.js",
    "dev:test": "pnpm build && node --env-file=../../.env --env-file=../../.env.test --env-file-if-exists=../../.env.local dist/index.js",
    "dev:prod": "pnpm build && pnpm start",
    "start:test": "node --env-file=../../.env --env-file=../../.env.test --env-file-if-exists=../../.env.local dist/index.js",
    "start:prod": "pnpm start"
  },
  "dependencies": {
{{#if features.ai}}
    "@h-ai/ai": "{{haiPackageSpecifier}}",
{{/if}}
    "@h-ai/audit": "{{haiPackageSpecifier}}",
    "@h-ai/cache": "{{haiPackageSpecifier}}",
    "@h-ai/core": "{{haiPackageSpecifier}}",
    "@h-ai/crypto": "{{haiPackageSpecifier}}",
{{#if features.feedback}}
    "@h-ai/feedback": "{{haiPackageSpecifier}}",
{{/if}}
    "@h-ai/iam": "{{haiPackageSpecifier}}",
    "@h-ai/reach": "{{haiPackageSpecifier}}",
    "@h-ai/reldb": "{{haiPackageSpecifier}}",
    "@h-ai/serv": "{{haiPackageSpecifier}}",
    "@h-ai/storage": "{{haiPackageSpecifier}}",
{{#if features.vecdb}}
    "@h-ai/vecdb": "{{haiPackageSpecifier}}",
{{/if}}
    "zod": "{{fullstack.packageSpecifiers.zod}}",
    "{{fullstack.contractPackageName}}": "workspace:*"
  }
}
