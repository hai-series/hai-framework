{
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "name": "{{fullstack.servPackageName}}",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "config",
    "data",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo",
    "dev": "pnpm build && node --env-file-if-exists=../../.env dist/index.js",
    "start": "node --env-file-if-exists=../../.env dist/index.js"
  },
  "dependencies": {
    "@h-ai/audit": "{{haiPackageSpecifier}}",
    "@h-ai/cache": "{{haiPackageSpecifier}}",
    "@h-ai/core": "{{haiPackageSpecifier}}",
    "@h-ai/crypto": "{{haiPackageSpecifier}}",
    "@h-ai/iam": "{{haiPackageSpecifier}}",
    "@h-ai/reldb": "{{haiPackageSpecifier}}",
    "@h-ai/serv": "{{haiPackageSpecifier}}",
    "@h-ai/storage": "{{haiPackageSpecifier}}",
    "zod": "{{fullstack.packageSpecifiers.zod}}",
    "{{fullstack.contractPackageName}}": "workspace:*"
  }
}
