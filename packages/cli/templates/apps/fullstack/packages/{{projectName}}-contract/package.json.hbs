{
  "engines": { "node": "^22.23.4 || ^24.22.1 || ^26.12.1" },
  "name": "{{fullstack.contractPackageName}}",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "check": "pnpm typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@h-ai/api-contract": "{{haiPackageSpecifier}}",
    "@h-ai/core": "{{haiPackageSpecifier}}",
    "zod": "{{fullstack.packageSpecifiers.zod}}"
  }
}
