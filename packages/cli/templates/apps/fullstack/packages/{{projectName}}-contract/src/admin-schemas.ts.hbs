import { IamListUsersInputSchema, IamPermissionSchema } from '@h-ai/api-contract'
import { z } from 'zod'

/** 权限的敏感操作配置复用框架字段；职责授权仍由应用控制。 */
export const AdminPermissionPolicySchema = IamPermissionSchema.pick({ id: true, code: true, name: true, sensitiveOperations: true })
export const AdminPermissionPolicyInputSchema = AdminPermissionPolicySchema.pick({ id: true, sensitiveOperations: true })
export type AdminPermissionPolicy = z.infer<typeof AdminPermissionPolicySchema>

export const BusinessSettingsSchema = z.object({ notice: z.string().trim().max(200) }).strict()

export const AdminRoleCodeSchema = z.enum(['admin', 'audit_admin', 'config_admin', 'business_operator', 'user'])
export const AdminPageInputSchema = z.object({
  page: z.number().int().min(1).default(1),
  pageSize: z.number().int().min(1).max(100).default(20),
})
export const AdminUserSchema = z.object({
  id: z.string(),
  username: z.string(),
  email: z.string().optional(),
  displayName: z.string().optional(),
  avatarUrl: z.string().optional(),
  accountType: z.enum(['permanent', 'temporary']),
  accountStatus: z.enum(['active', 'dormant', 'closed']),
  accountExpiresAt: z.string().datetime().nullable(),
  lastLoginAt: z.string().datetime().nullable(),
  roles: z.array(AdminRoleCodeSchema),
  createdAt: z.string().datetime(),
  updatedAt: z.string().datetime(),
})
export const AdminUsersInputSchema = AdminPageInputSchema.extend({
  sortBy: IamListUsersInputSchema.shape.sortBy,
  sortDirection: IamListUsersInputSchema.shape.sortDirection,
  search: z.string().max(100).optional(),
  accountStatus: IamListUsersInputSchema.shape.accountStatus,
})
export const AdminUsersSchema = z.object({
  items: z.array(AdminUserSchema),
  total: z.number(),
  page: z.number(),
  pageSize: z.number(),
})
export const AdminCreateUserSchema = z.object({
  username: z.string().min(3).max(64).regex(/^[\w-]+$/),
  password: z.string().min(1),
  email: z.email().optional(),
  displayName: z.string().max(100).optional(),
  role: AdminRoleCodeSchema.default('user'),
  accountType: z.enum(['permanent', 'temporary']).default('permanent'),
  accountStatus: z.enum(['active', 'dormant', 'closed']).default('active'),
  accountExpiresAt: z.string().datetime().nullable().optional(),
}).strict()
export const AdminInviteUserSchema = AdminCreateUserSchema.omit({ password: true }).extend({ phone: z.string().trim().min(1).max(32).optional(), accountStatus: z.literal('active').default('active') })
export const AdminUpdateUserSchema = z.object({
  id: z.string().min(1),
  email: z.union([z.email(), z.literal('')]).optional(),
  displayName: z.string().max(100).optional(),
  accountType: z.enum(['permanent', 'temporary']).optional(),
  accountStatus: z.enum(['active', 'dormant', 'closed']).optional(),
  accountExpiresAt: z.string().datetime().nullable().optional(),
  role: AdminRoleCodeSchema.optional(),
}).strict()
export const AdminRoleSchema = z.object({
  id: z.string(),
  code: AdminRoleCodeSchema,
  name: z.string(),
  description: z.string().optional(),
  userCount: z.number(),
})
export const AdminAuditInputSchema = AdminPageInputSchema.extend({
  category: z.enum(['system', 'business']).optional(),
  outcome: z.enum(['success', 'failure', 'denied']).optional(),
  severity: z.enum(['info', 'warning', 'error', 'critical']).optional(),
  scopeId: z.string().max(256).optional(),
  requestId: z.string().max(256).optional(),
  traceId: z.string().max(256).optional(),
  sortBy: z.enum(['createdAt', 'action', 'resource', 'category', 'outcome', 'severity']).optional(),
  sortDirection: z.enum(['asc', 'desc']).optional(),
  userId: z.string().max(100).optional(),
  action: z.string().max(50).optional(),
  resource: z.string().max(50).optional(),
  startDate: z.string().datetime().optional(),
  endDate: z.string().datetime().optional(),
})
export const AdminAuditLogSchema = z.object({
  category: z.enum(['system', 'business']).nullish(),
  outcome: z.enum(['success', 'failure', 'denied']).nullish(),
  severity: z.enum(['info', 'warning', 'error', 'critical']).nullish(),
  scopeId: z.string().nullish(),
  requestId: z.string().nullish(),
  traceId: z.string().nullish(),
  actorSnapshot: z.object({ id: z.string(), username: z.string().optional(), displayName: z.string().optional(), roles: z.array(z.string()).optional() }).nullish(),
  id: z.string(),
  userId: z.string().nullable(),
  username: z.string().nullable(),
  action: z.string(),
  resource: z.string(),
  resourceId: z.string().nullable(),
  details: z.string().nullable(),
  ipAddress: z.string().nullable(),
  userAgent: z.string().nullable(),
  createdAt: z.string().datetime(),
})
export const AuditBackupReceiptSchema = z.object({ id: z.string(), key: z.string(), recordCount: z.number(), sha256: z.string(), createdAt: z.string().datetime(), cutoff: z.string().datetime() })
export const AdminAuditSchema = z.object({
  backupEnabled: z.boolean(),
  stats: z.array(z.object({ action: z.string(), count: z.number() })),
  items: z.array(AdminAuditLogSchema),
  total: z.number(),
  page: z.number(),
  pageSize: z.number(),
})
export const ProfileUpdateSchema = z.object({
  displayName: z.string().max(100).optional(),
  email: z.union([z.email(), z.literal('')]).optional(),
  locale: z.enum([{{#each fullstack.i18n.locales}}'{{this}}'{{#unless @last}}, {{/unless}}{{/each}}]).optional(),
  theme: z.string().min(1).max(40).regex(/^[\w-]+$/).optional(),
}).strict()
/** 512 KiB 头像以 JSON 传输，上传及响应均经过统一加密。 */
export const AvatarUploadSchema = z.object({
  contentType: z.enum(['image/png', 'image/jpeg', 'image/webp']),
  base64: z.string().min(1).max(699052).regex(/^[A-Z\d+/]+={0,2}$/i),
}).strict()
export const AvatarOutputSchema = z.object({ avatarUrl: z.string().describe('Generated relative asset path') })

export type AdminUser = z.infer<typeof AdminUserSchema>
export type AdminRole = z.infer<typeof AdminRoleSchema>
export type AdminRoleCode = z.infer<typeof AdminRoleCodeSchema>
export type AuditBackupReceipt = z.infer<typeof AuditBackupReceiptSchema>
export type AdminAuditLog = z.infer<typeof AdminAuditLogSchema>
export type AdminInviteUser = z.infer<typeof AdminInviteUserSchema>
export type AdminCreateUser = z.infer<typeof AdminCreateUserSchema>
export type AdminUpdateUser = z.infer<typeof AdminUpdateUserSchema>
export type ProfileUpdate = z.infer<typeof ProfileUpdateSchema>
export type AvatarUpload = z.infer<typeof AvatarUploadSchema>
