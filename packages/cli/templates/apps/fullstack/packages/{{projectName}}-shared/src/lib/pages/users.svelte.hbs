<script lang='ts'>
  import type { ChangePasswordFormData } from '@h-ai/ui'
  import type { AdminRoleCode, AdminUser } from '{{fullstack.contractPackageName}}'
  import type { ManagementStore } from '../stores/management-store.svelte.js'
  import { Card, DataTable, FilterBar, FormField, FormLayout, Modal, PageHeader, Pagination, Skeleton } from '@h-ai/ui/components/compounds/index'
  import { Avatar, Badge, BareInput, Button, Input, Select } from '@h-ai/ui/components/primitives/index'
  import { ChangePasswordForm, PasswordInput } from '@h-ai/ui/components/scenes/iam/index'
  import { AdminRoleCodeSchema } from '{{fullstack.contractPackageName}}'
  import * as m from '../paraglide/messages.js'
  import { roleLabel } from '../security/role-label.js'

  interface Props { store: ManagementStore }
  const { store }: Props = $props()

  let editorOpen = $state(false)
  let editing = $state<AdminUser | null>(null)
  let deleting = $state<AdminUser | null>(null)
  let resetting = $state<AdminUser | null>(null)
  let username = $state('')
  let displayName = $state('')
  let email = $state('')
  let password = $state('')
  let invitation = $state(false)
  let phone = $state('')
  let role = $state<AdminRoleCode>('user')
  let accountType = $state<'permanent' | 'temporary'>('permanent')
  let accountStatus = $state<'active' | 'dormant' | 'closed'>('active')
  let expiresAt = $state('')
  const columns = $derived([
    { key: 'username', sortable: true, label: m.user_account() },
    { key: 'email', sortable: true, label: m.user_email() },
    { key: 'roles', label: m.user_role() },
    { key: 'accountStatus', sortable: true, label: m.account_state() },
    { key: 'createdAt', sortable: true, label: m.created_at() },
  ])
  const roleOptions = $derived(AdminRoleCodeSchema.options.map(value => ({ value, label: roleLabel(value) })))
  const statusOptions = $derived([{ value: 'all', label: m.all_statuses() }, { value: 'active', label: m.account_active() }, { value: 'dormant', label: m.account_dormant() }, { value: 'closed', label: m.account_closed() }])

  function openEditor(user: AdminUser | null, useInvitation = false) {
    editing = user
    username = user?.username ?? ''
    displayName = user?.displayName ?? ''
    email = user?.email ?? ''
    password = ''
    invitation = useInvitation
    phone = ''
    role = user?.roles[0] ?? 'user'
    accountType = user?.accountType ?? 'permanent'
    accountStatus = user?.accountStatus ?? 'active'
    expiresAt = user?.accountExpiresAt ? store.localDateTime(user.accountExpiresAt) : ''
    store.error = ''
    editorOpen = true
  }

  async function submit(event: SubmitEvent) {
    event.preventDefault()
    const fields = { displayName: displayName.trim(), role, accountType, accountStatus, accountExpiresAt: expiresAt ? new Date(expiresAt).toISOString() : null }
    const saved = invitation && !editing
      ? await store.inviteUser({ username: username.trim(), email: email.trim() || undefined, phone: phone.trim() || undefined, ...fields, accountStatus: 'active' })
      : await store.saveUser(editing ? { id: editing.id, email: email.trim(), ...fields } : { username: username.trim(), password, email: email.trim() || undefined, ...fields })
    if (saved) {
      editorOpen = false
      password = ''
    }
  }

  async function confirmDelete() {
    if (deleting && await store.deleteUser(deleting))
      deleting = null
  }

  async function confirmReset(data: ChangePasswordFormData) {
    if (resetting && await store.resetUserPassword(resetting, data.newPassword))
      resetting = null
  }

  function upload(user: AdminUser, event: Event & { currentTarget: HTMLInputElement }) {
    const file = event.currentTarget.files?.[0]
    if (file)
      void store.uploadAvatar(file, user.id)
    event.currentTarget.value = ''
  }
</script>

<section class='flex min-h-0 flex-1 flex-col gap-3' data-testid='users-page'>
  <PageHeader title={m.nav_users()} description={m.users_description()} class='mb-0 shrink-0'>
    {#snippet actions()}
      {#if store.authConfig?.initialCredentials?.enabled}<Button variant='outline' size='sm' onclick={() => openEditor(null, true)} data-testid='invite-user'>{m.invitation_title()}</Button>{/if}
      <Button variant='primary' size='sm' onclick={() => openEditor(null)} data-testid='create-user'>{m.user_create()}</Button>
    {/snippet}
  </PageHeader>
  <div class='flex min-h-0 flex-1 flex-col overflow-hidden rounded-xl border border-base-content/8 bg-base-100'>
    <form class='shrink-0 border-b border-base-content/8 p-3' onsubmit={(event) => {
      event.preventDefault()
      void store.queryUsers()
    }}>
      <FilterBar activeCount={store.usersStatus === 'all' ? 0 : 1} onreset={() => {
        store.usersSearch = ''
        store.usersStatus = 'all'
        store.usersSortBy = 'createdAt'
        store.usersSortDirection = 'desc'
        void store.queryUsers()
      }} data-testid='users-filters'>
        {#snippet leading()}<div class='min-w-0 flex-1'><Input type='search' size='sm' bind:value={store.usersSearch} placeholder={m.users_search()} data-testid='users-search' /></div>{/snippet}
        {#snippet actions()}<Button type='submit' submitHint size='sm' variant='outline' disabled={store.loading}>{m.search()}</Button>{/snippet}
        <div class='w-full sm:w-40'><Select size='sm' bind:value={store.usersStatus} options={statusOptions} /></div>
      </FilterBar>
    </form>
    <div class='hidden min-h-0 flex-1 overflow-auto md:flex md:flex-col'>
      <DataTable data={store.users} {columns} keyField='id' loading={store.loading} striped={false} sortKey={store.usersSortBy} sortDir={store.usersSortDirection} onsort={(key, direction) => void store.sortUsers(key, direction)} class='min-h-0 flex-1 overflow-auto'>
        {#snippet cell(user, key)}
          {#if key === 'username'}
            <div class='flex items-center gap-3'>
              <Avatar name={user.displayName || user.username} src={user.avatarUrl} size='sm' />
              <div><p class='font-medium'>{user.displayName || user.username}</p><p class='text-xs text-base-content/45'>@{user.username}</p></div>
            </div>
          {:else if key === 'roles'}
            <Badge variant={user.roles.includes('admin') ? 'primary' : 'ghost'}>{user.roles.map(roleLabel).join(', ')}</Badge>
          {:else if key === 'accountStatus'}
            <Badge variant={user.accountStatus === 'active' ? 'success' : user.accountStatus === 'dormant' ? 'warning' : 'ghost'}>{user.accountStatus === 'active' ? m.account_active() : user.accountStatus === 'dormant' ? m.account_dormant() : m.account_closed()}</Badge>
          {:else if key === 'createdAt'}
            <span class='whitespace-nowrap text-xs text-base-content/60'>{store.formatDate(user.createdAt)}</span>
          {:else if key === 'email'}
            {user.email || '—'}
          {/if}
        {/snippet}
        {#snippet actions(user)}
          {@render userActions(user)}
        {/snippet}
      </DataTable>
    </div>
    <div class='min-h-0 flex-1 space-y-3 overflow-auto p-4 md:hidden' data-testid='user-cards'>
      {#if store.loading}
        <Skeleton count={3} />
      {:else if store.users.length === 0}
        <p class='py-8 text-center text-sm text-base-content/50'>{m.users_empty()}</p>
      {:else}
        {#each store.users as user (user.id)}
          <Card bordered shadow={false}>
            <div class='flex items-center gap-3'>
              <Avatar name={user.displayName || user.username} src={user.avatarUrl} size='sm' />
              <div class='min-w-0 flex-1'><p class='truncate font-medium'>{user.displayName || user.username}</p><p class='truncate text-xs text-base-content/45'>@{user.username}</p></div>
              <Badge size='sm' variant={user.accountStatus === 'active' ? 'success' : user.accountStatus === 'dormant' ? 'warning' : 'ghost'}>{user.accountStatus === 'active' ? m.account_active() : user.accountStatus === 'dormant' ? m.account_dormant() : m.account_closed()}</Badge>
            </div>
            <p class='mt-3 truncate text-xs text-base-content/60' title={user.email}>{user.email || '—'}</p>
            <div class='mt-3 flex flex-wrap items-center justify-between gap-2'>
              <Badge size='sm' variant={user.roles.includes('admin') ? 'primary' : 'ghost'}>{user.roles.map(roleLabel).join(', ')}</Badge>
              {@render userActions(user)}
            </div>
          </Card>
        {/each}
      {/if}
    </div>
    <div class='mt-auto shrink-0 border-t border-base-content/8 px-3 py-2'>
      <Pagination page={store.usersPage} total={store.usersTotal} pageSize={store.pageSize} onchange={page => void store.loadUsers(page)} />
    </div>
  </div>
</section>

<Modal bind:open={editorOpen} title={editing ? m.user_edit() : invitation ? m.invitation_title() : m.user_create()} closeOnBackdrop={!store.saving} closeOnEscape={!store.saving} size='3xl' data-testid='user-editor'>
  <form onsubmit={submit}>
    {#if invitation}<p class='mb-4 text-sm text-base-content/60'>{m.invitation_hint()}</p>{/if}
    <FormLayout columns={2} labelPosition='left' labelWidth='6rem'>
      <FormField label={m.user_username()} required>
        <Input bind:value={username} name='username' readonly={!!editing} required minlength={3} maxlength={64} pattern='[\w\-]+' autocomplete='off' data-testid='user-username' />
      </FormField>
      <FormField label={m.user_display_name()}><Input bind:value={displayName} maxlength={100} data-testid='user-display-name' /></FormField>
      <FormField label={m.user_email()}><Input type='email' bind:value={email} data-testid='user-email' /></FormField>
      {#if !editing && !invitation}
        <FormField label={m.user_password()} hint={m.initial_password_rules({ min: store.authConfig?.password.minLength ?? 8 })} required><PasswordInput required bind:value={password} autocomplete='new-password' minLength={store.authConfig?.password.minLength ?? 8} data-testid='user-password' /></FormField>
      {/if}
      {#if invitation && store.authConfig?.passwordReset.mode === 'phone'}<FormField label={m.invitation_phone()} required><Input type='tel' bind:value={phone} required maxlength={32} data-testid='invite-phone' /></FormField>{/if}
      <FormField label={m.account_type()}><Select bind:value={accountType} options={[{ value: 'permanent', label: m.account_permanent() }, { value: 'temporary', label: m.account_temporary() }]} data-testid='account-type' /></FormField>
      <FormField label={m.account_state()}><Select bind:value={accountStatus} disabled={invitation || editing?.id === store.user?.id} options={[{ value: 'active', label: m.account_active() }, { value: 'dormant', label: m.account_dormant() }, { value: 'closed', label: m.account_closed() }]} data-testid='account-state' /></FormField>
      <FormField label={m.account_expires()} required={accountType === 'temporary'}><Input type='datetime-local' bind:value={expiresAt} required={accountType === 'temporary'} data-testid='account-expires' /></FormField>
      <FormField label={m.user_role()}><Select bind:value={role} options={roleOptions} disabled={editing?.id === store.user?.id} data-testid='user-role' /></FormField>
      <div class='flex justify-end gap-2 border-t border-base-content/8 pt-4'>
        <Button variant='ghost' disabled={store.saving} onclick={() => { editorOpen = false }}>{m.cancel()}</Button>
        <Button type='submit' variant='primary' loading={store.saving} disabled={!editing && !invitation && password.length < (store.authConfig?.password.minLength ?? 8)} data-testid='user-save'>{m.save()}</Button>
      </div>
    </FormLayout>
  </form>
</Modal>

{#snippet userActions(user: AdminUser)}
  <div class='flex items-center gap-1' data-testid='user-actions' data-user={user.username}>
    <Button size='xs' variant='ghost' disabled={store.saving} onclick={() => openEditor(user)}>{m.edit()}</Button>
    <Button size='xs' variant='ghost' disabled={store.saving} onclick={() => { resetting = user }} data-testid='reset-user-password'>{m.user_password_reset()}</Button>
    <label class='cursor-pointer rounded-lg px-2 py-1.5 text-xs text-primary hover:bg-primary/5'>
      {m.avatar_upload()}
      <BareInput type='file' class='sr-only' accept='image/png,image/jpeg,image/webp' disabled={store.saving} onchange={event => upload(user, event)} data-testid='user-avatar-input' />
    </label>
    <Button size='xs' variant='ghost' class='text-error' disabled={user.id === store.user?.id || store.saving} onclick={() => { deleting = user }}>{m.delete()}</Button>
  </div>
{/snippet}

<Modal open={!!deleting} title={m.user_delete_title()} onclose={() => { deleting = null }} closeOnBackdrop={!store.saving} closeOnEscape={!store.saving}>
  <p class='text-sm leading-6 text-base-content/70'>{m.user_delete_confirm({ name: deleting?.displayName || deleting?.username || '' })}</p>
  {#snippet footer()}
    <Button variant='ghost' disabled={store.saving} onclick={() => { deleting = null }}>{m.cancel()}</Button>
    <Button variant='error' loading={store.saving} onclick={confirmDelete} data-testid='confirm-delete-user'>{m.delete()}</Button>
  {/snippet}
</Modal>

<Modal open={!!resetting} title={m.user_password_reset()} onclose={() => { resetting = null }} closeOnBackdrop={!store.saving} closeOnEscape={!store.saving} data-testid='password-reset-dialog'>
  {#if resetting}
    {#key resetting.id}
      <p class='text-sm leading-6 text-base-content/70'>{m.user_password_reset_hint({ name: resetting?.displayName || resetting?.username || '' })}</p>
      {#if store.authConfig?.password.requireInitialChange}<p class='text-sm leading-6 text-base-content/70'>{m.user_password_reset_initial_hint()}</p>{/if}
      <ChangePasswordForm requireOldPassword={false} loading={store.saving} passwordPolicy={store.authConfig?.password} minPasswordLength={store.authConfig?.password.minLength ?? 8} submitText={m.user_password_reset()} onsubmit={confirmReset} class='mt-4' data-testid='admin-password-reset-form' />
    {/key}
  {/if}
  {#snippet footer()}
    <Button variant='ghost' disabled={store.saving} onclick={() => { resetting = null }}>{m.cancel()}</Button>
  {/snippet}
</Modal>
