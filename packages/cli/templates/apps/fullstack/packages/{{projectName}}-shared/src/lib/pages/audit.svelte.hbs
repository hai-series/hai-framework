<script lang="ts">
  import type { AdminAuditLog } from '{{fullstack.contractPackageName}}'
  import type { ManagementStore } from '../stores/management-store.svelte.js'
  import { DataTable, FilterBar, FormField, FormLayout, Modal, PageHeader, Pagination } from '@h-ai/ui/components/compounds/index'
  import { Badge, Button, Input, Select } from '@h-ai/ui/components/primitives/index'
  import * as m from '../paraglide/messages.js'

  interface Props { store: ManagementStore }
  const { store }: Props = $props()
  let selected = $state<AdminAuditLog | null>(null)
  const columns = $derived([
    { key: 'createdAt', sortable: true, label: m.created_at() },
    { key: 'username', label: m.audit_actor() },
    { key: 'action', sortable: true, label: m.audit_action() },
    { key: 'category', sortable: true, label: m.audit_category() },
    { key: 'outcome', sortable: true, label: m.audit_outcome() },
    { key: 'severity', sortable: true, label: m.audit_severity() },
    { key: 'resource', sortable: true, label: m.audit_resource() },
    { key: 'ipAddress', label: m.audit_ip() },
  ])
</script>

<section class="flex min-h-0 flex-1 flex-col gap-3" data-testid="audit-page">
  <PageHeader title={m.nav_audit()} description={m.audit_description()} class='mb-0 shrink-0'>
    {#snippet actions()}{#if store.auditBackupEnabled && store.hasPermission('audit:backup')}<Button size='sm' variant='outline' loading={store.saving} onclick={() => void store.backupAudit()} data-testid='audit-backup'>{m.audit_backup_run()}</Button>{/if}{/snippet}
  </PageHeader>
  {#if store.auditBackupReceipt}<p class='break-all font-mono text-xs' data-testid='audit-backup-receipt'>{store.auditBackupReceipt.key} · {store.auditBackupReceipt.recordCount} · SHA-256: {store.auditBackupReceipt.sha256}</p>{/if}
  <div class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-xl border border-base-content/8 bg-base-100">
    <form class='shrink-0 border-b border-base-content/8 p-3' onsubmit={(event) => {
      event.preventDefault()
      void store.queryAudit()
    }}>
      <FilterBar data-testid='audit-filters' activeCount={[store.auditAction, store.auditResource, store.auditStartDate, store.auditEndDate, store.auditCategory, store.auditOutcome, store.auditSeverity].filter(Boolean).length} onreset={() => {
        store.auditAction = ''
        store.auditResource = ''
        store.auditStartDate = ''
        store.auditEndDate = ''
        store.auditCategory = ''
        store.auditOutcome = ''
        store.auditSeverity = ''
        store.auditSortBy = 'createdAt'
        store.auditSortDirection = 'desc'
        void store.queryAudit()
      }}>
        {#snippet leading()}<div class='min-w-0 flex-1'><label class='sr-only' for='audit-action'>{m.audit_action()}</label><Input id='audit-action' size='sm' bind:value={store.auditAction} placeholder={m.audit_action_placeholder()} data-testid='audit-action' /></div>{/snippet}
        {#snippet actions()}<Button type='submit' submitHint size='sm' variant='outline' disabled={store.loading}>{m.search()}</Button>{/snippet}
        <FormLayout columns={2} class='w-full [--hai-form-gap:1rem_1.25rem]' data-testid='audit-advanced'>
          <FormField label={m.audit_resource()}><Input size='sm' id="audit-resource" bind:value={store.auditResource} placeholder={m.audit_resource_placeholder()} data-testid="audit-resource" /></FormField>
          <FormField label={m.audit_start()} for="audit-start"><input id="audit-start" type="date" class="input block h-9 min-w-0 w-full" bind:value={store.auditStartDate} /></FormField>
          <FormField label={m.audit_end()} for="audit-end"><input id="audit-end" type="date" class="input block h-9 min-w-0 w-full" bind:value={store.auditEndDate} /></FormField>
          <FormField label={m.audit_category()}><Select size='sm' bind:value={store.auditCategory} options={[{ value: '', label: m.audit_all() }, { value: 'system', label: m.audit_category_system() }, { value: 'business', label: m.audit_category_business() }]} data-testid='audit-category' /></FormField>
          <FormField label={m.audit_outcome()}><Select size='sm' bind:value={store.auditOutcome} options={[{ value: '', label: m.audit_all() }, { value: 'success', label: m.audit_success() }, { value: 'failure', label: m.audit_failure() }, { value: 'denied', label: m.audit_denied() }]} data-testid='audit-outcome' /></FormField>
          <FormField label={m.audit_severity()}><Select size='sm' bind:value={store.auditSeverity} options={[{ value: '', label: m.audit_all() }, { value: 'info', label: m.audit_info() }, { value: 'warning', label: m.audit_warning() }, { value: 'error', label: m.audit_error() }, { value: 'critical', label: m.audit_critical() }]} data-testid='audit-severity' /></FormField>
        </FormLayout>
      <div class='w-full space-y-2'>
        <p class='text-xs text-base-content/60'>{m.audit_stats_hint()}</p>
        <div class='flex flex-wrap gap-2'>{#each store.auditStats as stat (stat.action)}<Badge variant='ghost'>{stat.action}: {stat.count}</Badge>{/each}</div>
      </div>
      </FilterBar>
    </form>
    <div class="flex min-h-32 flex-1 flex-col overflow-auto">
      <DataTable data={store.audit} {columns} keyField="id" loading={store.loading} striped={false} sortKey={store.auditSortBy} sortDir={store.auditSortDirection} onsort={(key, direction) => void store.sortAudit(key, direction)} class="min-h-0 flex-1 overflow-auto">
        {#snippet cell(entry, key)}
          {#if key === 'createdAt'}<span class="whitespace-nowrap text-xs">{store.formatDate(entry.createdAt)}</span>
          {:else if key === 'username'}{entry.username || m.audit_system()}
          {:else if key === 'action'}<span class="rounded-md bg-base-200 px-2 py-1 font-mono text-xs">{entry.action}</span>
          {:else if key === 'category' || key === 'outcome' || key === 'severity'}{entry[key] ?? '—'}
          {:else if key === 'resource'}<span class="text-sm">{entry.resource}</span>
          {:else if key === 'ipAddress'}<span class="text-xs text-base-content/55">{entry.ipAddress || '—'}</span>{/if}
        {/snippet}
        {#snippet actions(entry)}<Button size="xs" variant="ghost" onclick={() => { selected = entry }}>{m.details()}</Button>{/snippet}
      </DataTable>
    </div>
    <div class="mt-auto shrink-0 border-t border-base-content/8 px-3 py-2"><Pagination page={store.auditPage} total={store.auditTotal} pageSize={store.pageSize} onchange={page => void store.loadAudit(page)} /></div>
  </div>
</section>

<Modal open={!!selected} title={m.audit_details()} onclose={() => { selected = null }}>
  {#if selected}
    <dl class="grid grid-cols-[auto_1fr] gap-x-5 gap-y-3 text-sm">
      <dt>{m.audit_request_id()}</dt><dd class='break-all'>{selected.requestId ?? '—'}</dd>
      <dt>{m.audit_trace_id()}</dt><dd class='break-all'>{selected.traceId ?? '—'}</dd>
      <dt>{m.audit_scope()}</dt><dd class='break-all'>{selected.scopeId ?? '—'}</dd>
      <dt>{m.audit_actor_snapshot()}</dt><dd class='break-all'>{selected.actorSnapshot ? JSON.stringify(selected.actorSnapshot) : '—'}</dd>
      <dt class="text-base-content/50">{m.created_at()}</dt><dd>{store.formatDate(selected.createdAt)}</dd>
      <dt class="text-base-content/50">{m.audit_actor()}</dt><dd class="break-all">{selected.username || m.audit_system()}</dd>
      <dt class="text-base-content/50">{m.audit_action()}</dt><dd>{selected.action}</dd>
      <dt class="text-base-content/50">{m.audit_resource()}</dt><dd>{selected.resource}</dd>
      <dt class="text-base-content/50">{m.audit_resource_id()}</dt><dd class="break-all">{selected.resourceId || '—'}</dd>
      <dt class="text-base-content/50">{m.audit_ip()}</dt><dd>{selected.ipAddress || '—'}</dd>
    </dl>
    <pre class="mt-5 max-h-72 overflow-auto whitespace-pre-wrap rounded-lg bg-base-200 p-4 text-xs">{selected.details || '—'}</pre>
  {/if}
</Modal>
