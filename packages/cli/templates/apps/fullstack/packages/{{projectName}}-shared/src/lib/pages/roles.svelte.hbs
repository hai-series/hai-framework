<script lang="ts">
  import type { AdminPermissionPolicy, AdminRole } from '{{fullstack.contractPackageName}}'
  import type { ManagementStore } from '../stores/management-store.svelte.js'
  import { err, HaiCommonError } from '@h-ai/core'
  import { SensitiveOperationsForm } from '@h-ai/ui/components/scenes/iam/index'
  import { Card, Modal, PageHeader, Pagination } from '@h-ai/ui/components/compounds/index'
  import { Badge, Button, Textarea } from '@h-ai/ui/components/primitives/index'
  import { roleCapabilities, roleLabel } from '../security/role-label.js'
  import * as m from '../paraglide/messages.js'

  interface Props { store: ManagementStore }
  const { store }: Props = $props()
  let editing = $state<AdminRole | null>(null)
  let description = $state('')
  let permission = $state<AdminPermissionPolicy | null>(null)
  async function savePolicy(operations: string[]) {
    return permission ? store.savePermissionPolicy(permission.id, operations) : err(HaiCommonError.CONFLICT, m.home_error())
  }
  function edit(role: AdminRole) {
    editing = role
    description = role.description ?? ''
    store.error = ''
  }
  async function save(event: SubmitEvent) {
    event.preventDefault()
    if (editing && await store.saveRole(editing.id, description))
      editing = null
  }
</script>

<section class="space-y-3" data-testid="roles-page">
  <PageHeader title={m.nav_roles()} description={m.roles_description()} class='mb-0'>
    {#snippet actions()}<Button size='sm' variant='outline' loading={store.loading} onclick={() => void store.loadRoles()}>{m.home_refresh()}</Button>{/snippet}
  </PageHeader>
  <div class="grid gap-3 md:grid-cols-2">
    {#each store.roles as role (role.id)}
      <Card bordered shadow={false}>
        <div class="flex items-center justify-between gap-3"><h2 class="text-lg font-semibold">{roleLabel(role.code)}</h2><Badge variant={role.code === 'admin' ? 'primary' : 'ghost'}>{role.code}</Badge></div>
        <p class="mt-3 text-sm leading-6 text-base-content/60">{roleCapabilities(role.code)}</p>
        <p class="mt-4 text-xs text-base-content/45">{m.role_members({ count: String(role.userCount) })}</p>
        {#if role.description}<p class="mt-3 text-sm text-base-content/70">{role.description}</p>{/if}
        {#if role.code === 'admin' || role.code === 'user'}<div class="mt-5"><Button variant="outline" size="sm" onclick={() => edit(role)}>{m.role_edit()}</Button></div>{/if}
      </Card>
    {/each}
  </div>
  {#if store.authConfig?.reauthentication?.enabled}
    <Card bordered shadow={false}>
      <h2 class="mb-4 text-lg font-semibold">{m.security_sensitive_operations()}</h2>
      <div class="divide-y divide-base-content/8">
        {#each store.permissionPolicies as item (item.id)}
          <div class="flex items-center justify-between gap-4 py-3">
            <div class="min-w-0"><p class="break-all font-mono text-sm">{item.code}</p><p class="mt-1 break-all text-xs text-base-content/60">{item.sensitiveOperations.join(', ') || '—'}</p></div>
            <Button size="sm" variant="outline" onclick={() => { permission = item }}>{m.security_sensitive_operations()}</Button>
          </div>
        {/each}
      </div>
      <Pagination page={store.permissionPolicyPage} total={store.permissionPolicyTotal} pageSize={store.pageSize} onchange={page => void store.loadPermissionPolicies(page)} />
    </Card>
  {/if}
</section>

<Modal open={!!editing} title={m.role_edit()} onclose={() => { editing = null }} closeOnBackdrop={!store.saving} closeOnEscape={!store.saving}>
  <form class="space-y-4" onsubmit={save}>
    <label class="block text-sm font-medium" for="role-description">{m.role_description()}</label>
    <Textarea id="role-description" bind:value={description} rows={4} data-testid="role-description" />
    <div class="flex justify-end gap-2"><Button variant="ghost" disabled={store.saving} onclick={() => { editing = null }}>{m.cancel()}</Button><Button type="submit" variant="primary" loading={store.saving}>{m.save()}</Button></div>
  </form>
</Modal>

<Modal open={!!permission} title={m.security_sensitive_operations()} onclose={() => { permission = null }}>
  {#if permission}
    {#key permission.id}
      <p class="mb-3 break-all font-mono text-sm">{permission.code}</p>
      <SensitiveOperationsForm operations={permission.sensitiveOperations} onsubmit={savePolicy} ondone={() => { permission = null }} />
    {/key}
  {/if}
</Modal>
