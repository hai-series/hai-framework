{{! @skipIfEmpty }}
{{#if features.feedback}}
<script lang='ts'>
  import { errorMessage, useToastFeedback } from '@h-ai/ui/toast'
  import type { FeedbackDraft } from '@h-ai/feedback/client'
  import type { FeedbackAnnotation, FeedbackAttachmentView, FeedbackFormData } from '@h-ai/ui'
  import { FeedbackModal } from '@h-ai/ui/components/scenes/app/index'
  import { Button } from '@h-ai/ui/components/primitives/index'
  import { onDestroy } from 'svelte'
  import { browserFeedback } from '../api/feedback-client.js'
  import * as m from '../paraglide/messages.js'

  let open = $state(false)
  $effect(() => {
    if (!open)
      browserFeedback.pause()
  })
  let preparing = $state(false)
  let error = $state('')
  let draft = $state.raw<FeedbackDraft>()
  let attachments = $state<FeedbackAttachmentView[]>([])
  function refreshAttachments() {
    attachments = browserFeedback.getView().attachments
  }
  async function prepare() {
    preparing = true
    error = ''
    try {
      const result = await browserFeedback.prepare()
      if (!result.success)
        throw new Error(result.error.message, { cause: result.error })
      draft = result.data
      refreshAttachments()
      open = true
    }
    catch (cause) {
      error = errorMessage(cause, m.operation_failed())
    }
    finally {
      preparing = false
    }
  }
  function input(data: FeedbackFormData) {
    return { description: data.description, category: data.type, contact: data.contact, files: data.files, removedAttachmentIds: data.removedAttachmentIds }
  }
  async function submit(data: FeedbackFormData) {
    const result = await browserFeedback.submit(input(data))
    if (!result.success)
      throw new Error(result.error.message, { cause: result.error })
    return result.data
  }
  async function annotate(mark: FeedbackAnnotation) {
    const result = await browserFeedback.annotate(mark.id, { mode: mark.mode, ...mark.rect, coordinateSpace: 'ratio' })
    if (!result.success)
      throw new Error(result.error.message, { cause: result.error })
    refreshAttachments()
  }
  async function capturePage(id?: string) {
    const result = await browserFeedback.captureScreenshot(id)
    if (!result.success)
      throw new Error(result.error.message, { cause: result.error })
    draft = browserFeedback.getDraft()
    refreshAttachments()
  }
  async function addFiles(files: File[], removedAttachmentIds: readonly string[] = []) {
    const result = await browserFeedback.addFiles(files, removedAttachmentIds)
    if (!result.success)
      throw new Error(result.error.message, { cause: result.error })
    draft = browserFeedback.getDraft()
    refreshAttachments()
  }
  async function exportLocal(data: FeedbackFormData) {
    const result = await browserFeedback.saveDraft(input(data))
    if (!result.success)
      throw new Error(result.error.message, { cause: result.error })
    return result.data.status !== 'cancelled'
  }
  onDestroy(browserFeedback.releasePreviews)
  useToastFeedback(() => error)
</script>

<Button variant='ghost' size='sm' loading={preparing} onclick={() => void prepare()} data-testid='feedback-open'>{m.nav_feedback()}</Button>
<FeedbackModal bind:open {attachments} budget={browserFeedback.budget} resetKey={draft?.submissionId} onsubmit={submit} oncapture={capturePage} onannotate={annotate} onexport={exportLocal} onfileschange={addFiles}
  evidence={draft?.evidence ?? []}
  evidenceSummary={draft?.missing.length ? [{ label: m.feedback_logs(), status: 'partial', detail: draft.missing.join(', ') }] : []} />
{{/if}}
