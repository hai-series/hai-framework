{{! @skipIfEmpty }}
{{#if features.feedback}}
<script lang='ts'>
  import { Button, FeedbackList, FeedbackModal, Modal } from '@h-ai/ui'
  import { myFeedbackActions, submitFeedback } from '../api/feedback-client.js'
  import * as m from '../paraglide/messages.js'

  const { canSubmit }: { canSubmit: boolean } = $props()
  let open = $state(false)
  let mine = $state(false)
  let selected = $state<string>()

  function openMine(id?: string) {
    selected = id
    mine = true
  }
</script>

{#if canSubmit}
  <Button variant='ghost' size='sm' onclick={() => { open = true }} data-testid='feedback-open'>{m.nav_feedback()}</Button>
  <FeedbackModal bind:open onsubmit={submitFeedback} oncomplete={openMine} />
{/if}
<Button variant='ghost' size='sm' onclick={() => openMine()} data-testid='feedback-mine'>{m.feedback_mine()}</Button>
<Modal bind:open={mine} title={m.feedback_mine()} size='xl'>
  {#if mine}
    <FeedbackList actions={myFeedbackActions} initialId={selected} />
  {/if}
</Modal>
{{/if}}
