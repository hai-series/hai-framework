{{! @skipIfEmpty }}
{{#if features.feedback}}
import { createFeedbackClient, createFeedbackReview, saveFeedbackFile } from '@h-ai/feedback/client'
import { managementApi } from './api-client.js'

/** 仅装配共享采集器，不复制采集、脱敏、上传或离线打包逻辑。 */
export const browserFeedback = createFeedbackClient()
export const feedbackReview = createFeedbackReview(managementApi.feedback.reports)
export { feedbackDataBytes } from '@h-ai/feedback/client'

export async function initializeBrowserFeedback(metadata: { appVersion: string, buildId: string, commit: string }): Promise<void> {
  const result = await browserFeedback.init({
    appId: '{{projectName}}',
    ...metadata,
    screenshot: true,
    replay: true,
    persistDraft: false,
    actions: {
      policy: () => managementApi.feedback.reports.policy({}),
      submit: input => managementApi.feedback.reports.submit(input),
      appendEvidence: input => managementApi.feedback.reports.appendEvidence(input),
      completeCollection: input => managementApi.feedback.reports.completeCollection(input),
      upload: input => managementApi.feedback.attachments.upload(input),
    },
  })
  if (!result.success)
    throw new Error(result.error.message, { cause: result.error })
}

/** 下载的内容来自受权 API 或本地采集器；对象 URL 在发起后释放。 */
export async function downloadFeedback(bytes: Uint8Array, name: string, contentType = 'application/zip'): Promise<void> {
  const result = await saveFeedbackFile(bytes, name, contentType)
  if (!result.success)
    throw new Error(result.error.message, { cause: result.error })
}
{{/if}}
