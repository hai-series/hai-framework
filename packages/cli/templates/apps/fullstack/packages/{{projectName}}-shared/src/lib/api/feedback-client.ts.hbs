{{! @skipIfEmpty }}
{{#if features.feedback}}
import type { FeedbackViewActions } from '@h-ai/ui'
import { managementApi } from './api-client.js'

const { reports, attachments } = managementApi.feedback
const detail = {
  get: reports.get,
  listMessages: reports.listMessages,
  addMessage: reports.addMessage,
  getAttachment: attachments.get,
}

export const submitFeedback = reports.submit
export const myFeedbackActions: FeedbackViewActions = { ...detail, list: reports.listMine }
export const staffFeedbackActions: FeedbackViewActions = { ...detail, list: reports.list, setStatus: reports.setStatus }
{{/if}}
