{{! @skipIfEmpty }}
{{#if features.feedback}}
<script lang='ts'>
  import type { FeedbackDetail as Detail, FeedbackEvidenceInput, FeedbackReport } from '@h-ai/api-contract/feedback'
  import type { FeedbackEvidenceQuery, FeedbackListQuery, FeedbackReportView, FeedbackStatusChange } from '@h-ai/ui'
  import type { ManagementStore } from '../stores/management-store.svelte.js'
  import { PageHeader } from '@h-ai/ui/components/compounds/index'
  import { FeedbackDetail, FeedbackList } from '@h-ai/ui/components/scenes/app/index'
  import { onMount } from 'svelte'
  import { managementApi } from '../api/api-client.js'
  import { downloadFeedback, feedbackDataBytes, feedbackReview } from '../api/feedback-client.js'
  import * as m from '../paraglide/messages.js'

  const { store }: { store: ManagementStore } = $props()
  let page = $state({ items: [] as FeedbackReportView[], total: 0, page: 1, pageSize: 20 })
  let query = $state<FeedbackListQuery>({ page: 1, pageSize: 20 })
  let selected = $state<Detail>()
  let evidence = $state({ items: [] as FeedbackEvidenceInput[], total: 0, page: 1, pageSize: 20 })
  let loading = $state(false)
  let error = $state('')
  let requestVersion = 0
  let detailVersion = 0
  let imageUrls = $state<Record<string, string>>({})
  const permissions = $derived({ read: store.hasPermission('feedback:read'), process: store.hasPermission('feedback:process'), reopen: store.hasPermission('feedback:reopen'), export: store.hasPermission('feedback:export'), retry: store.hasPermission('feedback:process') })
  function view(report: FeedbackReport): FeedbackReportView {
    return { ...report, description: report.description || report.summary || '', appVersion: report.appVersion || '' }
  }
  async function load(next: FeedbackListQuery = query) {
    const version = ++requestVersion
    query = next
    loading = true
    error = ''
    try {
      const result = await managementApi.feedback.reports.list(next)
      if (!result.success)
        throw new Error(result.error.message)
      if (version === requestVersion)
        page = { ...result.data, items: result.data.items.map(view) }
    }
    catch (cause) {
      if (version === requestVersion)
        error = cause instanceof Error ? cause.message : m.operation_failed()
    }
    finally {
      if (version === requestVersion)
        loading = false
    }
  }
  async function loadEvidence(next: FeedbackEvidenceQuery = { page: 1, pageSize: 20 }) {
    if (!selected)
      return
    const id = selected.report.id
    const kind = next.kind as FeedbackEvidenceInput['kind'] | undefined
    const result = await managementApi.feedback.reports.getEvidence({ ...next, kind, id })
    if (!result.success)
      throw new Error(result.error.message)
    if (selected?.report.id === id)
      evidence = result.data
  }
  async function selectId(id: string) {
    const version = ++detailVersion
    const result = await managementApi.feedback.reports.get({ id })
    if (version !== detailVersion)
      return
    if (!result.success)
      throw new Error(result.error.message)
    selected = result.data
    await loadEvidence()
  }
  async function loadReplay() {
    const id = selected?.report.id
    if (!id)
      return []
    const result = await feedbackReview.loadReplay(id)
    if (!result.success)
      throw new Error(result.error.message)
    return result.data
  }
  async function select(report: FeedbackReportView) {
    await selectId(report.id)
  }
  function closeDetail() {
    detailVersion++
    selected = undefined
  }
  async function status(input: FeedbackStatusChange) {
    const result = await managementApi.feedback.reports.setStatus(input)
    if (!result.success)
      throw new Error(result.error.message)
    if (selected?.report.id === input.id)
      await select(view(result.data))
    await load()
  }
  async function retry(report: FeedbackReportView) {
    const retried = await feedbackReview.retryReport(report.id)
    if (!retried.success)
      throw new Error(retried.error.message)
    if (selected?.report.id === report.id)
      await select(report)
    await load()
  }
  async function exportBundle(report: FeedbackReportView) {
    const result = await feedbackReview.exportReport(report.id)
    if (!result.success)
      throw new Error(result.error.message)
  }
  async function attachment(id: string) {
    if (!selected)
      return
    const result = await managementApi.feedback.attachments.get({ id: selected.report.id, attachmentId: id })
    if (!result.success)
      throw new Error(result.error.message)
    if (result.data.contentType.startsWith('image/') || result.data.contentType.startsWith('video/')) {
      if (imageUrls[id])
        URL.revokeObjectURL(imageUrls[id])
      imageUrls = { ...imageUrls, [id]: URL.createObjectURL(new Blob([new Uint8Array(feedbackDataBytes(result.data)).buffer], { type: result.data.contentType })) }
    }
    else {
      await downloadFeedback(feedbackDataBytes(result.data), result.data.name, result.data.contentType)
    }
  }
  onMount(() => {
    let active = true
    void load().then(async () => {
      if (!active)
        return
      const id = new URL(location.href).searchParams.get('feedback')
      if (id)
        await selectId(id)
    }).catch((cause) => {
      if (active)
        error = cause instanceof Error ? cause.message : m.operation_failed()
    })
    return () => {
      active = false
      requestVersion++
      detailVersion++
      for (const url of Object.values(imageUrls)) {
        URL.revokeObjectURL(url)
      }
    }
  })
</script>

<section data-testid='feedback-page' class='flex min-h-0 flex-1 flex-col gap-3'>
  <PageHeader title={m.nav_feedback()} class='mb-0' />
  {#if selected}
    <FeedbackDetail report={view(selected.report)} webhook={selected.jobs.find(job => job.type === 'webhook')} {evidence} history={selected.history.map(item => ({ id: item.id, actorId: item.userId, fromStatus: item.from, toStatus: item.to, createdAt: item.timestamp, note: item.note }))} {permissions}
      attachments={selected.attachments.map(item => ({ ...item, mimeType: item.contentType, url: imageUrls[item.id] }))}
      onevidencequery={loadEvidence} onreplay={loadReplay} onstatus={status} onexport={exportBundle} onretry={retry}
      onattachment={item => attachment(item.id)} onclose={closeDetail} />
  {:else}
    <FeedbackList data={page} bind:query {permissions} {loading} {error} onquerychange={load} onview={select} onstatus={status} onexport={exportBundle} onretry={retry} />
  {/if}
</section>
{{/if}}
