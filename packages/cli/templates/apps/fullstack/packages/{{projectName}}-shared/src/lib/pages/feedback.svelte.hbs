{{! @skipIfEmpty }}
{{#if features.feedback}}
<script lang='ts'>
  import type { FeedbackDetail as Detail, FeedbackEvidenceInput, FeedbackReport } from '@h-ai/api-contract/feedback'
  import type { FeedbackEvidenceQuery, FeedbackListQuery, FeedbackReportView, FeedbackStatusChange } from '@h-ai/ui'
  import type { ManagementStore } from '../stores/management-store.svelte.js'
  import { feedback } from '@h-ai/feedback/client'
  import { FeedbackDetail, FeedbackList, PageHeader, ui } from '@h-ai/ui'
  import { onMount } from 'svelte'
  import { SvelteMap } from 'svelte/reactivity'
  import { managementApi } from '../api/api-client.js'
  import { downloadFeedback, feedbackReview } from '../api/feedback-client.js'
  import * as m from '../paraglide/messages.js'

  const { store }: { store: ManagementStore } = $props()
  let page = $state({
    items: [] as FeedbackReportView[],
    total: 0,
    page: 1,
    pageSize: 20,
  })
  let query = $state<FeedbackListQuery>({ page: 1, pageSize: 20 })
  let selected = $state<Detail>()
  let evidence = $state({
    items: [] as FeedbackEvidenceInput[],
    total: 0,
    page: 1,
    pageSize: 20,
  })
  let evidenceQuery = $state<FeedbackEvidenceQuery>({ page: 1, pageSize: 20 })
  let loading = $state(false)
  let detailLoading = $state(false)
  let error = $state('')
  let requestVersion = 0
  let detailVersion = 0
  let evidenceVersion = 0
  const previewUrls = new SvelteMap<string, string>()
  const permissions = $derived({
    read: store.hasPermission('feedback:read'),
    process: store.hasPermission('feedback:process'),
    reopen: store.hasPermission('feedback:reopen'),
    export: store.hasPermission('feedback:export'),
    retry: store.hasPermission('feedback:process'),
  })
  function view(report: FeedbackReport): FeedbackReportView {
    return { ...report, description: report.description || report.summary || '', appVersion: report.appVersion || '' }
  }
  async function load(next: FeedbackListQuery = query) {
    const version = ++requestVersion
    query = next
    loading = true
    error = ''
    try {
      const result = await managementApi.feedback.reports.list(next)
      if (!result.success)
        throw new Error(result.error.message, { cause: result.error })
      if (version === requestVersion) {
        page = {
          ...result.data,
          items: result.data.items.map(view),
        }
      }
    }
    catch (cause) {
      if (version === requestVersion)
        error = ui.errorMessage(cause, m.operation_failed())
    }
    finally {
      if (version === requestVersion)
        loading = false
    }
  }
  async function loadEvidence(next: FeedbackEvidenceQuery) {
    if (!selected)
      return
    const id = selected.report.id
    const reportVersion = detailVersion
    const version = ++evidenceVersion
    const kind = next.kind as FeedbackEvidenceInput['kind'] | undefined
    const result = await managementApi.feedback.reports.getEvidence({ ...next, kind, id })
    if (reportVersion !== detailVersion || version !== evidenceVersion || selected?.report.id !== id)
      return
    if (!result.success)
      throw new Error(result.error.message, { cause: result.error })
    evidence = result.data
  }
  async function selectId(id: string) {
    if (selected?.report.id !== id)
      closeDetail()
    const version = ++detailVersion
    detailLoading = true
    error = ''
    try {
      const result = await managementApi.feedback.reports.get({ id })
      if (version !== detailVersion)
        return
      if (!result.success)
        throw new Error(result.error.message, { cause: result.error })
      selected = result.data
      await loadEvidence(evidenceQuery)
    }
    catch (cause) {
      if (version === detailVersion)
        error = ui.errorMessage(cause, m.operation_failed())
    }
    finally {
      if (version === detailVersion)
        detailLoading = false
    }
  }
  async function loadReplay() {
    const id = selected?.report.id
    if (!id)
      return []
    const result = await feedbackReview.loadReplay(id)
    if (!result.success)
      throw new Error(result.error.message, { cause: result.error })
    return result.data
  }
  async function select(report: FeedbackReportView) {
    await selectId(report.id)
  }
  function closeDetail() {
    detailVersion++
    evidenceVersion++
    selected = undefined
    evidence = {
      items: [],
      total: 0,
      page: 1,
      pageSize: 20,
    }
    evidenceQuery = { page: 1, pageSize: 20 }
    detailLoading = false
    error = ''
    for (const url of previewUrls.values())
      URL.revokeObjectURL(url)
    previewUrls.clear()
  }
  async function status(input: FeedbackStatusChange) {
    const version = detailVersion
    const result = await managementApi.feedback.reports.setStatus(input)
    if (!result.success)
      throw new Error(result.error.message, { cause: result.error })
    if (version === detailVersion && selected?.report.id === input.id)
      await select(view(result.data))
    await load()
  }
  async function retry(report: FeedbackReportView) {
    const version = detailVersion
    const retried = await feedbackReview.retryReport(report.id)
    if (!retried.success)
      throw new Error(retried.error.message, { cause: retried.error })
    if (version === detailVersion && selected?.report.id === report.id)
      await select(report)
    await load()
  }
  async function exportBundle(report: FeedbackReportView) {
    const result = await feedbackReview.exportReport(report.id)
    if (!result.success)
      throw new Error(result.error.message, { cause: result.error })
  }
  async function attachment(id: string) {
    if (!selected)
      return
    const reportId = selected.report.id
    const version = detailVersion
    const result = await managementApi.feedback.attachments.get({ id: reportId, attachmentId: id })
    if (version !== detailVersion || selected?.report.id !== reportId)
      return
    if (!result.success)
      throw new Error(result.error.message, { cause: result.error })
    const bytes = feedback.dataBytes(result.data)
    if (result.data.contentType.startsWith('image/') || result.data.contentType.startsWith('video/')) {
      const previousUrl = previewUrls.get(id)
      if (previousUrl)
        URL.revokeObjectURL(previousUrl)
      previewUrls.set(id, URL.createObjectURL(new Blob([new Uint8Array(bytes).buffer], { type: result.data.contentType })))
    }
    else {
      await downloadFeedback(bytes, result.data.name, result.data.contentType)
    }
  }
  onMount(() => {
    let active = true
    void load().then(async () => {
      if (!active)
        return
      const id = new URL(location.href).searchParams.get('feedback')
      if (id)
        await selectId(id)
    }).catch((cause) => {
      if (active)
        error = ui.errorMessage(cause, m.operation_failed())
    })
    return () => {
      active = false
      requestVersion++
      closeDetail()
    }
  })
</script>

<section data-testid='feedback-page' class='flex min-h-0 flex-1 flex-col gap-3'>
  <PageHeader title={m.nav_feedback()} class='mb-0' />
  {#if selected}
    <FeedbackDetail report={view(selected.report)} webhook={selected.jobs.find(job => job.type === 'webhook')} {evidence} history={selected.history.map(item => ({
id: item.id,
actorId: item.userId,
fromStatus: item.from,
toStatus: item.to,
createdAt: item.timestamp,
note: item.note,
}))} {permissions}
      attachments={selected.attachments.map(item => ({
        ...item,
        mimeType: item.contentType,
        url: previewUrls.get(item.id),
      }))}
      loading={detailLoading} {error} bind:evidenceQuery
      onevidencequery={loadEvidence} onreplay={loadReplay} onstatus={status} onexport={exportBundle} onretry={retry}
      onattachment={item => attachment(item.id)} onclose={closeDetail} />
  {:else}
    <FeedbackList data={page} bind:query {permissions} loading={loading || detailLoading} {error} onquerychange={load} onview={select} onstatus={status} onexport={exportBundle} onretry={retry} />
  {/if}
</section>
{{/if}}
