import type { AdminUser } from '{{fullstack.contractPackageName}}'
import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
import { HashRouter } from '../src/lib/navigation/hash-router.svelte.js'
import * as m from '../src/lib/paraglide/messages.js'
import { ManagementStore } from '../src/lib/stores/management-store.svelte.js'

const api = vi.hoisted(() => ({
  initialize: vi.fn(),
  app: { info: vi.fn() },
  auth: { clear: vi.fn() },
  iam: { auth: { logout: vi.fn(), currentUser: vi.fn(), reauthenticate: vi.fn(), changePassword: vi.fn() } },
  admin: { users: { list: vi.fn(), resetPassword: vi.fn() }, audit: { list: vi.fn() } },
}))
vi.mock('../src/lib/api/api-client.js', () => ({
  managementApi: api,
  managementAuthActions: { reauthenticate: api.iam.auth.reauthenticate },
  initializeManagementApi: api.initialize,
  resolveAvatarUrl: (url: string | undefined) => url,
}))

const member = {
  id: 'member-id',
  username: 'member',
  accountStatus: 'active' as const,
  roles: ['user'],
  permissions: [],
  createdAt: '2026-01-01T00:00:00.000Z',
  updatedAt: '2026-01-01T00:00:00.000Z',
}
const administrator = { ...member, id: 'admin-id', username: 'admin', roles: ['admin'], permissions: ['app.users.manage', 'app.roles.manage'] }
const forbidden = { success: false, error: { code: 'test:forbidden', message: 'Forbidden', httpStatus: 403 } } as const

function deferred<T>() {
  let resolve!: (result: T) => void
  const promise = new Promise<T>((done) => {
    resolve = done
  })
  return { promise, resolve }
}

beforeEach(() => {
  vi.resetAllMocks()
  vi.stubGlobal('location', { hash: '#/users' })
  vi.stubGlobal('history', { replaceState: vi.fn(), pushState: vi.fn() })
  api.iam.auth.logout.mockResolvedValue({ success: true })
  api.iam.auth.currentUser.mockResolvedValue({ success: true, data: member })
})

afterEach(() => vi.unstubAllGlobals())

/** 会话测试使用真实路由状态，浏览器历史由 E2E 验证。 */
function createStore() {
  return new ManagementStore(new HashRouter(['../pages/users.svelte', '../pages/settings.svelte'], '/users'))
}

describe('management session and request ownership', () => {
  it('password validation explains missing current password and mismatched confirmation without a request', async () => {
    const store = createStore()
    store.user = member
    await store.changePassword({ newPassword: 'NewPassword123!', confirmPassword: 'NewPassword123!' })
    expect(store.error).toBe(m.password_current_required())
    await store.changePassword({ oldPassword: 'CurrentPassword123!', newPassword: 'NewPassword123!', confirmPassword: 'ＮewPassword123!' })
    expect(store.error).toBe(m.password_confirmation_mismatch())
    expect(api.iam.auth.changePassword).not.toHaveBeenCalled()
    expect(api.auth.clear).not.toHaveBeenCalled()
  })

  it.each(['hai:iam:002', 'hai:iam:034', 'hai:iam:999'])('password failures use safe messages and keep the active session: %s', async (code) => {
    api.iam.auth.changePassword.mockResolvedValueOnce({ success: false, error: { code, message: 'Private password or database detail', httpStatus: code === 'hai:iam:002' ? 401 : code === 'hai:iam:999' ? 500 : 400, traceId: 'password-failure' } })
    const store = createStore()
    store.user = member
    await store.changePassword({ oldPassword: 'CurrentPassword123!', newPassword: 'NewPassword123!', confirmPassword: 'NewPassword123!' })
    expect(store.error).toContain('traceId: password-failure')
    expect(store.error).not.toContain('Private')
    expect(store.error).not.toBe(m.session_expired())
    expect(store.user?.id).toBe(member.id)
    expect(api.auth.clear).not.toHaveBeenCalled()
    expect(api.iam.auth.changePassword).toHaveBeenCalledWith({ oldPassword: 'CurrentPassword123!', newPassword: 'NewPassword123!' })
  })

  it('an accepted password change clears local tokens only after the server confirms success', async () => {
    api.iam.auth.changePassword.mockResolvedValueOnce({ success: true, data: undefined })
    const store = createStore()
    store.user = member
    await store.changePassword({ oldPassword: 'CurrentPassword123!', newPassword: 'NewPassword123!', confirmPassword: 'NewPassword123!' })
    expect(api.auth.clear).toHaveBeenCalledOnce()
    expect(store.user).toBeNull()
  })

  it.each(['dormant', 'closed'] as const)('resetting another duty password preserves its %s state and the administrator session', async (accountStatus) => {
    const target: AdminUser = { ...member, roles: ['config_admin'], accountStatus, accountType: 'permanent', accountExpiresAt: null, lastLoginAt: null }
    api.admin.users.resetPassword.mockResolvedValueOnce({ success: true })
    const store = createStore()
    store.user = administrator
    store.users = [target]
    expect(await store.resetUserPassword(target, 'NewPassword123!')).toBe(true)
    expect(api.admin.users.resetPassword).toHaveBeenCalledWith({ id: target.id, newPassword: 'NewPassword123!' }, expect.objectContaining({ context: expect.any(Object) }))
    expect(store.users[0]?.accountStatus).toBe(accountStatus)
    expect(store.user?.id).toBe(administrator.id)
    expect(api.auth.clear).not.toHaveBeenCalled()
    expect(store.saving).toBe(false)
  })

  it('an unsuccessful self reset retains authentication and hides private server details', async () => {
    const target: AdminUser = { ...administrator, roles: ['admin'], accountType: 'permanent', accountExpiresAt: null, lastLoginAt: null }
    api.admin.users.resetPassword.mockResolvedValueOnce({ success: false, error: { code: 'hai:iam:999', httpStatus: 500, message: 'Private password reset detail', traceId: 'reset-failure' } })
    const store = createStore()
    store.user = administrator
    expect(await store.resetUserPassword(target, 'NewPassword123!')).toBe(false)
    expect(store.user?.id).toBe(administrator.id)
    expect(api.auth.clear).not.toHaveBeenCalled()
    expect(store.error).not.toContain('Private')
    expect(store.error).toContain('traceId: reset-failure')
  })

  it('a successful self reset clears local authentication after the server confirms revocation', async () => {
    const target: AdminUser = { ...administrator, roles: ['admin'], accountType: 'permanent', accountExpiresAt: null, lastLoginAt: null }
    const response = deferred<{ success: true }>()
    api.admin.users.resetPassword.mockReturnValueOnce(response.promise)
    const store = createStore()
    store.user = administrator
    const reset = store.resetUserPassword(target, 'NewPassword123!')
    expect(api.auth.clear).not.toHaveBeenCalled()
    expect(store.user?.id).toBe(administrator.id)
    response.resolve({ success: true })
    expect(await reset).toBe(true)
    expect(api.auth.clear).toHaveBeenCalledOnce()
    expect(store.user).toBeNull()
  })

  it('preserves the clock synchronization advice when application bootstrap is rejected', async () => {
    const message = 'Synchronize device and server clocks, then refresh to retry.'
    api.initialize.mockResolvedValueOnce({ success: true })
    api.app.info.mockResolvedValueOnce({ success: false, error: { code: 'hai:api-client:007', httpStatus: 400, message, cause: { transportCode: 'hai:crypto:071' } } })
    const store = createStore()
    await store.initialize({ baseUrl: 'https://api.example.test' })
    expect(store.error).toBe(message)
    expect(store.initializing).toBe(false)
    expect(api.iam.auth.currentUser).not.toHaveBeenCalled()
  })

  it('preserves useful validation advice instead of replacing it with a generic operation error', async () => {
    const message = 'Synchronize device and server clocks, then refresh to retry.'
    api.admin.users.list.mockResolvedValueOnce({ success: false, error: { code: 'hai:api-client:007', httpStatus: 400, message } })
    const store = createStore()
    store.user = administrator
    await store.loadUsers()
    expect(store.error).toBe(message)
    expect(store.loading).toBe(false)
  })
  it('ignores a previous administrator failure after logout and another user login', async () => {
    const oldRequest = deferred<typeof forbidden>()
    api.admin.users.list.mockReturnValueOnce(oldRequest.promise)
    const store = createStore()
    store.user = administrator
    const loading = store.loadUsers()
    await store.logout()
    await store.authenticated()
    oldRequest.resolve(forbidden)
    await loading
    expect(store.user?.id).toBe(member.id)
    expect(store.page).toBe('settings')
    expect(store.error).toBe('')
    expect(store.loading).toBe(false)
    expect(api.iam.auth.currentUser).toHaveBeenCalledTimes(1)
  })

  it('ignores an obsolete page failure after opening personal settings', async () => {
    const oldRequest = deferred<typeof forbidden>()
    api.admin.users.list.mockReturnValueOnce(oldRequest.promise)
    const store = createStore()
    store.user = administrator
    const loading = store.loadUsers()
    await store.navigate('settings')
    oldRequest.resolve(forbidden)
    await loading
    expect(store.user?.id).toBe(administrator.id)
    expect(store.page).toBe('settings')
    expect(store.error).toBe('')
    expect(store.loading).toBe(false)
    expect(api.iam.auth.currentUser).not.toHaveBeenCalled()
  })

  it('refreshes revoked roles once and clears administration data', async () => {
    api.admin.users.list.mockResolvedValueOnce(forbidden)
    const store = createStore()
    store.user = administrator
    store.roles = [{ id: 'role-id', code: 'admin', name: 'Administrator', userCount: 1 }]
    await store.loadUsers()
    expect(store.user?.roles).toEqual(['user'])
    expect(store.page).toBe('settings')
    expect(store.roles).toEqual([])
    expect(store.users).toEqual([])
    expect(store.loading).toBe(false)
    expect(store.error).toBe(m.forbidden())
    expect(api.iam.auth.currentUser).toHaveBeenCalledTimes(1)
  })

  it.each(['hai:iam:105', 'hai:common:100'])('keeps the page, original user and unsaved fields when an expired session request is cancelled: %s', async (code) => {
    api.admin.users.list.mockResolvedValueOnce({ success: false, error: { code, message: 'Expired', httpStatus: 401 } })
    const store = createStore()
    store.user = administrator
    store.businessNotice = 'Unsaved business input'
    await store.loadUsers()
    expect(store.user?.id).toBe(administrator.id)
    expect(store.businessNotice).toBe('Unsaved business input')
    expect(store.page).toBe('settings')
    expect(api.auth.clear).not.toHaveBeenCalled()
    expect(store.error).toBe(m.session_expired())
  })

  it('reports a connection failure when loading the authenticated user', async () => {
    api.iam.auth.currentUser.mockRejectedValueOnce(new Error('Connection unavailable'))
    const store = createStore()
    await store.authenticated()
    expect(store.error).toBe(m.network_error())
    expect(store.error).not.toBe(m.login_invalid())
    expect(store.saving).toBe(false)
    expect(api.iam.auth.currentUser).toHaveBeenCalledTimes(1)
  })
})

it('user paging and header sorting keep applied filters until Query submits drafts', async () => {
  api.admin.users.list.mockResolvedValue({ success: true, data: { items: [], total: 60, page: 1, pageSize: 20 } })
  const store = createStore()
  store.user = administrator
  store.usersSearch = 'applied'
  store.usersStatus = 'active'
  await store.queryUsers()
  store.usersSearch = 'draft'
  store.usersStatus = 'dormant'
  await store.loadUsers(2)
  expect(api.admin.users.list).toHaveBeenLastCalledWith(expect.objectContaining({ page: 2, search: 'applied', accountStatus: 'active' }))
  await store.sortUsers('username', 'asc')
  expect(api.admin.users.list).toHaveBeenLastCalledWith(expect.objectContaining({ page: 1, search: 'applied', accountStatus: 'active', sortBy: 'username', sortDirection: 'asc' }))
  await store.queryUsers()
  expect(api.admin.users.list).toHaveBeenLastCalledWith(expect.objectContaining({ search: 'draft', accountStatus: 'dormant' }))
})

it('audit paging and header sorting do not submit unfinished filter drafts', async () => {
  api.admin.audit.list.mockResolvedValue({ success: true, data: { items: [], stats: [], backupEnabled: false, total: 60, page: 1, pageSize: 20 } })
  const store = createStore()
  store.user = administrator
  store.auditResource = 'applied'
  await store.queryAudit()
  store.auditResource = 'draft'
  await store.loadAudit(2)
  expect(api.admin.audit.list).toHaveBeenLastCalledWith(expect.objectContaining({ page: 2, resource: 'applied' }))
  await store.sortAudit('action', 'asc')
  expect(api.admin.audit.list).toHaveBeenLastCalledWith(expect.objectContaining({ page: 1, resource: 'applied', sortBy: 'action', sortDirection: 'asc' }))
  await store.queryAudit()
  expect(api.admin.audit.list).toHaveBeenLastCalledWith(expect.objectContaining({ page: 1, resource: 'draft' }))
})
