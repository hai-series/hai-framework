# syntax=docker/dockerfile:1.7
FROM node:24-bookworm-slim AS build
ARG SQLITE_PREBUILD_MIRROR
ENV npm_config_better_sqlite3_binary_host_mirror=$SQLITE_PREBUILD_MIRROR
ARG HAI_DEPLOY_ENVIRONMENT=prod
ARG HAI_CORE_ENV=production
ENV HAI_DEPLOY_ENVIRONMENT=$HAI_DEPLOY_ENVIRONMENT
ENV HAI_CORE_ENV=$HAI_CORE_ENV

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV CI=true
WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@12.11.2 --activate
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id={{projectName}}-pnpm,target=/pnpm/store pnpm fetch
COPY . .
RUN --mount=type=cache,id={{projectName}}-pnpm,target=/pnpm/store pnpm install --offline --frozen-lockfile --ignore-scripts
RUN pnpm build

FROM build AS service-build

RUN if [ -d node_modules/better-sqlite3 ]; then cd node_modules/better-sqlite3; for attempt in 1 2 3; do node -e "require('node:child_process').execFileSync(process.execPath,[require.resolve('prebuild-install/bin.js'),'--verbose'],{stdio:'inherit'})" && break; [ "$attempt" = 3 ] && exit 1; sleep 3; done; fi
RUN --mount=type=cache,id={{projectName}}-pnpm,target=/pnpm/store pnpm pm deploy --filter {{fullstack.servPackageName}} --prod /prod/service

FROM node:24-bookworm-slim AS service
ARG HAI_DEPLOY_ENVIRONMENT=prod
ARG HAI_CORE_ENV=production

ENV NODE_ENV=production
ENV HAI_DEPLOY_ENVIRONMENT=$HAI_DEPLOY_ENVIRONMENT
ENV HAI_CORE_ENV=$HAI_CORE_ENV
ENV HOST=0.0.0.0
ENV PORT=3000
WORKDIR /app

COPY --from=service-build --chown=node:node /prod/service ./
RUN mkdir -p /app/data && chown node:node /app/data

USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/index.js"]

FROM service AS runtime-with-data

COPY --from=embedded-data --chown=node:node / /app/data/

FROM service AS runtime

{{#if fullstack.frontends.web}}
FROM nginxinc/nginx-unprivileged:1.29-alpine AS web

ENV PUBLIC_API_BASE=
ENV NGINX_ENVSUBST_FILTER=PUBLIC_API_BASE_BASE64
ENV NGINX_ENVSUBST_OUTPUT_DIR=/tmp/hai-runtime-config

RUN mkdir -p /tmp/hai-runtime-config
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --chmod=755 docker/19-runtime-config.envsh /docker-entrypoint.d/19-runtime-config.envsh
COPY docker/runtime-config.js.template /etc/nginx/templates/runtime-config.js.template
COPY --from=build /workspace/apps/{{projectName}}-web/dist /usr/share/nginx/html

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -Y off -q -O /dev/null http://127.0.0.1:8080/health || exit 1
{{/if}}
