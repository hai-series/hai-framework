{{! @skipIfEmpty }}
{{#if fullstack.frontends.app}}
import type { CapacitorConfig } from '@capacitor/cli'
import { resolve } from 'node:path'
import process from 'node:process'
import { resolveNativeName } from '../../scripts/native-name.mjs'

const envDir = resolve(process.cwd(), '../..')
const config: CapacitorConfig = {
  appId: 'com.hai.{{fullstack.nativeAppIdSegment}}.app',
  appName: resolveNativeName(envDir, resolve(envDir, 'packages/{{fullstack.servPackageName}}/config/_core.yml')),
  webDir: 'dist',
  server: process.env.NODE_ENV === 'production'
    ? undefined
    : {
      // 仅用于 Capacitor live reload 前端页面；API 地址由前端配置或 shared client 参数控制。
        url: process.env.CAPACITOR_SERVER_URL,
        cleartext: process.env.CAPACITOR_SERVER_URL?.startsWith('http://') ?? false,
      },
}
export default config
{{/if}}
