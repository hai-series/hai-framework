{{! @skipIfEmpty }}
{{#if fullstack.frontends.app}}
{
  "name": "{{projectName}}-app",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "paraglide:watch": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --watch",
    "dev": "vite dev --host 127.0.0.1 --port {{fullstack.ports.app}}",
    "build": "pnpm paraglide:compile && vite build",
    "package": "pnpm cap:sync",
    "deploy": "pnpm package",
    "preview": "vite preview --host 127.0.0.1 --port {{fullstack.ports.app}} --strictPort",
    "typecheck": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm paraglide:compile && svelte-kit sync && vitest run",
    "test:watch": "pnpm paraglide:compile && svelte-kit sync && vitest",
    "clean": "rimraf .svelte-kit build android ios .turbo src/lib/paraglide",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "pnpm build && cap sync",
    "cap:sync:android": "pnpm build && cap sync android",
    "cap:sync:ios": "pnpm build && cap sync ios",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "cap:run:android": "cap run android",
    "cap:run:ios": "cap run ios",
     "cap:build:android:debug": "pnpm build && cap sync android && cd android && gradlew.bat assembleDebug",
    "cap:build:android:release": "pnpm build && cap sync android && cap build android --androidreleasetype APK",
    "cap:build:ios": "pnpm build && cap sync ios && cap build ios"
  },
  "dependencies": {
    "@h-ai/api-client": "{{fullstack.versions.apiClient}}",
    "@h-ai/capacitor": "{{fullstack.versions.capacitor}}",
    "@h-ai/ui": "{{fullstack.versions.ui}}",
    "{{fullstack.contractPackageName}}": "workspace:*",
    "{{fullstack.sharedPackageName}}": "workspace:*"
  },
  "devDependencies": {
    "@antfu/eslint-config": "{{fullstack.versions.antfuEslintConfig}}",
    "@aparajita/capacitor-secure-storage": "{{fullstack.versions.capacitorSecureStorage}}",
    "@capacitor/android": "{{fullstack.versions.capacitorAndroid}}",
    "@capacitor/app": "{{fullstack.versions.capacitorApp}}",
    "@capacitor/camera": "{{fullstack.versions.capacitorCamera}}",
    "@capacitor/cli": "{{fullstack.versions.capacitorCli}}",
    "@capacitor/core": "{{fullstack.versions.capacitorCore}}",
    "@capacitor/device": "{{fullstack.versions.capacitorDevice}}",
    "@capacitor/ios": "{{fullstack.versions.capacitorIos}}",
    "@capacitor/preferences": "{{fullstack.versions.capacitorPreferences}}",
    "@capacitor/push-notifications": "{{fullstack.versions.capacitorPushNotifications}}",
    "@capacitor/status-bar": "{{fullstack.versions.capacitorStatusBar}}",
    "@iconify-json/tabler": "{{fullstack.versions.iconifyJsonTabler}}",
    "@iconify/tailwind4": "{{fullstack.versions.iconifyTailwind}}",
    "@inlang/paraglide-js": "{{fullstack.versions.inlangParaglide}}",
    "@inlang/plugin-message-format": "{{fullstack.versions.inlangMessageFormat}}",
    "@sveltejs/adapter-static": "{{fullstack.versions.adapterStatic}}",
    "@sveltejs/kit": "{{fullstack.versions.svelteKit}}",
    "@sveltejs/vite-plugin-svelte": "{{fullstack.versions.sveltePlugin}}",
    "@tailwindcss/vite": "{{fullstack.versions.tailwindcssVite}}",
    "bits-ui": "{{fullstack.versions.bitsUi}}",
    "daisyui": "{{fullstack.versions.daisyui}}",
    "eslint": "{{fullstack.versions.eslint}}",
    "eslint-plugin-format": "{{fullstack.versions.eslintPluginFormat}}",
    "eslint-plugin-svelte": "{{fullstack.versions.eslintPluginSvelte}}",
    "svelte": "{{fullstack.versions.svelte}}",
    "svelte-check": "{{fullstack.versions.svelteCheck}}",
    "svelte-eslint-parser": "{{fullstack.versions.svelteEslintParser}}",
    "tailwindcss": "{{fullstack.versions.tailwindcss}}",
    "typescript": "{{fullstack.versions.typescript}}",
    "vite": "{{fullstack.versions.vite}}",
    "vitest": "{{fullstack.versions.vitest}}"
  }
}
{{/if}}
