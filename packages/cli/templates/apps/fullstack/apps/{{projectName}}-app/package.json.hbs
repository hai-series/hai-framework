{{! @skipIfEmpty }}
{{#if fullstack.frontends.app}}
{
  "name": "{{projectName}}-app",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "paraglide:watch": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --watch",
    "dev": "vite dev --host 127.0.0.1 --port {{fullstack.ports.app}}",
    "build": "pnpm paraglide:compile && vite build",
    "package": "pnpm cap:sync",
    "deploy": "pnpm package",
    "preview": "vite preview --host 127.0.0.1 --port {{fullstack.ports.app}} --strictPort",
    "typecheck": "pnpm paraglide:compile && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm paraglide:compile && vitest run",
    "test:watch": "pnpm paraglide:compile && vitest",
    "clean": "rimraf dist build android ios .turbo src/lib/paraglide",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "pnpm build && cap sync",
    "cap:sync:android": "pnpm build && cap sync android",
    "cap:sync:ios": "pnpm build && cap sync ios",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "cap:run:android": "cap run android",
    "cap:run:ios": "cap run ios",
    "cap:build:android:debug": "pnpm build && cap sync android && cd android && gradlew.bat assembleDebug",
    "cap:build:android:release": "pnpm build && cap sync android && cap build android --androidreleasetype APK",
    "cap:build:ios": "pnpm build && cap sync ios && cap build ios"
  },
  "dependencies": {
    "@h-ai/capacitor": "{{haiPackageSpecifier}}",
    "@h-ai/ui": "{{haiPackageSpecifier}}",
    "{{fullstack.sharedPackageName}}": "workspace:*"
  },
  "devDependencies": {
    "@antfu/eslint-config": "{{fullstack.packageSpecifiers.antfuEslintConfig}}",
    "@aparajita/capacitor-secure-storage": "{{fullstack.packageSpecifiers.capacitorSecureStorage}}",
    "@capacitor/android": "{{fullstack.packageSpecifiers.capacitorAndroid}}",
    "@capacitor/app": "{{fullstack.packageSpecifiers.capacitorApp}}",
    "@capacitor/camera": "{{fullstack.packageSpecifiers.capacitorCamera}}",
    "@capacitor/cli": "{{fullstack.packageSpecifiers.capacitorCli}}",
    "@capacitor/core": "{{fullstack.packageSpecifiers.capacitorCore}}",
    "@capacitor/device": "{{fullstack.packageSpecifiers.capacitorDevice}}",
    "@capacitor/ios": "{{fullstack.packageSpecifiers.capacitorIos}}",
    "@capacitor/preferences": "{{fullstack.packageSpecifiers.capacitorPreferences}}",
    "@capacitor/push-notifications": "{{fullstack.packageSpecifiers.capacitorPushNotifications}}",
    "@capacitor/status-bar": "{{fullstack.packageSpecifiers.capacitorStatusBar}}",
    "@iconify-json/tabler": "{{fullstack.packageSpecifiers.iconifyJsonTabler}}",
    "@iconify/tailwind4": "{{fullstack.packageSpecifiers.iconifyTailwind}}",
    "@inlang/paraglide-js": "{{fullstack.packageSpecifiers.inlangParaglide}}",
    "@inlang/plugin-message-format": "{{fullstack.packageSpecifiers.inlangMessageFormat}}",
    "@sveltejs/vite-plugin-svelte": "{{fullstack.packageSpecifiers.sveltePlugin}}",
    "@tailwindcss/vite": "{{fullstack.packageSpecifiers.tailwindcssVite}}",
    "bits-ui": "{{fullstack.packageSpecifiers.bitsUi}}",
    "daisyui": "{{fullstack.packageSpecifiers.daisyui}}",
    "eslint": "{{fullstack.packageSpecifiers.eslint}}",
    "eslint-plugin-format": "{{fullstack.packageSpecifiers.eslintPluginFormat}}",
    "eslint-plugin-svelte": "{{fullstack.packageSpecifiers.eslintPluginSvelte}}",
    "svelte": "{{fullstack.packageSpecifiers.svelte}}",
    "svelte-check": "{{fullstack.packageSpecifiers.svelteCheck}}",
    "svelte-eslint-parser": "{{fullstack.packageSpecifiers.svelteEslintParser}}",
    "tailwindcss": "{{fullstack.packageSpecifiers.tailwindcss}}",
    "typescript": "{{fullstack.packageSpecifiers.typescript}}",
    "vite": "{{fullstack.packageSpecifiers.vite}}",
    "vitest": "{{fullstack.packageSpecifiers.vitest}}"
  }
}
{{/if}}
