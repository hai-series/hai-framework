{{! @skipIfEmpty }}
{{#if fullstack.frontends.app}}
import type { Plugin } from 'vite'
import process from 'node:process'
import { fileURLToPath } from 'node:url'
import { core } from '@h-ai/core'
import { haiOptimizeExclude, haiPrebundledDeps } from '@h-ai/ui/vite'
import { paraglideVitePlugin } from '@inlang/paraglide-js'
import { svelte } from '@sveltejs/vite-plugin-svelte'
import tailwindcss from '@tailwindcss/vite'
import { defineConfig } from 'vitest/config'
import { resolveBuildMetadata } from '../../scripts/build-metadata.js'

const envDir = fileURLToPath(new URL('../../', import.meta.url))

export default defineConfig(({ mode, command }) => {
  const envResult = command === 'build' || process.env.HAI_E2E === '1' ? { success: true as const, data: {} as Record<string, string> } : core.config.loadEnvFiles({ mode, envDir })
  if (!envResult.success)
    throw new Error(envResult.error.message)
  const env = envResult.data
  Object.assign(process.env, env)
  const buildMetadata = resolveBuildMetadata(fileURLToPath(new URL('.', import.meta.url)))
  const metadataAsset: Plugin = {
    name: 'hai-build-metadata',
    generateBundle() {
      this.emitFile({ type: 'asset', fileName: 'build-metadata.json', source: JSON.stringify(buildMetadata) })
    },
  }
  const target = (env.PUBLIC_API_BASE || process.env.SERVICE_BASE_URL || 'http://127.0.0.1:3000').replace(/\/api\/v1\/?$/, '')
  const proxy = { '/api': { target, changeOrigin: true } }
  return {
    base: './',
    envDir: false,
    define: { __HAI_BUILD_METADATA__: JSON.stringify(buildMetadata) },
    server: { proxy },
    preview: { proxy },
    build: {
      rolldownOptions: {
        output: {
          codeSplitting: {
            groups: [
              { name: 'vendor-ui', test: /node_modules\/(?:@h-ai\/ui|bits-ui|svelte)\// },
              { name: 'vendor-crypto', test: /node_modules\/(?:@h-ai\/(?:core|crypto)|sm-crypto(?:-v2)?)\// },
              { name: 'vendor-api', test: /node_modules\/(?:@orpc\/|zod\/)/ },
            ],
          },
        },
      },
    },
    plugins: [
      metadataAsset,
      svelte(),
      paraglideVitePlugin({
        project: './project.inlang',
        outdir: './src/lib/paraglide',
        strategy: ['cookie', 'baseLocale'],
      }),
      tailwindcss(),
    ],
    optimizeDeps: {
      exclude: [...haiOptimizeExclude],
      include: [...haiPrebundledDeps],
    },
    envPrefix: ['VITE_', 'PUBLIC_'],
    ssr: {
      noExternal: ['@h-ai/ui', /{{fullstack.sharedPackageName}}/],
    },
    test: {
      environment: 'node',
      include: ['tests/**/*.test.ts'],
    },
  }
})
{{/if}}
