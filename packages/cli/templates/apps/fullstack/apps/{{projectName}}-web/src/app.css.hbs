{{! @skipIfEmpty }}
{{#if fullstack.frontends.web}}
@import 'tailwindcss';
@import '@h-ai/ui/styles/global.css';
@import '@h-ai/ui/styles/theme.css';
@source "../node_modules/@h-ai/ui/dist/**/*.{svelte,js,ts}";
@source "../../../node_modules/@h-ai/ui/dist/**/*.{svelte,js,ts}";

@plugin "daisyui" {
  themes:
    light --default,
    dark --prefersdark,
    corporate,
    nord,
    winter,
    night,
    business;
}
@plugin "@iconify/tailwind4" {
  prefixes: tabler;
}
{{/if}}
