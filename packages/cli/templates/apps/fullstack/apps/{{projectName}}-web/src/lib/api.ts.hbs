{{! @skipIfEmpty }}
{{#if fullstack.frontends.web}}
import type { AppInfoOutputData } from '{{fullstack.contractPackageName}}'
import { apiClient } from '@h-ai/api-client'
import { APP_HTTP_ROUTES, {{fullstack.contractExportName}} } from '{{fullstack.contractPackageName}}'

export type AppInfo = AppInfoOutputData

const DEFAULT_API_ORIGIN = 'http://127.0.0.1:3000'

export async function fetchAppInfo(
  fetchFn: typeof fetch = fetch,
  baseUrl = resolveApiBaseUrl(),
): Promise<AppInfo> {
  const client = apiClient.create({{fullstack.contractExportName}})
  const init = await client.init({
    baseUrl: normalizeApiBaseUrl(baseUrl),
    clientName: '{{projectName}}-web',
    fetch: fetchFn,
  })
  if (!init.success) {
    throw new Error(init.error?.message ?? 'Failed to initialize API client')
  }

  try {
    const result = await client.app.info()
    if (!result.success) {
      throw new Error(result.error?.message ?? 'Failed to fetch app info')
    }
    return result.data
  }
  finally {
    await client.close()
  }
}

export function resolveApiBaseUrl(): string {
  const configured = import.meta.env.VITE_API_BASE_URL as string | undefined
  return normalizeApiBaseUrl(configured || DEFAULT_API_ORIGIN)
}

function normalizeApiBaseUrl(value: string): string {
  const trimmed = trimTrailingSlash(value)
  return trimmed.endsWith(APP_HTTP_ROUTES.apiPrefix)
    ? trimmed
    : `${trimmed}${APP_HTTP_ROUTES.apiPrefix}`
}

function trimTrailingSlash(value: string): string {
  return value.replace(/\/+$/, '')
}
{{/if}}
