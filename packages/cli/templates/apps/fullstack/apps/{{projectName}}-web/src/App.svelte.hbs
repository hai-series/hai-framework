{{! @skipIfEmpty }}
{{#if fullstack.frontends.web}}
<script lang="ts">
  import { AdminWorkspace } from '{{fullstack.sharedPackageName}}'
{{#if features.feedback}}
  import { buildMetadata } from './build-metadata.js'
{{/if}}
  import { setLocale } from './lib/paraglide/runtime.js'

  const apiOptions = { clientName: '{{projectName}}-web' }

  function syncLocale(locale: string) {
    setLocale(locale as Parameters<typeof setLocale>[0], { reload: false })
  }
</script>

<AdminWorkspace platform="web" {apiOptions}{{#if features.feedback}} {buildMetadata}{{/if}} onLocaleChange={syncLocale} />
{{/if}}
