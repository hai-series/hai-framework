{{! @skipIfEmpty }}
{{#if fullstack.frontends.desktop}}
<script lang="ts">
  import type { AppInfo } from '{{fullstack.sharedPackageName}}'
  import * as appM from './lib/paraglide/messages.js'
  import { setLocale } from './lib/paraglide/runtime.js'
  import { Alert, Button, Card, Skeleton } from '@h-ai/ui'
  import { onMount } from 'svelte'
  import { AppShell, fetchAppInfo, messages as sharedM } from '{{fullstack.sharedPackageName}}'

  let info = $state<AppInfo | null>(null)
  let loading = $state(true)
  let errorMessage = $state('')

  function syncLocale(locale: string) {
    setLocale(locale as Parameters<typeof setLocale>[0])
  }

  async function refreshStatus() {
    loading = true
    errorMessage = ''
    try {
      info = await fetchAppInfo({ clientName: '{{projectName}}-desktop' })
    }
    catch {
      info = null
      errorMessage = sharedM.home_error()
    }
    finally {
      loading = false
    }
  }

  onMount(() => {
    document.title = appM.page_title({ name: sharedM.app_name() })
    void refreshStatus()
  })
</script>

<AppShell platform="desktop" onLocaleChange={syncLocale}>
  <section class="space-y-8">
    <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
      <section class="relative overflow-hidden rounded-[1.5rem] border border-base-300/70 bg-base-100 p-6 shadow-xl lg:p-10">
        <div class="max-w-2xl space-y-6">
          <span class="badge badge-primary badge-lg gap-2">
            <span class="icon-[tabler--device-desktop] size-4"></span>
            {appM.hero_badge()}
          </span>
          <div class="space-y-4">
            <h1 class="text-4xl font-black tracking-tight text-base-content sm:text-5xl">
              {appM.hero_title({ name: sharedM.app_name() })}
            </h1>
            <p class="max-w-xl text-lg leading-8 text-base-content/70">
              {appM.hero_subtitle()}
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a class="btn btn-primary" href="#status">
              <span class="icon-[tabler--activity-heartbeat] size-5"></span>
              {appM.hero_primary_action()}
            </a>
            <a class="btn btn-ghost" href="#customize">
              <span class="icon-[tabler--adjustments] size-5"></span>
              {appM.hero_secondary_action()}
            </a>
          </div>
        </div>
      </section>

      <aside class="rounded-[1.5rem] border border-base-300/70 bg-base-100 p-5 shadow-lg">
        <div class="mockup-window border border-base-300 bg-base-200/70">
          <div class="space-y-4 bg-base-100 p-5">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-semibold">{appM.preview_title()}</p>
                <p class="text-xs text-base-content/55">{appM.preview_body()}</p>
              </div>
              <span class="badge badge-success badge-outline">{appM.platform_name()}</span>
            </div>
            <div class="grid gap-3 text-sm">
              <div class="rounded-2xl bg-primary/10 p-4">
                <span class="icon-[tabler--components] mb-2 size-6 text-primary"></span>
                <p class="font-semibold">{appM.preview_metric_shared()}</p>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div class="rounded-2xl bg-secondary/10 p-4">
                  <span class="icon-[tabler--language] mb-2 size-6 text-secondary"></span>
                  <p class="font-semibold">{appM.preview_metric_local()}</p>
                </div>
                <div class="rounded-2xl bg-accent/10 p-4">
                  <span class="icon-[tabler--palette] mb-2 size-6 text-accent"></span>
                  <p class="font-semibold">{appM.preview_metric_theme()}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
      <div id="status">
        <Card title={appM.status_title()} bordered shadow="md" class="bg-base-100">
          <p class="mb-5 text-sm text-base-content/65">{appM.status_description()}</p>
          {#if loading}
            <Skeleton variant="title" class="mb-3" />
            <Skeleton count={3} />
            <p class="sr-only" data-testid="service-status">{sharedM.home_loading()}</p>
          {:else if info}
            <Alert variant="success" title={appM.status_online({ name: info.name })}>
              <p data-testid="service-status">{info.name}</p>
            </Alert>
            <dl class="mt-5 grid gap-3 text-sm sm:grid-cols-2">
              <div class="rounded-box border border-base-300/70 bg-base-200/60 p-4">
                <dt class="text-xs text-base-content/55">{appM.status_version()}</dt>
                <dd class="mt-1 font-semibold">{info.version}</dd>
              </div>
              <div class="rounded-box border border-base-300/70 bg-base-200/60 p-4">
                <dt class="text-xs text-base-content/55">{appM.status_started({ time: info.startedAt })}</dt>
                <dd class="mt-1 font-semibold">{appM.status_frontends_count({ count: String(info.frontends.length) })}</dd>
              </div>
            </dl>
          {:else}
            <Alert variant="error" title={sharedM.home_error()}>
              <p data-testid="service-status">{errorMessage}</p>
            </Alert>
          {/if}

          <div class="mt-5">
            <Button type="button" variant="primary" loading={loading} onclick={refreshStatus}>
              {sharedM.home_refresh()}
            </Button>
          </div>
        </Card>
      </div>

      <section id="customize" class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-[1.5rem] border border-base-300/70 bg-base-100 p-5 shadow-md">
          <span class="icon-[tabler--package] mb-4 size-7 text-primary"></span>
          <h2 class="text-lg font-bold">{appM.custom_shared_title()}</h2>
          <p class="mt-2 text-sm leading-6 text-base-content/65">{appM.custom_shared_body()}</p>
        </div>
        <div class="rounded-[1.5rem] border border-base-300/70 bg-base-100 p-5 shadow-md">
          <span class="icon-[tabler--message-language] mb-4 size-7 text-secondary"></span>
          <h2 class="text-lg font-bold">{appM.custom_local_title()}</h2>
          <p class="mt-2 text-sm leading-6 text-base-content/65">{appM.custom_local_body()}</p>
        </div>
      </section>
    </div>
  </section>
</AppShell>
{{/if}}
