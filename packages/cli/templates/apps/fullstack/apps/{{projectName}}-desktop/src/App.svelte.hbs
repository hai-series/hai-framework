{{! @skipIfEmpty }}
{{#if fullstack.frontends.desktop}}
<script lang="ts">
  import type { ManagementApiOptions } from '{{fullstack.sharedPackageName}}'
  import { apiClient } from '@h-ai/api-client'
  import { AdminWorkspace } from '{{fullstack.sharedPackageName}}'
{{#if features.feedback}}
  import { buildMetadata } from './build-metadata.js'
{{/if}}
  import { setLocale } from './lib/paraglide/runtime.js'

  const native = '__TAURI_INTERNALS__' in globalThis
  const apiOptions: ManagementApiOptions = {
    clientName: '{{projectName}}-desktop',
      terminalType: 'desktop',
    ...(native ? { requireApiBase: true, tokenStorage: apiClient.tokenStorage.memory(), headers: { 'X-HAI-Token-Transport': 'body' } } : {}),
  }

  function syncLocale(locale: string) {
    setLocale(locale as Parameters<typeof setLocale>[0], { reload: false })
  }
</script>

<AdminWorkspace platform="desktop" {apiOptions}{{#if features.feedback}} {buildMetadata}{{/if}} onLocaleChange={syncLocale} />
{{/if}}
