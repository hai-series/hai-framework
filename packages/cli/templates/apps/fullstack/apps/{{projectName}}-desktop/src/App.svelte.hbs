{{! @skipIfEmpty }}
{{#if fullstack.frontends.desktop}}
<script lang="ts">
  import type { ManagementApiOptions } from '{{fullstack.sharedPackageName}}'
  import type { DesktopUpdateMessage } from './lib/desktop-update/DesktopUpdateEntry.svelte'
  import { apiClient } from '@h-ai/api-client'
  import { AdminWorkspace } from '{{fullstack.sharedPackageName}}'
  import DesktopUpdateEntry from './lib/desktop-update/DesktopUpdateEntry.svelte'
  import * as m from './lib/paraglide/messages.js'
  import { getLocale, setLocale } from './lib/paraglide/runtime.js'

  const native = '__TAURI_INTERNALS__' in globalThis
  const apiOptions: ManagementApiOptions = {
    clientName: '{{projectName}}-desktop',
    terminalType: 'desktop',
    ...(native
      ? {
        requireApiBase: true,
        tokenStorage: apiClient.tokenStorage.memory(),
        headers: { 'X-HAI-Token-Transport': 'body' },
      }
      : {}),
  }

  let desktopLocale = $state(getLocale())
  function syncLocale(locale: string) {
    desktopLocale = locale as Parameters<typeof setLocale>[0]
    setLocale(desktopLocale, { reload: false })
  }

  function updateMessage(key: DesktopUpdateMessage): string {
    return m[key]({}, { locale: desktopLocale })
  }
</script>

<AdminWorkspace platform="desktop" {apiOptions} onLocaleChange={syncLocale} />
<DesktopUpdateEntry message={updateMessage} />
{{/if}}
