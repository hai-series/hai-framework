{{! @skipIfEmpty }}
{{#if fullstack.frontends.desktop}}
{
  "name": "{{projectName}}-desktop",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "paraglide:watch": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --watch",
    "dev": "vite dev --host 127.0.0.1 --port {{fullstack.ports.desktop}}",
    "build": "pnpm paraglide:compile && vite build",
    "package": "pnpm tauri:build",
    "deploy": "pnpm package",
    "preview": "vite preview --host 127.0.0.1 --port {{fullstack.ports.desktop}} --strictPort",
    "typecheck": "pnpm paraglide:compile && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src tests vite.config.ts svelte.config.js",
    "lint:fix": "eslint src tests vite.config.ts svelte.config.js --fix",
    "test": "pnpm paraglide:compile && vitest run",
    "test:watch": "pnpm paraglide:compile && vitest",
    "clean": "rimraf dist .turbo src-tauri/target src/lib/paraglide",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@h-ai/ui": "{{haiPackageSpecifier}}",
    "{{fullstack.sharedPackageName}}": "workspace:*"
  },
  "devDependencies": {
    "@antfu/eslint-config": "{{fullstack.packageSpecifiers.antfuEslintConfig}}",
    "@iconify-json/tabler": "{{fullstack.packageSpecifiers.iconifyJsonTabler}}",
    "@iconify/tailwind4": "{{fullstack.packageSpecifiers.iconifyTailwind}}",
    "@inlang/paraglide-js": "{{fullstack.packageSpecifiers.inlangParaglide}}",
    "@inlang/plugin-message-format": "{{fullstack.packageSpecifiers.inlangMessageFormat}}",
    "@sveltejs/vite-plugin-svelte": "{{fullstack.packageSpecifiers.sveltePlugin}}",
    "@tailwindcss/vite": "{{fullstack.packageSpecifiers.tailwindcssVite}}",
    "@tauri-apps/cli": "{{fullstack.packageSpecifiers.tauriCli}}",
    "bits-ui": "{{fullstack.packageSpecifiers.bitsUi}}",
    "daisyui": "{{fullstack.packageSpecifiers.daisyui}}",
    "eslint": "{{fullstack.packageSpecifiers.eslint}}",
    "eslint-plugin-format": "{{fullstack.packageSpecifiers.eslintPluginFormat}}",
    "eslint-plugin-svelte": "{{fullstack.packageSpecifiers.eslintPluginSvelte}}",
    "svelte": "{{fullstack.packageSpecifiers.svelte}}",
    "svelte-check": "{{fullstack.packageSpecifiers.svelteCheck}}",
    "svelte-eslint-parser": "{{fullstack.packageSpecifiers.svelteEslintParser}}",
    "tailwindcss": "{{fullstack.packageSpecifiers.tailwindcss}}",
    "typescript": "{{fullstack.packageSpecifiers.typescript}}",
    "vite": "{{fullstack.packageSpecifiers.vite}}",
    "vitest": "{{fullstack.packageSpecifiers.vitest}}"
  }
}
{{/if}}
