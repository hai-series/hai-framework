{
  "name": "{{projectName}}",
  "version": "0.1.0-alpha.29",
  "private": true,
  "description": "{{#if_eq appType 'admin'}}Enterprise management system built with hai Agent Framework{{/if_eq}}{{#if_eq appType 'website'}}Enterprise website built with hai Agent Framework{{/if_eq}}{{#if_eq appType 'h5'}}Mobile H5 app built with hai Agent Framework{{/if_eq}}{{#if_eq appType 'api'}}REST API service built with hai Agent Framework{{/if_eq}}{{#if_eq appType 'mobile-app'}}Mobile app built with hai Agent Framework{{/if_eq}}",
  "keywords": ["hai", {{#unless isSvelteOnlyApp}}"sveltekit", {{/unless}}"svelte5", "{{appType}}"],
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
{{#if hasI18n}}
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
{{/if}}
    "dev": "vite dev",
    "build": "{{#if hasI18n}}pnpm paraglide:compile && {{/if}}vite build",
    "preview": "vite preview",
    "check": "{{#if hasI18n}}pnpm paraglide:compile && {{/if}}{{#if isSvelteOnlyApp}}svelte-check --tsconfig ./tsconfig.json{{else}}svelte-kit sync && svelte-check --tsconfig ./tsconfig.json{{/if}}",
    "typecheck": "{{#if hasI18n}}pnpm paraglide:compile && {{/if}}{{#if isSvelteOnlyApp}}svelte-check --tsconfig ./tsconfig.json{{else}}svelte-kit sync && svelte-check --tsconfig ./tsconfig.json{{/if}}",
    "lint": "eslint .",
    "test": "{{#if hasI18n}}pnpm paraglide:compile && {{/if}}vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "clean": "{{#if isSvelteOnlyApp}}rimraf dist build android ios .turbo src/lib/paraglide{{else}}rimraf .svelte-kit build .turbo{{/if}}"{{#if isCapacitorApp}},
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "pnpm build && cap sync",
    "cap:sync:android": "pnpm build && cap sync android",
    "cap:sync:ios": "pnpm build && cap sync ios",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "cap:run:android": "cap run android",
    "cap:run:ios": "cap run ios",
    "cap:build:android:debug": "pnpm build && cap sync android && cd android && gradlew.bat assembleDebug",
    "cap:build:android:release": "pnpm build && cap sync android && cap build android --androidreleasetype APK",
    "cap:build:ios": "pnpm build && cap sync ios && cap build ios"{{/if}}
  },
  "dependencies": {
  {{#if isSvelteOnlyApp}}
    "@h-ai/api-client": "{{haiPackageSpecifier}}",
    "@h-ai/capacitor": "{{haiPackageSpecifier}}",
    "@h-ai/ui": "{{haiPackageSpecifier}}"
  {{else}}
    "@h-ai/core": "{{haiPackageSpecifier}}",
    "@h-ai/kit": "{{haiPackageSpecifier}}"{{#if hasUi}},
    "@h-ai/ui": "{{haiPackageSpecifier}}"{{/if}}{{#if features.db}},
    "@h-ai/reldb": "{{haiPackageSpecifier}}"{{/if}}{{#if features.cache}},
    "@h-ai/cache": "{{haiPackageSpecifier}}"{{/if}}{{#if features.iam}},
    "@h-ai/iam": "{{haiPackageSpecifier}}"{{/if}}{{#if features.crypto}},
    "@h-ai/crypto": "{{haiPackageSpecifier}}"{{/if}}{{#if features.storage}},
    "@h-ai/storage": "{{haiPackageSpecifier}}"{{/if}}{{#if features.ai}},
    "@h-ai/ai": "{{haiPackageSpecifier}}"{{/if}}{{#if features.audit}},
    "@h-ai/audit": "{{haiPackageSpecifier}}"{{/if}}{{#if features.reach}},
    "@h-ai/reach": "{{haiPackageSpecifier}}"{{/if}}{{#if features.payment}},
    "@h-ai/payment": "{{haiPackageSpecifier}}"{{/if}}{{#if features.vecdb}},
    "@h-ai/vecdb": "{{haiPackageSpecifier}}"{{/if}}{{#if features.datapipe}},
    "@h-ai/datapipe": "{{haiPackageSpecifier}}"{{/if}}{{#if features.scheduler}},
    "@h-ai/scheduler": "{{haiPackageSpecifier}}"{{/if}}{{#if features.deploy}},
    "@h-ai/deploy": "{{haiPackageSpecifier}}"{{/if}}{{#if features.api-client}},
    "@h-ai/api-client": "{{haiPackageSpecifier}}"{{/if}}{{#if features.capacitor}},
    "@h-ai/capacitor": "{{haiPackageSpecifier}}"{{/if}}{{#if isCapacitorApp}}{{#unless features.api-client}},
    "@h-ai/api-client": "{{haiPackageSpecifier}}"{{/unless}}{{#unless features.capacitor}},
    "@h-ai/capacitor": "{{haiPackageSpecifier}}"{{/unless}}{{/if}},
    "zod": "^4.4.3"
{{/if}}
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@playwright/test": "^1.60.0",
{{#if isCapacitorApp}}
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/camera": "^8.0.1",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/android": "^8.3.4",
    "@capacitor/device": "^8.0.1",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
{{else}}
{{#if_eq appType 'api'}}
    "@sveltejs/adapter-node": "^5.5.4",
{{else}}
    "@sveltejs/adapter-auto": "^7.0.1",
{{/if_eq}}
{{/if}}
{{#unless isSvelteOnlyApp}}
    "@sveltejs/kit": "^2.61.1",
{{/unless}}
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-svelte": "^3.17.1",
    "rimraf": "^6.1.3",
    "svelte": "^5.55.9",
    "svelte-check": "^4.4.8",
    "svelte-eslint-parser": "^1.6.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"{{#if hasUi}},
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "daisyui": "^5.5.20",
    "@iconify-json/tabler": "^1.2.35",
    "@iconify/tailwind4": "^1.2.3"{{/if}}{{#if hasI18n}},
    "@inlang/paraglide-js": "^2.18.1",
    "@inlang/plugin-message-format": "^4.4.0"{{/if}}
  }{{#if features.db}},
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  }{{/if}}
}
