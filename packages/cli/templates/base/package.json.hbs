{
  "engines": { "node": "^22.23.4 || ^24.22.1 || ^26.12.1" },
  "name": "{{projectName}}",
  "version": "0.1.0-alpha.76",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "description": "{{#if_eq appType 'admin'}}Enterprise management system built with hai Agent Framework{{/if_eq}}{{#if_eq appType 'website'}}Enterprise website built with hai Agent Framework{{/if_eq}}{{#if_eq appType 'h5'}}Mobile H5 app built with hai Agent Framework{{/if_eq}}{{#if_eq appType 'api'}}REST API service built with hai Agent Framework{{/if_eq}}{{#if_eq appType 'mobile-app'}}Mobile app built with hai Agent Framework{{/if_eq}}",
  "keywords": ["hai", {{#unless isSvelteOnlyApp}}"sveltekit", {{/unless}}"svelte5", "{{appType}}"],
  "license": "Apache-2.0",
  "type": "module",
{{#unless isSvelteOnlyApp}}
  "files": [
    "build",
    "config",
    "data",
    "package.json"
  ],
{{/unless}}
  "scripts": {
{{#if hasI18n}}
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
{{/if}}
    "dev": "vite dev",
    "dev:test": "vite dev --mode test",
    "dev:prod": "vite dev --mode prod",
    "compile": "{{#if hasI18n}}pnpm paraglide:compile && {{/if}}vite build",
    "build": "hai build",
{{#if features.deploy}}
    "deploy": "hai deploy",
{{/if}}
{{#unless isSvelteOnlyApp}}
    "start": "node --env-file=.env --env-file=.env.prod --env-file-if-exists=.env.local build/index.js",
    "start:test": "node --env-file=.env --env-file=.env.test --env-file-if-exists=.env.local build/index.js",
    "start:prod": "pnpm start",
{{/unless}}
    "preview": "vite preview",
    "check": "pnpm typecheck",
    "typecheck": "{{#if hasI18n}}pnpm paraglide:compile && {{/if}}{{#if isSvelteOnlyApp}}svelte-check --tsconfig ./tsconfig.json{{else}}svelte-kit sync && svelte-check --tsconfig ./tsconfig.json{{/if}}",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "{{#if hasI18n}}pnpm paraglide:compile && {{/if}}vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "clean": "{{#if isSvelteOnlyApp}}rimraf dist build android ios .turbo src/lib/paraglide{{else}}rimraf .svelte-kit build .turbo{{/if}}"{{#if isCapacitorApp}},
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "pnpm compile && cap sync",
    "cap:sync:android": "pnpm compile && cap sync android",
    "cap:sync:ios": "pnpm compile && cap sync ios",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "cap:run:android": "cap run android",
    "cap:run:ios": "cap run ios",
    "cap:build:android:debug": "pnpm compile && cap sync android && cd android && gradlew.bat assembleDebug",
    "cap:build:android:release": "pnpm compile && cap sync android && cap build android --androidreleasetype APK",
    "cap:build:ios": "pnpm compile && cap sync ios && cap build ios"{{/if}}
  },
  "dependencies": {
    "pino-pretty": "{{versions.pinoPretty}}",
  {{#if isSvelteOnlyApp}}
    "@h-ai/api-client": "{{haiPackageSpecifier}}",
    "@h-ai/capacitor": "{{haiPackageSpecifier}}",
{{#if features.crypto}}
    "@h-ai/crypto": "{{haiPackageSpecifier}}",
{{/if}}
    "@h-ai/ui": "{{haiPackageSpecifier}}"
  {{else}}
    "@h-ai/core": "{{haiPackageSpecifier}}",
    "@h-ai/kit": "{{haiPackageSpecifier}}"{{#if hasUi}},
    "@h-ai/ui": "{{haiPackageSpecifier}}"{{/if}}{{#if features.db}},
    "@h-ai/reldb": "{{haiPackageSpecifier}}"{{/if}}{{#if features.cache}},
    "@h-ai/cache": "{{haiPackageSpecifier}}"{{/if}}{{#if features.iam}},
    "@h-ai/iam": "{{haiPackageSpecifier}}"{{/if}}{{#if features.crypto}},
    "@h-ai/crypto": "{{haiPackageSpecifier}}"{{/if}}{{#if features.storage}},
    "@h-ai/storage": "{{haiPackageSpecifier}}"{{/if}}{{#if features.ai}},
    "@h-ai/ai": "{{haiPackageSpecifier}}"{{/if}}{{#if features.audit}},
    "@h-ai/audit": "{{haiPackageSpecifier}}"{{/if}}{{#if features.reach}},
    "@h-ai/reach": "{{haiPackageSpecifier}}"{{/if}}{{#if features.feedback}},
    "@h-ai/feedback": "{{haiPackageSpecifier}}"{{/if}}{{#if features.payment}},
    "@h-ai/payment": "{{haiPackageSpecifier}}"{{/if}}{{#if features.vecdb}},
    "@h-ai/vecdb": "{{haiPackageSpecifier}}"{{/if}}{{#if features.datapipe}},
    "@h-ai/datapipe": "{{haiPackageSpecifier}}"{{/if}}{{#if features.scheduler}},
    "@h-ai/scheduler": "{{haiPackageSpecifier}}"{{/if}}{{#if features.api-client}},
    "@h-ai/api-client": "{{haiPackageSpecifier}}"{{/if}}{{#if features.capacitor}},
    "@h-ai/capacitor": "{{haiPackageSpecifier}}"{{/if}}{{#if isCapacitorApp}}{{#unless features.api-client}},
    "@h-ai/api-client": "{{haiPackageSpecifier}}"{{/unless}}{{#unless features.capacitor}},
    "@h-ai/capacitor": "{{haiPackageSpecifier}}"{{/unless}}{{/if}},
    "sm-crypto": "0.5.7",
    "zod": "{{versions.zod}}"
{{/if}}
  },
  "devDependencies": {
{{#if features.deploy}}
    "@h-ai/deploy": "{{haiPackageSpecifier}}",
{{/if}}
    "@h-ai/cli": "{{haiPackageSpecifier}}",
{{#if isSvelteOnlyApp}}
    "@h-ai/core": "{{haiPackageSpecifier}}",
{{/if}}
    "@antfu/eslint-config": "{{versions.antfuEslintConfig}}",
    "@playwright/test": "{{versions.playwright}}",
{{#if isCapacitorApp}}
    "@aparajita/capacitor-secure-storage": "{{versions.capacitorSecureStorage}}",
    "@capacitor/app": "{{versions.capacitorApp}}",
    "@capacitor/camera": "{{versions.capacitorCamera}}",
    "@capacitor/cli": "{{versions.capacitorCli}}",
    "@capacitor/core": "{{versions.capacitorCore}}",
    "@capacitor/android": "{{versions.capacitorAndroid}}",
    "@capacitor/device": "{{versions.capacitorDevice}}",
    "@capacitor/ios": "{{versions.capacitorIos}}",
    "@capacitor/preferences": "{{versions.capacitorPreferences}}",
    "@capacitor/push-notifications": "{{versions.capacitorPushNotifications}}",
    "@capacitor/status-bar": "{{versions.capacitorStatusBar}}",
{{else}}
    "@sveltejs/adapter-node": "{{versions.svelteAdapterNode}}",
{{/if}}
{{#unless isSvelteOnlyApp}}
    "@sveltejs/kit": "{{versions.svelteKit}}",
{{/unless}}
    "@sveltejs/vite-plugin-svelte": "{{versions.sveltePlugin}}",
    "@types/node": "{{versions.nodeTypes}}",
    "eslint": "{{versions.eslint}}",
    "eslint-plugin-format": "{{versions.eslintPluginFormat}}",
    "eslint-plugin-svelte": "{{versions.eslintPluginSvelte}}",
    "rimraf": "{{versions.rimraf}}",
    "svelte": "{{versions.svelte}}",
    "svelte-check": "{{versions.svelteCheck}}",
    "svelte-eslint-parser": "{{versions.svelteEslintParser}}",
    "typescript": "{{versions.typescript}}",
    "vite": "{{versions.vite}}",
    "vitest": "{{versions.vitest}}"{{#if hasUi}},
    "@tailwindcss/vite": "{{versions.tailwindcssVite}}",
    "tailwindcss": "{{versions.tailwindcss}}",
    "daisyui": "{{versions.daisyui}}",
    "@iconify-json/tabler": "{{versions.iconifyJsonTabler}}",
    "@iconify/tailwind4": "{{versions.iconifyTailwind}}"{{/if}}{{#if hasI18n}},
    "@inlang/paraglide-js": "{{versions.inlangParaglide}}",
    "@inlang/plugin-message-format": "{{versions.inlangMessageFormat}}"{{/if}}
  }
}
