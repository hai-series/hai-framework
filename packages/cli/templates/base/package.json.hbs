{
  "name": "{{projectName}}",
  "version": "0.1.0-alpha.16",
  "private": true,
  "description": "{{#if_eq appType 'admin'}}Enterprise management system built with hai Agent Framework{{/if_eq}}{{#if_eq appType 'website'}}Enterprise website built with hai Agent Framework{{/if_eq}}{{#if_eq appType 'h5'}}Mobile H5 app built with hai Agent Framework{{/if_eq}}{{#if_eq appType 'api'}}REST API service built with hai Agent Framework{{/if_eq}}{{#if_eq appType 'android-app'}}Android app built with hai Agent Framework{{/if_eq}}",
  "keywords": ["hai", "sveltekit", "svelte5", "{{appType}}"],
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
{{#if hasI18n}}
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
{{/if}}
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "clean": "rimraf .svelte-kit build .turbo"
  },
  "dependencies": {
    "@h-ai/core": "^0.1.0-alpha.16",
    "@h-ai/kit": "^0.1.0-alpha.16"{{#if hasUi}},
    "@h-ai/ui": "^0.1.0-alpha.16"{{/if}}{{#if features.db}},
    "@h-ai/reldb": "^0.1.0-alpha.16"{{/if}}{{#if features.cache}},
    "@h-ai/cache": "^0.1.0-alpha.16"{{/if}}{{#if features.iam}},
    "@h-ai/iam": "^0.1.0-alpha.16"{{/if}}{{#if features.crypto}},
    "@h-ai/crypto": "^0.1.0-alpha.16"{{/if}}{{#if features.storage}},
    "@h-ai/storage": "^0.1.0-alpha.16"{{/if}}{{#if features.ai}},
    "@h-ai/ai": "^0.1.0-alpha.16"{{/if}}{{#if features.audit}},
    "@h-ai/audit": "^0.1.0-alpha.16"{{/if}}{{#if features.reach}},
    "@h-ai/reach": "^0.1.0-alpha.16"{{/if}}{{#if features.payment}},
    "@h-ai/payment": "^0.1.0-alpha.16"{{/if}}{{#if features.vecdb}},
    "@h-ai/vecdb": "^0.1.0-alpha.16"{{/if}}{{#if features.datapipe}},
    "@h-ai/datapipe": "^0.1.0-alpha.16"{{/if}}{{#if features.scheduler}},
    "@h-ai/scheduler": "^0.1.0-alpha.16"{{/if}}{{#if features.deploy}},
    "@h-ai/deploy": "^0.1.0-alpha.16"{{/if}}{{#if features.api-client}},
    "@h-ai/api-client": "^0.1.0-alpha.16"{{/if}}{{#if features.capacitor}},
    "@h-ai/capacitor": "^0.1.0-alpha.16"{{/if}}{{#if isCapacitorApp}}{{#unless features.api-client}},
    "@h-ai/api-client": "^0.1.0-alpha.16"{{/unless}}{{#unless features.capacitor}},
    "@h-ai/capacitor": "^0.1.0-alpha.16"{{/unless}}{{/if}},
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@playwright/test": "^1.60.0",
{{#if isCapacitorApp}}
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/android": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
{{else}}
{{#if_eq appType 'api'}}
    "@sveltejs/adapter-node": "^5.5.4",
{{else}}
    "@sveltejs/adapter-auto": "^7.0.1",
{{/if_eq}}
{{/if}}
    "@sveltejs/kit": "^2.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-svelte": "^3.17.1",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "svelte": "^5.55.9",
    "svelte-check": "^4.4.8",
    "svelte-eslint-parser": "^1.6.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"{{#if hasUi}},
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "daisyui": "^5.5.20",
    "@iconify-json/tabler": "^1.2.35",
    "@iconify/tailwind4": "^1.2.3"{{/if}}{{#if hasI18n}},
    "@inlang/paraglide-js": "^2.18.1",
    "@inlang/plugin-message-format": "^4.4.0"{{/if}}
  }{{#if features.db}},
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  }{{/if}}
}
