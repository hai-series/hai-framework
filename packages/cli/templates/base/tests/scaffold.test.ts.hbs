{{#unless isSvelteOnlyApp}}
import type { CoreConfig } from '@h-ai/core'
{{/unless}}
import { readFile } from 'node:fs/promises'
import { join } from 'node:path'
{{#unless isSvelteOnlyApp}}
import process from 'node:process'
{{/unless}}
import { fileURLToPath } from 'node:url'
{{#unless isSvelteOnlyApp}}
{{#if features.iam}}
import { cache } from '@h-ai/cache'
{{/if}}
import { core } from '@h-ai/core'
{{#if features.iam}}
import { iam } from '@h-ai/iam'
import { reldb } from '@h-ai/reldb'
{{/if}}
{{/unless}}
import { describe, expect, it } from 'vitest'
{{#unless isSvelteOnlyApp}}
import { load } from '../src/routes/+layout.server'
{{/unless}}

const rootDir = fileURLToPath(new URL('..', import.meta.url))

describe('generated scaffold', () => {
  it('declares project metadata and quality gate scripts', async () => {
    const packageJsonPath = join(rootDir, 'package.json')
    const pkg = JSON.parse(await readFile(packageJsonPath, 'utf-8')) as {
      name: string
      scripts: Record<string, string>
    }

    expect(pkg.name).toBe('{{projectName}}')
    expect(pkg.scripts.typecheck).toBeDefined()
    expect(pkg.scripts.lint).toBeDefined()
    expect(pkg.scripts.test).toBeDefined()
    expect(pkg.scripts['test:e2e']).toBeDefined()
  })

{{#if isSvelteOnlyApp}}
  it('renders the Vite app shell entry', async () => {
    const indexHtml = await readFile(join(rootDir, 'index.html'), 'utf-8')
    expect(indexHtml).toContain('<div id="app"></div>')
  })
{{else}}
  it('renders the app shell locale marker', async () => {
    const appHtml = await readFile(join(rootDir, 'src/app.html'), 'utf-8')
    expect(appHtml).toContain('lang="{{#if hasI18n}}{{#if isCapacitorApp}}{{defaultLocale}}{{else}}%lang%{{/if}}{{else}}{{defaultLocale}}{{/if}}"')
  })
{{/if}}
{{#unless isCapacitorApp}}

  it('ships an application config loaded at startup', async () => {
    const result = core.config.load<CoreConfig>('core', join(rootDir, 'config/_core.yml'))
    expect(result.success).toBe(true)
    if (!result.success)
      return
    expect(result.data.name).toBe(process.env.HAI_CORE_NAME ?? '{{projectName}}')
    expect(result.data.defaultLocale).toBe(process.env.HAI_CORE_DEFAULTLOCALE ?? '{{defaultLocale}}')
  })
{{/unless}}
{{#unless isSvelteOnlyApp}}

  it('publishes only public metadata from parsed core configuration', async () => {
    core.init({ configDir: './config' })
    const config = core.config.getOrThrow<CoreConfig>('core')
    expect(core.logger.getLevel()).toBe(config.logging?.level ?? 'info')
{{#if features.iam}}
    // 动态公开策略依赖已初始化的 IAM，使用隔离内存后端，不能用未等待的 Promise 冒充数据。
    try {
      const db = await reldb.init({ type: 'sqlite', database: ':memory:' })
      expect(db.success).toBe(true)
      const cached = await cache.init({ type: 'memory' })
      expect(cached.success).toBe(true)
      const initialized = await iam.init({ seedDefaultData: false })
      expect(initialized.success).toBe(true)
      const publicConfig = await iam.getPublicConfig()
      if (!publicConfig.success)
        throw new Error(publicConfig.error.message)
      expect(await load()).toEqual({
        iamPublicConfig: publicConfig.data,
        appConfig: { name: config.name, version: config.version, env: config.env, defaultLocale: config.defaultLocale },
      })
    }
    finally {
      await iam.close()
      await cache.close()
      await reldb.close()
    }
{{else}}
    expect(await load()).toEqual({
      appConfig: { name: config.name, version: config.version, env: config.env, defaultLocale: config.defaultLocale },
    })
{{/if}}
  })
{{/unless}}
})
