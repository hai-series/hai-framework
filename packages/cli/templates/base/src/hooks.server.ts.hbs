/**
 * =============================================================================
 * {{projectName}} - Server Hooks
 * =============================================================================
 */
{{#if features.crypto}}
import type { TransportEncryptionOptions } from '@h-ai/kit'
{{/if}}
import type { Handle, HandleServerError } from '@sveltejs/kit/hooks'
import process from 'node:process'
{{#if hasI18n}}
import { resolve as resolvePath } from '$app/paths'
{{else}}
{{#if features.iam}}
import { resolve as resolvePath } from '$app/paths'
{{else}}
{{#if features.crypto}}
import { resolve as resolvePath } from '$app/paths'
{{/if}}
{{/if}}
{{/if}}
{{#if features.ai}}{{#if features.iam}}
import { ai } from '@h-ai/ai'
{{/if}}{{/if}}
{{#if features.cache}}
import { cache } from '@h-ai/cache'
{{/if}}
import { core, HaiCommonError } from '@h-ai/core'
{{#if features.crypto}}
import { crypto } from '@h-ai/crypto'
{{/if}}
{{#if features.iam}}
import { iam } from '@h-ai/iam'
{{/if}}
import { kit } from '@h-ai/kit'
{{#if hasI18n}}
import { paraglideMiddleware } from '#lib/paraglide/server.js'
{{/if}}
import { closeApp, initApp } from '#lib/server/init.js'
import { getKitConfig } from '#lib/server/kit-config.js'

// =============================================================================
// 应用初始化
// =============================================================================

let appInitPromise: Promise<void> | null = null

// Node 适配器停止接收请求后释放模块，避免数据库或后台任务阻止进程退出。
process.once('sveltekit:shutdown', () => {
  void closeApp().catch((error: unknown) => {
    core.logger.error('Application shutdown failed', { error })
    process.exitCode = 1
  })
})

async function ensureAppInitialized() {
  if (!appInitPromise) {
    appInitPromise = initApp().catch((err: unknown) => {
      appInitPromise = null
      throw err
    })
  }
  await appInitPromise
}

// =============================================================================
// 初始化 Handle
// =============================================================================

const initHandle: Handle = async ({ event, resolve }) => {
  await ensureAppInitialized()
  return resolve(event)
}
{{#if hasI18n}}
// =============================================================================
// Paraglide i18n Middleware
// =============================================================================

/**
 * i18n Handle - 使用 Paraglide middleware 处理语言
 *
 * API 和 A2A 请求跳过页面路由本地化，保留协议路径与正文。
 */
const i18nHandle: Handle = async ({ event, resolve }) => {
  const a2a = getKitConfig().a2a
  const path = event.url.pathname
  if (path.startsWith(`${resolvePath('/').replace(/\/$/, '')}/api/`)
    || (a2a && (path === a2a.cardPath || path === a2a.rpcPath))) {
    const locale = event.cookies.get('PARAGLIDE_LOCALE') ?? '{{defaultLocale}}'
    event.locals.locale = locale
    return kit.i18n.runWithLocale(locale, () => resolve(event))
  }

  return paraglideMiddleware(event.request, async ({ locale }) => {
    event.locals.locale = locale
    return kit.i18n.runWithLocale(locale, () => resolve(event, {
      transformPageChunk: ({ html }) => html.replace('%lang%', locale),
    }))
  })
}
{{/if}}
// =============================================================================
// hai Handle（会话验证 + 限流 + 日志）
// =============================================================================

let configuredHandle: Handle | undefined
const haiHandle: Handle = async (input) => {
  if (!configuredHandle) {
    const settings = getKitConfig()
{{#if features.crypto}}
    let transport: TransportEncryptionOptions | undefined
    if (settings.transport !== false) {
      const ring = crypto.transport.parseServerKeyRing(process.env.HAI_CRYPTO_TRANSPORT_SERVERKEYRING)
      if (!ring.success)
        throw new Error(`HAI_CRYPTO_TRANSPORT_SERVERKEYRING: ${ring.error.message} (${ring.error.code})`)
      transport = {
        ...settings.transport,
        crypto,
        basePath: resolvePath('/').replace(/\/$/, ''),
        serverKeyRing: ring.data,
        keyStore: crypto.transport.createKeyStore({ cache }),
      }
    }
{{else}}
    if (settings.transport !== false)
      throw new Error('Transport encryption requires the crypto feature; add it before enabling kit.transport')
{{/if}}
    const { http } = settings
{{#unless features.cache}}
    if (http.rateLimit !== false)
      throw new Error('Kit http.rateLimit requires the cache feature; add it before enabling rate limiting')
{{/unless}}
    configuredHandle = kit.createHandle({
      cors: settings.cors,
{{#if features.ai}}{{#if features.iam}}
      a2a: settings.a2a && ai.a2a.createHttpHandler({
        ...settings.a2a,
        authenticate: {
          verifyApiKey: key => iam.apiKey.verifyApiKey(key),
        },
      }),
{{/if}}{{/if}}
      http: {
        ...http,
{{#if features.cache}}
        rateLimit: http.rateLimit && {
          ...http.rateLimit,
          store: core.access.createCacheRateLimitStore(cache, {
            namespace: '{{projectName}}',
            allowMemory: process.env.NODE_ENV !== 'production' || process.env.HAI_E2E === '1',
          }),
        },
{{else}}
        rateLimit: false,
{{/if}}
      },
{{#if features.crypto}}
      transport,
{{/if}}
{{#if features.iam}}
      auth: {
        iam,
        loginUrl: `${resolvePath('/').replace(/\/$/, '')}/auth/login`,
        protectedPaths: ['/admin/*', '/api/*'].map(path => `${resolvePath('/').replace(/\/$/, '')}${path}`),
        publicPaths: [
          ...kit.auth.publicPaths,
          '/api/auth/logout',
          '/api/public/*',
          '/api/health',
        ].map(path => `${resolvePath('/').replace(/\/$/, '')}${path}`),
      },
{{/if}}
      logging: { logBody: false },
      onError: (error: unknown, _event) => {
        core.logger.error('Request error:', { error })
        return new Response(
          JSON.stringify({
            success: false,
            error: core.error.toPublic({ code: 'INTERNAL_ERROR', message: '', httpStatus: 500 }),
          }),
          {
            status: 500,
            headers: { 'Content-Type': 'application/json' },
          },
        )
      },
    })
  }
  return configuredHandle(input)
}

// =============================================================================
// 组合 Handle
// =============================================================================

export const handle = kit.sequence(
  initHandle,
{{#if hasI18n}}
  i18nHandle,
{{/if}}
  haiHandle,
)

/** 初始化发生在 kit Handle 之前，未预期错误也须保留结构化根因和追踪编号。 */
export const handleError: HandleServerError = ({ kind, error, event }) => {
  if (kind !== 'unknown')
    return
  const publicError = core.error.toPublic({ ...HaiCommonError.INTERNAL_ERROR, message: '' }, event.locals.requestId, event.locals.locale)
  core.logger.error('Request failed', {
    module: '{{projectName}}',
    scope: 'hooks',
    method: event.request.method,
    route: event.route.id,
    traceId: publicError.traceId,
    error,
  })
  return {
    message: publicError.message,
    code: String(publicError.code),
  }
}
