{{! @skipIfEmpty }}
{{#if hasUi}}
/* ─── Tailwind CSS v4 ─── */
@import 'tailwindcss';

/* ─── @h-ai/ui 共享样式 ─── */
@import '@h-ai/ui/styles/global.css';
@import '@h-ai/ui/styles/theme.css';
@import '@h-ai/ui/styles/design-tokens.css';
@import '@h-ai/ui/styles/mobile.css';

/* ─── 扫描 @h-ai/ui 组件中使用的 Tailwind 类名 ─── */
@source "../node_modules/@h-ai/ui/dist/**/*.{svelte,js,ts}";
@source "../../../node_modules/@h-ai/ui/dist/**/*.{svelte,js,ts}";

/* ─── DaisyUI 主题 ─── */
@plugin "daisyui" {
  themes:
    light --default,
    dark --prefersdark,
    cupcake,
    emerald,
    corporate,
    nord,
    lofi,
    winter,
    dracula,
    night,
    dim,
    business,
    sunset,
    luxury,
    coffee;
}

/* ─── 图标 ─── */
@plugin "@iconify/tailwind4" {
  prefixes: tabler;
}
{{#if_eq appType 'admin'}}

@media not (prefers-reduced-transparency: reduce) {
  :where([data-theme='liquid-glass']) .admin-shell {
    background-color: rgb(247 250 255 / 0.16);
  }

  :where([data-theme='liquid-glass']) .admin-shell > :is(header, footer),
  :where([data-theme='liquid-glass']) .admin-shell :is(.drawer-side > nav, .hai-workspace > header) {
    background-color: var(--hai-glass-chrome-fill);
  }
}
{{/if_eq}}
{{/if}}
