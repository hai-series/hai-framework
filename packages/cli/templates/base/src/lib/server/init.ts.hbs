/** 应用声明真实模块顺序；并发、失败回滚与关闭重试由 core 处理。 */
{{#if features.ai}}
import { ai, AIConfigSchema } from '@h-ai/ai'
{{/if}}
{{#if features.audit}}
import { audit, AuditInitConfigSchema } from '@h-ai/audit'
{{/if}}
{{#if features.cache}}
import { cache, CacheConfigSchema } from '@h-ai/cache'
{{/if}}
import { core } from '@h-ai/core'
{{#if features.crypto}}
import { crypto } from '@h-ai/crypto'
{{/if}}
{{#if features.feedback}}
import { feedback, FeedbackConfigSchema } from '@h-ai/feedback'
{{/if}}
{{#if features.iam}}
import { iam, IamConfigSchema } from '@h-ai/iam'
{{/if}}
{{#if features.reach}}
import { reach, ReachConfigSchema } from '@h-ai/reach'
{{/if}}
{{#if features.db}}
import { reldb, ReldbConfigSchema } from '@h-ai/reldb'
{{/if}}
{{#if features.audit}}
{{#if features.scheduler}}
import { scheduler, SchedulerConfigSchema } from '@h-ai/scheduler'
{{/if}}
{{/if}}
{{#if features.storage}}
import { storage, StorageConfigSchema } from '@h-ai/storage'
{{/if}}
{{#if features.vecdb}}
import { vecdb, VecdbConfigSchema } from '@h-ai/vecdb'
{{/if}}
{{#if features.feedback}}
import { buildMetadata } from '../build-metadata.js'
{{/if}}

const runtime = core.module.createRuntime([
  { name: 'configuration', start: () => { core.init({ configDir: './config' }) }, close: () => {} },
{{#if features.db}}
  { name: 'reldb', start: async () => {
    const config = ReldbConfigSchema.parse(core.config.getOrThrow('db'))
    if (config.type === 'sqlite' && config.database !== ':memory:') {
      const { mkdir } = await import('node:fs/promises')
      const { dirname } = await import('node:path')
      await mkdir(dirname(config.database), { recursive: true })
    }
    return reldb.init(config)
  }, close: () => reldb.close() },
{{/if}}
{{#if features.cache}}
  { name: 'cache', start: () => cache.init(CacheConfigSchema.parse(core.config.getOrThrow('cache'))), close: () => cache.close() },
{{/if}}
{{#if features.vecdb}}
  { name: 'vecdb', start: () => vecdb.init(VecdbConfigSchema.parse(core.config.getOrThrow('vecdb'))), close: () => vecdb.close() },
{{/if}}
{{#if features.crypto}}
  { name: 'crypto', start: () => crypto.init(), close: () => crypto.close() },
{{/if}}
{{#if features.storage}}
  { name: 'storage', start: () => storage.init(StorageConfigSchema.parse(core.config.getOrThrow('storage'))), close: () => storage.close() },
{{/if}}
{{#if features.reach}}
  { name: 'reach', enabled: () => Boolean(core.config.get('reach')), start: () => reach.init(ReachConfigSchema.parse(core.config.getOrThrow('reach'))), close: () => reach.close() },
{{/if}}
{{#if features.audit}}
  { name: 'audit', start: () => audit.init({ ...AuditInitConfigSchema.parse(core.config.get('audit') ?? {}){{#if features.storage}}, storage{{/if}}{{#if features.reach}}, reach{{/if}} }), close: () => audit.close() },
{{/if}}
{{#if features.iam}}
  { name: 'iam', start: () => iam.init({ ...IamConfigSchema.parse(core.config.getOrThrow('iam')){{#if features.reach}}, reach{{/if}} }), close: () => iam.close() },
{{/if}}
{{#if features.audit}}
{{#if features.scheduler}}
  { name: 'audit-jobs', enabled: () => Boolean(audit.schedulerPlan), start: async () => {
    const schedule = audit.schedulerPlan
    if (!schedule)
      return
    const initialized = await scheduler.init({ ...SchedulerConfigSchema.parse(core.config.get('scheduler') ?? {}), ...schedule })
    if (!initialized.success)
      return initialized
    const started = scheduler.start()
    if (!started.success)
      await scheduler.close()
    return started
  }, close: () => scheduler.close() },
{{/if}}
{{/if}}
{{#if features.feedback}}
  { name: 'feedback', start: () => feedback.init({ ...FeedbackConfigSchema.parse(core.config.getOrThrow('feedback')), ...buildMetadata }), close: () => feedback.close() },
{{/if}}
{{#if features.ai}}
  { name: 'ai', start: () => ai.init(AIConfigSchema.parse(core.config.getOrThrow('ai'))), close: () => ai.close() },
{{/if}}
  { name: 'bootstrap', start: () => { core.logger.info('Application initialized') }, close: () => {} },
])

/** 启动失败只报告模块、错误码和配置路径，私密值不进入错误上下文。 */
export async function initApp(): Promise<void> {
  const result = await runtime.start()
  if (!result.success)
    throw new Error(result.error.message, { cause: result.error })
}

/** 清理失败时保留依赖和清理义务，可再次调用。 */
export async function closeApp(): Promise<void> {
  const result = await runtime.close()
  if (!result.success)
    throw new Error(result.error.message, { cause: result.error })
}
