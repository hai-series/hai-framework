# =============================================================================
# pnpm configuration
# =============================================================================

# Hoist all packages to node_modules root (required for native addons like better-sqlite3)
shamefully-hoist=true

# Use hoisted node_modules layout instead of pnpm's default symlink isolation
node-linker=hoisted

# Do not fail on peer dependency conflicts
strict-peer-dependencies=false

# Automatically install missing peer dependencies
auto-install-peers=true
