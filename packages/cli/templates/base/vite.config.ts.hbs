/**
 * {{projectName}} - Vite 配置
 */
{{#if isSvelteOnlyApp}}
import type { CoreConfig } from '@h-ai/core'
{{/if}}
import type { Plugin } from 'vite'
import path from 'node:path'
import process from 'node:process'
import { fileURLToPath } from 'node:url'
import { core } from '@h-ai/core'
{{#if hasUi}}
import { haiOptimizeExclude, haiPrebundledDeps } from '@h-ai/ui/vite'
{{/if}}
{{#if hasI18n}}
import { paraglideVitePlugin } from '@inlang/paraglide-js'
{{/if}}
{{#if isSvelteOnlyApp}}
import { svelte } from '@sveltejs/vite-plugin-svelte'
{{else}}
import { sveltekit } from '@sveltejs/kit/vite'
{{/if}}
{{#if hasUi}}
import tailwindcss from '@tailwindcss/vite'
{{/if}}
import { defineConfig } from 'vite'
import { resolveBuildMetadata } from './scripts/build-metadata.js'
{{#if isSvelteOnlyApp}}
import { publicRuntimeConfig } from './scripts/vite-runtime-config.js'
{{/if}}

export default defineConfig(({ mode, command }) => {
  const envResult = command === 'build' || process.env.HAI_E2E === '1' ? { success: true as const, data: {} as Record<string, string> } : core.config.loadEnvFiles({ mode, envDir: process.cwd() })
  if (!envResult.success)
    throw new Error(envResult.error.message)
  const env = envResult.data
  Object.assign(process.env, env)
  const buildMetadata = resolveBuildMetadata(fileURLToPath(new URL('.', import.meta.url)))
  const metadataAsset: Plugin = {
    name: 'hai-build-metadata',
    generateBundle() {
      this.emitFile({ type: 'asset', fileName: 'build-metadata.json', source: JSON.stringify(buildMetadata) })
    },
  }
{{#if isSvelteOnlyApp}}
  // 浏览器无法读取 YAML；构建时通过 core 解析，仅注入明确可公开的字段。
  core.init({ configDir: './config' })
  const config = core.config.getOrThrow<CoreConfig>('core')
  const appConfig = {
    name: config.name,
    version: config.version,
    env: config.env,
    defaultLocale: config.defaultLocale,
    logging: config.logging ? { level: config.logging.level, format: config.logging.format } : undefined,
  }
{{/if}}

  return {
    envDir: false,
    envPrefix: ['VITE_', 'PUBLIC_'],
    define: {
      __HAI_BUILD_METADATA__: JSON.stringify(buildMetadata),
{{#if isSvelteOnlyApp}}
      __APP_CORE_CONFIG__: JSON.stringify(appConfig),
{{/if}}
    },
    plugins: [
      metadataAsset,
  {{#if isSvelteOnlyApp}}
      publicRuntimeConfig({ apiBase: process.env.PUBLIC_API_BASE, {{#if features.crypto}}apiTransport: process.env.PUBLIC_API_TRANSPORT, apiKeyExchangePath: process.env.PUBLIC_API_KEY_EXCHANGE_PATH, {{/if}}core: appConfig }),
      svelte(),
  {{else}}
      sveltekit(),
  {{/if}}
{{#if hasUi}}
      tailwindcss(),
{{/if}}
{{#if hasI18n}}
      paraglideVitePlugin({
        project: './project.inlang',
        outdir: './src/lib/paraglide',
        strategy: ['cookie', 'baseLocale'],
      }),
{{/if}}
    ],
{{#if hasUi}}
    optimizeDeps: {
      // bits-ui 含 .svelte 源码须 exclude；@internationalized/date 须与 bits-ui 同为原始副本，
      // 避免日期类型 instanceof 失败（"Unknown date type"）。
      exclude: [...haiOptimizeExclude],
      // 预打包 @h-ai/ui 的重型纯 JS 依赖，避免首次进入业务路由触发依赖再优化与整页刷新
      include: [...haiPrebundledDeps],
    },
{{/if}}
{{#unless isSvelteOnlyApp}}
    ssr: {
      noExternal: ['@h-ai/ui', '@h-ai/kit'],
      // sm-crypto 同时列入生产依赖，避免 adapter-node 再次打包其动态 require。
      external: ['@h-ai/core', 'sm-crypto'],
    },
{{/unless}}
    server: {
      fs: {
        allow: [path.resolve(process.cwd())],
      },
    },
  }
})
