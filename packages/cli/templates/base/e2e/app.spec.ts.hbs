/** 首页从真实浏览器页面发起，覆盖基础渲染链路。 */
test('home page renders from browser', async ({ page }) => {
{{#if_eq appType 'h5'}}
  await page.setViewportSize({ width: 390, height: 844 })
{{/if_eq}}
  const pageErrors: string[] = []
  page.on('pageerror', error => pageErrors.push(error.message))
  await page.goto('./')
  await expect(page).toHaveTitle(process.env.HAI_CORE_NAME ?? '{{projectName}}')
  await expect(pageErrors).toEqual([])
  await expect(page.locator('main, section').first()).toBeVisible()
  await expect(page.locator('header').first()).toBeVisible()
  await expect(page.locator('footer').first()).toBeAttached()
  // 大屏使用可用空间，窄屏由组件内部滚动，不能撑宽整个页面。
  for (const width of [390, 1440, 1920, 2560, 3840]) {
    await page.setViewportSize({ width, height: 960 })
    const availableWidth = await page.evaluate(() => document.documentElement.clientWidth)
    expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth)).toBe(true)
    const shell = page.locator('.hai-mobile-shell')
    if (await shell.count())
      expect((await shell.boundingBox())!.width).toBeGreaterThan(availableWidth - 2)
  }
  await page.setViewportSize({ width: 390, height: 844 })
{{#if_eq appType 'h5'}}
  // 在手机宽度验证导航真正切换路由，避免样式失效但首页渲染测试仍通过。
  const nav = page.locator('nav')
  await nav.getByRole('button', { name: /发现|Discover/i, exact: true }).click()
  await expect(page).toHaveURL(/\/discover$/)
  const home = nav.getByRole('button', { name: /首页|Home/i, exact: true })
  await whileClientBootPaused(page, async () => {
    await page.reload({ waitUntil: 'commit' })
    await expect(page).toHaveURL(/\/discover$/)
    await expect(page.getByRole('heading', { name: /发现|Discover/i })).toBeVisible()
    await expect(home).toBeDisabled()
  })
  await home.click()
  await expect(page).toHaveURL(/\/$/)
  expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth)).toBe(true)
{{/if_eq}}
{{#if_eq appType 'website'}}
  await page.goto('./about')
  await page.reload()
  await expect(page).toHaveURL(/\/about$/)
  await expect(page.locator('header')).toBeVisible()
  await expect(page.locator('footer')).toBeVisible()
{{/if_eq}}
  const evidence = process.env.HAI_AUTH_EVIDENCE_DIR || path.resolve('test-results/auth-screenshots')
  await mkdir(evidence, { recursive: true })
  await page.evaluate(() => document.fonts.ready)
  await page.screenshot({ path: path.join(evidence, '{{projectName}}-home.png'), fullPage: true, animations: 'disabled' })
})
