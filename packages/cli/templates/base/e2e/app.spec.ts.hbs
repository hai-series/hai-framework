/** 延迟客户端脚本，覆盖 SSR 已显示而事件尚未绑定的阶段。 */
async function whileClientBootPaused(page: Page, inspect: () => Promise<void>) {
  let resumeClient = () => {}
  const clientBoot = new Promise<void>((resolve) => {
    resumeClient = resolve
  })
  await page.route('**/*.js', async (route) => {
    if (!new URL(route.request().url()).pathname.endsWith('/_hai/browser-check/startup.js'))
      await clientBoot
    await route.continue()
  })
  try {
    await inspect()
  }
  finally {
    resumeClient()
    await page.unrouteAll({ behavior: 'wait' })
  }
}

{{/if_eq}}
