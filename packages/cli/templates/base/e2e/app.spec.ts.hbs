/** 实际注册和密码登录；截图只保存空白表单。 */
test('configured IAM registration and password login', async ({ page, context }) => {
  test.setTimeout(90_000)
{{#if_eq appType 'h5'}}
  await page.setViewportSize({ width: 390, height: 844 })
{{/if_eq}}
  const evidence = process.env.HAI_AUTH_EVIDENCE_DIR || path.resolve('test-results/auth-screenshots')
  await mkdir(evidence, { recursive: true })
  const username = `scaf${randomUUID().replaceAll('-', '').slice(0, 12)}`
  const password = 'ScaffoldPassword123'
  const authUrl = '{{#if isCapacitorApp}}./{{else}}./auth/login{{/if}}'
  await page.goto(authUrl)
  await expect(page.locator('#login-username')).toBeVisible()
  await expect(page.locator('header').first()).toBeVisible()
  await expect(page.locator('footer')).toBeVisible()
  await page.screenshot({ path: path.join(evidence, '{{projectName}}-login.png'), fullPage: true })
  await page.getByRole('{{#if isCapacitorApp}}button{{else}}link{{/if}}', { name: /立即注册|Register now/i }).click()
{{#unless isCapacitorApp}}
  await expect(page).toHaveURL(/\/auth\/register(?:\?|$)/)
{{/unless}}
  const registerForm = page.locator('.register-form')
  await expect(registerForm.locator('#register-username')).toBeVisible()
  await page.screenshot({ path: path.join(evidence, '{{projectName}}-register.png'), fullPage: true })
  if (process.env.IAM_NOTIFICATION_URL) {
    // 协议弹窗留在认证页，关闭后继续填写注册表单。
    await registerForm.getByRole('button', { name: /用户协议|Terms of Service/i, exact: true }).click()
    await expect(page.getByRole('dialog')).toBeVisible()
    await expect(page.getByRole('dialog').getByRole('heading', { name: 'Configured registration agreement' })).toBeVisible()
    await expect(page.locator('iframe')).toHaveCount(0)
    await page.screenshot({ path: path.join(evidence, '{{projectName}}-agreement.png'), fullPage: true })
    await page.keyboard.press('Escape')
    await expect(page.getByRole('dialog')).not.toBeVisible()
  }
  await registerForm.locator('#register-username').fill(username)
  await registerForm.locator('#register-email').fill(`${username}@example.com`)
  await registerForm.locator('#register-password').fill(password)
  await registerForm.locator('#register-confirm-password').fill(password)
  await registerForm.locator('button[type="submit"]').click()
  await expect(page.locator('.register-form')).not.toBeVisible()
{{#if isCapacitorApp}}
  // 浏览器预览通过刷新 Cookie 恢复会话，不能把页面重载当作退出。
  await page.reload()
  await expect(page.getByRole('navigation')).toBeVisible()
  await page.getByRole('navigation').getByRole('button', { name: /我的|Profile|プロフィール/, exact: true }).click()
  const appearance = page.getByTestId('profile-theme')
  await appearance.getByRole('button', { name: /选择主题|Select theme|テーマを選択/, exact: true }).click()
  await appearance.getByRole('button', { name: /护眼|Eye care|目にやさしい/, exact: true }).click()
  await expect(page.locator('html')).toHaveAttribute('data-theme', 'eye-care')
  await page.reload()
  await expect(page.getByTestId('profile-theme')).toBeVisible()
  await expect(page.locator('html')).toHaveAttribute('data-theme', 'eye-care')
  await expect.poll(() => page.evaluate(() => getComputedStyle(document.documentElement).getPropertyValue('--color-base-100').trim())).toBe('#e8f0df')
  await page.screenshot({ path: path.join(evidence, '{{projectName}}-eye-care.png'), fullPage: true, animations: 'disabled' })
{{else}}
  // 通过页面 fetch 复用 Cookie 与已安装的传输加密，避免 HTTP 辅助客户端绕过浏览器协议。
  const me = await page.evaluate(async url => (await fetch(url)).status, new URL('./api/auth/me', test.info().project.use.baseURL).href)
  expect(me).toBe(200)
{{/if}}
  await context.clearCookies()
  await page.reload()
  await page.goto(authUrl)
  await expect(page.locator('#login-username')).toBeVisible()
  await page.locator('#login-username').fill(username)
  await page.locator('input[type="password"]').fill(password)
  await page.locator('button[type="submit"]').click()
  await expect(page.locator('.login-form')).not.toBeVisible()
  expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth)).toBe(true)

  if (!process.env.IAM_NOTIFICATION_URL)
    return
  await context.clearCookies()
  await page.reload()
  await page.goto(authUrl)
  await page.getByRole('button', { name: /邮件验证码|Email code/i, exact: true }).click()
  await page.screenshot({ path: path.join(evidence, '{{projectName}}-email.png'), fullPage: true })
  const email = `${username}@example.com`
  await page.locator('#login-username').fill(email)
  await page.getByRole('button', { name: /发送验证码|Send code/i, exact: true }).click()
  await expect(page.getByRole('button', { name: /秒后重发|Resend in/ })).toBeDisabled()
  async function received(template: string) {
    const response = await page.request.get(`${process.env.IAM_NOTIFICATION_URL}/messages?to=${encodeURIComponent(email)}`)
    const messages = await response.json() as { template: string, vars: Record<string, string> }[]
    return messages.findLast(item => item.template === template)?.vars
  }
  const otp = await received('otp_email')
  expect(Boolean(otp?.code)).toBe(true)
  await page.locator('#login-code').fill(otp?.code ?? '')
  await page.locator('button[type="submit"]').click()
  await expect(page.locator('.login-form')).not.toBeVisible()
  await context.clearCookies()
  await page.reload()
  await page.goto(authUrl)
  await page.getByRole('button', { name: /忘记密码|Forgot password/i }).click()
  await page.screenshot({ path: path.join(evidence, '{{projectName}}-forgot.png'), fullPage: true })
  await page.locator('input[type="email"]').fill(email)
  await page.locator('button[type="submit"]').click()
  await expect(page.locator('.hai-toast-item[data-variant="success"]')).toBeVisible()
  const reset = await received('password_reset')
  expect(Boolean(reset?.token)).toBe(true)
  await page.getByRole('button', { name: /已有重置令牌|I have a reset token/i }).click()
  await page.screenshot({ path: path.join(evidence, '{{projectName}}-reset.png'), fullPage: true })
  const resetUrl = `{{#if isCapacitorApp}}/{{else}}/auth/reset-password{{/if}}?token=${encodeURIComponent(reset?.token ?? '')}`
{{#if_eq appType 'h5'}}
  await whileClientBootPaused(page, async () => {
    await page.goto(resetUrl, { waitUntil: 'commit' })
    await expect(page.locator('input[type="password"]').nth(0)).toBeDisabled()
  })
{{else}}
  await page.goto(resetUrl)
{{/if_eq}}
  await expect(page.locator('input[type="password"]').nth(0)).toBeVisible()
  await page.locator('input[type="password"]').nth(0).fill('ScaffoldReset456')
  await page.locator('input[type="password"]').nth(1).fill('ScaffoldReset456')
  await page.locator('button[type="submit"]').click()
  await expect(page.locator('.hai-toast-item[data-variant="success"]')).toBeVisible()
  await page.getByRole('{{#if isCapacitorApp}}button{{else}}link{{/if}}', { name: /^(登录|Sign in|Login)$/i }).click()
  await page.locator('#login-username').fill(username)
  await page.locator('input[type="password"]').fill('ScaffoldReset456')
  await page.locator('button[type="submit"]').click()
  await expect(page.locator('.login-form')).not.toBeVisible()
  expect(new URL(page.url()).searchParams.has('token')).toBe(false)
  await page.reload()
{{#if isCapacitorApp}}
  // 已消费的重置令牌不再参与启动；刷新 Cookie 恢复同一已登录会话。
  await expect(page.getByRole('navigation')).toBeVisible()
  await expect(page.locator('#login-username')).not.toBeVisible()
{{else}}
  expect(await page.evaluate(async url => (await fetch(url)).status, new URL('./api/auth/me', test.info().project.use.baseURL).href)).toBe(200)
{{/if}}
})
{{/if}}
