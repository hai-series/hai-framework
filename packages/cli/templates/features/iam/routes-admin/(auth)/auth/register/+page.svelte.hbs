{{!-- Admin 注册页面 --}}
<script lang='ts'>
  /**
   * 注册页面
   */
  import { resolve } from '$app/paths'
{{#if hasI18n}}
  import * as m from '$lib/paraglide/messages'
{{/if}}
  import { Alert, Button, FormField, Input } from '@h-ai/ui'

  let username = $state('')
  let email = $state('')
  let password = $state('')
  let confirmPassword = $state('')
  let error = $state('')
  let loading = $state(false)

  async function handleRegister(event: SubmitEvent) {
    event.preventDefault()
    error = ''
    if (password !== confirmPassword) {
{{#if hasI18n}}
      error = m.auth_error_password_mismatch()
{{else}}
      error = '密码不一致'
{{/if}}
      return
    }
    loading = true
    try {
      const res = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, email, password, confirmPassword }),
      })
      const data = await res.json()
      if (data.success) {
        window.location.href = '/auth/login'
      }
      else {
{{#if hasI18n}}
        error = data.error?.message || m.auth_register_failed()
{{else}}
        error = data.error?.message || '注册失败'
{{/if}}
      }
    }
    catch {
{{#if hasI18n}}
      error = m.auth_error_network()
{{else}}
      error = '网络错误'
{{/if}}
    }
    finally {
      loading = false
    }
  }
</script>

<svelte:head>
{{#if hasI18n}}
  <title>{m.auth_register_title()}</title>
{{else}}
  <title>注册</title>
{{/if}}
</svelte:head>

{{#if hasI18n}}
<h2 class='text-2xl font-bold text-center mb-6'>{m.auth_register_title()}</h2>
{{else}}
<h2 class='text-2xl font-bold text-center mb-6'>注册</h2>
{{/if}}

{#if error}
  <Alert variant='error' class='mb-4'>{error}</Alert>
{/if}

<form onsubmit={handleRegister} class='space-y-4'>
{{#if hasI18n}}
  <FormField label={m.auth_label_username()} required>
    <Input id='username' type='text' bind:value={username} required />
  </FormField>
  <FormField label={m.auth_label_email()} required>
    <Input id='email' type='email' bind:value={email} required />
  </FormField>
  <FormField label={m.auth_label_password()} required>
    <Input id='password' type='password' bind:value={password} required />
  </FormField>
  <FormField label={m.auth_label_confirm_password()} required>
    <Input id='confirmPassword' type='password' bind:value={confirmPassword} required />
  </FormField>
  <Button type='submit' variant='primary' loading={loading} class='w-full'>
    {loading ? m.auth_register_loading() : m.auth_register_submit()}
  </Button>
{{else}}
  <FormField label='用户名' required>
    <Input id='username' type='text' bind:value={username} required />
  </FormField>
  <FormField label='邮箱' required>
    <Input id='email' type='email' bind:value={email} required />
  </FormField>
  <FormField label='密码' required>
    <Input id='password' type='password' bind:value={password} required />
  </FormField>
  <FormField label='确认密码' required>
    <Input id='confirmPassword' type='password' bind:value={confirmPassword} required />
  </FormField>
  <Button type='submit' variant='primary' loading={loading} class='w-full'>
    {loading ? '注册中...' : '注册'}
  </Button>
{{/if}}
</form>

<div class='text-center mt-4'>
{{#if hasI18n}}
  <a href={resolve('/auth/login', {})} class='link link-primary text-sm'>{m.auth_register_to_login()}</a>
{{else}}
  <a href={resolve('/auth/login', {})} class='link link-primary text-sm'>已有账号？立即登录</a>
{{/if}}
</div>
