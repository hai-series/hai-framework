  retries: 0,
  workers: 2,
  reporter: 'list',
  timeout: 30_000,
  use: { baseURL, channel: 'chrome', trace: 'retain-on-failure', screenshot: 'only-on-failure' },
  webServer: testServer({
    ...notificationConfig(),
    HAI_CORE_NAME: 'Configured scaffold',
    HAI_CORE_VERSION: '9.8.7',
  }, {
    command: `pnpm build && pnpm preview --mode test --host ${url.hostname} --port ${url.port || '4173'} --strictPort`,
    url: baseURL,
    reuseExistingServer: false,
    timeout: 180_000,
  }),
