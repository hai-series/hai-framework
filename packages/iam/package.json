{
  "name": "@h-ai/iam",
  "type": "module",
  "version": "0.1.0-alpha.67",
  "description": "Hai Framework identity and access management module.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "browser": "./dist/browser.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node ../../scripts/typecheck.mjs --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rimraf dist .turbo",
    "build:clean": "rimraf dist"
  },
  "peerDependencies": {
    "@h-ai/reach": "workspace:*",
    "ldapts": "catalog:"
  },
  "peerDependenciesMeta": {
    "@h-ai/reach": {
      "optional": true
    },
    "ldapts": {
      "optional": true
    }
  },
  "dependencies": {
    "@h-ai/audit": "workspace:*",
    "@h-ai/cache": "workspace:*",
    "@h-ai/core": "workspace:*",
    "@h-ai/crypto": "workspace:*",
    "@h-ai/reldb": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@h-ai/reach": "workspace:*",
    "@types/node": "catalog:",
    "ldapts": "catalog:",
    "rimraf": "catalog:",
    "testcontainers": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
