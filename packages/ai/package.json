{
  "name": "@h-ai/ai",
  "type": "module",
  "version": "0.1.0-alpha.69",
  "description": "Hai Framework AI module (LLM, MCP, tools, and clients).",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "main": "./dist/index.js",
  "browser": "./dist/browser.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "node ../../scripts/typecheck.mjs --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist .turbo",
    "model:list": "node models/build.mjs list",
    "model:prepare": "node models/build.mjs prepare",
    "model:build": "node models/build.mjs build",
    "model:run": "node models/build.mjs run",
    "build:clean": "rimraf dist"
  },
  "peerDependencies": {
    "@qdrant/js-client-rest": "1.18.0"
  },
  "peerDependenciesMeta": {
    "@qdrant/js-client-rest": {
      "optional": true
    }
  },
  "dependencies": {
    "@a2a-js/sdk": "catalog:",
    "@h-ai/api-contract": "workspace:*",
    "@h-ai/core": "workspace:*",
    "@h-ai/datapipe": "workspace:*",
    "@h-ai/reldb": "workspace:*",
    "@h-ai/vecdb": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "mem0ai": "catalog:",
    "nanoid": "catalog:",
    "openai": "catalog:",
    "undici": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "optionalDependencies": {
    "better-sqlite3": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "rimraf": "catalog:",
    "testcontainers": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
