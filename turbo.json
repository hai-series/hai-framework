{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "scripts/typecheck.mjs",
    "scripts/vite-runtime-config.ts",
    "scripts/container-runtime-config.sh",
    "packages/tsup.base.ts",
    "packages/vitest.base.ts"
  ],
  "tasks": {
    "paraglide:compile": {
      "dependsOn": [],
      "outputs": [
        "src/lib/paraglide/**",
        "src/i18n/paraglide/**"
      ],
      "inputs": [
        "project.inlang/**",
        "messages/**"
      ],
      "cache": true
    },
    "build": {
      "env": [
        "HAI_DOCKER_PROD_BUILD",
        "HAI_E2E",
        "HAI_BUILD_ID",
        "HAI_BUILD_COMMIT",
        "PUBLIC_*",
        "VITE_*",
        "TAURI_*"
      ],
      "dependsOn": [
        "^build",
        "paraglide:compile"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        ".svelte-kit/**",
        ".vercel/output/**"
      ],
      "cache": true
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "persistent": true,
      "cache": false
    },
    "lint": {
      "cache": true
    },
    "lint:fix": {
      "dependsOn": [],
      "cache": false
    },
    "test": {
      "passThroughEnv": [
        "DOCKER_HOST",
        "DOCKER_TLS_VERIFY",
        "DOCKER_CERT_PATH",
        "TESTCONTAINERS_*"
      ],
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "test:e2e": {
      "passThroughEnv": [
        "HAI_CLI_NATIVE_BUILD",
        "CARGO_BUILD_JOBS",
        "DOCKER_HOST",
        "DOCKER_TLS_VERIFY",
        "DOCKER_CERT_PATH",
        "TESTCONTAINERS_*",
        "HAI_DEPLOY_E2E_*",
        "HAI_AUTH_EVIDENCE_DIR",
        "PLAYWRIGHT_HTML_OUTPUT_DIR",
        "PLAYWRIGHT_HTML_REPORT"
      ],
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "clean": {
      "cache": false
    }
  }
}
