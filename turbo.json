{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "scripts/typecheck.mjs",
    "packages/tsup.base.ts"
  ],
  "tasks": {
    "paraglide:compile": {
      "dependsOn": [],
      "outputs": [
        "src/lib/paraglide/**",
        "src/i18n/paraglide/**"
      ],
      "inputs": [
        "project.inlang/**",
        "messages/**"
      ],
      "cache": true
    },
    "build": {
      "env": [
        "HAI_DOCKER_PROD_BUILD",
        "HAI_E2E",
        "PUBLIC_*",
        "VITE_*",
        "TAURI_*"
      ],
      "dependsOn": [
        "^build",
        "paraglide:compile",
        "build:clean"
      ],
      "outputs": [
        "dist/**",
        ".svelte-kit/**"
      ],
      "cache": true
    },
    "build:clean": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "persistent": true,
      "cache": false
    },
    "lint": {
      "cache": true
    },
    "lint:fix": {
      "dependsOn": [],
      "cache": false
    },
    "test": {
      "passThroughEnv": [
        "DOCKER_HOST",
        "DOCKER_TLS_VERIFY",
        "DOCKER_CERT_PATH",
        "TESTCONTAINERS_*"
      ],
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "test:e2e": {
      "passThroughEnv": [
        "HAI_AUTH_EVIDENCE_DIR"
      ],
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "clean": {
      "cache": false
    }
  }
}
