{
  "name": "hai-framework",
  "type": "module",
  "version": "1.0.0-beta.1",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "description": "hai Agent Framework - AI-Native, Configuration-Driven, Security-First",
  "author": "hai-series",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1",
    "pnpm": ">=12.11.2"
  },
  "scripts": {
    "build": "pnpm lint && turbo run build",
    "check:leak-words": "node scripts/check-leak-words.mjs --staged",
    "check:skills": "node scripts/check-skill-contracts.mjs",
    "dev": "turbo run dev",
    "e2e": "turbo run test:e2e --concurrency=1 --filter=@h-ai/cli --filter=@h-ai/deploy --filter=admin-console --filter=ai-playground --filter=corporate-website --filter=h5-app --filter=mobile-app --filter=framework-website",
    "test:release-local": "node scripts/run-release-local.mjs",
    "lint": "pnpm check:skills && pnpm check:readme && turbo run lint",
    "check:readme": "node scripts/check-readme.mjs",
    "lint:fix": "turbo run lint:fix",
    "model": "node packages/ai/models/build.mjs build",
    "model:list": "node packages/ai/models/build.mjs list",
    "model:prepare": "node packages/ai/models/build.mjs prepare",
    "model:run": "node packages/ai/models/build.mjs run",
    "test": "pnpm test:scripts && node scripts/run-tests.mjs",
    "test:scripts": "vitest run --config scripts/vitest.config.ts",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "format": "eslint --fix .",
    "prepare": "husky || true",
    "generate:env": "node scripts/generate-env-catalog.mjs && node scripts/generate-app-env.mjs",
    "check:env": "node scripts/generate-env-catalog.mjs --check && node scripts/generate-app-env.mjs --check",
    "check:usage-examples": "node scripts/check-usage-examples.mjs",
    "generate:api": "node scripts/module-api-inventory.mjs",
    "check:api": "node scripts/module-api-inventory.mjs --check",
    "test:api": "node scripts/module-api-smoke.mjs",
    "check:jsdoc": "node scripts/check-module-jsdoc.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "rimraf": "catalog:",
    "svelte-eslint-parser": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "overrides": {
    "eslint-plugin-yml": "3.9.0"
  },
  "lint-staged": {
    "*.{js,ts,svelte,json,md,yml,yaml}": [
      "eslint --fix --cache --cache-location .turbo/.eslintcache --no-warn-ignored"
    ]
  }
}
