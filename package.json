{
  "name": "hai-framework",
  "type": "module",
  "version": "0.1.0-alpha.36",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "description": "hai Agent Framework - AI-Native, Configuration-Driven, Security-First",
  "author": "hai-series",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm lint && turbo run build",
    "check:leak-words": "node scripts/check-leak-words.mjs --staged",
    "dev": "turbo run dev",
    "e2e": "turbo run test:e2e --concurrency=1 --filter=@h-ai/cli --filter=admin-console --filter=corporate-website --filter=h5-app --filter=mobile-app",
    "test:release-local": "pnpm install --frozen-lockfile && CI=true pnpm typecheck && CI=true pnpm lint && CI=true pnpm build && CI=true pnpm test && pnpm --filter admin-console exec playwright install chrome && CI=true pnpm --filter admin-console test:e2e",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test --concurrency=1",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "format": "eslint --fix .",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "rimraf": "catalog:",
    "svelte-eslint-parser": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "eslint-plugin-yml": "3.3.1"
  },
  "lint-staged": {
    "*.{js,ts,svelte,json,md,yml,yaml}": [
      "eslint --fix --cache --cache-location .turbo/.eslintcache --no-warn-ignored"
    ]
  }
}
