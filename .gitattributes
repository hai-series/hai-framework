# Windows 构建机交付 Linux 启动脚本时必须保留 LF，避免 /bin/sh 解释器失效。
*.sh text eol=lf
*.sh.hbs text eol=lf
*.envsh text eol=lf
*.envsh.hbs text eol=lf

# 容器构建文件统一行尾，保持跨平台维护一致。
.dockerignore text eol=lf
*.dockerignore text eol=lf
*.dockerignore.hbs text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
*.Dockerfile.hbs text eol=lf
