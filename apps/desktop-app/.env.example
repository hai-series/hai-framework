# 环境配置示例：包含本应用完整可用字段、说明和取值约束。
# .env / .env.dev / .env.test / .env.prod 为公共配置，提交 Git；.env.local 为本机私有覆盖，不提交。
# 优先级：进程环境 > .env.local > .env.<dev|test|prod> > .env。
# 可选字段先在 YAML 声明，或使用父级对象整体覆盖；完整框架变量见根 .env.example。

# crypto.transport.keyExchangePath — 桌面示例公开密钥交换端点，构建期插值
# 约束：以 / 开头的路径
HAI_CRYPTO_TRANSPORT_KEYEXCHANGEPATH='/_hai/key-exchange'

# PUBLIC_API_BASE — 浏览器/原生客户端 API 地址，不能含凭据
# 约束：有效 HTTP(S) URL；是否含 /api/v1 以对应客户端为准
PUBLIC_API_BASE='http://localhost:3000/api/v1'

# 可选字段（模块字段先启用 YAML 路径，运行时入口可直接注入）：
# crypto — crypto 配置对象
# 约束：JSON 对象；整体替换该配置
# HAI_CRYPTO=''

# HAI_CRYPTO_TRANSPORT — 桌面示例公开传输配置；在构建阶段与浏览器使用同一 Schema 校验
# 约束：false 关闭；或 JSON/YAML 对象，keyExchangePath 须以 / 开头；不接受 true
# HAI_CRYPTO_TRANSPORT='false'

# TAURI_DEV_HOST — Tauri 开发时 HMR 可访问的宿主机地址
# 约束：主机名或 IP，由 Tauri 开发工具注入
# TAURI_DEV_HOST=''

# VITEST — Vitest 自动注入的测试运行标记
# 约束：true 表示运行测试；通常无需手动设置
# VITEST=''
