{
  "name": "desktop-app",
  "type": "module",
  "version": "0.1.0-alpha.66",
  "private": true,
  "description": "hai Agent Framework - 桌面应用示例（Tauri v2 + Svelte 5 + Vite + @h-ai/api-client）",
  "keywords": [
    "hai",
    "desktop",
    "tauri",
    "svelte5",
    "vite",
    "api-client"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:test": "vite dev --mode test",
    "dev:prod": "vite dev --mode prod",
    "build": "hai build",
    "preview": "vite preview",
    "check": "pnpm typecheck",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src tests vite.config.ts svelte.config.js config-env.ts vitest.config.ts",
    "lint:fix": "eslint src tests vite.config.ts svelte.config.js config-env.ts vitest.config.ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo src-tauri/target",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "compile": "vite build",
    "build:images": "hai build --target docker",
    "deploy": "hai deploy"
  },
  "dependencies": {
    "@h-ai/api-client": "workspace:*",
    "@h-ai/api-contract": "workspace:*",
    "@h-ai/api-service-contract": "workspace:*",
    "@h-ai/crypto": "workspace:*",
    "@h-ai/ui": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@h-ai/cli": "workspace:*",
    "@h-ai/core": "workspace:*",
    "@h-ai/deploy": "workspace:*",
    "@iconify-json/tabler": "catalog:",
    "@iconify/tailwind4": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tauri-apps/cli": "catalog:",
    "@types/node": "catalog:",
    "daisyui": "catalog:",
    "jsdom": "catalog:",
    "rimraf": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
