{
  "name": "desktop-app",
  "type": "module",
  "version": "0.1.0-alpha.32",
  "private": true,
  "description": "hai Agent Framework - 桌面应用示例（Tauri v2 + Svelte 5 + Vite + @h-ai/api-client）",
  "keywords": [
    "hai",
    "desktop",
    "tauri",
    "svelte5",
    "vite",
    "api-client"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src tests vite.config.ts svelte.config.js",
    "lint:fix": "eslint src tests vite.config.ts svelte.config.js --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo src-tauri/target",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@h-ai/api-client": "workspace:*",
    "@h-ai/api-contract": "workspace:*",
    "@h-ai/api-service-contract": "workspace:*",
    "@h-ai/crypto": "workspace:*",
    "@h-ai/ui": "workspace:*",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/tabler": "catalog:",
    "@iconify/tailwind4": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tauri-apps/cli": "catalog:",
    "@types/node": "catalog:",
    "daisyui": "catalog:",
    "jsdom": "catalog:",
    "rimraf": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
