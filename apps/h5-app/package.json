{
  "name": "h5-app",
  "type": "module",
  "version": "1.0.0-beta.4",
  "private": true,
  "description": "hai Agent Framework - 移动端拍照识别示例应用",
  "keywords": [
    "hai",
    "h5",
    "mobile",
    "sveltekit",
    "svelte5"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "dev": "vite dev",
    "dev:test": "vite dev --mode test",
    "dev:prod": "vite dev --mode prod",
    "build": "hai build",
    "preview": "vite preview",
    "start": "node --env-file=.env --env-file=.env.prod --env-file-if-exists=.env.local build/index.js",
    "start:test": "node --env-file=.env --env-file=.env.test --env-file-if-exists=.env.local build/index.js",
    "start:prod": "pnpm start",
    "check": "pnpm typecheck",
    "typecheck": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node ../../scripts/run-e2e.mjs",
    "clean": "rimraf .svelte-kit build .turbo",
    "compile": "vite build",
    "build:images": "hai build --target image",
    "deploy": "hai deploy"
  },
  "dependencies": {
    "@h-ai/ai": "workspace:*",
    "@h-ai/cache": "workspace:*",
    "@h-ai/core": "workspace:*",
    "@h-ai/iam": "workspace:*",
    "@h-ai/kit": "workspace:*",
    "@h-ai/reach": "workspace:*",
    "@h-ai/reldb": "workspace:*",
    "@h-ai/storage": "workspace:*",
    "@h-ai/ui": "workspace:*",
    "@h-ai/vecdb": "workspace:*",
    "sm-crypto": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@h-ai/cli": "workspace:*",
    "@h-ai/deploy": "workspace:*",
    "@iconify-json/tabler": "catalog:",
    "@iconify/tailwind4": "catalog:",
    "@inlang/paraglide-js": "catalog:",
    "@inlang/plugin-message-format": "catalog:",
    "@playwright/test": "catalog:",
    "@sveltejs/adapter-node": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "daisyui": "catalog:",
    "rimraf": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
