# =============================================================================
# Mobile App - Environment Variables
# =============================================================================
#
# Copy this file to .env and fill in actual values.
# Variables with PUBLIC_ prefix are exposed to the client-side bundle.
#
# =============================================================================

# apps/api-service typed API base URL, including the apiPrefix from _serv.yml.
# Web preview:      http://localhost:3000/api/v1
# Android emulator: http://10.0.2.2:3000/api/v1
# iOS simulator:    http://localhost:3000/api/v1
PUBLIC_API_BASE=http://localhost:3000/api/v1

# api-service enables transport encryption by default.
# Set to "off" only when apps/api-service is started with transport disabled.
PUBLIC_API_TRANSPORT=on

# Optional override, must match apps/api-service/config/_serv.yml.
PUBLIC_API_KEY_EXCHANGE_PATH=/_hai/key-exchange

# Optional Capacitor live reload front-end URL.
# CAPACITOR_SERVER_URL=http://localhost:5175
