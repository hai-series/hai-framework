{
  "build": {
    "images": [
      {
        "name": "web",
        "context": "../..",
        "dockerfile": "images/web.Dockerfile",
        "containerPort": 8080
      }
    ],
    "app": [
      "."
    ]
  },
  "deploy": {
    "provider": {
      "type": "docker-ssh",
      "expose": {
        "hostPort": 18080
      }
    },
    "container": {
      "s3Engine": "${HAI_DEPLOY_CONTAINER_S3ENGINE:rustfs}"
    }
  }
}
