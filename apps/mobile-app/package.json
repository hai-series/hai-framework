{
  "name": "mobile-app",
  "type": "module",
  "version": "0.1.0-alpha.50",
  "private": true,
  "description": "hai Agent Framework - Mobile app（Capacitor + Svelte 5 + api-service contract）",
  "keywords": [
    "hai",
    "mobile",
    "android",
    "ios",
    "capacitor",
    "svelte5",
    "api-client"
  ],
  "scripts": {
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "dev": "vite dev --port 5175",
    "build": "pnpm paraglide:compile && vite build",
    "preview": "vite preview --port 5175",
    "check": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm paraglide:compile && svelte-kit sync && vitest run",
    "test:watch": "pnpm paraglide:compile && svelte-kit sync && vitest",
    "test:e2e": "playwright test",
    "clean": "rimraf .svelte-kit build .turbo",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "pnpm build && cap sync",
    "cap:sync:android": "pnpm build && cap sync android",
    "cap:sync:ios": "pnpm build && cap sync ios",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "cap:run:android": "cap run android",
    "cap:run:ios": "cap run ios",
    "cap:build:android:debug": "pnpm build && cap sync android && cd android && gradlew.bat assembleDebug",
    "cap:build:android:release": "pnpm build && cap sync android && cap build android --androidreleasetype APK",
    "cap:build:ios": "pnpm build && cap sync ios && cap build ios"
  },
  "dependencies": {
    "@h-ai/api-client": "workspace:*",
    "@h-ai/api-contract": "workspace:*",
    "@h-ai/api-service-contract": "workspace:*",
    "@h-ai/capacitor": "workspace:*",
    "@h-ai/crypto": "workspace:*",
    "@h-ai/ui": "workspace:*"
  },
  "devDependencies": {
    "@aparajita/capacitor-secure-storage": "catalog:",
    "@capacitor/android": "catalog:",
    "@capacitor/app": "catalog:",
    "@capacitor/cli": "catalog:",
    "@capacitor/core": "catalog:",
    "@capacitor/device": "catalog:",
    "@capacitor/ios": "catalog:",
    "@capacitor/preferences": "catalog:",
    "@capacitor/status-bar": "catalog:",
    "@iconify-json/tabler": "catalog:",
    "@iconify/tailwind4": "catalog:",
    "@inlang/paraglide-js": "catalog:",
    "@inlang/plugin-message-format": "catalog:",
    "@playwright/test": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "daisyui": "catalog:",
    "rimraf": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
