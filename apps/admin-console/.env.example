# 环境配置示例：包含本应用完整可用字段、说明和取值约束。
# .env / .env.dev / .env.test / .env.prod 为公共配置，提交 Git；.env.local 为本机私有覆盖，不提交。
# 优先级：进程环境 > .env.local > .env.<dev|test|prod> > .env。
# 可选字段先在 YAML 或 hai.json.deploy 声明，或使用父级对象整体覆盖；完整框架变量见根 .env.example。

# audit.capture.enabled — audit.capture.enabled 配置项
# 约束：true | false
HAI_AUDIT_CAPTURE_ENABLED='true'

# audit.capture.includeReads — audit.capture.includeReads 配置项
# 约束：true | false
HAI_AUDIT_CAPTURE_INCLUDEREADS='false'

# audit.retention.enabled — audit.retention.enabled 配置项
# 约束：true | false
HAI_AUDIT_RETENTION_ENABLED='true'

# audit.retention.minDays — audit.retention.minDays 配置项
# 约束：整数；>= 1；<= 36500
HAI_AUDIT_RETENTION_MINDAYS='90'

# audit.privacy.enabled — audit.privacy.enabled 配置项
# 约束：true | false
HAI_AUDIT_PRIVACY_ENABLED='true'

# audit.backup.enabled — audit.backup.enabled 配置项
# 约束：true | false
HAI_AUDIT_BACKUP_ENABLED='false'

# audit.backup.batchSize — audit.backup.batchSize 配置项
# 约束：整数；>= 1；<= 1000
HAI_AUDIT_BACKUP_BATCHSIZE='200'

# audit.backup.maxRecordBytes — audit.backup.maxRecordBytes 配置项
# 约束：整数；>= 1024；<= 67108864
HAI_AUDIT_BACKUP_MAXRECORDBYTES='1048576'

# audit.backup.schedule.enabled — audit.backup.schedule.enabled 配置项
# 约束：true | false
HAI_AUDIT_BACKUP_SCHEDULE_ENABLED='false'

# audit.backup.schedule.cron — audit.backup.schedule.cron 配置项
# 约束：字符串；最小字符数 1；最大字符数 128
HAI_AUDIT_BACKUP_SCHEDULE_CRON='0 2 * * *'

# audit.backup.schedule.timezone — audit.backup.schedule.timezone 配置项
# 约束：字符串；最小字符数 1；最大字符数 128
HAI_AUDIT_BACKUP_SCHEDULE_TIMEZONE='UTC'

# audit.alerts.enabled — audit.alerts.enabled 配置项
# 约束：true | false
HAI_AUDIT_ALERTS_ENABLED='false'

# audit.alerts.maxNotificationsPerCheck — audit.alerts.maxNotificationsPerCheck 配置项
# 约束：整数；>= 1；<= 1000
HAI_AUDIT_ALERTS_MAXNOTIFICATIONSPERCHECK='100'

# audit.alerts.schedule.enabled — audit.alerts.schedule.enabled 配置项
# 约束：true | false
HAI_AUDIT_ALERTS_SCHEDULE_ENABLED='false'

# audit.alerts.schedule.cron — audit.alerts.schedule.cron 配置项
# 约束：字符串；最小字符数 1；最大字符数 128
HAI_AUDIT_ALERTS_SCHEDULE_CRON='* * * * *'

# audit.alerts.schedule.timezone — audit.alerts.schedule.timezone 配置项
# 约束：字符串；最小字符数 1；最大字符数 128
HAI_AUDIT_ALERTS_SCHEDULE_TIMEZONE='UTC'

# cache.type — 后端或功能类型，按枚举选择
# 约束：字符串；取值：memory | redis
HAI_CACHE_TYPE='memory'

# cache.host — 主机地址；默认 'localhost'
# 约束：字符串
HAI_CACHE_HOST='localhost'

# cache.port — 端口号；默认 6379
# 约束：整数；>= 1；<= 65535
HAI_CACHE_PORT='6379'

# cache.password — 单机、Cluster 和 Sentinel 数据节点的认证密码；url 模式使用 URL 内凭据。
# 约束：字符串
HAI_CACHE_PASSWORD=''

# cache.url — Redis 连接 URL（如 redis://user:pass
# 约束：字符串
HAI_CACHE_URL=''

# cache.db — 数据库编号（0~15）；默认 0
# 约束：整数；>= 0；<= 15
HAI_CACHE_DB='0'

# cache.connectTimeout — 连接超时时间（毫秒）；默认 10000
# 约束：整数；>= 0；<= 9007199254740991
HAI_CACHE_CONNECTTIMEOUT='10000'

# cache.commandTimeout — 命令执行超时（毫秒）；默认 5000
# 约束：整数；>= 0；<= 9007199254740991
HAI_CACHE_COMMANDTIMEOUT='5000'

# cache.tls — 是否开启 TLS；默认 false
# 约束：true | false
HAI_CACHE_TLS='false'

# cache.maxRetries — 最大重试次数；默认 3
# 约束：整数；>= 0；<= 9007199254740991
HAI_CACHE_MAXRETRIES='3'

# cache.retryDelay — 重试间隔基数（毫秒）；实际间隔 = retryDelay × 重试次数；默认 50
# 约束：整数；>= 0；<= 9007199254740991
HAI_CACHE_RETRYDELAY='50'

# cache.readOnly — 是否只读模式；默认 false
# 约束：true | false
HAI_CACHE_READONLY='false'

# core.name — 应用名称（默认 'hai Admin'）
# 约束：字符串
HAI_CORE_NAME='hai Admin Console'

# core.version — 应用版本（默认 '0.1.0'）
# 约束：字符串
HAI_CORE_VERSION='0.1.0'

# core.env — 运行环境（默认 'development'）
# 约束：字符串；取值：development | production | test | staging
HAI_CORE_ENV='development'

# core.defaultLocale — 默认语言（默认 'zh-CN'）
# 约束：字符串
HAI_CORE_DEFAULTLOCALE='zh-CN'

# db.type — 后端或功能类型，按枚举选择
# 约束：字符串；取值：sqlite | postgresql | mysql
HAI_DB_TYPE='sqlite'

# db.database — 数据库：SQLite文件路径或:memory:；PostgreSQL必填名称；MySQL无URL时必填，URL模式从URL读取
# 约束：字符串；最小字符数 1
HAI_DB_DATABASE='./data/admin.db'

# db.host — 数据库主机地址（默认 localhost）
# 约束：字符串
HAI_DB_HOST='localhost'

# db.port — 数据库端口 - PostgreSQL 默认 5432 - MySQL 默认 3306
# 约束：整数；>= 1；<= 65535
HAI_DB_PORT='5432'

# db.user — 数据库用户名
# 约束：字符串
HAI_DB_USER='postgres'

# db.password — 数据库密码
# 约束：字符串
HAI_DB_PASSWORD=''

# db.url — 网络数据库URL；MySQL空串表示使用分字段，非空仅mysql://且拒绝query/fragment，优先于host/port/database/user/password
# 约束：字符串；格式 uri；取值：
HAI_DB_URL=''

# db.ssl — TLS：PostgreSQL使用其模式；MySQL仅false或严格对象，空对象默认校验证书链和DNS身份
# 约束：MySQL：false 或严格 TLS 对象（{} 默认校验证书链和 DNS 身份）；PostgreSQL：布尔值、require/prefer/allow/disable 或 TLS 对象
HAI_DB_SSL='false'

# feedback.notificationMode — disabled 不通知，console 输出安全摘要，reach 使用已有通知通道。
# 约束：字符串；取值：disabled | console | reach
HAI_FEEDBACK_NOTIFICATIONMODE='console'

# feedback.maxTotalBytes — 未压缩导出总预算；客户端、附件总量和传输预算由此派生。
# 约束：整数；>= 4194304；<= 41943040
HAI_FEEDBACK_MAXTOTALBYTES='33554432'

# feedback (HAI_FEEDBACK_RECIPIENTS_0，可选块) — Reach 接收方，由实际 Provider 校验邮箱、手机号或业务目的地。；此变量整体替换单个数组项
# 约束：字符串；最小字符数 1；最大字符数 320
HAI_FEEDBACK_RECIPIENTS_0=''

# feedback.adminUrl — 管理员通知中的反馈管理页面地址。
# 约束：字符串；格式 uri
HAI_FEEDBACK_ADMINURL='http://localhost:5173/admin/feedback'

# feedback.collectionTimeoutMs — 补充材料收集超时，单位毫秒；超时后冻结为完整或部分材料。
# 约束：整数；>= 0；<= 300000
HAI_FEEDBACK_COLLECTIONTIMEOUTMS='60000'

# feedback.businessCollectionTimeoutMs — 业务 collectEvidence 异步回调的等待上限，单位毫秒；超时后重试采集任务。
# 约束：整数；>= 1；<= 300000
HAI_FEEDBACK_BUSINESSCOLLECTIONTIMEOUTMS='30000'

# feedback.webhookUrl — 反馈采集结束后的 Webhook 地址；空字符串禁用，只允许可信 HTTP(S) 地址且不跟随重定向。
# 约束：字符串；最大字符数 2048
HAI_FEEDBACK_WEBHOOKURL=''

# feedback.webhookSecret — Webhook HMAC-SHA256 签名密钥；空字符串不签名，仅服务端私有环境配置。
# 约束：字符串；最大字符数 4096
HAI_FEEDBACK_WEBHOOKSECRET=''

# feedback.webhookTimeoutMs — 单次 Webhook 请求超时，单位毫秒；非 2xx 或超时均进入持久重试。
# 约束：整数；>= 1；<= 60000
HAI_FEEDBACK_WEBHOOKTIMEOUTMS='10000'

# feedback.workerIntervalMs — 持久任务扫描间隔，单位毫秒；零值由宿主手动运行任务。
# 约束：整数；>= 0；<= 60000
HAI_FEEDBACK_WORKERINTERVALMS='1000'

# iam.login.password — 是否启用密码登录
# 约束：true | false
HAI_IAM_LOGIN_PASSWORD='true'

# iam.login.otp — 是否启用 OTP 登录
# 约束：true | false
HAI_IAM_LOGIN_OTP='false'

# iam.login.ldap — 是否启用 LDAP 登录；需要显式开启并提供 ldap 配置。
# 约束：true | false
HAI_IAM_LOGIN_LDAP='false'

# iam (HAI_IAM_LDAP_BINDPASSWORD，可选块) — 绑定密码
# 约束：字符串
HAI_IAM_LDAP_BINDPASSWORD=''

# iam.password.minLength — 最小长度（默认 8）
# 约束：整数；>= 1；<= 9007199254740991
HAI_IAM_PASSWORD_MINLENGTH='8'

# iam.password.maxLength — 最大长度（默认 128）
# 约束：整数；>= 1；<= 256
HAI_IAM_PASSWORD_MAXLENGTH='128'

# iam.password.requireUppercase — 需要大写字母
# 约束：true | false
HAI_IAM_PASSWORD_REQUIREUPPERCASE='false'

# iam.password.requireLowercase — 需要小写字母
# 约束：true | false
HAI_IAM_PASSWORD_REQUIRELOWERCASE='false'

# iam.password.requireNumber — 需要数字
# 约束：true | false
HAI_IAM_PASSWORD_REQUIRENUMBER='false'

# iam.password.requireSpecialChar — 需要特殊字符
# 约束：true | false
HAI_IAM_PASSWORD_REQUIRESPECIALCHAR='false'

# iam.password.minCharacterClasses — 至少包含的字符类别数（大小写、数字、特殊字符），0 不额外限制。
# 约束：整数；>= 0；<= 4
HAI_IAM_PASSWORD_MINCHARACTERCLASSES='3'

# iam.password.expirationDays — 密码过期天数（0 表示不过期）
# 约束：整数；>= 0；<= 9007199254740991
HAI_IAM_PASSWORD_EXPIRATIONDAYS='0'

# iam.password.preventSamePassword — 拒绝新旧密码相同；启用口令期限或首次强改时也始终拒绝相同密码。
# 约束：true | false
HAI_IAM_PASSWORD_PREVENTSAMEPASSWORD='false'

# iam.password.requireInitialChange — 管理员创建或重置的初始密码必须先更换；不影响用户自行注册设密。
# 约束：true | false
HAI_IAM_PASSWORD_REQUIREINITIALCHANGE='false'

# iam.initialCredentials.enabled — iam.initialCredentials.enabled 配置项
# 约束：true | false
HAI_IAM_INITIALCREDENTIALS_ENABLED='false'

# iam.reauthentication.enabled — iam.reauthentication.enabled 配置项
# 约束：true | false
HAI_IAM_REAUTHENTICATION_ENABLED='false'

# iam.reauthentication.ttlSeconds — iam.reauthentication.ttlSeconds 配置项
# 约束：整数；>= 1；<= 900
HAI_IAM_REAUTHENTICATION_TTLSECONDS='300'

# iam.loginAccess.enabled — iam.loginAccess.enabled 配置项
# 约束：true | false
HAI_IAM_LOGINACCESS_ENABLED='false'

# iam.loginAccess.timezone — iam.loginAccess.timezone 配置项
# 约束：字符串
HAI_IAM_LOGINACCESS_TIMEZONE='Asia/Shanghai'

# iam.session.endOnPageHide — 页面离开时尽力撤销会话；浏览器关闭不可保证，仍应配置服务端闲置/绝对期限。
# 约束：true | false
HAI_IAM_SESSION_ENDONPAGEHIDE='false'

# iam.session.maxAge — 新会话的默认 access 时长（秒）；创建时可用 maxAge 覆盖，滑动/刷新沿用会话固有时长。
# 约束：整数；>= 60；<= 9007199254740991
HAI_IAM_SESSION_MAXAGE='900'

# iam.session.refreshTokenMaxAge — refreshToken 独立有效期（秒，默认 604800 = 7天）；从签发时刻起算，access 到期仍可刷新。
# 约束：整数；>= 3600；<= 9007199254740991
HAI_IAM_SESSION_REFRESHTOKENMAXAGE='604800'

# iam.session.sliding — 是否滑动窗口（每次访问刷新过期时间）
# 约束：true | false
HAI_IAM_SESSION_SLIDING='true'

# iam.session.singleDevice — 单设备登录（踢掉其他设备）
# 约束：true | false
HAI_IAM_SESSION_SINGLEDEVICE='false'

# iam.session.singleDeviceMode — 单设备超限策略：replace 顶旧保新，reject 保留旧会话并拒绝新登录。
# 约束：字符串；取值：replace | reject
HAI_IAM_SESSION_SINGLEDEVICEMODE='replace'

# iam.session.maxSessions — 每个用户的最大有效会话数，0 不限制；包含 access 到期但仍可刷新的会话。
# 约束：整数；>= 0；<= 10000
HAI_IAM_SESSION_MAXSESSIONS='0'

# iam.session.idleTimeout — 闲置期限（秒），0 关闭；真实访问记录活动，自动刷新不延长闲置；access/refresh 均执行。
# 约束：整数；>= 0；<= 31536000
HAI_IAM_SESSION_IDLETIMEOUT='0'

# iam.session.absoluteTimeout — 从首次登录起的绝对期限（秒），0 关闭；刷新不能重新起算。
# 约束：整数；>= 0；<= 31536000
HAI_IAM_SESSION_ABSOLUTETIMEOUT='0'

# iam.accounts.dormantAfterDays — 连续未成功登录多少天后休眠，0 关闭。未登录账号从创建时间起算。
# 约束：整数；>= 0；<= 36500
HAI_IAM_ACCOUNTS_DORMANTAFTERDAYS='0'

# iam.accounts.scanIntervalSeconds — 自动扫描间隔（秒）；开启自动休眠时执行，默认每小时。
# 约束：整数；>= 60；<= 86400
HAI_IAM_ACCOUNTS_SCANINTERVALSECONDS='3600'

# iam.seedDefaultData — 是否初始化默认角色和权限（默认 true）
# 约束：true | false
HAI_IAM_SEEDDEFAULTDATA='true'

# iam.register.enabled — 是否启用注册
# 约束：true | false
HAI_IAM_REGISTER_ENABLED='true'

# iam.register.defaultEnabled — 新注册用户是否默认启用
# 约束：true | false
HAI_IAM_REGISTER_DEFAULTENABLED='true'

# iam.security.lockoutEnabled — 是否启用失败计数锁定；关闭时忽略历史锁。
# 约束：true | false
HAI_IAM_SECURITY_LOCKOUTENABLED='true'

# iam.security.failureWindow — 从首次失败起的固定计数窗口（秒）。
# 约束：整数；>= 1；<= 31536000
HAI_IAM_SECURITY_FAILUREWINDOW='86400'

# iam.security.maxLoginAttempts — 最大登录失败次数（默认 5）
# 约束：整数；>= 1；<= 9007199254740991
HAI_IAM_SECURITY_MAXLOGINATTEMPTS='5'

# iam.security.lockoutDuration — 锁定时长（秒，默认 900）
# 约束：整数；>= 60；<= 9007199254740991
HAI_IAM_SECURITY_LOCKOUTDURATION='1200'

# iam.otp.email — 分别启用邮件、短信验证码
# 约束：true | false
HAI_IAM_OTP_EMAIL='true'

# iam.otp.sms — 是否允许短信验证码
# 约束：true | false
HAI_IAM_OTP_SMS='true'

# iam.otp.length — 验证码长度（默认 6）
# 约束：整数；>= 4；<= 8
HAI_IAM_OTP_LENGTH='6'

# iam.otp.expiresIn — 验证码过期时间（秒，默认 300）
# 约束：整数；>= 60；<= 9007199254740991
HAI_IAM_OTP_EXPIRESIN='300'

# iam.otp.maxAttempts — 最大重试次数（默认 3）
# 约束：整数；>= 1；<= 9007199254740991
HAI_IAM_OTP_MAXATTEMPTS='3'

# iam.otp.resendInterval — 发送间隔（秒，默认 60）
# 约束：整数；>= 30；<= 9007199254740991
HAI_IAM_OTP_RESENDINTERVAL='60'

# iam.passwordReset.enabled — 是否启用密码重置
# 约束：true | false
HAI_IAM_PASSWORDRESET_ENABLED='true'

# iam.passwordReset.mode — 重置通知渠道，phone 使用 password_reset_sms 模板。
# 约束：字符串；取值：email | phone
HAI_IAM_PASSWORDRESET_MODE='email'

# iam.passwordReset.tokenExpiresIn — 重置令牌有效期（秒，默认 3600 = 1小时）
# 约束：整数；>= 300；<= 9007199254740991
HAI_IAM_PASSWORDRESET_TOKENEXPIRESIN='3600'

# iam.passwordReset.maxAttempts — 最大验证尝试次数（默认 3）
# 约束：整数；>= 1；<= 9007199254740991
HAI_IAM_PASSWORDRESET_MAXATTEMPTS='3'

# iam.captcha.enabled — iam.captcha.enabled 配置项
# 约束：true | false
HAI_IAM_CAPTCHA_ENABLED='false'

# iam.captcha.ttlSeconds — iam.captcha.ttlSeconds 配置项
# 约束：整数；>= 1；<= 600
HAI_IAM_CAPTCHA_TTLSECONDS='120'

# iam.captcha.cost — iam.captcha.cost 配置项
# 约束：整数；>= 100；<= 50000
HAI_IAM_CAPTCHA_COST='5000'

# iam.captcha.maxCounter — iam.captcha.maxCounter 配置项
# 约束：整数；>= 1；<= 2000
HAI_IAM_CAPTCHA_MAXCOUNTER='100'

# kit.server.host — HTTP 监听主机名或 IP
# 约束：字符串；最小字符数 1
HAI_KIT_SERVER_HOST='127.0.0.1'

# kit.server.port — HTTP 监听端口
# 约束：整数；>= 1；<= 65535
HAI_KIT_SERVER_PORT='3000'

# kit.transport.maxPlaintextBytes — 双向业务明文 UTF-8 字节上限；默认 1 MiB，密文与代理预算自动推导
# 约束：整数；>= 1024；<= 67108864
HAI_KIT_TRANSPORT_MAXPLAINTEXTBYTES='8388608'

# kit.transport.keyExchangePath — 客户端与服务端约定的密钥交换端点
# 约束：字符串；以 / 开头的路径字符串
HAI_KIT_TRANSPORT_KEYEXCHANGEPATH='/api/_hai/key-exchange'

# kit.transport.excludePaths.0 — 不进入传输加密管道的路径
# 约束：以 / 开头的路径字符串
HAI_KIT_TRANSPORT_EXCLUDEPATHS_0='/api/storage'

# kit.transport.excludePaths.1 — 不进入传输加密管道的路径
# 约束：以 / 开头的路径字符串
HAI_KIT_TRANSPORT_EXCLUDEPATHS_1='/api/public'

# kit.transport.excludePaths.2 — 不进入传输加密管道的路径
# 约束：以 / 开头的路径字符串
HAI_KIT_TRANSPORT_EXCLUDEPATHS_2='/api/auth/profile/avatar'

# reach.providers.0.type — 后端或功能类型，按枚举选择
# 约束：字符串；取值：console | smtp | aliyun-sms | api
HAI_REACH_PROVIDERS_0_TYPE='console'

# reach.providers.1.type — 后端或功能类型，按枚举选择
# 约束：字符串；取值：console | smtp | aliyun-sms | api
HAI_REACH_PROVIDERS_1_TYPE='console'

# scheduler.tickInterval — 调度检查间隔，单位毫秒（默认 1000，即每秒检查一次）
# 约束：整数；>= 100；<= 9007199254740991
HAI_SCHEDULER_TICKINTERVAL='1000'

# scheduler.leaseMs — 执行租约毫秒数（默认 300000，范围 1000–86400000），在途每三分之一周期续期。
# 约束：整数；>= 1000；<= 86400000
HAI_SCHEDULER_LEASEMS='300000'

# storage.type — 存储类型
# 约束：字符串；取值：s3 | local
HAI_STORAGE_TYPE='local'

# storage.root — 根目录路径
# 约束：字符串；最小字符数 1
HAI_STORAGE_ROOT='./data/uploads'

# storage.bucket — 存储桶名称
# 约束：字符串；最小字符数 1
HAI_STORAGE_BUCKET=''

# storage.region — 区域
# 约束：字符串；最小字符数 1
HAI_STORAGE_REGION='us-east-1'

# storage.accessKeyId — Access Key ID
# 约束：字符串；最小字符数 1
HAI_STORAGE_ACCESSKEYID=''

# storage.secretAccessKey — Secret Access Key
# 约束：字符串；最小字符数 1
HAI_STORAGE_SECRETACCESSKEY=''

# storage.endpoint — 自定义端点（用于 MinIO、RustFS、阿里云 OSS 等）
# 约束：字符串；格式 uri
HAI_STORAGE_ENDPOINT='https://s3.amazonaws.com'

# storage.forcePathStyle — 强制使用路径风格 URL（某些 S3 兼容服务需要）
# 约束：true | false
HAI_STORAGE_FORCEPATHSTYLE='false'

# storage.createBucket — 初始化时检查并创建缺失的桶；默认关闭，启用后凭据须有建桶权限。
# 约束：true | false
HAI_STORAGE_CREATEBUCKET='false'

# deploy.provider.type — 应用部署：平台/暴露方式，按所在节点的枚举选择
# 约束：字符串；取值：vercel | docker-ssh
HAI_DEPLOY_PROVIDER_TYPE='docker-ssh'

# deploy.provider.ssh.host — 远程主机地址或 ~/.ssh/config 中的 Host 别名
# 约束：字符串；正则 ^[a-z0-9][a-z0-9.:-]*$
HAI_DEPLOY_PROVIDER_SSH_HOST=''

# deploy.provider.ssh.port — SSH 端口
# 约束：整数；>= 1；<= 65535
HAI_DEPLOY_PROVIDER_SSH_PORT='22'

# deploy.provider.ssh.username — SSH 用户名
# 约束：字符串；正则 ^[a-z_][\w-]*$
HAI_DEPLOY_PROVIDER_SSH_USERNAME='deploy'

# deploy.provider.ssh.identityFile — 私钥文件路径（省略时使用 ssh-agent 或 ~/.ssh 默认密钥）
# 约束：字符串；最小字符数 1
HAI_DEPLOY_PROVIDER_SSH_IDENTITYFILE=''

# deploy.provider.remote.baseDir — 远程应用根目录
# 约束：字符串；正则 ^\/[\w/. -]+$
HAI_DEPLOY_PROVIDER_REMOTE_BASEDIR='/opt/hai/apps'

# deploy.provider.remote.runtime — 远程容器运行时（auto 优先 podman）
# 约束：字符串；取值：auto | docker | podman
HAI_DEPLOY_PROVIDER_REMOTE_RUNTIME='auto'

# deploy.provider.expose.type — 应用部署：平台/暴露方式，按所在节点的枚举选择
# 约束：字符串；取值：port
HAI_DEPLOY_PROVIDER_EXPOSE_TYPE='port'

# deploy.provider.expose.containerPort — 容器内监听端口（adapter-node 默认 3000）
# 约束：整数；>= 1；<= 65535
HAI_DEPLOY_PROVIDER_EXPOSE_CONTAINERPORT='3000'

# deploy.provider.expose.hostPort — 宿主机映射端口
# 约束：整数；>= 1；<= 65535
HAI_DEPLOY_PROVIDER_EXPOSE_HOSTPORT='18080'

# deploy.container.s3Engine — 自建 S3 服务实现；协议仍为 storage.type=s3。
# 约束：字符串；取值：rustfs | minio
HAI_DEPLOY_CONTAINER_S3ENGINE='rustfs'

# 可选字段（模块字段先启用 YAML 路径，运行时入口可直接注入）：
# audit — audit. 配置对象
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_AUDIT=''

# audit.alerts — 以固定时间窗口统计已提交事件；目标和事件由应用配置，不内置业务角色。
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_AUDIT_ALERTS='{"enabled":false,"maxNotificationsPerCheck":100,"rules":[],"schedule":{"enabled":false,"cron":"* * * * *","timezone":"UTC"}}'

# audit.alerts.rules — audit.alerts.rules 配置项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 20
# HAI_AUDIT_ALERTS_RULES='[]'

# audit.alerts.rules.0 — audit.alerts.rules.0 配置项
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_AUDIT_ALERTS_RULES_0=''

# audit.alerts.rules.0.actions — audit.alerts.rules.0.actions 配置项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最少项数 1；最多项数 50
# HAI_AUDIT_ALERTS_RULES_0_ACTIONS=''

# audit.alerts.rules.0.actions.0 — audit.alerts.rules.0.actions.0 配置项
# 约束：字符串；最小字符数 1；最大字符数 128
# HAI_AUDIT_ALERTS_RULES_0_ACTIONS_0=''

# audit.alerts.rules.0.id — audit.alerts.rules.0.id 配置项
# 约束：字符串；正则 ^[\w-]{1,64}$
# HAI_AUDIT_ALERTS_RULES_0_ID=''

# audit.alerts.rules.0.minimumSeverity — audit.alerts.rules.0.minimumSeverity 配置项
# 约束：字符串；取值：info | warning | error | critical
# HAI_AUDIT_ALERTS_RULES_0_MINIMUMSEVERITY='info'

# audit.alerts.rules.0.outcomes — audit.alerts.rules.0.outcomes 配置项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 3
# HAI_AUDIT_ALERTS_RULES_0_OUTCOMES='["failure","denied"]'

# audit.alerts.rules.0.outcomes.0 — audit.alerts.rules.0.outcomes.0 配置项
# 约束：字符串；取值：success | failure | denied
# HAI_AUDIT_ALERTS_RULES_0_OUTCOMES_0='success'

# audit.alerts.rules.0.resource — audit.alerts.rules.0.resource 配置项
# 约束：字符串；最小字符数 1；最大字符数 256
# HAI_AUDIT_ALERTS_RULES_0_RESOURCE=''

# audit.alerts.rules.0.severity — audit.alerts.rules.0.severity 配置项
# 约束：字符串；取值：warning | error | critical
# HAI_AUDIT_ALERTS_RULES_0_SEVERITY='warning'

# audit.alerts.rules.0.targets — audit.alerts.rules.0.targets 配置项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最少项数 1；最多项数 20
# HAI_AUDIT_ALERTS_RULES_0_TARGETS=''

# audit.alerts.rules.0.targets.0 — audit.alerts.rules.0.targets.0 配置项
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_AUDIT_ALERTS_RULES_0_TARGETS_0=''

# audit.alerts.rules.0.targets.0.id — audit.alerts.rules.0.targets.0.id 配置项
# 约束：字符串；正则 ^[\w-]{1,64}$
# HAI_AUDIT_ALERTS_RULES_0_TARGETS_0_ID=''

# audit.alerts.rules.0.targets.0.provider — 所选后端的连接参数，按 type 选择对应字段
# 约束：字符串；最小字符数 1；最大字符数 128
# HAI_AUDIT_ALERTS_RULES_0_TARGETS_0_PROVIDER=''

# audit.alerts.rules.0.targets.0.to — audit.alerts.rules.0.targets.0.to 配置项
# 约束：字符串；最小字符数 1；最大字符数 1000
# HAI_AUDIT_ALERTS_RULES_0_TARGETS_0_TO=''

# audit.alerts.rules.0.threshold — audit.alerts.rules.0.threshold 配置项
# 约束：整数；>= 1；<= 1000000000
# HAI_AUDIT_ALERTS_RULES_0_THRESHOLD='1'

# audit.alerts.rules.0.windowSeconds — audit.alerts.rules.0.windowSeconds 配置项
# 约束：整数；>= 60；<= 86400
# HAI_AUDIT_ALERTS_RULES_0_WINDOWSECONDS='300'

# audit.alerts.schedule — audit.alerts.schedule 配置项
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_AUDIT_ALERTS_SCHEDULE='{"enabled":false,"cron":"* * * * *","timezone":"UTC"}'

# audit.backup — 可选的流式归档；自动执行由宿主现有 Scheduler 装配。
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_AUDIT_BACKUP='{"enabled":false,"batchSize":200,"maxRecordBytes":1048576,"schedule":{"enabled":false,"cron":"0 2 * * *","timezone":"UTC"}}'

# audit.backup.schedule — audit.backup.schedule 配置项
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_AUDIT_BACKUP_SCHEDULE='{"enabled":false,"cron":"0 2 * * *","timezone":"UTC"}'

# audit.capture — 框架入口自动采集；显式 audit.log 不受此开关影响。
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_AUDIT_CAPTURE='{"enabled":true,"includeReads":false}'

# audit.privacy — 凭据始终脱敏；此开关仅控制业务隐私字段。
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_AUDIT_PRIVACY='{"enabled":true,"fields":[]}'

# audit.privacy.fields — audit.privacy.fields 配置项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 1000
# HAI_AUDIT_PRIVACY_FIELDS='[]'

# audit.privacy.fields.0 — audit.privacy.fields.0 配置项
# 约束：字符串；最小字符数 1；最大字符数 256
# HAI_AUDIT_PRIVACY_FIELDS_0=''

# audit.retention — 未传时沿用数据库保留设置；显式关闭才解除保护。
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_AUDIT_RETENTION=''

# audit.userIdColumn — 用户表主键列名，用于 JOIN 条件
# 约束：字符串
# HAI_AUDIT_USERIDCOLUMN='id'

# audit.userNameColumn — 用户表用户名列名，用于 SELECT 输出
# 约束：字符串
# HAI_AUDIT_USERNAMECOLUMN='username'

# audit.userTable — 用户表名，用于 list 查询时 LEFT JOIN 获取用户名
# 约束：字符串
# HAI_AUDIT_USERTABLE='hai_iam_users'

# cache — cache. 配置对象
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_CACHE=''

# cache.cluster — 集群节点列表；配置后以集群模式连接
# 约束：JSON 数组；索引可按 0、1、2 扩展
# HAI_CACHE_CLUSTER=''

# cache.cluster.0 — 集群节点列表；配置后以集群模式连接；此变量整体替换单个数组项
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_CACHE_CLUSTER_0=''

# cache.cluster.0.host — 节点主机地址
# 约束：字符串
# HAI_CACHE_CLUSTER_0_HOST=''

# cache.cluster.0.port — 节点端口号（1~65535）
# 约束：整数；>= 1；<= 65535
# HAI_CACHE_CLUSTER_0_PORT=''

# cache.keyPrefix — 键前缀（自动加在所有键前）
# 约束：字符串
# HAI_CACHE_KEYPREFIX=''

# cache.sentinel — 哨兵配置；配置后以哨兵模式连接
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_CACHE_SENTINEL=''

# cache.sentinel.name — 哨兵监控的主节点名称
# 约束：字符串
# HAI_CACHE_SENTINEL_NAME=''

# cache.sentinel.sentinels — 哨兵节点列表（至少 1 个）
# 约束：JSON 数组；索引可按 0、1、2 扩展；最少项数 1
# HAI_CACHE_SENTINEL_SENTINELS=''

# cache.sentinel.sentinels.0 — 哨兵节点列表（至少 1 个）；此变量整体替换单个数组项
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_CACHE_SENTINEL_SENTINELS_0=''

# cache.sentinel.sentinels.0.host — 节点主机地址
# 约束：字符串
# HAI_CACHE_SENTINEL_SENTINELS_0_HOST=''

# cache.sentinel.sentinels.0.port — 节点端口号（1~65535）
# 约束：整数；>= 1；<= 65535
# HAI_CACHE_SENTINEL_SENTINELS_0_PORT=''

# core — core. 配置对象
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_CORE=''

# core.logging — 日志配置（可选）
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_CORE_LOGGING=''

# core.logging.context — 默认上下文，会自动添加到每条日志
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_CORE_LOGGING_CONTEXT=''

# core.logging.format — 日志格式：'json' 用于生产环境，'pretty' 用于开发环境（默认 'json'）
# 约束：字符串；取值：json | pretty
# HAI_CORE_LOGGING_FORMAT='json'

# core.logging.level — 日志级别（默认 'info'）
# 约束：字符串；取值：trace | debug | info | warn | error | fatal
# HAI_CORE_LOGGING_LEVEL='info'

# core.logging.redact — 要脱敏的字段路径列表（如 ['password', 'token']，默认 []）
# 约束：JSON 数组；索引可按 0、1、2 扩展
# HAI_CORE_LOGGING_REDACT='[]'

# core.logging.redact.0 — 要脱敏的字段路径列表（如 ['password', 'token']，默认 []）；此变量整体替换单个数组项
# 约束：字符串
# HAI_CORE_LOGGING_REDACT_0=''

# db — db. 配置对象
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_DB=''

# db.mysql — MySQL 特定选项
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_DB_MYSQL=''

# db.mysql.charset — 字符集（默认 utf8mb4），推荐使用 utf8mb4 支持完整 Unicode
# 约束：字符串
# HAI_DB_MYSQL_CHARSET='utf8mb4'

# db.operationLog — db 操作日志的读写开关、级别与字段截断规则
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_DB_OPERATIONLOG=''

# db.operationLog.level — 操作日志的输出级别
# 约束：字符串；取值：info | debug | trace
# HAI_DB_OPERATIONLOG_LEVEL='debug'

# db.operationLog.maxLength — 安全数量摘要的最大字符数；0 表示省略摘要，永不记录 SQL 原文或参数值。
# 约束：整数；>= 0；<= 9007199254740991
# HAI_DB_OPERATIONLOG_MAXLENGTH='1000'

# db.operationLog.read — 是否记录读取操作
# 约束：true | false
# HAI_DB_OPERATIONLOG_READ='false'

# db.operationLog.write — 是否记录写入操作
# 约束：true | false
# HAI_DB_OPERATIONLOG_WRITE='false'

# db.pool — 连接池配置：PostgreSQL支持min/idleTimeout；MySQL仅max/acquireTimeout/queueLimit，拒绝其他字段
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_DB_POOL=''

# db.pool.acquireTimeout — 获取连接超时，毫秒（默认10000）；PostgreSQL >=0，0禁用；MySQL排队+建连总期限为1–2147483647
# 约束：整数；PostgreSQL >=0（0禁用）；MySQL 1–2147483647
# HAI_DB_POOL_ACQUIRETIMEOUT='10000'

# db.pool.idleTimeout — PostgreSQL 空闲连接超时，毫秒（默认 30000；0 禁用）
# 约束：整数；>= 0；<= 9007199254740991
# HAI_DB_POOL_IDLETIMEOUT='30000'

# db.pool.max — 最大连接数（默认 10）
# 约束：整数；>= 1；<= 9007199254740991
# HAI_DB_POOL_MAX='10'

# db.pool.min — PostgreSQL 已建立连接的最小保留数（默认 1，不主动预建）
# 约束：整数；>= 0；<= 9007199254740991
# HAI_DB_POOL_MIN='1'

# db.pool.queueLimit — MySQL 等待队列最大请求数（默认 1000；正整数，不支持无限队列）
# 约束：整数；>= 1；<= 9007199254740991
# HAI_DB_POOL_QUEUELIMIT='1000'

# db.sqlite — SQLite 特定选项
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_DB_SQLITE=''

# db.sqlite.executor — 执行方式（默认 sync）。 - `sync`：主线程直接执行 better-sqlite3（同步阻塞主线程事件循环）。 - `worker`：在专用 worker 线程持有唯一连接执行，把阻塞移出主线程。 注意 WAL 只改善数据库锁并发，无法避免 better-sqlite3 同步调用占用调用线程。
# 约束：字符串；取值：sync | worker
# HAI_DB_SQLITE_EXECUTOR='sync'

# db.sqlite.readonly — 是否只读模式（默认 false）
# 约束：true | false
# HAI_DB_SQLITE_READONLY='false'

# db.sqlite.walMode — 是否启用 WAL 模式（默认 true），可提高并发读写性能
# 约束：true | false
# HAI_DB_SQLITE_WALMODE='true'

# db.sqlite.workerConnectTimeoutMs — worker 执行方式下等待连接打开的超时（毫秒，默认 10000）
# 约束：整数；<= 9007199254740991；> 0
# HAI_DB_SQLITE_WORKERCONNECTTIMEOUTMS='10000'

# db.ssl.ca — MySQL 信任的 CA，PEM 内容；省略时使用 Node 信任库
# 约束：字符串；最小字符数 1
# HAI_DB_SSL_CA=''

# db.ssl.cert — MySQL 客户端证书，PEM 内容；必须同时提供 key
# 约束：字符串；最小字符数 1
# HAI_DB_SSL_CERT=''

# db.ssl.key — MySQL 客户端私钥，PEM 内容；必须同时提供 cert
# 约束：字符串；最小字符数 1
# HAI_DB_SSL_KEY=''

# db.ssl.rejectUnauthorized — MySQL 是否校验证书链（默认 true）；false 明确放弃服务端认证
# 约束：true | false
# HAI_DB_SSL_REJECTUNAUTHORIZED='true'

# db.ssl.verifyIdentity — MySQL 是否验证 DNS 主机身份（默认 true）；仅证书链验证开启时有效
# 约束：true | false
# HAI_DB_SSL_VERIFYIDENTITY='true'

# feedback — feedback. 配置对象
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_FEEDBACK=''

# feedback.appId — 反馈所属应用标识；应与浏览器及 API 入口配置一致。
# 约束：字符串；最小字符数 1；最大字符数 128
# HAI_FEEDBACK_APPID=''

# feedback.appVersion — 当前应用版本，作为默认诊断信息保存。
# 约束：字符串；最大字符数 128
# HAI_FEEDBACK_APPVERSION=''

# feedback.buildId — 构建标识，帮助定位发布产物。
# 约束：字符串；最大字符数 128
# HAI_FEEDBACK_BUILDID=''

# feedback.commit — 源码提交标识，帮助定位对应代码。
# 约束：字符串；最大字符数 128
# HAI_FEEDBACK_COMMIT=''

# feedback.envAllowlist — 允许采集的服务端环境变量名；凭据类名称仍按敏感信息策略排除。
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 100
# HAI_FEEDBACK_ENVALLOWLIST='[]'

# feedback.envAllowlist.0 — 允许采集的服务端环境变量名；凭据类名称仍按敏感信息策略排除。；此变量整体替换单个数组项
# 约束：字符串；最小字符数 1；最大字符数 128
# HAI_FEEDBACK_ENVALLOWLIST_0=''

# feedback.leaseMs — 持久任务执行租约时长，单位毫秒；过期后允许其他实例接管。
# 约束：整数；>= 1000；<= 300000
# HAI_FEEDBACK_LEASEMS='30000'

# feedback.maxAttachmentBytes — 单个附件允许的最大字节数；同时受总预算约束。
# 约束：整数；>= 1；<= 5242880
# HAI_FEEDBACK_MAXATTACHMENTBYTES='5242880'

# feedback.maxAttempts — 汇集、通知、Webhook 和导出任务最大尝试次数；到期清理持续重试。
# 约束：整数；>= 1；<= 20
# HAI_FEEDBACK_MAXATTEMPTS='5'

# feedback.maxEvidenceBytes — 单份反馈累计证据允许的最大字节数。
# 约束：整数；>= 1024；<= 4194304
# HAI_FEEDBACK_MAXEVIDENCEBYTES='4194304'

# feedback.maxEvidenceCount — 单份反馈累计证据允许的最大条数。
# 约束：整数；>= 1；<= 10000
# HAI_FEEDBACK_MAXEVIDENCECOUNT='2000'

# feedback.notificationProvider — 已初始化 Reach Provider 的唯一名称，不限制为邮件。
# 约束：字符串；最小字符数 1
# HAI_FEEDBACK_NOTIFICATIONPROVIDER='email'

# feedback.recipients — Reach 接收方，由实际 Provider 校验邮箱、手机号或业务目的地。
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 20
# HAI_FEEDBACK_RECIPIENTS='[]'

# feedback.retentionDays — 已受理反馈及对象附件的保留天数。
# 约束：整数；>= 1；<= 3650
# HAI_FEEDBACK_RETENTIONDAYS='30'

# iam — iam. 配置对象
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_IAM=''

# iam.accounts — 账号自动休眠策略；未配置时不启动扫描。
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_IAM_ACCOUNTS=''

# iam.agreements — 协议展示配置
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_IAM_AGREEMENTS='{"showOnRegister":true,"showOnLogin":false}'

# iam.agreements.privacyPolicyMarkdown — 隐私协议 Markdown 正文；YAML 使用 | 保留段落和换行。
# 约束：字符串；最小字符数 1
# HAI_IAM_AGREEMENTS_PRIVACYPOLICYMARKDOWN=''

# iam.agreements.privacyPolicyUrl — 隐私协议 URL
# 约束：字符串；格式 uri
# HAI_IAM_AGREEMENTS_PRIVACYPOLICYURL=''

# iam.agreements.showOnLogin — 登录时展示协议
# 约束：true | false
# HAI_IAM_AGREEMENTS_SHOWONLOGIN='false'

# iam.agreements.showOnRegister — 注册时展示协议
# 约束：true | false
# HAI_IAM_AGREEMENTS_SHOWONREGISTER='true'

# iam.agreements.userAgreementMarkdown — 用户协议 Markdown 正文；同时配置 URL 时优先显示正文。
# 约束：字符串；最小字符数 1
# HAI_IAM_AGREEMENTS_USERAGREEMENTMARKDOWN=''

# iam.agreements.userAgreementUrl — 用户协议 URL
# 约束：字符串；格式 uri
# HAI_IAM_AGREEMENTS_USERAGREEMENTURL=''

# iam.apikey — API Key 配置
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_IAM_APIKEY=''

# iam.apikey.defaultExpirationDays — API Key 默认有效期（天，0 表示永不过期，默认 0）
# 约束：整数；>= 0；<= 9007199254740991
# HAI_IAM_APIKEY_DEFAULTEXPIRATIONDAYS='0'

# iam.apikey.maxKeysPerUser — 单用户最大 API Key 数量（默认 10）
# 约束：整数；>= 1；<= 9007199254740991
# HAI_IAM_APIKEY_MAXKEYSPERUSER='10'

# iam.apikey.prefix — API Key 前缀（默认 'hai_'）
# 约束：字符串
# HAI_IAM_APIKEY_PREFIX='hai_'

# iam.captcha — 可选的自托管交互挑战。
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_IAM_CAPTCHA='{"enabled":false,"ttlSeconds":120,"cost":5000,"maxCounter":100}'

# iam.initialCredentials — 管理端可用单次邀请代替共享初始密码；需要已配置的密码重置通知通道。
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_IAM_INITIALCREDENTIALS=''

# iam.ldap — LDAP 配置
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_IAM_LDAP=''

# iam.ldap.bindDn — 绑定 DN
# 约束：字符串
# HAI_IAM_LDAP_BINDDN=''

# iam.ldap.connectTimeout — 连接超时（毫秒）
# 约束：整数；>= 1000；<= 9007199254740991
# HAI_IAM_LDAP_CONNECTTIMEOUT='5000'

# iam.ldap.displayNameAttribute — 显示名称属性
# 约束：字符串
# HAI_IAM_LDAP_DISPLAYNAMEATTRIBUTE='cn'

# iam.ldap.emailAttribute — 邮箱属性
# 约束：字符串
# HAI_IAM_LDAP_EMAILATTRIBUTE='mail'

# iam.ldap.searchBase — 搜索基础 DN
# 约束：字符串
# HAI_IAM_LDAP_SEARCHBASE=''

# iam.ldap.searchFilter — 搜索过滤器（默认使用 uid）
# 约束：字符串
# HAI_IAM_LDAP_SEARCHFILTER='(uid={{username}})'

# iam.ldap.url — LDAP 服务器 URL
# 约束：字符串；格式 uri
# HAI_IAM_LDAP_URL=''

# iam.ldap.usernameAttribute — 用户名属性
# 约束：字符串
# HAI_IAM_LDAP_USERNAMEATTRIBUTE='uid'

# iam.ldap.useTls — 启用 TLS
# 约束：true | false
# HAI_IAM_LDAP_USETLS='false'

# iam.login — 登录启用配置
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_IAM_LOGIN='{"password":true,"otp":true,"ldap":false,"apikey":false}'

# iam.login.apikey — 是否启用 API Key 登录
# 约束：true | false
# HAI_IAM_LOGIN_APIKEY='false'

# iam.loginAccess — 宿主提供可信客户端地址；绝不从凭据 JSON 或任意转发头取得 IP。
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_IAM_LOGINACCESS=''

# iam.loginAccess.allowIps — iam.loginAccess.allowIps 配置项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 1000
# HAI_IAM_LOGINACCESS_ALLOWIPS='[]'

# iam.loginAccess.allowIps.0 — iam.loginAccess.allowIps.0 配置项
# 约束：字符串；格式 ipv4；正则 ^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$；格式 ipv6；正则 ^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$；格式 cidrv4；正则 ^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\/([0-9]|[1-2][0-9]|3[0-2])$；格式 cidrv6；正则 ^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))\/(12[0-8]|1[01][0-9]|[1-9]?[0-9])$
# HAI_IAM_LOGINACCESS_ALLOWIPS_0=''

# iam.loginAccess.denyIps — iam.loginAccess.denyIps 配置项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 1000
# HAI_IAM_LOGINACCESS_DENYIPS='[]'

# iam.loginAccess.denyIps.0 — iam.loginAccess.denyIps.0 配置项
# 约束：字符串；格式 ipv4；正则 ^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$；格式 ipv6；正则 ^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$；格式 cidrv4；正则 ^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\/([0-9]|[1-2][0-9]|3[0-2])$；格式 cidrv6；正则 ^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))\/(12[0-8]|1[01][0-9]|[1-9]?[0-9])$
# HAI_IAM_LOGINACCESS_DENYIPS_0=''

# iam.loginAccess.windows — iam.loginAccess.windows 配置项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 100
# HAI_IAM_LOGINACCESS_WINDOWS='[]'

# iam.loginAccess.windows.0 — iam.loginAccess.windows.0 配置项
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_IAM_LOGINACCESS_WINDOWS_0=''

# iam.loginAccess.windows.0.days — iam.loginAccess.windows.0.days 配置项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最少项数 1；最多项数 7
# HAI_IAM_LOGINACCESS_WINDOWS_0_DAYS=''

# iam.loginAccess.windows.0.days.0 — iam.loginAccess.windows.0.days.0 配置项
# 约束：整数；>= 1；<= 7
# HAI_IAM_LOGINACCESS_WINDOWS_0_DAYS_0=''

# iam.loginAccess.windows.0.end — iam.loginAccess.windows.0.end 配置项
# 约束：字符串；正则 ^(?:[01]\d|2[0-3]):[0-5]\d$
# HAI_IAM_LOGINACCESS_WINDOWS_0_END=''

# iam.loginAccess.windows.0.start — iam.loginAccess.windows.0.start 配置项
# 约束：字符串；正则 ^(?:[01]\d|2[0-3]):[0-5]\d$
# HAI_IAM_LOGINACCESS_WINDOWS_0_START=''

# iam.otp — OTP 配置
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_IAM_OTP=''

# iam.password — 密码配置
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_IAM_PASSWORD=''

# iam.passwordReset — 密码重置配置
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_IAM_PASSWORDRESET=''

# iam.passwordReset.resetUrl — 重置页面的绝对地址，通知模板可使用 resetUrl。
# 约束：字符串；格式 uri
# HAI_IAM_PASSWORDRESET_RESETURL=''

# iam.rbac — RBAC 配置
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_IAM_RBAC='{"enabled":true,"superAdminRole":"super_admin","defaultRole":"user"}'

# iam.rbac.defaultRole — 默认用户角色
# 约束：字符串
# HAI_IAM_RBAC_DEFAULTROLE='user'

# iam.rbac.enabled — 是否启用 RBAC
# 约束：true | false
# HAI_IAM_RBAC_ENABLED='true'

# iam.rbac.superAdminRole — 超级管理员角色代码
# 约束：字符串
# HAI_IAM_RBAC_SUPERADMINROLE='super_admin'

# iam.reauthentication — 指定敏感操作额外验证原密码；凭据短期且单次使用。
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_IAM_REAUTHENTICATION=''

# iam.reauthentication.operations — 音频模型支持的操作
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 1000
# HAI_IAM_REAUTHENTICATION_OPERATIONS='[]'

# iam.reauthentication.operations.0 — 音频模型支持的操作
# 约束：字符串；最小字符数 1；最大字符数 128
# HAI_IAM_REAUTHENTICATION_OPERATIONS_0=''

# iam.register — 注册配置
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_IAM_REGISTER='{"enabled":true,"defaultEnabled":true}'

# iam.security — 安全策略配置
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_IAM_SECURITY='{"lockoutEnabled":true,"failureWindow":86400,"maxLoginAttempts":5,"lockoutDuration":900}'

# iam.session — 会话配置
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_IAM_SESSION=''

# iam.ui — 认证页外观
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_IAM_UI=''

# iam.ui.brandText — 认证页品牌介绍正文
# 约束：字符串
# HAI_IAM_UI_BRANDTEXT=''

# iam.ui.brandTitle — 认证页品牌区域标题
# 约束：字符串
# HAI_IAM_UI_BRANDTITLE=''

# iam.ui.illustrationUrl — 认证页插图 URL
# 约束：字符串
# HAI_IAM_UI_ILLUSTRATIONURL=''

# iam.ui.logoUrl — 认证页品牌 Logo URL
# 约束：字符串
# HAI_IAM_UI_LOGOURL=''

# iam.ui.subtitle — 认证面板副标题
# 约束：字符串
# HAI_IAM_UI_SUBTITLE=''

# iam.ui.title — 认证面板标题
# 约束：字符串
# HAI_IAM_UI_TITLE=''

# iam.ui.variant — 认证页布局样式
# 约束：字符串；取值：card | split
# HAI_IAM_UI_VARIANT='card'

# kit — kit. 配置对象
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_KIT=''

# HAI_KIT_COOKIE_KEY — kit Cookie 加密密钥
# 约束：满足 crypto SM4 密钥格式；敏感值仅本机或目标进程注入
# HAI_KIT_COOKIE_KEY=''

# kit.server — HTTP 服务监听地址与端口
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_KIT_SERVER=''

# kit.transport — 传输加密开关或密钥协商配置
# 约束：true | false；JSON 对象；整体覆盖时替换该节点；取值：false
# HAI_KIT_TRANSPORT='false'

# kit.transport.excludePaths — 不进入传输加密管道的路径
# 约束：JSON 数组；索引可按 0、1、2 扩展
# HAI_KIT_TRANSPORT_EXCLUDEPATHS='[]'

# reach — reach. 配置对象
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_REACH=''

# reach.dnd — 免打扰配置
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_REACH_DND=''

# reach.dnd.enabled — 是否启用免打扰（默认 false）
# 约束：true | false
# HAI_REACH_DND_ENABLED='false'

# reach.dnd.end — 免打扰结束时间（HH:mm 格式）
# 约束：字符串；正则 ^([01]\d|2[0-3]):[0-5]\d$
# HAI_REACH_DND_END='00:00'

# reach.dnd.start — 免打扰开始时间（HH:mm 格式）
# 约束：字符串；正则 ^([01]\d|2[0-3]):[0-5]\d$
# HAI_REACH_DND_START='00:00'

# reach.dnd.strategy — discard 丢弃；delay 要求数据库队列就绪并确认入队（默认 discard）。
# 约束：字符串；取值：discard | delay
# HAI_REACH_DND_STRATEGY='discard'

# reach.providers — Provider 配置列表
# 约束：JSON 数组；索引可按 0、1、2 扩展；最少项数 1
# HAI_REACH_PROVIDERS=''

# reach.providers.0 — Provider 配置列表；此变量整体替换单个数组项
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_REACH_PROVIDERS_0=''

# reach.providers.0.accessKeyId — 阿里云 AccessKey ID
# 约束：字符串；最小字符数 1
# HAI_REACH_PROVIDERS_0_ACCESSKEYID=''

# reach.providers.0.accessKeySecret — 阿里云 AccessKey Secret
# 约束：字符串；最小字符数 1
# HAI_REACH_PROVIDERS_0_ACCESSKEYSECRET=''

# reach.providers.0.endpoint — API 端点（默认 dysmsapi.aliyuncs.com）
# 约束：字符串
# HAI_REACH_PROVIDERS_0_ENDPOINT='dysmsapi.aliyuncs.com'

# reach.providers.0.from — 发件人地址
# 约束：字符串；最小字符数 1
# HAI_REACH_PROVIDERS_0_FROM='noreply@example.com'

# reach.providers.0.headers — 自定义请求头
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_REACH_PROVIDERS_0_HEADERS=''

# HAI_REACH_PROVIDERS_0_HEADERS_AUTHORIZATION — API 通知 Provider 的完整 Authorization 请求头
# 约束：敏感字符串，包含认证方案及凭据，例如 Bearer <token>
# HAI_REACH_PROVIDERS_0_HEADERS_AUTHORIZATION=''

# reach.providers.0.host — SMTP 服务器地址
# 约束：字符串；最小字符数 1
# HAI_REACH_PROVIDERS_0_HOST='smtp.example.com'

# reach.providers.0.idempotent — 接收端按 Idempotency-Key 原子持久去重，且覆盖所有重试与旧节点迟到请求时才启用；默认 false。
# 约束：true | false
# HAI_REACH_PROVIDERS_0_IDEMPOTENT='false'

# reach.providers.0.method — HTTP 方法（默认 POST）
# 约束：字符串；取值：POST | PUT
# HAI_REACH_PROVIDERS_0_METHOD='POST'

# reach.providers.0.name — Provider 唯一名称
# 约束：字符串；最小字符数 1
# HAI_REACH_PROVIDERS_0_NAME=''

# reach.providers.0.pass — SMTP 认证密码
# 约束：字符串
# HAI_REACH_PROVIDERS_0_PASS=''

# reach.providers.0.port — SMTP 端口（默认 465）
# 约束：整数；>= 1；<= 65535
# HAI_REACH_PROVIDERS_0_PORT='465'

# reach.providers.0.secure — 是否使用 TLS（默认 true）
# 约束：true | false
# HAI_REACH_PROVIDERS_0_SECURE='true'

# reach.providers.0.signName — 短信签名
# 约束：字符串；最小字符数 1
# HAI_REACH_PROVIDERS_0_SIGNNAME=''

# reach.providers.0.timeout — 请求超时毫秒数（默认 10000）
# 约束：整数；>= 0；<= 9007199254740991
# HAI_REACH_PROVIDERS_0_TIMEOUT='10000'

# reach.providers.0.url — 回调 URL
# 约束：字符串；格式 uri
# HAI_REACH_PROVIDERS_0_URL=''

# reach.providers.0.user — SMTP 认证用户名
# 约束：字符串
# HAI_REACH_PROVIDERS_0_USER=''

# reach.queue — 可靠队列重试策略；每条消息入队时持久保存。
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_REACH_QUEUE='{}'

# reach.queue.maxAttempts — 自动领取次数上限（含首次及崩溃恢复，默认 5，范围 1–100）。
# 约束：整数；>= 1；<= 100
# HAI_REACH_QUEUE_MAXATTEMPTS='5'

# reach.queue.maxRetryDelayMs — 指数退避上限毫秒数，不得小于 retryDelayMs（默认 3600000）。
# 约束：整数；>= 1000；<= 86400000
# HAI_REACH_QUEUE_MAXRETRYDELAYMS='3600000'

# reach.queue.retryDelayMs — 首次失败后的退避毫秒数（默认 60000，范围 1000–86400000）。
# 约束：整数；>= 1000；<= 86400000
# HAI_REACH_QUEUE_RETRYDELAYMS='60000'

# reach.templates — 模板配置（通过配置文件注册）
# 约束：JSON 数组；索引可按 0、1、2 扩展
# HAI_REACH_TEMPLATES=''

# reach.templates.0 — 模板配置（通过配置文件注册）；此变量整体替换单个数组项
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_REACH_TEMPLATES_0=''

# reach.templates.0.body — 正文模板
# 约束：字符串；最小字符数 1
# HAI_REACH_TEMPLATES_0_BODY=''

# reach.templates.0.name — 模板名称
# 约束：字符串；最小字符数 1
# HAI_REACH_TEMPLATES_0_NAME=''

# reach.templates.0.provider — 绑定的 Provider 名称
# 约束：字符串；最小字符数 1
# HAI_REACH_TEMPLATES_0_PROVIDER=''

# reach.templates.0.subject — 邮件主题模板
# 约束：字符串
# HAI_REACH_TEMPLATES_0_SUBJECT=''

# scheduler — scheduler. 配置对象
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_SCHEDULER=''

# scheduler.enableDb — 必须使用共享数据库保存执行状态；false 不再允许，需要先初始化
# 约束：true | false；取值：true
# HAI_SCHEDULER_ENABLEDB='true'

# scheduler.maxLogs — 执行日志最大保留条数（启用 DB 时生效）
# 约束：整数；>= 1；<= 9007199254740991
# HAI_SCHEDULER_MAXLOGS=''

# scheduler.nodeId — 节点标识（默认自动生成 UUID，多节点部署时建议设置固定标识以便审计）
# 约束：字符串；最小字符数 1
# HAI_SCHEDULER_NODEID=''

# scheduler.retentionDays — 执行日志保留天数（启用 DB 时生效）
# 约束：整数；>= 1；<= 9007199254740991
# HAI_SCHEDULER_RETENTIONDAYS=''

# storage — storage. 配置对象
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_STORAGE=''

# storage.directoryMode — 目录创建权限
# 约束：数字
# HAI_STORAGE_DIRECTORYMODE='493'

# storage.fileMode — 文件创建权限
# 约束：数字
# HAI_STORAGE_FILEMODE='420'

# storage.operationLog — storage 操作日志的读写开关、级别与字段截断规则
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_STORAGE_OPERATIONLOG=''

# storage.operationLog.level — 操作日志的输出级别
# 约束：字符串；取值：info | debug | trace
# HAI_STORAGE_OPERATIONLOG_LEVEL='debug'

# storage.operationLog.maxLength — 操作日志字段的最大字符数，0 表示不截断
# 约束：整数；>= 0；<= 9007199254740991
# HAI_STORAGE_OPERATIONLOG_MAXLENGTH='1000'

# storage.operationLog.read — 是否记录读取操作
# 约束：true | false
# HAI_STORAGE_OPERATIONLOG_READ='false'

# storage.operationLog.write — 是否记录写入操作
# 约束：true | false
# HAI_STORAGE_OPERATIONLOG_WRITE='false'

# storage.prefix — 路径前缀（所有操作都会加上此前缀）
# 约束：字符串
# HAI_STORAGE_PREFIX=''

# storage.publicUrl — 公开访问基础 URL（用于生成公开 URL）
# 约束：字符串；格式 uri
# HAI_STORAGE_PUBLICURL=''

# deploy — deploy. 配置对象
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_DEPLOY=''

# HAI_DEPLOY_ASKPASS_PASSWORD — 凭据输入；使用位置 packages/deploy/src/container/deploy-ssh-askpass.ts
# 约束：敏感字符串；启用相应功能时必填，不得提交真实值
# HAI_DEPLOY_ASKPASS_PASSWORD=''

# deploy.container — Docker Compose 部署参数；构建配置位于项目 hai.json.build。
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_DEPLOY_CONTAINER=''

# deploy.environment — 部署环境文件模式；dev/test/prod 或自定义模式，禁止 local/example。
# 约束：字符串；正则 ^[a-z0-9][\w-]*$
# HAI_DEPLOY_ENVIRONMENT=''

# deploy.provider — 应用部署目标平台及其连接参数，按 type 选择对应平台字段
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_DEPLOY_PROVIDER=''

# deploy.provider.expose — 应用暴露方式
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_DEPLOY_PROVIDER_EXPOSE=''

# deploy.provider.remote — 远程主机运行参数
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_DEPLOY_PROVIDER_REMOTE='{"baseDir":"/opt/hai/apps","runtime":"auto"}'

# deploy.provider.ssh — SSH 连接参数
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_DEPLOY_PROVIDER_SSH=''

# deploy.provider.ssh.auth — 认证方式；省略时非空 password 使用密码，否则保留私钥/agent；显式 key 忽略残留密码。
# 约束：字符串；取值：key | password
# HAI_DEPLOY_PROVIDER_SSH_AUTH='key'

# deploy.provider.ssh.connectTimeoutSeconds — 连接超时（秒）
# 约束：整数；<= 9007199254740991；> 0
# HAI_DEPLOY_PROVIDER_SSH_CONNECTTIMEOUTSECONDS='10'

# deploy.provider.ssh.knownHostsFile — known_hosts 文件路径（省略时使用默认；配合 CI/临时环境隔离主机指纹）
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_PROVIDER_SSH_KNOWNHOSTSFILE=''

# deploy.provider.ssh.password — SSH 密码（保留原值）；密码方式必须非空、无 CR/LF/NUL，UTF-8 不超过 1023 字节。
# 约束：字符串
# HAI_DEPLOY_PROVIDER_SSH_PASSWORD=''

# deploy.provider.ssh.strictHostKeyChecking — 严格主机密钥校验，默认开启（true→accept-new 首次信任并拒绝变更；false→关闭校验）
# 约束：true | false
# HAI_DEPLOY_PROVIDER_SSH_STRICTHOSTKEYCHECKING='true'

# deploy.provider.token — 应用部署：部署平台访问令牌
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_PROVIDER_TOKEN=''

# deploy.services — 自动开通依赖服务的服务商及连接配置
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_DEPLOY_SERVICES=''

# deploy.services.cache — 自动开通缓存服务的服务商及连接配置
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_DEPLOY_SERVICES_CACHE=''

# deploy.services.cache.apiKey — 自动开通 cache 服务：服务商 API 密钥
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_SERVICES_CACHE_APIKEY=''

# deploy.services.cache.email — 自动开通 cache 服务：服务商账号邮箱
# 约束：字符串；格式 email；正则 ^(?:[A-Za-z0-9_'+\-]+\.)*[A-Za-z0-9_'+\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\-]*\.)+[A-Za-z]{2,}$
# HAI_DEPLOY_SERVICES_CACHE_EMAIL=''

# deploy.services.cache.provisioner — 自动开通 cache 服务：资源开通服务商
# 约束：字符串；取值：upstash
# HAI_DEPLOY_SERVICES_CACHE_PROVISIONER='upstash'

# deploy.services.db — 自动开通关系数据库服务的服务商及连接配置
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_DEPLOY_SERVICES_DB=''

# deploy.services.db.apiKey — 自动开通 db 服务：服务商 API 密钥
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_SERVICES_DB_APIKEY=''

# deploy.services.db.provisioner — 自动开通 db 服务：资源开通服务商
# 约束：字符串；取值：neon
# HAI_DEPLOY_SERVICES_DB_PROVISIONER='neon'

# deploy.services.email — 自动开通 email 服务：服务商账号邮箱
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_DEPLOY_SERVICES_EMAIL=''

# deploy.services.email.apiKey — 自动开通 email 服务：服务商 API 密钥
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_SERVICES_EMAIL_APIKEY=''

# deploy.services.email.from — 自动开通 email 服务：已验证域名的发件邮箱
# 约束：字符串；格式 email；正则 ^(?:[A-Za-z0-9_'+\-]+\.)*[A-Za-z0-9_'+\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\-]*\.)+[A-Za-z]{2,}$
# HAI_DEPLOY_SERVICES_EMAIL_FROM=''

# deploy.services.email.provisioner — 自动开通 email 服务：资源开通服务商
# 约束：字符串；取值：resend
# HAI_DEPLOY_SERVICES_EMAIL_PROVISIONER='resend'

# deploy.services.sms — 是否允许短信验证码
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_DEPLOY_SERVICES_SMS=''

# deploy.services.sms.accessKeyId — 自动开通 sms 服务：服务商访问密钥 ID
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_SERVICES_SMS_ACCESSKEYID=''

# deploy.services.sms.accessKeySecret — 自动开通 sms 服务：服务商访问密钥 Secret
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_SERVICES_SMS_ACCESSKEYSECRET=''

# deploy.services.sms.provisioner — 自动开通 sms 服务：资源开通服务商
# 约束：字符串；取值：aliyun
# HAI_DEPLOY_SERVICES_SMS_PROVISIONER='aliyun'

# deploy.services.sms.signName — 自动开通 sms 服务：短信服务审核通过的签名
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_SERVICES_SMS_SIGNNAME=''

# deploy.services.storage — 自动开通对象存储服务的服务商及连接配置
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_DEPLOY_SERVICES_STORAGE=''

# deploy.services.storage.accessKeyId — 自动开通 storage 服务：服务商访问密钥 ID
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_SERVICES_STORAGE_ACCESSKEYID=''

# deploy.services.storage.accountId — 自动开通 storage 服务：Cloudflare 账号 ID
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_SERVICES_STORAGE_ACCOUNTID=''

# deploy.services.storage.apiToken — 自动开通 storage 服务：Cloudflare API 令牌
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_SERVICES_STORAGE_APITOKEN=''

# deploy.services.storage.provisioner — 自动开通 storage 服务：资源开通服务商
# 约束：字符串；取值：cloudflare-r2
# HAI_DEPLOY_SERVICES_STORAGE_PROVISIONER='cloudflare-r2'

# deploy.services.storage.secretAccessKey — 自动开通 storage 服务：对象存储访问密钥 Secret
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_SERVICES_STORAGE_SECRETACCESSKEY=''

# BASE_URL — Playwright 验收访问的前端基础地址
# 约束：有效 HTTP(S) URL；按项目 Playwright 配置选择默认端口
# BASE_URL=''

# ADMIN_E2E_BASE_URL — 管理台独立 E2E 服务地址，可由根验收透传以避开其它工作区端口
# 约束：本机 HTTP(S) URL；直接运行时 BASE_URL 优先
# ADMIN_E2E_BASE_URL=''

# HAI_E2E_DATA_ROOT — 端到端测试的隔离运行数据目录
# 约束：目录路径
# HAI_E2E_DATA_ROOT=''

# CI — 持续集成环境标记
# 约束：true 或 1 启用；未设置为本地运行
# CI=''

# HAI_CRYPTO_TRANSPORT_SERVERKEYRING — 服务端受管版本化传输密钥环；仅私有环境或 Secret Manager 注入
# 约束：JSON 对象 {activeKeyId,keys:{id:{publicKey,privateKey}}}；所有节点共享，ID 为 1-64 个字母/数字/下划线/连字符；禁止 PUBLIC_/VITE_/公开 YAML/日志
# HAI_CRYPTO_TRANSPORT_SERVERKEYRING=''

# NODE_ENV — Node/Vite 运行模式
# 约束：development | test | production
# NODE_ENV=''

# HAI_E2E — 示例/模板端到端测试开关
# 约束：1 启用；其余值关闭
# HAI_E2E=''

# HAI_E2E_MOCK — AI 示例使用确定性端到端测试服务
# 约束：1 启用；其余值关闭
# HAI_E2E_MOCK=''

# HAI_AUDIT_ADMIN_PASSWORD — 首次创建审计管理员的独立密码
# 约束：满足 IAM 密码策略；仅在本地或目标进程注入；已有账号不改密
# HAI_AUDIT_ADMIN_PASSWORD=''

# HAI_CONFIG_ADMIN_PASSWORD — 首次创建业务配置员的独立密码
# 约束：满足 IAM 密码策略；仅在本地或目标进程注入；已有账号不改密
# HAI_CONFIG_ADMIN_PASSWORD=''

# HAI_BUSINESS_OPERATOR_PASSWORD — 首次创建业务操作员的独立密码
# 约束：满足 IAM 密码策略；仅在本地或目标进程注入；已有账号不改密
# HAI_BUSINESS_OPERATOR_PASSWORD=''

# HAI_ADMIN_DEFAULT_PASSWORD — 首次创建管理员的密码
# 约束：满足 IAM 密码策略；敏感值仅在本地或目标进程注入
# HAI_ADMIN_DEFAULT_PASSWORD=''

# ai.llm.apiKey — 全局 API Key（各模型 fallback；未提供时回退到 `process.env.HAI_AI_LLM_APIKEY` 或 `process.env.OPENAI_API_KEY`）
# 约束：string,null
# HAI_AI_LLM_APIKEY=''

# POLLINATIONS_API_KEY — POLLINATIONS 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# POLLINATIONS_API_KEY=''

# HAI_BUILD_COMMIT — 当前编译目标所属的源码提交；无所属 Git 提交时明确 unknown
# 约束：40或64位十六进制 Git SHA，或 unknown；hai build 内部确定，不继承调用者的同名值
# HAI_BUILD_COMMIT=''

# HAI_BUILD_ID — CLI 内部生成并向编译目标传递的产物标识；同次 SSR 构建复用
# 约束：非空字母、数字、下划线、点、加减号，最多128字符；显式非法值拒绝构建；hai build 不继承调用者的同名值
# HAI_BUILD_ID=''

# HOST — 部署平台 HTTP 监听地址，覆盖 serv/kit server.host
# 约束：主机名或 IP
# HOST='0.0.0.0'

# PORT — 部署平台 HTTP 监听端口，覆盖 serv/kit server.port
# 约束：整数 1–65535
# PORT='8000'
