{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "tests",
    "*.ts",
    "*.js"
  ],
  "exclude": [
    "node_modules",
    "build",
    "src/service-worker"
  ]
}
