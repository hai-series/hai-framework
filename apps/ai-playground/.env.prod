# 公共生产配置：服务名对应 Compose 内部 DNS。
# 凭据必须通过 Secret/进程环境或忽略的 .env.local 注入，禁止写入本文件。
HAI_CORE_ENV=production
HAI_CORE_DEBUG=false
HAI_CORE_LOGGING_LEVEL=info

# 必须私有注入 HAI_DB_PASSWORD。
HAI_DB_TYPE=postgresql
HAI_DB_HOST=db
HAI_DB_PORT=5432
HAI_DB_DATABASE=hai
HAI_DB_USER=postgres

# 必须私有注入 HAI_CACHE_PASSWORD。
HAI_CACHE_TYPE=redis
HAI_CACHE_HOST=cache
HAI_CACHE_PORT=6379

# 受保护的 Qdrant 须私有注入 HAI_VECDB_APIKEY。
HAI_VECDB_TYPE=qdrant
HAI_VECDB_URL=http://vecdb:6333
