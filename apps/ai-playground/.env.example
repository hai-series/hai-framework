# AI model API credential. Overrides config/_ai.yml llm.apiKey by convention.
HAI_AI_LLM_APIKEY=

# Pollinations image credential used by config/_ai.yml.
AI_IMAGE_API_KEY=

# Any YAML leaf can be overridden with HAI_<config name>_<YAML path>.
