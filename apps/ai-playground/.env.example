# AI model API credential. Copy this file to .env and fill the value locally.
AI_API_KEY=

# Optional model/endpoint overrides. Defaults target the Xiaomi MiMo models,
# but any OpenAI-compatible endpoint works by overriding these values.
AI_BASE_URL=https://api.xiaomimimo.com/v1
AI_LLM_MODEL=mimo-v2.5
AI_TTS_MODEL=mimo-v2.5-tts
AI_ASR_MODEL=mimo-v2.5-asr

# Audio provider adapter: openai | mimo | qwen | doubao
AI_AUDIO_PROVIDER=mimo

# Optional comma-separated TTS voice list shown in the UI.
# AI_TTS_VOICES=alloy,echo,fable
