{
  "build": {
    "images": [
      {
        "name": "serv",
        "context": "../..",
        "dockerfile": "images/serv.Dockerfile",
        "containerPort": 3000
      }
    ]
  },
  "deploy": {
    "provider": {
      "type": "docker-ssh",
      "expose": {
        "hostPort": 18080
      }
    },
    "container": {
      "s3Engine": "${HAI_DEPLOY_CONTAINER_S3ENGINE:rustfs}"
    }
  }
}
