{
  "name": "api-service",
  "type": "module",
  "version": "0.1.0-alpha.68",
  "private": true,
  "description": "hai Agent Framework - 无头 REST API 服务示例应用",
  "keywords": [
    "hai",
    "api",
    "hono",
    "orpc"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "dev": "tsup --watch --onSuccess \"node --env-file=.env --env-file=.env.dev --env-file-if-exists=.env.local dist/index.js\"",
    "dev:test": "tsup --watch --onSuccess \"node --env-file=.env --env-file=.env.test --env-file-if-exists=.env.local dist/index.js\"",
    "dev:prod": "tsup --watch --onSuccess \"node --env-file=.env --env-file=.env.prod --env-file-if-exists=.env.local dist/index.js\"",
    "build": "hai build",
    "preview": "pnpm start",
    "start": "node --env-file=.env --env-file=.env.prod --env-file-if-exists=.env.local dist/index.js",
    "start:test": "node --env-file=.env --env-file=.env.test --env-file-if-exists=.env.local dist/index.js",
    "start:prod": "pnpm start",
    "check": "pnpm typecheck",
    "typecheck": "node ../../scripts/typecheck.mjs --noEmit",
    "lint": "eslint src tests tsup.config.ts vitest.config.ts",
    "lint:fix": "eslint src tests tsup.config.ts vitest.config.ts --fix",
    "test": "vitest run",
    "clean": "rimraf dist .turbo",
    "test:watch": "vitest",
    "compile": "tsup",
    "build:images": "hai build --target docker",
    "deploy": "hai deploy"
  },
  "dependencies": {
    "@h-ai/ai": "workspace:*",
    "@h-ai/api-contract": "workspace:*",
    "@h-ai/api-service-contract": "workspace:*",
    "@h-ai/cache": "workspace:*",
    "@h-ai/core": "workspace:*",
    "@h-ai/crypto": "workspace:*",
    "@h-ai/iam": "workspace:*",
    "@h-ai/reach": "workspace:*",
    "@h-ai/reldb": "workspace:*",
    "@h-ai/serv": "workspace:*",
    "@h-ai/storage": "workspace:*",
    "@h-ai/vecdb": "workspace:*",
    "@lancedb/lancedb": "catalog:"
  },
  "devDependencies": {
    "@h-ai/api-client": "workspace:*",
    "@h-ai/cli": "workspace:*",
    "@h-ai/deploy": "workspace:*",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
