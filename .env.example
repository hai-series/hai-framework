# =============================================================================
# hai-framework unified environment variables (workspace-level)
# =============================================================================
# Copy this file to .env and fill real values for your local/dev environment.
# Config convention: HAI_<config name>_<YAML path>; environment overrides YAML.
# =============================================================================

# --- Core / runtime ---
HAI_CORE_ENV=development
HAI_CORE_DEBUG=false
# HAI_CORE_NAME=my-app
# HAI_CORE_LOGGING_LEVEL=info
# HAI_CORE_LOGGING_FORMAT=pretty

# --- Database (reldb) ---
HAI_DB_TYPE=sqlite
HAI_DB_DATABASE=./data/app.db
# HAI_DB_HOST=localhost
# HAI_DB_PORT=5432
# HAI_DB_USER=postgres
# HAI_DB_PASSWORD=
# Optional unified DSN (some deploy workflows output this)
# HAI_DB_URL=

# --- Cache (cache) ---
HAI_CACHE_TYPE=memory
# HAI_CACHE_URL=redis://localhost:6379/0
# HAI_CACHE_HOST=localhost
# HAI_CACHE_PORT=6379
# HAI_CACHE_PASSWORD=
# HAI_CACHE_DB=0
# HAI_CACHE_CONNECT_TIMEOUT=10000
# HAI_CACHE_COMMAND_TIMEOUT=5000
# HAI_CACHE_KEY_PREFIX=hai:
# Deploy-generated Upstash style vars
# HAI_CACHE_UPSTASH_URL=
# HAI_CACHE_UPSTASH_TOKEN=

# --- Session / Auth (iam + kit) ---
# HAI_IAM_PASSWORD_MINLENGTH=8
# HAI_IAM_SESSION_MAXAGE=86400
# HAI_IAM_SESSION_REFRESHTOKENMAXAGE=604800
# HAI_IAM_SECURITY_MAXLOGINATTEMPTS=5
# HAI_KIT_COOKIE_KEY=                 # 32-char hex key for SM4-CBC cookie encryption

# --- Storage (storage) ---
HAI_STORAGE_TYPE=local
HAI_STORAGE_ROOT=./data/uploads
# HAI_STORAGE_BUCKET=
# HAI_STORAGE_REGION=us-east-1
# HAI_STORAGE_ACCESSKEYID=
# HAI_STORAGE_SECRETACCESSKEY=
# HAI_STORAGE_ENDPOINT=
# HAI_STORAGE_FORCEPATHSTYLE=false

# --- AI (ai) ---
# Convention keys override YAML; OPENAI_* remains a module compatibility fallback.
# HAI_AI_LLM_APIKEY=
# HAI_AI_LLM_BASEURL=https://api.openai.com/v1
# HAI_AI_LLM_MODEL=gpt-4o-mini
# HAI_AI_LLM_MAXTOKENS=4096
# Optional compatibility fallbacks
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# --- Vector DB (vecdb) ---
# HAI_VECDB_TYPE=lancedb
# HAI_VECDB_PATH=./data/vecdb
# HAI_VECDB_URL=http://localhost:6333
# HAI_VECDB_APIKEY=

# --- Reach (reach) ---
# HAI_REACH_SMTP_HOST=smtp.example.com
# HAI_REACH_SMTP_PORT=465
# HAI_REACH_SMTP_USER=
# HAI_REACH_SMTP_PASS=
# HAI_REACH_SMTP_FROM=noreply@example.com
# HAI_REACH_SMS_ACCESS_KEY=
# HAI_REACH_SMS_SECRET_KEY=
# HAI_REACH_SMS_SIGN_NAME=
# HAI_REACH_RESEND_KEY=
# HAI_REACH_WEBHOOK_URL=

# --- Payment (payment) ---
# HAI_PAYMENT_WECHAT_APPID=
# HAI_PAYMENT_WECHAT_MCHID=
# HAI_PAYMENT_WECHAT_APIV3KEY=
# HAI_PAYMENT_WECHAT_PRIVATEKEY=
# HAI_PAYMENT_WECHAT_SERIALNO=
# HAI_PAYMENT_WECHAT_NOTIFYURL=
# HAI_PAYMENT_ALIPAY_APPID=
# HAI_PAYMENT_ALIPAY_PRIVATEKEY=
# HAI_PAYMENT_ALIPAY_ALIPAYPUBLICKEY=
# HAI_PAYMENT_ALIPAY_NOTIFYURL=
# HAI_PAYMENT_STRIPE_SECRETKEY=
# HAI_PAYMENT_STRIPE_WEBHOOKSECRET=
# HAI_PAYMENT_STRIPE_SUCCESSURL=
# HAI_PAYMENT_STRIPE_CANCELURL=

# --- Deploy credentials (deploy / CLI) ---
# HAI_DEPLOY_VERCEL_TOKEN=
# HAI_DEPLOY_NEON_API_KEY=
# HAI_DEPLOY_UPSTASH_EMAIL=
# HAI_DEPLOY_UPSTASH_API_KEY=
# HAI_DEPLOY_CF_ACCOUNT_ID=
# HAI_DEPLOY_CF_API_TOKEN=
# HAI_DEPLOY_RESEND_API_KEY=
# HAI_DEPLOY_ALIYUN_ACCESS_KEY_ID=
# HAI_DEPLOY_ALIYUN_ACCESS_KEY_SECRET=

# --- App-specific vars ---
# HAI_PARTNER_USERNAME=partner-admin
# HAI_PARTNER_PASSWORD=
# HAI_PARTNER_SESSIONTTLSECONDS=14400
# HAI_CRYPTO_DATA_KEY=

# --- Dev/test helpers ---
# HAI_E2E=1
# BASE_URL=http://localhost:4173
# PUBLIC_API_BASE=http://10.0.2.2:5173
# VITE_ADAPTER=node
# CI=0
