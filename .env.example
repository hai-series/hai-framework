# hai-framework 环境变量总表（由 scripts/generate-env-catalog.mjs 生成）
# 所有变量默认注释；按应用 .env.example 选择启用，公共值放已跟踪的 .env / .env.dev / .env.test / .env.prod，私有值仅放 .env.local / .env.<mode>.local 或进程环境。
# 赋值为合法示例或建议值，不代表所有字段的 Schema 默认值；实际默认、单位和消费位置见 .agents/skills/hai-module-create/configuration.md。
# 规则、加载优先级与环境命令：README.md 的配置与环境变量章节。
# HAI_<配置名>_<路径>；camelCase 不拆词；数组的 0 可替换为任意有效索引。
# 同来源 JSON 为基础、细项覆盖；高来源整段替换清掉低来源细项。Schema 可识别 YAML 未填写的合法路径；数组索引仅覆盖已有元素。
# Schema 枚举和上下界如下；Provider 的依赖与跨字段条件仍由模块校验。

# HAI_ADMIN_DEFAULT_PASSWORD — 首次创建管理员的密码
# 约束：满足 IAM 密码策略；敏感值仅在本地或目标进程注入
# HAI_ADMIN_DEFAULT_PASSWORD=""

# ai.a2a.agentCard.description — Agent 描述
# 约束：字符串
# HAI_AI_A2A_AGENTCARD_DESCRIPTION="A simple echo agent that repeats your message (A2A demo)"

# ai.a2a.agentCard.name — Agent 名称
# 约束：字符串
# HAI_AI_A2A_AGENTCARD_NAME="echo-agent"

# ai.a2a.agentCard.skills.0.description — 技能描述
# 约束：字符串
# HAI_AI_A2A_AGENTCARD_SKILLS_0_DESCRIPTION="Echoes back the user message"

# ai.a2a.agentCard.skills.0.id — 技能 ID
# 约束：字符串
# HAI_AI_A2A_AGENTCARD_SKILLS_0_ID=""

# ai.a2a.agentCard.skills.0.name — 技能名称
# 约束：字符串
# HAI_AI_A2A_AGENTCARD_SKILLS_0_NAME=""

# ai.a2a.agentCard.skills.0.tags — 标签列表
# 约束：JSON 数组；索引可按 0、1、2 扩展
# HAI_AI_A2A_AGENTCARD_SKILLS_0_TAGS=""

# ai.a2a.agentCard.url — Agent 对外 URL
# 约束：字符串
# HAI_AI_A2A_AGENTCARD_URL="http://localhost:5173"

# ai.a2a.agentCard.version — Agent 版本
# 约束：字符串
# HAI_AI_A2A_AGENTCARD_VERSION="0.1.0"

# ai.a2a.execution.leaseMs — 活跃执行租约毫秒数，默认30秒，范围1秒至1天。
# 约束：整数；>= 1000；<= 86400000
# HAI_AI_A2A_EXECUTION_LEASEMS="30000"

# ai.a2a.execution.maxExecutionMs — 单次执行绝对上限毫秒数，默认5分钟；超时标中断，不自动重放。
# 约束：整数；>= 1000；<= 86400000
# HAI_AI_A2A_EXECUTION_MAXEXECUTIONMS="300000"

# ai.a2a.execution.pollIntervalMs — 共享事件/状态订阅轮询间隔毫秒数，默认250。
# 约束：整数；>= 10；<= 5000
# HAI_AI_A2A_EXECUTION_POLLINTERVALMS="250"

# ai.a2a.security.apiKey.in — API Key 的传递位置（默认 header）
# 约束：字符串；取值：header | query
# HAI_AI_A2A_SECURITY_APIKEY_IN="header"

# ai.a2a.security.apiKey.name — 参数名（默认 x-api-key）
# 约束：字符串
# HAI_AI_A2A_SECURITY_APIKEY_NAME="x-api-key"

# HAI_AI_AUDIO_DOUBAO_APIKEY — DOUBAO 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# HAI_AI_AUDIO_DOUBAO_APIKEY=""

# HAI_AI_AUDIO_INDEXTTS_APIKEY — INDEXTTS 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# HAI_AI_AUDIO_INDEXTTS_APIKEY=""

# ai.audio.inheritLlmApiKey — 是否允许未单独配置密钥的语音模型继承 LLM 全局密钥；跨供应商部署应保持关闭。
# 约束：true | false
# HAI_AI_AUDIO_INHERITLLMAPIKEY="false"

# ai.audio.maxAudioBytes — 单次音频字节上限（默认 10 MiB，防止资源耗尽）
# 约束：整数；<= 9007199254740991；> 0
# HAI_AI_AUDIO_MAXAUDIOBYTES="10485760"

# ai.audio.maxStreamDurationMs — 实时连接最长持续时间（毫秒，默认 5 分钟）
# 约束：整数；<= 9007199254740991；> 0
# HAI_AI_AUDIO_MAXSTREAMDURATIONMS="300000"

# HAI_AI_AUDIO_MIMO_APIKEY — MIMO 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# HAI_AI_AUDIO_MIMO_APIKEY=""

# ai.audio.models.0.accessKey — 火山引擎 Access Key（`X-Api-Access-Key`，旧版控制台 ASR 需要）
# 约束：string,null
# HAI_AI_AUDIO_MODELS_0_ACCESSKEY=""

# ai.audio.models.0.apiKey — API Key 覆盖（未提供时可按 Audio 配置继承 LLM 密钥，最后回退对应平台环境变量）
# 约束：string,null
# HAI_AI_AUDIO_MODELS_0_APIKEY=""

# ai.audio.models.0.appKey — 火山引擎 App Key（`X-Api-App-Key`，旧版控制台 ASR 需要）
# 约束：string,null
# HAI_AI_AUDIO_MODELS_0_APPKEY=""

# ai.audio.models.0.baseUrl — HTTP / WebSocket 端点覆盖（`whisper` / `indextts` 无默认端点，必须显式配置）
# 约束：字符串
# HAI_AI_AUDIO_MODELS_0_BASEURL="https://api.xiaomimimo.com/v1"

# ai.audio.models.0.id — 模型唯一标识（用于场景解析与请求显式指定）
# 约束：字符串
# HAI_AI_AUDIO_MODELS_0_ID=""

# ai.audio.models.0.model — 厂商模型名（传给厂商 API 的实际模型名）
# 约束：字符串
# HAI_AI_AUDIO_MODELS_0_MODEL="mimo-v2.5-asr"

# ai.audio.models.0.operations — 模型允许执行的操作；解析模型时会在调用厂商前校验
# 约束：JSON 数组；索引可按 0、1、2 扩展；最少项数 1
# HAI_AI_AUDIO_MODELS_0_OPERATIONS=""

# ai.audio.models.0.provider — 所属语音平台
# 约束：字符串；取值：openai | mimo | qwen | doubao | whisper | indextts
# HAI_AI_AUDIO_MODELS_0_PROVIDER="mimo"

# ai.audio.models.0.resourceId — 火山引擎资源 ID（`X-Api-Resource-Id`；未提供时使用平台默认资源 ID）
# 约束：字符串
# HAI_AI_AUDIO_MODELS_0_RESOURCEID=""

# ai.audio.models.0.timeout — 请求超时（毫秒，默认 60000）
# 约束：数字；> 0
# HAI_AI_AUDIO_MODELS_0_TIMEOUT="120000"

# ai.audio.models.0.workspaceId — 阿里云百炼业务空间 ID（`X-DashScope-WorkSpace`，可选）
# 约束：字符串
# HAI_AI_AUDIO_MODELS_0_WORKSPACEID=""

# HAI_AI_AUDIO_MODELS_1_BASEURL — HTTP / WebSocket 端点覆盖（`whisper` / `indextts` 无默认端点，必须显式配置）
# 约束：字符串
# HAI_AI_AUDIO_MODELS_1_BASEURL="https://api.xiaomimimo.com/v1"

# HAI_AI_AUDIO_MODELS_1_MODEL — 厂商模型名（传给厂商 API 的实际模型名）
# 约束：字符串
# HAI_AI_AUDIO_MODELS_1_MODEL="mimo-v2.5-tts"

# HAI_AI_AUDIO_MODELS_1_PROVIDER — 所属语音平台
# 约束：字符串；取值：openai | mimo | qwen | doubao | whisper | indextts
# HAI_AI_AUDIO_MODELS_1_PROVIDER="mimo"

# HAI_AI_AUDIO_MODELS_1_TIMEOUT — 请求超时（毫秒，默认 60000）
# 约束：数字；> 0
# HAI_AI_AUDIO_MODELS_1_TIMEOUT="120000"

# HAI_AI_AUDIO_OPENAI_APIKEY — OPENAI 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# HAI_AI_AUDIO_OPENAI_APIKEY=""

# HAI_AI_AUDIO_QWEN_APIKEY — QWEN 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# HAI_AI_AUDIO_QWEN_APIKEY=""

# ai.audio.synthesizeModel — 默认合成模型 ID（`ai.audio.synthesize*` 未指定 model 时使用）
# 约束：字符串
# HAI_AI_AUDIO_SYNTHESIZEMODEL="tts"

# ai.audio.transcribeModel — 默认识别模型 ID（`ai.audio.transcribe*` 未指定 model 时使用）
# 约束：字符串
# HAI_AI_AUDIO_TRANSCRIBEMODEL="asr"

# HAI_AI_AUDIO_WHISPER_APIKEY — WHISPER 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# HAI_AI_AUDIO_WHISPER_APIKEY=""

# ai.compress.defaultMaxTokens — 默认 Token 预算（默认 0 表示取模型上限的 80%）
# 约束：整数；>= 0；<= 9007199254740991
# HAI_AI_COMPRESS_DEFAULTMAXTOKENS="0"

# ai.compress.defaultStrategy — 默认压缩策略（默认 'hybrid'）
# 约束：字符串；取值：summary | sliding-window | hybrid
# HAI_AI_COMPRESS_DEFAULTSTRATEGY="hybrid"

# ai.compress.preserveLastN — 默认保留最近消息数（默认 4）
# 约束：整数；>= 0；<= 9007199254740991
# HAI_AI_COMPRESS_PRESERVELASTN="4"

# ai.embedding.batchSize — 批量大小（单次请求最多处理的文本数，默认 100）
# 约束：整数；<= 9007199254740991；> 0
# HAI_AI_EMBEDDING_BATCHSIZE="100"

# ai.embedding.dimensions — 向量维度（可选，部分模型支持指定维度）
# 约束：整数；<= 9007199254740991；> 0
# HAI_AI_EMBEDDING_DIMENSIONS=""

# ai.file.systemPrompt — OCR 系统提示词（可选，覆盖内置默认提示词）
# 约束：字符串
# HAI_AI_FILE_SYSTEMPROMPT=""

# ai.image.generateModel — 默认文生图模型 ID
# 约束：字符串
# HAI_AI_IMAGE_GENERATEMODEL="image"

# HAI_AI_IMAGE_GOOGLE_APIKEY — GOOGLE 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# HAI_AI_IMAGE_GOOGLE_APIKEY=""

# ai.image.maxImageBytes — 单张图片或参考图的字节上限，默认 20 MiB；JSON 上限为 max(64 KiB, 两倍图片上限)。
# 约束：整数；<= 104857600；> 0
# HAI_AI_IMAGE_MAXIMAGEBYTES="20971520"

# ai.image.maxImages — 单次生成/参考图数量上限，默认 4，最大 16；临时 URL 串行下载。
# 约束：整数；<= 16；> 0
# HAI_AI_IMAGE_MAXIMAGES="4"

# ai.image.models.0.apiKey — API Key 覆盖；未提供时回退厂商环境变量
# 约束：string,null
# HAI_AI_IMAGE_MODELS_0_APIKEY=""

# ai.image.models.0.baseUrl — API 基础 URL 覆盖
# 约束：字符串；格式 uri
# HAI_AI_IMAGE_MODELS_0_BASEURL=""

# ai.image.models.0.id — 模型唯一标识（供请求选择）
# 约束：字符串
# HAI_AI_IMAGE_MODELS_0_ID=""

# ai.image.models.0.model — 厂商模型名
# 约束：字符串
# HAI_AI_IMAGE_MODELS_0_MODEL="zimage"

# ai.image.models.0.provider — 所属文生图平台
# 约束：字符串；取值：openai | google | qwen | seedream | pollinations
# HAI_AI_IMAGE_MODELS_0_PROVIDER="pollinations"

# ai.image.models.0.timeout — 整次图片生成与下载超时（毫秒，1–2147483647，默认 120000）
# 约束：整数；<= 2147483647；> 0
# HAI_AI_IMAGE_MODELS_0_TIMEOUT="120000"

# ai.image.models.0.workspaceId — 阿里云百炼业务空间 ID（可选）
# 约束：字符串
# HAI_AI_IMAGE_MODELS_0_WORKSPACEID=""

# HAI_AI_IMAGE_OPENAI_APIKEY — OPENAI 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# HAI_AI_IMAGE_OPENAI_APIKEY=""

# HAI_AI_IMAGE_POLLINATIONS_APIKEY — POLLINATIONS 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# HAI_AI_IMAGE_POLLINATIONS_APIKEY=""

# HAI_AI_IMAGE_QWEN_APIKEY — QWEN 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# HAI_AI_IMAGE_QWEN_APIKEY=""

# HAI_AI_IMAGE_SEEDREAM_APIKEY — SEEDREAM 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# HAI_AI_IMAGE_SEEDREAM_APIKEY=""

# ai.knowledge.chunkOptions.markdownKeepTitle — 是否保留 Markdown 标题在分块内容中（默认 true）
# 约束：true | false
# HAI_AI_KNOWLEDGE_CHUNKOPTIONS_MARKDOWNKEEPTITLE="true"

# ai.knowledge.chunkOptions.markdownMinLevel — Markdown 标题分割深度（1-6，默认 2，即 # 和 ## 作为分块边界；设为 3 则 ### 也作为分块边界）
# 约束：整数；>= 1；<= 6
# HAI_AI_KNOWLEDGE_CHUNKOPTIONS_MARKDOWNMINLEVEL="2"

# ai.knowledge.chunkOptions.maxSize — 每块上限包含 overlap/分隔符；word 按非空白词，其他按 Unicode code point，默认 1500。
# 约束：整数；<= 9007199254740991；> 0
# HAI_AI_KNOWLEDGE_CHUNKOPTIONS_MAXSIZE="1500"

# ai.knowledge.chunkOptions.mode — 分块模式
# 约束：字符串；取值：sentence | paragraph | markdown | page | word | character | custom
# HAI_AI_KNOWLEDGE_CHUNKOPTIONS_MODE="markdown"

# ai.knowledge.chunkOptions.overlap — 重叠使用与 maxSize 相同的单位，必须严格小于 maxSize。
# 约束：整数；>= 0；<= 9007199254740991
# HAI_AI_KNOWLEDGE_CHUNKOPTIONS_OVERLAP="200"

# ai.knowledge.chunkOptions.separator — 自定义分隔符正则（仅 mode='custom' 时使用） ❗ 安全提示：separator 会通过 `new RegExp()` 构造，如果其值来源于用户输入，请在调用方先行校验以防止 ReDoS 攻击。
# 约束：字符串
# HAI_AI_KNOWLEDGE_CHUNKOPTIONS_SEPARATOR=""

# ai.knowledge.cleanOptions.customReplacements.0.pattern — 正则表达式字符串
# 约束：字符串
# HAI_AI_KNOWLEDGE_CLEANOPTIONS_CUSTOMREPLACEMENTS_0_PATTERN=""

# ai.knowledge.cleanOptions.customReplacements.0.replacement — 替换文本
# 约束：字符串
# HAI_AI_KNOWLEDGE_CLEANOPTIONS_CUSTOMREPLACEMENTS_0_REPLACEMENT=""

# ai.knowledge.cleanOptions.normalizeWhitespace — 标准化空白字符（多空格→单空格、去掉多余空行，默认 true）
# 约束：true | false
# HAI_AI_KNOWLEDGE_CLEANOPTIONS_NORMALIZEWHITESPACE="true"

# ai.knowledge.cleanOptions.removeEmails — 移除 Email 地址（默认 false）
# 约束：true | false
# HAI_AI_KNOWLEDGE_CLEANOPTIONS_REMOVEEMAILS="false"

# ai.knowledge.cleanOptions.removeHtml — 移除 HTML 标签（默认 true）
# 约束：true | false
# HAI_AI_KNOWLEDGE_CLEANOPTIONS_REMOVEHTML="true"

# ai.knowledge.cleanOptions.removeUrls — 移除 URL（默认 false）
# 约束：true | false
# HAI_AI_KNOWLEDGE_CLEANOPTIONS_REMOVEURLS="false"

# ai.knowledge.cleanOptions.trim — 去除首尾空白（默认 true）
# 约束：true | false
# HAI_AI_KNOWLEDGE_CLEANOPTIONS_TRIM="true"

# ai.knowledge.collection — 默认向量集合名（默认 'hai_ai_knowledge'）
# 约束：字符串
# HAI_AI_KNOWLEDGE_COLLECTION="hai_ai_knowledge"

# ai.knowledge.dimension — 向量维度（默认 1536，需与 embedding 模型匹配）
# 约束：整数；<= 9007199254740991；> 0
# HAI_AI_KNOWLEDGE_DIMENSION="1536"

# ai.knowledge.enableEntityExtraction — 是否启用实体提取（默认 true）
# 约束：true | false
# HAI_AI_KNOWLEDGE_ENABLEENTITYEXTRACTION="true"

# ai.knowledge.entityBoostWeight — 实体查询命中的额外加权系数（默认 0.15，叠加到向量分数上）
# 约束：数字；>= 0；<= 1
# HAI_AI_KNOWLEDGE_ENTITYBOOSTWEIGHT="0.15"

# ai.knowledge.entityTypes — 自定义实体类型列表（不指定时使用内置默认类型）
# 约束：JSON 数组；索引可按 0、1、2 扩展
# HAI_AI_KNOWLEDGE_ENTITYTYPES=""

# ai.knowledge.systemPrompt — 自定义实体提取系统提示词（不指定时使用内置默认提示词）
# 约束：字符串
# HAI_AI_KNOWLEDGE_SYSTEMPROMPT=""

# ai.llm.apiKey — 默认服务密钥；模型项可单独覆盖。未填写时读取 HAI_AI_LLM_APIKEY 或对应供应商密钥变量，真实值只放服务端。
# 约束：string,null
# HAI_AI_LLM_APIKEY=""

# ai.llm.baseUrl — 默认模型服务地址；使用代理时填写，模型项可覆盖。未填写时按协议读取环境地址或使用供应商默认地址。
# 约束：字符串；格式 uri
# HAI_AI_LLM_BASEURL=""

# ai.llm.maxTokens — 单次回答最多生成多少 Token，默认 4096；模型项可覆盖，需符合供应商限制。
# 约束：数字；> 0
# HAI_AI_LLM_MAXTOKENS="4096"

# ai.llm.model — 默认模型名称（默认 `'gpt-4o-mini'`）
# 约束：字符串
# HAI_AI_LLM_MODEL="gpt-4o-mini"

# ai.llm.models.0.apiKey — API Key 覆盖（可选，未提供时使用全局配置）
# 约束：string,null
# HAI_AI_LLM_MODELS_0_APIKEY=""

# ai.llm.models.0.baseUrl — Base URL 覆盖（可选）
# 约束：字符串；格式 uri
# HAI_AI_LLM_MODELS_0_BASEURL=""

# ai.llm.models.0.id — 模型唯一标识（用于 ModelResolver 解析）
# 约束：字符串
# HAI_AI_LLM_MODELS_0_ID=""

# ai.llm.models.0.maxTokens — 最大 Token 数覆盖（可选）
# 约束：数字；> 0
# HAI_AI_LLM_MODELS_0_MAXTOKENS=""

# ai.llm.models.0.model — 模型名称（传给 API 的实际模型名）
# 约束：字符串
# HAI_AI_LLM_MODELS_0_MODEL=""

# ai.llm.models.0.protocol — API 协议（可选，未指定时回退全局 `protocol`，再回退 `chat`；决定走 Chat Completions / Responses / Anthropic）
# 约束：字符串；取值：chat | responses | anthropic
# HAI_AI_LLM_MODELS_0_PROTOCOL="chat"

# ai.llm.models.0.temperature — 温度覆盖（可选）
# 约束：数字；>= 0；<= 2
# HAI_AI_LLM_MODELS_0_TEMPERATURE=""

# ai.llm.models.0.timeout — 超时覆盖（可选，毫秒）
# 约束：数字；> 0
# HAI_AI_LLM_MODELS_0_TIMEOUT=""

# ai.llm.protocol — 默认请求格式：chat 为 Chat Completions，responses 为 OpenAI Responses，anthropic 为 Anthropic Messages；模型项可覆盖。
# 约束：字符串；取值：chat | responses | anthropic
# HAI_AI_LLM_PROTOCOL="chat"

# ai.llm.scenarios.chat — 场景 chat 使用的模型 ID，须与 llm.models 中的 ID 一致
# 约束：字符串
# HAI_AI_LLM_SCENARIOS_CHAT=""

# ai.llm.scenarios.default — 场景 default 使用的模型 ID，须与 llm.models 中的 ID 一致
# 约束：字符串
# HAI_AI_LLM_SCENARIOS_DEFAULT=""

# ai.llm.scenarios.embedding — 场景 embedding 使用的模型 ID，须与 llm.models 中的 ID 一致
# 约束：字符串
# HAI_AI_LLM_SCENARIOS_EMBEDDING=""

# ai.llm.scenarios.execute — 场景 execute 使用的模型 ID，须与 llm.models 中的 ID 一致
# 约束：字符串
# HAI_AI_LLM_SCENARIOS_EXECUTE=""

# ai.llm.scenarios.extraction — 场景 extraction 使用的模型 ID，须与 llm.models 中的 ID 一致
# 约束：字符串
# HAI_AI_LLM_SCENARIOS_EXTRACTION=""

# ai.llm.scenarios.fast — 场景 fast 使用的模型 ID，须与 llm.models 中的 ID 一致
# 约束：字符串
# HAI_AI_LLM_SCENARIOS_FAST=""

# ai.llm.scenarios.ocr — 场景 ocr 使用的模型 ID，须与 llm.models 中的 ID 一致
# 约束：字符串
# HAI_AI_LLM_SCENARIOS_OCR=""

# ai.llm.scenarios.plan — 场景 plan 使用的模型 ID，须与 llm.models 中的 ID 一致
# 约束：字符串
# HAI_AI_LLM_SCENARIOS_PLAN=""

# ai.llm.scenarios.reasoning — 场景 reasoning 使用的模型 ID，须与 llm.models 中的 ID 一致
# 约束：字符串
# HAI_AI_LLM_SCENARIOS_REASONING=""

# ai.llm.scenarios.rerank — 场景 rerank 使用的模型 ID，须与 llm.models 中的 ID 一致
# 约束：字符串
# HAI_AI_LLM_SCENARIOS_RERANK=""

# ai.llm.scenarios.summary — 场景 summary 使用的模型 ID，须与 llm.models 中的 ID 一致
# 约束：字符串
# HAI_AI_LLM_SCENARIOS_SUMMARY=""

# ai.llm.temperature — 回答的随机程度，0–2，默认 0.7；较低通常更稳定，模型项可覆盖，部分模型不支持自定义。
# 约束：数字；>= 0；<= 2
# HAI_AI_LLM_TEMPERATURE="0.7"

# ai.llm.tempModelCacheTtl — 临时模型客户端缓存存活时间（毫秒，默认 `600000` = 10 分钟；超时后临时模型客户端实例失效并重建）
# 约束：数字；> 0
# HAI_AI_LLM_TEMPMODELCACHETTL="600000"

# ai.llm.timeout — 一次模型请求最多等待多少毫秒，默认 60000；模型项可覆盖。
# 约束：数字；> 0
# HAI_AI_LLM_TIMEOUT="60000"

# ai.mcp.server.capabilities.prompts — 是否支持提示词模板（默认 `true`）
# 约束：true | false
# HAI_AI_MCP_SERVER_CAPABILITIES_PROMPTS="true"

# ai.mcp.server.capabilities.resources — 是否支持资源访问（默认 `true`）
# 约束：true | false
# HAI_AI_MCP_SERVER_CAPABILITIES_RESOURCES="true"

# ai.mcp.server.capabilities.tools — 是否支持工具调用（默认 `true`）
# 约束：true | false
# HAI_AI_MCP_SERVER_CAPABILITIES_TOOLS="true"

# ai.mcp.server.name — 服务器名称
# 约束：字符串
# HAI_AI_MCP_SERVER_NAME=""

# ai.mcp.server.version — 服务器版本（默认 `'1.0.0'`）
# 约束：字符串
# HAI_AI_MCP_SERVER_VERSION="1.0.0"

# ai.memory.allowEphemeralFallback — 是否允许在配置了持久化向量后端但 mem0 无法映射时退回内存存储（默认 false） 仅影响 `provider='mem0'`：当前框架适配仅映射 qdrant；pgvector 的 SDK 连接无法公开关闭，所有环境拒绝。底层 vecdb 是 lancedb / chroma / 未知后端时，默认 fail-fast（初始化失败），避免服务重启后记忆静默丢失； 仅当显式设为 true 时才在开发或明确 E2E 环境退回内存存储（数据不持久）。 生产始终要求实际持久化连接，不能通过此开关绕过共享状态要求。
# 约束：true | false
# HAI_AI_MEMORY_ALLOWEPHEMERALFALLBACK="false"

# ai.memory.candidateMultiplier — 候选池倍数（默认 5） 检索时先从向量后端取回 `topK × candidateMultiplier` 条候选，再按 scope / 重要性等 条件在内存中过滤，最后截取 topK。用于修正「向量后端仅返回 topK，随后被 scope 过滤 掉大部分、导致同一主体下特定主题/角色记忆漏召回」的问题：候选池越大，scope 命中越充分。 native provider 会对全部候选评分，故此值仅影响向量预取宽度；mem0 provider 无法下推 scope，必须依赖更大的候选池才能保证 scope 内记忆被召回。
# 约束：整数；<= 9007199254740991；> 0
# HAI_AI_MEMORY_CANDIDATEMULTIPLIER="5"

# ai.memory.defaultTopK — 检索时默认返回数量（默认 10）
# 约束：整数；<= 9007199254740991；> 0
# HAI_AI_MEMORY_DEFAULTTOPK="10"

# ai.memory.embeddingEnabled — 是否启用向量检索（默认 true，关闭则仅使用关键词匹配）
# 约束：true | false
# HAI_AI_MEMORY_EMBEDDINGENABLED="true"

# ai.memory.maxEntriesGlobal — 全局最大记忆条数（默认 100000） 跨所有主体的总量上限，作为整体保护阈值；超过时淘汰全局最低优先级条目。
# 约束：整数；<= 9007199254740991；> 0
# HAI_AI_MEMORY_MAXENTRIESGLOBAL="100000"

# ai.memory.maxEntriesPerObject — 单个主体（objectId）的最大记忆条数（默认 1000） native 淘汰按 objectId 分区触发：某个主体写入超过此上限时，只淘汰该主体自身 最低优先级的条目，不会波及其他主体的记忆。
# 约束：整数；<= 9007199254740991；> 0
# HAI_AI_MEMORY_MAXENTRIESPEROBJECT="1000"

# ai.memory.provider — 记忆后端：native 使用框架原生存储与批量合并；mem0 将框架提取结果写入受支持的嵌入式 SDK 后端
# 约束：字符串；取值：native | mem0
# HAI_AI_MEMORY_PROVIDER="native"

# ai.memory.recencyDecay — 时间衰减系数（默认 0.95，每次检索乘以此系数调整 recency 权重）
# 约束：数字；>= 0；<= 1
# HAI_AI_MEMORY_RECENCYDECAY="0.95"

# ai.memory.systemPrompt — 自定义记忆提取 systemPrompt（可选，覆盖内置默认提示词）
# 约束：字符串
# HAI_AI_MEMORY_SYSTEMPROMPT=""

# ai.memory.writebackRelatedTopK — 写回 / 合并时检索相关记忆的数量（native 与 mem0 共用，默认 20）
# 约束：整数；<= 9007199254740991；> 0
# HAI_AI_MEMORY_WRITEBACKRELATEDTOPK="20"

# ai.retrieval.sources.0.collection — vecdb collection 名称
# 约束：字符串
# HAI_AI_RETRIEVAL_SOURCES_0_COLLECTION=""

# ai.retrieval.sources.0.filter — 元数据过滤条件
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_AI_RETRIEVAL_SOURCES_0_FILTER=""

# ai.retrieval.sources.0.id — 来源唯一标识
# 约束：字符串
# HAI_AI_RETRIEVAL_SOURCES_0_ID=""

# ai.retrieval.sources.0.minScore — 最低相似度 0~1（低于此值的结果被过滤）
# 约束：数字；>= 0；<= 1
# HAI_AI_RETRIEVAL_SOURCES_0_MINSCORE=""

# ai.retrieval.sources.0.name — 信源显示名
# 约束：字符串
# HAI_AI_RETRIEVAL_SOURCES_0_NAME=""

# ai.retrieval.sources.0.topK — 最大返回条数（默认 5）
# 约束：整数；<= 9007199254740991；> 0
# HAI_AI_RETRIEVAL_SOURCES_0_TOPK=""

# ai.retrieval.sources.0.url — 信源 URL / 路径
# 约束：字符串
# HAI_AI_RETRIEVAL_SOURCES_0_URL=""

# ai.summary.systemPrompt — 自定义摘要 systemPrompt（可选，覆盖内置默认提示词）
# 约束：字符串
# HAI_AI_SUMMARY_SYSTEMPROMPT=""

# ai.token.tokenRatio — Token 估算每字符系数（默认 0.25，即 4 字符 ≈ 1 token）
# 约束：数字；> 0
# HAI_AI_TOKEN_TOKENRATIO="0.25"

# audit.alerts.enabled — 是否检查异常事件并发送告警；开启前配置至少一条规则和真实 Reach 通道，关闭不影响审计入库。
# 约束：true | false
# HAI_AUDIT_ALERTS_ENABLED="false"

# audit.alerts.maxNotificationsPerCheck — 每次检查最多尝试的通知数；超过的目标留待后续检查，避免突发告警挤占业务资源。
# 约束：整数；>= 1；<= 1000
# HAI_AUDIT_ALERTS_MAXNOTIFICATIONSPERCHECK="100"

# audit.alerts.rules.0.actions — 匹配的审计 action 全名，例如 auth.login；从实际记录复制，不支持 auth.* 通配。
# 约束：JSON 数组；索引可按 0、1、2 扩展；最少项数 1；最多项数 50
# HAI_AUDIT_ALERTS_RULES_0_ACTIONS=""

# audit.alerts.rules.0.id — 稳定且唯一的规则编号，用于共享去重；更改编号会视为新规则。
# 约束：字符串；正则 ^[\w-]{1,64}$
# HAI_AUDIT_ALERTS_RULES_0_ID=""

# audit.alerts.rules.0.minimumSeverity — 参与计数的事件最低等级；低于此级别的记录仍保留，但不触发这条告警。
# 约束：字符串；取值：info | warning | error | critical
# HAI_AUDIT_ALERTS_RULES_0_MINIMUMSEVERITY="info"

# audit.alerts.rules.0.outcomes — 要统计的执行结果；默认失败和拒绝，空数组表示所有结果均参与计数。
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 3
# HAI_AUDIT_ALERTS_RULES_0_OUTCOMES="[\"failure\",\"denied\"]"

# audit.alerts.rules.0.resource — 只统计此资源类型的事件；省略时不按资源过滤，不填写业务敏感正文。
# 约束：字符串；最小字符数 1；最大字符数 256
# HAI_AUDIT_ALERTS_RULES_0_RESOURCE=""

# audit.alerts.rules.0.severity — 发出通知时的告警等级；不修改原始审计事件的等级。
# 约束：字符串；取值：warning | error | critical
# HAI_AUDIT_ALERTS_RULES_0_SEVERITY="warning"

# audit.alerts.rules.0.targets.0.id — 本规则内稳定且唯一的目标编号，用于防止多节点重复投递。
# 约束：字符串；正则 ^[\w-]{1,64}$
# HAI_AUDIT_ALERTS_RULES_0_TARGETS_0_ID=""

# audit.alerts.rules.0.targets.0.provider — 已注册的 Reach Provider 名称，例如 email；不是 smtp/api 等 Provider 类型。
# 约束：字符串；最小字符数 1；最大字符数 128
# HAI_AUDIT_ALERTS_RULES_0_TARGETS_0_PROVIDER=""

# audit.alerts.rules.0.targets.0.to — 该通道接受的收件地址，例如邮箱或手机号；填写真实值，开发 Console 不会投递。
# 约束：字符串；最小字符数 1；最大字符数 1000
# HAI_AUDIT_ALERTS_RULES_0_TARGETS_0_TO=""

# audit.alerts.rules.0.threshold — 同一窗口内累计达到此次数才通知；与 IAM 登录失败锁定阈值分别配置。
# 约束：整数；>= 1；<= 1000000000
# HAI_AUDIT_ALERTS_RULES_0_THRESHOLD="1"

# audit.alerts.rules.0.windowSeconds — 固定计数窗口长度，单位秒；例如 300 表示按五分钟窗口统计，不追补长期停机历史。
# 约束：整数；>= 60；<= 86400
# HAI_AUDIT_ALERTS_RULES_0_WINDOWSECONDS="300"

# audit.alerts.schedule.cron — 检查频率的 Cron 表达式；默认每分钟检查，窗口阈值仍由规则决定。
# 约束：字符串；最小字符数 1；最大字符数 128
# HAI_AUDIT_ALERTS_SCHEDULE_CRON="* * * * *"

# audit.alerts.schedule.enabled — 是否让 Scheduler 自动检查；需同时开启 alerts.enabled，否则仅保留计划配置。
# 约束：true | false
# HAI_AUDIT_ALERTS_SCHEDULE_ENABLED="false"

# audit.alerts.schedule.timezone — Cron 使用的 IANA 时区，例如 Asia/Shanghai；UTC 不等于北京时间。
# 约束：字符串；最小字符数 1；最大字符数 128
# HAI_AUDIT_ALERTS_SCHEDULE_TIMEZONE="UTC"

# audit.backup.batchSize — 每批读取的记录数；较小更省内存但请求更多，不改变归档内容。
# 约束：整数；>= 1；<= 1000
# HAI_AUDIT_BACKUP_BATCHSIZE="200"

# audit.backup.enabled — 是否允许手动/计划归档审计；需已初始化的私有 Storage，关闭不影响审计采集。
# 约束：true | false
# HAI_AUDIT_BACKUP_ENABLED="false"

# audit.backup.maxRecordBytes — 单条归档记录的 UTF-8 字节上限；默认 1 MiB，超限报错而不截断原审计。
# 约束：整数；>= 1024；<= 67108864
# HAI_AUDIT_BACKUP_MAXRECORDBYTES="1048576"

# audit.backup.schedule.cron — 备份 Cron 表达式；0 2 * * * 表示在下方时区每天 02:00 执行。
# 约束：字符串；最小字符数 1；最大字符数 128
# HAI_AUDIT_BACKUP_SCHEDULE_CRON="0 2 * * *"

# audit.backup.schedule.enabled — 是否由 Scheduler 自动备份；还需 backup.enabled=true，关闭后仍可手动备份。
# 约束：true | false
# HAI_AUDIT_BACKUP_SCHEDULE_ENABLED="false"

# audit.backup.schedule.timezone — 定时备份采用的 IANA 时区；Asia/Shanghai 为北京时间，UTC 的 02:00 对应北京时间 10:00。
# 约束：字符串；最小字符数 1；最大字符数 128
# HAI_AUDIT_BACKUP_SCHEDULE_TIMEZONE="UTC"

# audit.capture.enabled — 是否自动记录已接入框架入口的重要操作、失败和拒绝；关闭不阻止显式 audit.log 写入。
# 约束：true | false
# HAI_AUDIT_CAPTURE_ENABLED="true"

# audit.capture.includeReads — 是否也采集成功读取事件；开启可追溯查询行为，但会显著增加日志量与存储开销。
# 约束：true | false
# HAI_AUDIT_CAPTURE_INCLUDEREADS="false"

# audit.privacy.enabled — 是否对业务隐私字段脱敏；关闭也不会暴露密码、token 等凭据，脱敏前的内容不会恢复。
# 约束：true | false
# HAI_AUDIT_PRIVACY_ENABLED="true"

# audit.privacy.fields — 额外脱敏的详情字段名，不区分大小写；例如 customerPhone，不要将秘密放进 action/resourceId。
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 1000
# HAI_AUDIT_PRIVACY_FIELDS="[]"

# audit.retention.enabled — 是否启用共享数据库的审计修改/删除/覆盖保护；配置会持久化，移除配置不会解除已有保护。
# 约束：true | false
# HAI_AUDIT_RETENTION_ENABLED="false"

# audit.retention.minDays — 保护期天数；例如 90 天内 cleanup(0) 也不能删除，到期不会自动清理日志。
# 约束：整数；>= 1；<= 36500
# HAI_AUDIT_RETENTION_MINDAYS="90"

# audit.userIdColumn — 用户表主键列名，用于 JOIN 条件
# 约束：字符串
# HAI_AUDIT_USERIDCOLUMN="id"

# audit.userNameColumn — 用户表用户名列名，用于 SELECT 输出
# 约束：字符串
# HAI_AUDIT_USERNAMECOLUMN="username"

# audit.userTable — 用户表名，用于 list 查询时 LEFT JOIN 获取用户名
# 约束：字符串
# HAI_AUDIT_USERTABLE="hai_iam_users"

# HAI_AUTH_EVIDENCE_DIR — 浏览器验收截图输出目录
# 约束：目录路径
# HAI_AUTH_EVIDENCE_DIR=""

# HAI_BUILD_COMMIT — 当前编译目标所属的源码提交；无所属 Git 提交时明确 unknown
# 约束：40或64位十六进制 Git SHA，或 unknown；hai build 内部确定，不继承调用者的同名值
# HAI_BUILD_COMMIT=""

# HAI_BUILD_ID — CLI 内部生成并向编译目标传递的产物标识；同次 SSR 构建复用
# 约束：非空字母、数字、下划线、点、加减号，最多128字符；显式非法值拒绝构建；hai build 不继承调用者的同名值
# HAI_BUILD_ID=""

# HAI_BUILD_STATIC — website模板显式静态预渲染；省略或0保持SSR，1仅用于无服务端业务模块的静态站点
# 约束：0 | 1；默认不启用；hai build仅compile目标透传，不能混用docker/app/desktop
# HAI_BUILD_STATIC=""

# cache.cluster.0.host — 节点主机地址
# 约束：字符串
# HAI_CACHE_CLUSTER_0_HOST=""

# cache.cluster.0.port — 节点端口号（1~65535）
# 约束：整数；>= 1；<= 65535
# HAI_CACHE_CLUSTER_0_PORT=""

# cache.commandTimeout — 命令执行超时（毫秒）；默认 5000
# 约束：整数；>= 0；<= 9007199254740991
# HAI_CACHE_COMMANDTIMEOUT="5000"

# cache.connectTimeout — 连接超时时间（毫秒）；默认 10000
# 约束：整数；>= 0；<= 9007199254740991
# HAI_CACHE_CONNECTTIMEOUT="10000"

# cache.db — 数据库编号（0~15）；默认 0
# 约束：整数；>= 0；<= 15
# HAI_CACHE_DB="0"

# cache.host — 主机地址；默认 'localhost'
# 约束：字符串
# HAI_CACHE_HOST="localhost"

# cache.keyPrefix — 键前缀（自动加在所有键前）
# 约束：字符串
# HAI_CACHE_KEYPREFIX=""

# cache.maxRetries — 最大重试次数；默认 3
# 约束：整数；>= 0；<= 9007199254740991
# HAI_CACHE_MAXRETRIES="3"

# cache.password — 单机、Cluster 和 Sentinel 数据节点的认证密码；url 模式使用 URL 内凭据。
# 约束：字符串
# HAI_CACHE_PASSWORD=""

# cache.port — 端口号；默认 6379
# 约束：整数；>= 1；<= 65535
# HAI_CACHE_PORT="6379"

# cache.readOnly — 是否只读模式；默认 false
# 约束：true | false
# HAI_CACHE_READONLY="false"

# cache.retryDelay — 重试间隔基数（毫秒）；实际间隔 = retryDelay × 重试次数；默认 50
# 约束：整数；>= 0；<= 9007199254740991
# HAI_CACHE_RETRYDELAY="50"

# cache.sentinel.name — 哨兵监控的主节点名称
# 约束：字符串
# HAI_CACHE_SENTINEL_NAME=""

# cache.sentinel.sentinels.0.host — 节点主机地址
# 约束：字符串
# HAI_CACHE_SENTINEL_SENTINELS_0_HOST=""

# cache.sentinel.sentinels.0.port — 节点端口号（1~65535）
# 约束：整数；>= 1；<= 65535
# HAI_CACHE_SENTINEL_SENTINELS_0_PORT=""

# cache.tls — 是否开启 TLS；默认 false
# 约束：true | false
# HAI_CACHE_TLS="false"

# cache.type — 后端或功能类型，按枚举选择
# 约束：字符串；取值：memory | redis
# HAI_CACHE_TYPE="memory"

# cache.url — Redis 连接 URL（如 redis://user:pass
# 约束：字符串
# HAI_CACHE_URL=""

# HAI_CONTACT_RECIPIENT — 企业官网联系表单的通知收件人
# 约束：有效邮箱地址
# HAI_CONTACT_RECIPIENT=""

# HAI_CONTAINER_ENGINE — 部署/集成测试使用的容器引擎
# 约束：docker | podman
# HAI_CONTAINER_ENGINE=""

# core.defaultLocale — 默认语言（默认 'zh-CN'）
# 约束：字符串
# HAI_CORE_DEFAULTLOCALE="zh-CN"

# core.env — 运行环境（默认 'development'）
# 约束：字符串；取值：development | production | test | staging
# HAI_CORE_ENV="development"

# core.logging.context — 默认上下文，会自动添加到每条日志
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_CORE_LOGGING_CONTEXT=""

# core.logging.format — 日志格式：'json' 用于生产环境，'pretty' 用于开发环境（默认 'json'）
# 约束：字符串；取值：json | pretty
# HAI_CORE_LOGGING_FORMAT="json"

# core.logging.level — 日志级别（默认 'info'）
# 约束：字符串；取值：trace | debug | info | warn | error | fatal
# HAI_CORE_LOGGING_LEVEL="info"

# core.logging.redact — 额外业务隐私的日志字段路径，如 customer.email、recipients[*].phone；* 匹配一层，区分大小写，默认 []。已知密码/令牌始终脱敏。
# 约束：JSON 数组；索引可按 0、1、2 扩展
# HAI_CORE_LOGGING_REDACT="[]"

# core.name — 应用名称（默认 'hai Admin'）
# 约束：字符串
# HAI_CORE_NAME="hai Admin"

# core.version — 应用版本（默认 '0.1.0'）
# 约束：字符串
# HAI_CORE_VERSION="0.1.0"

# HAI_CRYPTO_TRANSPORT — 桌面示例公开传输配置；在构建阶段与浏览器使用同一 Schema 校验
# 约束：false 关闭；或 JSON/YAML 对象，keyExchangePath 须以 / 开头；不接受 true
# HAI_CRYPTO_TRANSPORT="false"

# HAI_CRYPTO_TRANSPORT_KEYEXCHANGEPATH — 桌面示例公开密钥交换端点，构建期插值
# 约束：以 / 开头的路径
# HAI_CRYPTO_TRANSPORT_KEYEXCHANGEPATH="/_hai/key-exchange"

# db.database — 数据库：SQLite文件路径或:memory:；PostgreSQL必填名称；MySQL无URL时必填，URL模式从URL读取
# 约束：字符串；最小字符数 1
# HAI_DB_DATABASE="./data/admin.db"

# db.host — 数据库主机地址（默认 localhost）
# 约束：字符串
# HAI_DB_HOST="localhost"

# db.mysql.charset — 字符集（默认 utf8mb4），推荐使用 utf8mb4 支持完整 Unicode
# 约束：字符串
# HAI_DB_MYSQL_CHARSET="utf8mb4"

# db.operationLog.level — 操作日志的输出级别
# 约束：字符串；取值：info | debug | trace
# HAI_DB_OPERATIONLOG_LEVEL="debug"

# db.operationLog.maxLength — 安全数量摘要的最大字符数；0 表示省略摘要，永不记录 SQL 原文或参数值。
# 约束：整数；>= 0；<= 9007199254740991
# HAI_DB_OPERATIONLOG_MAXLENGTH="1000"

# db.operationLog.read — 是否记录读取操作
# 约束：true | false
# HAI_DB_OPERATIONLOG_READ="false"

# db.operationLog.write — 是否记录写入操作
# 约束：true | false
# HAI_DB_OPERATIONLOG_WRITE="false"

# db.password — 数据库密码
# 约束：字符串
# HAI_DB_PASSWORD=""

# db.pool.acquireTimeout — 获取连接超时，毫秒（默认10000）；PostgreSQL >=0，0禁用；MySQL排队+建连总期限为1–2147483647
# 约束：整数；PostgreSQL >=0（0禁用）；MySQL 1–2147483647
# HAI_DB_POOL_ACQUIRETIMEOUT="10000"

# db.pool.idleTimeout — PostgreSQL 空闲连接超时，毫秒（默认 30000；0 禁用）
# 约束：整数；>= 0；<= 9007199254740991
# HAI_DB_POOL_IDLETIMEOUT="30000"

# db.pool.max — 最大连接数（默认 10）
# 约束：整数；>= 1；<= 9007199254740991
# HAI_DB_POOL_MAX="10"

# db.pool.min — PostgreSQL 已建立连接的最小保留数（默认 1，不主动预建）
# 约束：整数；>= 0；<= 9007199254740991
# HAI_DB_POOL_MIN="1"

# db.pool.queueLimit — MySQL 等待队列最大请求数（默认 1000；正整数，不支持无限队列）
# 约束：整数；>= 1；<= 9007199254740991
# HAI_DB_POOL_QUEUELIMIT="1000"

# db.port — 数据库端口 - PostgreSQL 默认 5432 - MySQL 默认 3306
# 约束：整数；>= 1；<= 65535
# HAI_DB_PORT="5432"

# db.sqlite.executor — 执行方式（默认 sync）。 - `sync`：主线程直接执行 better-sqlite3（同步阻塞主线程事件循环）。 - `worker`：在专用 worker 线程持有唯一连接执行，把阻塞移出主线程。 注意 WAL 只改善数据库锁并发，无法避免 better-sqlite3 同步调用占用调用线程。
# 约束：字符串；取值：sync | worker
# HAI_DB_SQLITE_EXECUTOR="sync"

# db.sqlite.readonly — 是否只读模式（默认 false）
# 约束：true | false
# HAI_DB_SQLITE_READONLY="false"

# db.sqlite.walMode — 是否启用 WAL 模式（默认 true），可提高并发读写性能
# 约束：true | false
# HAI_DB_SQLITE_WALMODE="true"

# db.sqlite.workerConnectTimeoutMs — worker 执行方式下等待连接打开的超时（毫秒，默认 10000）
# 约束：整数；<= 9007199254740991；> 0
# HAI_DB_SQLITE_WORKERCONNECTTIMEOUTMS="10000"

# db.ssl — TLS：PostgreSQL使用其模式；MySQL仅false或严格对象，空对象默认校验证书链和DNS身份
# 约束：MySQL：false 或严格 TLS 对象（{} 默认校验证书链和 DNS 身份）；PostgreSQL：布尔值、require/prefer/allow/disable 或 TLS 对象
# HAI_DB_SSL="false"

# db.ssl.ca — MySQL 信任的 CA，PEM 内容；省略时使用 Node 信任库
# 约束：字符串；最小字符数 1
# HAI_DB_SSL_CA=""

# db.ssl.cert — MySQL 客户端证书，PEM 内容；必须同时提供 key
# 约束：字符串；最小字符数 1
# HAI_DB_SSL_CERT=""

# db.ssl.key — MySQL 客户端私钥，PEM 内容；必须同时提供 cert
# 约束：字符串；最小字符数 1
# HAI_DB_SSL_KEY=""

# db.ssl.rejectUnauthorized — MySQL 是否校验证书链（默认 true）；false 明确放弃服务端认证
# 约束：true | false
# HAI_DB_SSL_REJECTUNAUTHORIZED="true"

# db.ssl.verifyIdentity — MySQL 是否验证 DNS 主机身份（默认 true）；仅证书链验证开启时有效
# 约束：true | false
# HAI_DB_SSL_VERIFYIDENTITY="true"

# db.type — 后端或功能类型，按枚举选择
# 约束：字符串；取值：sqlite | postgresql | mysql
# HAI_DB_TYPE="sqlite"

# db.url — 网络数据库URL；MySQL空串表示使用分字段，非空仅mysql://且拒绝query/fragment，优先于host/port/database/user/password
# 约束：字符串；格式 uri；取值：
# HAI_DB_URL=""

# db.user — 数据库用户名
# 约束：字符串
# HAI_DB_USER="postgres"

# HAI_DEPLOY_ASKPASS_PASSWORD — 凭据输入；使用位置 packages/deploy/src/container/deploy-ssh-askpass.ts
# 约束：敏感字符串；启用相应功能时必填，不得提交真实值
# HAI_DEPLOY_ASKPASS_PASSWORD=""

# deploy.container.s3Engine — 自建 S3 服务实现；协议仍为 storage.type=s3。
# 约束：字符串；取值：rustfs | minio
# HAI_DEPLOY_CONTAINER_S3ENGINE="rustfs"

# deploy.environment — 部署环境文件模式；dev/test/prod 或自定义模式，禁止 local/example。
# 约束：字符串；正则 ^[a-z0-9][\w-]*$
# HAI_DEPLOY_ENVIRONMENT=""

# HAI_DEPLOY_PRIVATE_PROXY — 受管 Compose 私有代理拓扑的内部标志，由部署工具生成；应用用户不要手动设置
# 约束：仅后端无公开端口且存在入口代理时为 1；普通宿主不设置，使用显式 trustedProxies 配置自管入口
# HAI_DEPLOY_PRIVATE_PROXY=""

# deploy.provider.expose.containerPort — 容器内监听端口（adapter-node 默认 3000）
# 约束：整数；>= 1；<= 65535
# HAI_DEPLOY_PROVIDER_EXPOSE_CONTAINERPORT="3000"

# deploy.provider.expose.hostPort — 宿主机映射端口
# 约束：整数；>= 1；<= 65535
# HAI_DEPLOY_PROVIDER_EXPOSE_HOSTPORT="18080"

# deploy.provider.expose.https.acceptTerms — 明确同意 Let’s Encrypt 服务条款后才可设置为 true
# 约束：true；取值：true
# HAI_DEPLOY_PROVIDER_EXPOSE_HTTPS_ACCEPTTERMS="true"

# deploy.provider.expose.https.certificateFile — PEM 完整证书链路径，相对工程根或绝对路径；打包时复制到私有发布目录
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_PROVIDER_EXPOSE_HTTPS_CERTIFICATEFILE=""

# deploy.provider.expose.https.domain — HTTPS 公开域名；证书必须匹配该域名
# 约束：字符串；最大字符数 253；正则 ^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$
# HAI_DEPLOY_PROVIDER_EXPOSE_HTTPS_DOMAIN=""

# deploy.provider.expose.https.email — Let’s Encrypt 账号联系邮箱
# 约束：字符串；格式 email；正则 ^(?:[A-Za-z0-9_'+\-]+\.)*[A-Za-z0-9_'+\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\-]*\.)+[A-Za-z]{2,}$
# HAI_DEPLOY_PROVIDER_EXPOSE_HTTPS_EMAIL=""

# deploy.provider.expose.https.port — HTTPS 宿主端口，默认 443，须与 HTTP 端口不同
# 约束：整数；>= 1；<= 65535
# HAI_DEPLOY_PROVIDER_EXPOSE_HTTPS_PORT="443"

# deploy.provider.expose.https.privateKeyFile — 未加密 PEM 私钥路径，相对工程根或绝对路径；必须与证书匹配
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_PROVIDER_EXPOSE_HTTPS_PRIVATEKEYFILE=""

# deploy.provider.expose.https.redirectHttp — 普通 HTTP 请求是否以 308 跳转至 HTTPS，健康检查和 ACME 挑战除外
# 约束：true | false
# HAI_DEPLOY_PROVIDER_EXPOSE_HTTPS_REDIRECTHTTP="true"

# deploy.provider.expose.https.type — 应用部署：平台/暴露方式，按所在节点的枚举选择
# 约束：字符串；取值：files | letsencrypt
# HAI_DEPLOY_PROVIDER_EXPOSE_HTTPS_TYPE="files"

# deploy.provider.expose.type — 应用部署：平台/暴露方式，按所在节点的枚举选择
# 约束：字符串；取值：port
# HAI_DEPLOY_PROVIDER_EXPOSE_TYPE="port"

# deploy.provider.remote.baseDir — 远程应用根目录
# 约束：字符串；正则 ^\/[\w/. -]+$
# HAI_DEPLOY_PROVIDER_REMOTE_BASEDIR="/opt/hai/apps"

# deploy.provider.remote.runtime — 远程容器运行时（auto 优先 podman）
# 约束：字符串；取值：auto | docker | podman
# HAI_DEPLOY_PROVIDER_REMOTE_RUNTIME="auto"

# deploy.provider.ssh.auth — 认证方式；省略时非空 password 使用密码，否则保留私钥/agent；显式 key 忽略残留密码。
# 约束：字符串；取值：key | password
# HAI_DEPLOY_PROVIDER_SSH_AUTH="key"

# deploy.provider.ssh.connectTimeoutSeconds — 连接超时（秒）
# 约束：整数；<= 9007199254740991；> 0
# HAI_DEPLOY_PROVIDER_SSH_CONNECTTIMEOUTSECONDS="10"

# deploy.provider.ssh.host — 远程主机地址或 ~/.ssh/config 中的 Host 别名
# 约束：字符串；正则 ^[a-z0-9][a-z0-9.:-]*$
# HAI_DEPLOY_PROVIDER_SSH_HOST=""

# deploy.provider.ssh.identityFile — 私钥文件路径（省略时使用 ssh-agent 或 ~/.ssh 默认密钥）
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_PROVIDER_SSH_IDENTITYFILE=""

# deploy.provider.ssh.knownHostsFile — known_hosts 文件路径（省略时使用默认；配合 CI/临时环境隔离主机指纹）
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_PROVIDER_SSH_KNOWNHOSTSFILE=""

# deploy.provider.ssh.password — SSH 密码（保留原值）；密码方式必须非空、无 CR/LF/NUL，UTF-8 不超过 1023 字节。
# 约束：字符串
# HAI_DEPLOY_PROVIDER_SSH_PASSWORD=""

# deploy.provider.ssh.port — SSH 端口
# 约束：整数；>= 1；<= 65535
# HAI_DEPLOY_PROVIDER_SSH_PORT="22"

# deploy.provider.ssh.strictHostKeyChecking — 严格主机密钥校验，默认开启（true→accept-new 首次信任并拒绝变更；false→关闭校验）
# 约束：true | false
# HAI_DEPLOY_PROVIDER_SSH_STRICTHOSTKEYCHECKING="true"

# deploy.provider.ssh.username — SSH 用户名
# 约束：字符串；正则 ^[a-z_][\w-]*$
# HAI_DEPLOY_PROVIDER_SSH_USERNAME="deploy"

# deploy.provider.token — 应用部署：部署平台访问令牌
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_PROVIDER_TOKEN=""

# deploy.provider.trustedEdgeProxies — Nginx 前方可信负载均衡的 IP/CIDR；省略时不接受外部转发头。
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 1000
# HAI_DEPLOY_PROVIDER_TRUSTEDEDGEPROXIES=""

# deploy.provider.type — 应用部署：平台/暴露方式，按所在节点的枚举选择
# 约束：字符串；取值：vercel | docker-ssh
# HAI_DEPLOY_PROVIDER_TYPE="docker-ssh"

# deploy.services.cache.apiKey — 自动开通 cache 服务：服务商 API 密钥
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_SERVICES_CACHE_APIKEY=""

# deploy.services.cache.email — 自动开通 cache 服务：服务商账号邮箱
# 约束：字符串；格式 email；正则 ^(?:[A-Za-z0-9_'+\-]+\.)*[A-Za-z0-9_'+\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\-]*\.)+[A-Za-z]{2,}$
# HAI_DEPLOY_SERVICES_CACHE_EMAIL=""

# deploy.services.cache.provisioner — 自动开通 cache 服务：资源开通服务商
# 约束：字符串；取值：upstash
# HAI_DEPLOY_SERVICES_CACHE_PROVISIONER="upstash"

# deploy.services.db.apiKey — 自动开通 db 服务：服务商 API 密钥
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_SERVICES_DB_APIKEY=""

# deploy.services.db.provisioner — 自动开通 db 服务：资源开通服务商
# 约束：字符串；取值：neon
# HAI_DEPLOY_SERVICES_DB_PROVISIONER="neon"

# deploy.services.email.apiKey — 自动开通 email 服务：服务商 API 密钥
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_SERVICES_EMAIL_APIKEY=""

# deploy.services.email.from — 自动开通 email 服务：已验证域名的发件邮箱
# 约束：字符串；格式 email；正则 ^(?:[A-Za-z0-9_'+\-]+\.)*[A-Za-z0-9_'+\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\-]*\.)+[A-Za-z]{2,}$
# HAI_DEPLOY_SERVICES_EMAIL_FROM=""

# deploy.services.email.provisioner — 自动开通 email 服务：资源开通服务商
# 约束：字符串；取值：resend
# HAI_DEPLOY_SERVICES_EMAIL_PROVISIONER="resend"

# deploy.services.sms.accessKeyId — 自动开通 sms 服务：服务商访问密钥 ID
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_SERVICES_SMS_ACCESSKEYID=""

# deploy.services.sms.accessKeySecret — 自动开通 sms 服务：服务商访问密钥 Secret
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_SERVICES_SMS_ACCESSKEYSECRET=""

# deploy.services.sms.provisioner — 自动开通 sms 服务：资源开通服务商
# 约束：字符串；取值：aliyun
# HAI_DEPLOY_SERVICES_SMS_PROVISIONER="aliyun"

# deploy.services.sms.signName — 自动开通 sms 服务：短信服务审核通过的签名
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_SERVICES_SMS_SIGNNAME=""

# deploy.services.storage.accessKeyId — 自动开通 storage 服务：服务商访问密钥 ID
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_SERVICES_STORAGE_ACCESSKEYID=""

# deploy.services.storage.accountId — 自动开通 storage 服务：Cloudflare 账号 ID
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_SERVICES_STORAGE_ACCOUNTID=""

# deploy.services.storage.apiToken — 自动开通 storage 服务：Cloudflare API 令牌
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_SERVICES_STORAGE_APITOKEN=""

# deploy.services.storage.provisioner — 自动开通 storage 服务：资源开通服务商
# 约束：字符串；取值：cloudflare-r2
# HAI_DEPLOY_SERVICES_STORAGE_PROVISIONER="cloudflare-r2"

# deploy.services.storage.secretAccessKey — 自动开通 storage 服务：对象存储访问密钥 Secret
# 约束：字符串；最小字符数 1
# HAI_DEPLOY_SERVICES_STORAGE_SECRETACCESSKEY=""

# HAI_DOCKER_PROD_BUILD — 容器生产构建时省略声明文件和 sourcemap
# 约束：true 启用；其余值关闭
# HAI_DOCKER_PROD_BUILD=""

# HAI_E2E — 示例/模板端到端测试开关
# 约束：1 启用；其余值关闭
# HAI_E2E=""

# HAI_E2E_APP_URL — Fullstack 移动端浏览器预览验收地址
# 约束：有效 HTTP(S) URL；同时决定对应预览服务的监听地址
# HAI_E2E_APP_URL=""

# HAI_E2E_DATA_ROOT — 端到端测试的隔离运行数据目录
# 约束：目录路径
# HAI_E2E_DATA_ROOT=""

# HAI_E2E_DESKTOP_URL — Fullstack 桌面端浏览器预览验收地址
# 约束：有效 HTTP(S) URL；同时决定对应预览服务的监听地址
# HAI_E2E_DESKTOP_URL=""

# HAI_E2E_LIVE — AI 示例启用真实厂商端到端测试
# 约束：1 启用；其余值关闭
# HAI_E2E_LIVE=""

# HAI_E2E_MOCK — AI 示例使用确定性端到端测试服务
# 约束：1 启用；其余值关闭
# HAI_E2E_MOCK=""

# HAI_E2E_WEB_URL — Fullstack Web 端验收地址
# 约束：有效 HTTP(S) URL；同时决定对应预览服务的监听地址
# HAI_E2E_WEB_URL=""

# feedback.adminUrl — 管理员通知中的反馈管理页面地址。
# 约束：字符串；格式 uri
# HAI_FEEDBACK_ADMINURL="http://localhost:5173/admin/feedback"

# feedback.appId — 反馈所属应用标识；应与浏览器及 API 入口配置一致。
# 约束：字符串；最小字符数 1；最大字符数 128
# HAI_FEEDBACK_APPID=""

# feedback.appVersion — 当前应用版本，作为默认诊断信息保存。
# 约束：字符串；最大字符数 128
# HAI_FEEDBACK_APPVERSION=""

# feedback.buildId — 构建标识，帮助定位发布产物。
# 约束：字符串；最大字符数 128
# HAI_FEEDBACK_BUILDID=""

# feedback.businessCollectionTimeoutMs — 业务 collectEvidence 异步回调的等待上限，单位毫秒；超时后重试采集任务。
# 约束：整数；>= 1；<= 300000
# HAI_FEEDBACK_BUSINESSCOLLECTIONTIMEOUTMS="30000"

# feedback.collectionTimeoutMs — 补充材料收集超时，单位毫秒；超时后冻结为完整或部分材料。
# 约束：整数；>= 0；<= 300000
# HAI_FEEDBACK_COLLECTIONTIMEOUTMS="60000"

# feedback.commit — 源码提交标识，帮助定位对应代码。
# 约束：字符串；最大字符数 128
# HAI_FEEDBACK_COMMIT=""

# feedback.consoleContent — console 通知内容；metadata 只输出定位和采集状态，summary 显式加入通用脱敏摘要。
# 约束：字符串；取值：metadata | summary
# HAI_FEEDBACK_CONSOLECONTENT="metadata"

# feedback.envAllowlist — 允许采集的服务端环境变量名；凭据类名称仍按敏感信息策略排除。
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 100
# HAI_FEEDBACK_ENVALLOWLIST="[]"

# feedback.exportRetentionHours — 已完成导出的有效小时数；过期禁止下载，后台删除对象，默认 24 小时。
# 约束：整数；>= 1；<= 720
# HAI_FEEDBACK_EXPORTRETENTIONHOURS="24"

# feedback.leaseMs — 持久任务执行租约时长，单位毫秒；过期后允许其他实例接管。
# 约束：整数；>= 1000；<= 300000
# HAI_FEEDBACK_LEASEMS="30000"

# feedback.maxAttachmentBytes — 单个附件允许的最大字节数；同时受总预算约束。
# 约束：整数；>= 1；<= 5242880
# HAI_FEEDBACK_MAXATTACHMENTBYTES="5242880"

# feedback.maxAttempts — 汇集、通知、Webhook 和导出任务最大尝试次数；到期清理持续重试。
# 约束：整数；>= 1；<= 20
# HAI_FEEDBACK_MAXATTEMPTS="5"

# feedback.maxBytesPerUserDay — 单个用户每日预留存储字节（报告与最多历史导出）；默认 2 GiB。
# 约束：整数；>= 4194304；<= 1099511627776
# HAI_FEEDBACK_MAXBYTESPERUSERDAY="2147483648"

# feedback.maxEvidenceBytes — 单份反馈累计证据允许的最大字节数。
# 约束：整数；>= 1024；<= 4194304
# HAI_FEEDBACK_MAXEVIDENCEBYTES="4194304"

# feedback.maxEvidenceCount — 单份反馈累计证据允许的最大条数。
# 约束：整数；>= 1；<= 10000
# HAI_FEEDBACK_MAXEVIDENCECOUNT="2000"

# feedback.maxExportsPerReport — 单份报告最多历史导出数；已有有效快照复用，不重复计数。
# 约束：整数；>= 1；<= 20
# HAI_FEEDBACK_MAXEXPORTSPERREPORT="5"

# feedback.maxReportsPerUserDay — 单个用户按数据库 UTC 日累计受理上限；幂等重试不重复计数。
# 约束：整数；>= 1；<= 10000
# HAI_FEEDBACK_MAXREPORTSPERUSERDAY="20"

# feedback.maxStoredBytesPerScope — 应用内单个 scope 的持久材料预留容量；到期清理成功后释放，默认 10 GiB。
# 约束：整数；>= 4194304；<= 1099511627776
# HAI_FEEDBACK_MAXSTOREDBYTESPERSCOPE="10737418240"

# feedback.maxTotalBytes — 未压缩导出总预算；客户端、附件总量和传输预算由此派生。
# 约束：整数；>= 4194304；<= 41943040
# HAI_FEEDBACK_MAXTOTALBYTES="33554432"

# feedback.notificationMode — disabled 不通知，console 默认仅输出元数据，reach 使用已有通知通道。
# 约束：字符串；取值：disabled | console | reach
# HAI_FEEDBACK_NOTIFICATIONMODE="reach"

# feedback.notificationProvider — 已初始化 Reach Provider 的唯一名称，不限制为邮件。
# 约束：字符串；最小字符数 1
# HAI_FEEDBACK_NOTIFICATIONPROVIDER="email"

# feedback.recipients — Reach 接收方，由实际 Provider 校验邮箱、手机号或业务目的地。
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 20
# HAI_FEEDBACK_RECIPIENTS="[]"

# feedback.retentionDays — 已受理反馈及对象附件的保留天数。
# 约束：整数；>= 1；<= 3650
# HAI_FEEDBACK_RETENTIONDAYS="30"

# feedback.webhookSecret — Webhook HMAC-SHA256 签名密钥；空字符串不签名，仅服务端私有环境配置。
# 约束：字符串；最大字符数 4096
# HAI_FEEDBACK_WEBHOOKSECRET=""

# feedback.webhookTimeoutMs — 单次 Webhook 请求超时，单位毫秒；非 2xx 或超时均进入持久重试。
# 约束：整数；>= 1；<= 60000
# HAI_FEEDBACK_WEBHOOKTIMEOUTMS="10000"

# feedback.webhookUrl — 反馈采集结束后的 Webhook 地址；空字符串禁用，只允许可信 HTTP(S) 地址且不跟随重定向。
# 约束：字符串；最大字符数 2048
# HAI_FEEDBACK_WEBHOOKURL=""

# feedback.workerIntervalMs — 持久任务扫描间隔，单位毫秒；零值由宿主手动运行任务。
# 约束：整数；>= 0；<= 60000
# HAI_FEEDBACK_WORKERINTERVALMS="1000"

# iam.accounts.dormantAfterDays — 连续未成功登录多少天后休眠，0 关闭。未登录账号从创建时间起算。
# 约束：整数；>= 0；<= 36500
# HAI_IAM_ACCOUNTS_DORMANTAFTERDAYS="0"

# iam.accounts.scanIntervalSeconds — 自动扫描间隔（秒）；开启自动休眠时执行，默认每小时。
# 约束：整数；>= 60；<= 86400
# HAI_IAM_ACCOUNTS_SCANINTERVALSECONDS="3600"

# iam.agreements.privacyPolicyMarkdown — 隐私协议 Markdown 正文；YAML 使用 | 保留段落和换行。
# 约束：字符串；最小字符数 1
# HAI_IAM_AGREEMENTS_PRIVACYPOLICYMARKDOWN=""

# iam.agreements.privacyPolicyUrl — 隐私协议 URL
# 约束：字符串；格式 uri
# HAI_IAM_AGREEMENTS_PRIVACYPOLICYURL=""

# iam.agreements.showOnLogin — 登录时展示协议
# 约束：true | false
# HAI_IAM_AGREEMENTS_SHOWONLOGIN="false"

# iam.agreements.showOnRegister — 注册时展示协议
# 约束：true | false
# HAI_IAM_AGREEMENTS_SHOWONREGISTER="true"

# iam.agreements.userAgreementMarkdown — 用户协议 Markdown 正文；同时配置 URL 时优先显示正文。
# 约束：字符串；最小字符数 1
# HAI_IAM_AGREEMENTS_USERAGREEMENTMARKDOWN=""

# iam.agreements.userAgreementUrl — 用户协议 URL
# 约束：字符串；格式 uri
# HAI_IAM_AGREEMENTS_USERAGREEMENTURL=""

# iam.apikey.defaultExpirationDays — API Key 默认有效期（天，0 表示永不过期，默认 0）
# 约束：整数；>= 0；<= 9007199254740991
# HAI_IAM_APIKEY_DEFAULTEXPIRATIONDAYS="0"

# iam.apikey.maxKeysPerUser — 单用户最大 API Key 数量（默认 10）
# 约束：整数；>= 1；<= 9007199254740991
# HAI_IAM_APIKEY_MAXKEYSPERUSER="10"

# iam.apikey.prefix — API Key 前缀（默认 'hai_'）
# 约束：字符串
# HAI_IAM_APIKEY_PREFIX="hai_"

# iam.captcha.cost — 单次挑战的计算工作量；越高越难自动滥用，但低性能客户端等待也越久。
# 约束：整数；>= 100；<= 50000
# HAI_IAM_CAPTCHA_COST="5000"

# iam.captcha.enabled — 是否在认证提交前校验自托管计算挑战；开启会有验证等待，关闭时不加载浏览器求解器。
# 约束：true | false
# HAI_IAM_CAPTCHA_ENABLED="false"

# iam.captcha.maxCounter — 求解随机计数范围；与 cost 共同决定客户端计算负担，不是密码失败次数。
# 约束：整数；>= 1；<= 2000
# HAI_IAM_CAPTCHA_MAXCOUNTER="100"

# iam.captcha.ttlSeconds — 挑战证明有效期，单位秒；到期或重复使用需重新计算，不是登录会话期限。
# 约束：整数；>= 1；<= 600
# HAI_IAM_CAPTCHA_TTLSECONDS="120"

# iam.initialCredentials.enabled — 是否通过一次性邀请设密；开启前配置密码重置入口、用户联系方式与真实通知通道，不显示共享初始密码。
# 约束：true | false
# HAI_IAM_INITIALCREDENTIALS_ENABLED="false"

# iam.ldap.bindDn — 绑定 DN
# 约束：字符串
# HAI_IAM_LDAP_BINDDN=""

# iam.ldap.bindPassword — 绑定密码
# 约束：字符串
# HAI_IAM_LDAP_BINDPASSWORD=""

# iam.ldap.connectTimeout — 连接超时（毫秒）
# 约束：整数；>= 1000；<= 9007199254740991
# HAI_IAM_LDAP_CONNECTTIMEOUT="5000"

# iam.ldap.displayNameAttribute — 显示名称属性
# 约束：字符串
# HAI_IAM_LDAP_DISPLAYNAMEATTRIBUTE="cn"

# iam.ldap.emailAttribute — 邮箱属性
# 约束：字符串
# HAI_IAM_LDAP_EMAILATTRIBUTE="mail"

# iam.ldap.searchBase — 搜索基础 DN
# 约束：字符串
# HAI_IAM_LDAP_SEARCHBASE=""

# iam.ldap.searchFilter — 搜索过滤器（默认使用 uid）
# 约束：字符串
# HAI_IAM_LDAP_SEARCHFILTER="(uid={{username}})"

# iam.ldap.url — LDAP 服务器 URL
# 约束：字符串；格式 uri
# HAI_IAM_LDAP_URL=""

# iam.ldap.usernameAttribute — 用户名属性
# 约束：字符串
# HAI_IAM_LDAP_USERNAMEATTRIBUTE="uid"

# iam.ldap.useTls — 启用 TLS
# 约束：true | false
# HAI_IAM_LDAP_USETLS="false"

# iam.login.apikey — 是否启用 API Key 登录
# 约束：true | false
# HAI_IAM_LOGIN_APIKEY="false"

# iam.login.ldap — 是否启用 LDAP 登录；需要显式开启并提供 ldap 配置。
# 约束：true | false
# HAI_IAM_LOGIN_LDAP="false"

# iam.login.otp — 是否启用 OTP 登录
# 约束：true | false
# HAI_IAM_LOGIN_OTP="true"

# iam.login.password — 是否启用密码登录
# 约束：true | false
# HAI_IAM_LOGIN_PASSWORD="true"

# iam.loginAccess.allowIps — 允许的 IPv4/IPv6 地址或 CIDR；空数组不限，最多 1000 项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 1000
# HAI_IAM_LOGINACCESS_ALLOWIPS="[]"

# iam.loginAccess.denyIps — 拒绝的 IP/CIDR；拒绝优先，空数组不限，最多 1000 项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 1000
# HAI_IAM_LOGINACCESS_DENYIPS="[]"

# iam.loginAccess.enabled — 是否限制新建登录会话；已有会话的每次请求限制由 Serv/Kit 的 access 策略负责。
# 约束：true | false
# HAI_IAM_LOGINACCESS_ENABLED="false"

# iam.loginAccess.timezone — 访问时间窗口使用的 IANA 时区，默认 UTC，使用服务器时钟
# 约束：字符串
# HAI_IAM_LOGINACCESS_TIMEZONE="UTC"

# iam.loginAccess.windows.0.days — 允许窗口的开始日，周一 1 至周日 7，至少一项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最少项数 1；最多项数 7
# HAI_IAM_LOGINACCESS_WINDOWS_0_DAYS=""

# iam.loginAccess.windows.0.end — 允许窗口结束时间 HH:mm，不含结束；早于开始表示跨午夜，不得与开始相同
# 约束：字符串；正则 ^(?:[01]\d|2[0-3]):[0-5]\d$
# HAI_IAM_LOGINACCESS_WINDOWS_0_END=""

# iam.loginAccess.windows.0.start — 允许窗口开始时间 HH:mm，包含开始时刻
# 约束：字符串；正则 ^(?:[01]\d|2[0-3]):[0-5]\d$
# HAI_IAM_LOGINACCESS_WINDOWS_0_START=""

# iam.otp.email — 分别启用邮件、短信验证码
# 约束：true | false
# HAI_IAM_OTP_EMAIL="true"

# iam.otp.expiresIn — 验证码过期时间（秒，默认 300）
# 约束：整数；>= 60；<= 9007199254740991
# HAI_IAM_OTP_EXPIRESIN="300"

# iam.otp.length — 验证码长度（默认 6）
# 约束：整数；>= 4；<= 8
# HAI_IAM_OTP_LENGTH="6"

# iam.otp.maxAttempts — 最大重试次数（默认 3）
# 约束：整数；>= 1；<= 9007199254740991
# HAI_IAM_OTP_MAXATTEMPTS="3"

# iam.otp.resendInterval — 发送间隔（秒，默认 60）
# 约束：整数；>= 30；<= 9007199254740991
# HAI_IAM_OTP_RESENDINTERVAL="60"

# iam.otp.sms — 是否允许短信验证码
# 约束：true | false
# HAI_IAM_OTP_SMS="true"

# iam.password.expirationDays — 密码过期天数（0 表示不过期）
# 约束：整数；>= 0；<= 9007199254740991
# HAI_IAM_PASSWORD_EXPIRATIONDAYS="0"

# iam.password.maxLength — 新设密码的最多字符数，须不小于 minLength；避免超长输入消耗鉴别资源。
# 约束：整数；>= 1；<= 256
# HAI_IAM_PASSWORD_MAXLENGTH="128"

# iam.password.minCharacterClasses — 至少包含的字符类别数（大小写、数字、特殊字符），0 不额外限制。
# 约束：整数；>= 0；<= 4
# HAI_IAM_PASSWORD_MINCHARACTERCLASSES="0"

# iam.password.minLength — 新设密码的最少字符数；提高后只约束新建、重置和改密，不会反查已有密码的散列。
# 约束：整数；>= 1；<= 9007199254740991
# HAI_IAM_PASSWORD_MINLENGTH="8"

# iam.password.preventSamePassword — 拒绝新旧密码相同；启用口令期限或首次强改时也始终拒绝相同密码。
# 约束：true | false
# HAI_IAM_PASSWORD_PREVENTSAMEPASSWORD="false"

# iam.password.requireInitialChange — 管理员创建或重置的初始密码必须先更换；不影响用户自行注册设密。
# 约束：true | false
# HAI_IAM_PASSWORD_REQUIREINITIALCHANGE="false"

# iam.password.requireLowercase — 是否必须包含小写字母；false 不代表取消长度或其他字符类别条件。
# 约束：true | false
# HAI_IAM_PASSWORD_REQUIRELOWERCASE="true"

# iam.password.requireNumber — 是否必须包含数字；开启后所有服务端设密入口统一拒绝缺少数字的新密码。
# 约束：true | false
# HAI_IAM_PASSWORD_REQUIRENUMBER="true"

# iam.password.requireSpecialChar — 是否必须包含特殊字符；开启会增加密码输入要求，不影响已经保存的密码散列。
# 约束：true | false
# HAI_IAM_PASSWORD_REQUIRESPECIALCHAR="false"

# iam.password.requireUppercase — 是否必须包含大写字母；与 minCharacterClasses 同时执行，false 仅取消这一项强制要求。
# 约束：true | false
# HAI_IAM_PASSWORD_REQUIREUPPERCASE="true"

# iam.passwordReset.enabled — 是否启用密码重置
# 约束：true | false
# HAI_IAM_PASSWORDRESET_ENABLED="true"

# iam.passwordReset.maxAttempts — 最大验证尝试次数（默认 3）
# 约束：整数；>= 1；<= 9007199254740991
# HAI_IAM_PASSWORDRESET_MAXATTEMPTS="3"

# iam.passwordReset.mode — 重置通知渠道，phone 使用 password_reset_sms 模板。
# 约束：字符串；取值：email | phone
# HAI_IAM_PASSWORDRESET_MODE="email"

# iam.passwordReset.resetUrl — 重置页面的绝对地址，通知模板可使用 resetUrl。
# 约束：字符串；格式 uri
# HAI_IAM_PASSWORDRESET_RESETURL=""

# iam.passwordReset.tokenExpiresIn — 重置令牌有效期（秒，默认 3600 = 1小时）
# 约束：整数；>= 300；<= 9007199254740991
# HAI_IAM_PASSWORDRESET_TOKENEXPIRESIN="3600"

# iam.rbac.defaultRole — 默认用户角色
# 约束：字符串
# HAI_IAM_RBAC_DEFAULTROLE="user"

# iam.rbac.enabled — 是否启用 RBAC
# 约束：true | false
# HAI_IAM_RBAC_ENABLED="true"

# iam.rbac.superAdminRole — 超级管理员角色代码
# 约束：字符串
# HAI_IAM_RBAC_SUPERADMINROLE="super_admin"

# iam.reauthentication.enabled — 是否让已登录用户在敏感动作前弹窗验证当前密码；不创建另一个账号的登录，也不授予额外权限。
# 约束：true | false
# HAI_IAM_REAUTHENTICATION_ENABLED="false"

# iam.reauthentication.operations — 需要二次认证的操作 ID 清单，例如 iam.users.delete；两端须已接入同名守卫，仅添加名字不会保护自定义接口。
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 1000
# HAI_IAM_REAUTHENTICATION_OPERATIONS="[]"

# iam.reauthentication.ttlSeconds — 二次认证凭据的有效秒数；仅供当前用户/会话的指定操作单次使用，取消不发送敏感业务请求。
# 约束：整数；>= 1；<= 900
# HAI_IAM_REAUTHENTICATION_TTLSECONDS="300"

# iam.register.defaultAccountStatus — 自助注册的初始生命周期；active 可登录，dormant 等待管理员激活；默认 active。
# 约束：字符串；取值：active | dormant
# HAI_IAM_REGISTER_DEFAULTACCOUNTSTATUS="active"

# iam.register.enabled — 是否允许访客自助注册；关闭后隐藏注册入口并由服务端拒绝注册，不影响已有账号登录或管理员创建账号。
# 约束：true | false
# HAI_IAM_REGISTER_ENABLED="true"

# iam.security.failureWindow — 从首次失败开始的固定计数窗口，单位秒；86400 为24小时，不是滚动窗口。
# 约束：整数；>= 1；<= 31536000
# HAI_IAM_SECURITY_FAILUREWINDOW="86400"

# iam.security.lockoutDuration — 达到失败阈值后禁止密码鉴别的秒数；至少60秒，1200表示20分钟，锁定期间正确密码也不能登录。
# 约束：整数；>= 60；<= 9007199254740991
# HAI_IAM_SECURITY_LOCKOUTDURATION="900"

# iam.security.lockoutEnabled — 是否累计失败并暂时锁定密码鉴别；关闭忽略历史锁，成功密码验证会重置计数。
# 约束：true | false
# HAI_IAM_SECURITY_LOCKOUTENABLED="true"

# iam.security.maxLoginAttempts — 固定窗口内达到此失败次数后锁定密码鉴别；验证码失败等独立入口按各自策略处理。
# 约束：整数；>= 1；<= 9007199254740991
# HAI_IAM_SECURITY_MAXLOGINATTEMPTS="5"

# iam.seedDefaultData — 是否初始化默认角色和权限（默认 true）
# 约束：true | false
# HAI_IAM_SEEDDEFAULTDATA="true"

# iam.session.absoluteTimeout — 从首次登录起的绝对期限（秒），0 关闭；刷新不能重新起算。
# 约束：整数；>= 0；<= 31536000
# HAI_IAM_SESSION_ABSOLUTETIMEOUT="0"

# iam.session.endOnPageHide — 页面离开时尽力撤销会话；浏览器关闭不可保证，仍应配置服务端闲置/绝对期限。
# 约束：true | false
# HAI_IAM_SESSION_ENDONPAGEHIDE="false"

# iam.session.idleTimeout — 闲置期限（秒），0 关闭；真实访问记录活动，自动刷新不延长闲置；access/refresh 均执行。
# 约束：整数；>= 0；<= 31536000
# HAI_IAM_SESSION_IDLETIMEOUT="0"

# iam.session.maxAge — 新会话的默认 access 时长（秒）；创建时可用 maxAge 覆盖，滑动/刷新沿用会话固有时长。
# 约束：整数；>= 60；<= 9007199254740991
# HAI_IAM_SESSION_MAXAGE="86400"

# iam.session.maxSessions — 每个用户的最大有效会话数，0 不限制；包含 access 到期但仍可刷新的会话。
# 约束：整数；>= 0；<= 10000
# HAI_IAM_SESSION_MAXSESSIONS="0"

# iam.session.refreshTokenMaxAge — refreshToken 独立有效期（秒，默认 604800 = 7天）；从签发时刻起算，access 到期仍可刷新。
# 约束：整数；>= 3600；<= 9007199254740991
# HAI_IAM_SESSION_REFRESHTOKENMAXAGE="604800"

# iam.session.singleDevice — 单设备登录（踢掉其他设备）
# 约束：true | false
# HAI_IAM_SESSION_SINGLEDEVICE="false"

# iam.session.singleDeviceMode — 单设备超限策略：replace 顶旧保新，reject 保留旧会话并拒绝新登录。
# 约束：字符串；取值：replace | reject
# HAI_IAM_SESSION_SINGLEDEVICEMODE="replace"

# iam.session.sliding — 是否滑动窗口（每次访问刷新过期时间）
# 约束：true | false
# HAI_IAM_SESSION_SLIDING="true"

# iam.session.terminalLimitMode — 终端配额超限时 reject 拒绝新登录；replace 仅替换同类最早会话，不影响其他终端。
# 约束：字符串；取值：reject | replace
# HAI_IAM_SESSION_TERMINALLIMITMODE="reject"

# iam.session.terminalLimits — 各终端类型的最大会话数，例如 {web:2,app:1}；空对象关闭。启用后未列终端不能新登录，旧会话归为 web；仍受全局上限约束。
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_IAM_SESSION_TERMINALLIMITS="{}"

# iam.ui.brandText — 认证页品牌介绍正文
# 约束：字符串
# HAI_IAM_UI_BRANDTEXT=""

# iam.ui.brandTitle — 认证页品牌区域标题
# 约束：字符串
# HAI_IAM_UI_BRANDTITLE=""

# iam.ui.illustrationUrl — 认证页插图 URL
# 约束：字符串
# HAI_IAM_UI_ILLUSTRATIONURL=""

# iam.ui.logoUrl — 认证页品牌 Logo URL
# 约束：字符串
# HAI_IAM_UI_LOGOURL=""

# iam.ui.subtitle — 认证面板副标题
# 约束：字符串
# HAI_IAM_UI_SUBTITLE=""

# iam.ui.title — 认证面板标题
# 约束：字符串
# HAI_IAM_UI_TITLE=""

# iam.ui.variant — 认证页布局样式
# 约束：字符串；取值：card | split
# HAI_IAM_UI_VARIANT="card"

# kit.access — 每次请求的路径/IP/时间策略；false 关闭，内联规则与独立 YAML 文件引用不能混用
# 约束：true | false；false；JSON 对象；整体覆盖时替换该节点；取值：false
# HAI_KIT_ACCESS="false"

# kit.access.file — 独立 yml/yaml 策略文件；按工作目录解析，启动读一次，最大 1 MiB
# 约束：字符串；最小字符数 1；最大字符数 4096；正则 \.ya?ml$
# HAI_KIT_ACCESS_FILE=""

# kit.access.global.allowIps — 允许的 IPv4/IPv6 地址或 CIDR；空数组不限，最多 1000 项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 1000
# HAI_KIT_ACCESS_GLOBAL_ALLOWIPS="[]"

# kit.access.global.denyIps — 拒绝的 IP/CIDR；拒绝优先，空数组不限，最多 1000 项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 1000
# HAI_KIT_ACCESS_GLOBAL_DENYIPS="[]"

# kit.access.global.timezone — 访问时间窗口使用的 IANA 时区，默认 UTC，使用服务器时钟
# 约束：字符串
# HAI_KIT_ACCESS_GLOBAL_TIMEZONE="UTC"

# kit.access.global.windows.0.days — 允许窗口的开始日，周一 1 至周日 7，至少一项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最少项数 1；最多项数 7
# HAI_KIT_ACCESS_GLOBAL_WINDOWS_0_DAYS=""

# kit.access.global.windows.0.end — 允许窗口结束时间 HH:mm，不含结束；早于开始表示跨午夜，不得与开始相同
# 约束：字符串；正则 ^(?:[01]\d|2[0-3]):[0-5]\d$
# HAI_KIT_ACCESS_GLOBAL_WINDOWS_0_END=""

# kit.access.global.windows.0.start — 允许窗口开始时间 HH:mm，包含开始时刻
# 约束：字符串；正则 ^(?:[01]\d|2[0-3]):[0-5]\d$
# HAI_KIT_ACCESS_GLOBAL_WINDOWS_0_START=""

# kit.access.rules.0.allowIps — 允许的 IPv4/IPv6 地址或 CIDR；空数组不限，最多 1000 项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 1000
# HAI_KIT_ACCESS_RULES_0_ALLOWIPS="[]"

# kit.access.rules.0.denyIps — 拒绝的 IP/CIDR；拒绝优先，空数组不限，最多 1000 项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 1000
# HAI_KIT_ACCESS_RULES_0_DENYIPS="[]"

# kit.access.rules.0.encryption — 路径的应用层加解密模式；省略沿用宿主，required 强制加密，disabled 明文；重叠路径和方法不得冲突
# 约束：字符串；取值：required | disabled
# HAI_KIT_ACCESS_RULES_0_ENCRYPTION="required"

# kit.access.rules.0.id — 唯一规则编号，用于日志定位；1–64 个字母数字下划线、点或连字符
# 约束：字符串；最小字符数 1；最大字符数 64；正则 ^[\w.-]+$
# HAI_KIT_ACCESS_RULES_0_ID=""

# kit.access.rules.0.methods — 受该规则约束的 HTTP 方法；空数组全部方法，GET 不隐含 HEAD
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 9
# HAI_KIT_ACCESS_RULES_0_METHODS="[]"

# kit.access.rules.0.paths — 完整请求路径列表，包含部署前缀；精确或末尾 /**，最多 100 项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最少项数 1；最多项数 100
# HAI_KIT_ACCESS_RULES_0_PATHS=""

# kit.access.rules.0.timezone — 访问时间窗口使用的 IANA 时区，默认 UTC，使用服务器时钟
# 约束：字符串
# HAI_KIT_ACCESS_RULES_0_TIMEZONE="UTC"

# kit.access.rules.0.windows.0.days — 允许窗口的开始日，周一 1 至周日 7，至少一项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最少项数 1；最多项数 7
# HAI_KIT_ACCESS_RULES_0_WINDOWS_0_DAYS=""

# kit.access.rules.0.windows.0.end — 允许窗口结束时间 HH:mm，不含结束；早于开始表示跨午夜，不得与开始相同
# 约束：字符串；正则 ^(?:[01]\d|2[0-3]):[0-5]\d$
# HAI_KIT_ACCESS_RULES_0_WINDOWS_0_END=""

# kit.access.rules.0.windows.0.start — 允许窗口开始时间 HH:mm，包含开始时刻
# 约束：字符串；正则 ^(?:[01]\d|2[0-3]):[0-5]\d$
# HAI_KIT_ACCESS_RULES_0_WINDOWS_0_START=""

# HAI_KIT_COOKIE_KEY — kit Cookie 加密密钥
# 约束：满足 crypto SM4 密钥格式；敏感值仅本机或目标进程注入
# HAI_KIT_COOKIE_KEY=""

# kit.server.host — HTTP 监听主机名或 IP
# 约束：字符串；最小字符数 1
# HAI_KIT_SERVER_HOST="127.0.0.1"

# kit.server.port — HTTP 监听端口
# 约束：整数；>= 1；<= 65535
# HAI_KIT_SERVER_PORT="3000"

# kit.transport — 传输加密开关或密钥协商配置
# 约束：false；JSON 对象；整体覆盖时替换该节点；取值：false
# HAI_KIT_TRANSPORT="false"

# kit.transport.excludePaths — 不进入传输加密管道的路径
# 约束：JSON 数组；索引可按 0、1、2 扩展
# HAI_KIT_TRANSPORT_EXCLUDEPATHS="[]"

# kit.transport.keyExchangePath — 客户端与服务端约定的密钥交换端点
# 约束：字符串；以 / 开头的路径字符串
# HAI_KIT_TRANSPORT_KEYEXCHANGEPATH="/api/_hai/key-exchange"

# kit.transport.maxPlaintextBytes — 普通业务双向明文上限；auto 为 1 MiB；大材料使用 routePlaintextBytes 单独声明
# 约束：整数；>= 1024；<= 67108864；字符串；取值：auto
# HAI_KIT_TRANSPORT_MAXPLAINTEXTBYTES="auto"

# kit.transport.routePlaintextBytes — 完整路径段到双向明文字节上限的映射；星号匹配单段，供附件和归档独立容量
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_KIT_TRANSPORT_ROUTEPLAINTEXTBYTES=""

# kit.trustedProxies — 可信代理 IP/CIDR；默认 auto 在普通宿主忽略转发头，仅受管私有 Compose 采用容器网段
# 约束：字符串；JSON 数组；索引可按 0、1、2 扩展；最多项数 1000；取值：auto
# HAI_KIT_TRUSTEDPROXIES="auto"

# HAI_MODEL_API_KEY — 本地语音模型 HTTP 服务的 Bearer 认证密钥
# 约束：敏感字符串；空值表示该模型服务未启用认证
# HAI_MODEL_API_KEY=""

# HAI_MODEL_ID — 本地模型权重的 Hugging Face 仓库 ID
# 约束：有效模型仓库 ID，例如组织名/模型名；由模型目录提供默认值
# HAI_MODEL_ID=""

# HAI_MODEL_OUTPUT_DIR — 模型 prepare 子进程的权重输出目录
# 约束：目录路径；通常由 model:prepare 自动注入
# HAI_MODEL_OUTPUT_DIR=""

# HAI_MODEL_REVISION — Hugging Face 权重修订版本
# 约束：仓库已有的分支、标签或 commit；为空时使用厂商默认版本
# HAI_MODEL_REVISION=""

# HAI_MODELSCOPE_ID — 本地模型权重的 ModelScope 仓库 ID
# 约束：有效模型仓库 ID；优先使用模型目录的配置
# HAI_MODELSCOPE_ID=""

# HAI_MODELSCOPE_REVISION — ModelScope 权重修订版本
# 约束：仓库已有的分支、标签或 commit；通常为 master
# HAI_MODELSCOPE_REVISION=""

# HAI_PARTNER_PASSWORD — 企业官网合作伙伴演示的登录密码
# 约束：敏感字符串，仅本机或目标进程注入
# HAI_PARTNER_PASSWORD=""

# HAI_PARTNER_SESSIONTTLSECONDS — 合作伙伴演示会话有效期
# 约束：正整数，单位秒
# HAI_PARTNER_SESSIONTTLSECONDS="14400"

# HAI_PARTNER_USERNAME — 企业官网合作伙伴演示的登录用户名
# 约束：非空字符串
# HAI_PARTNER_USERNAME="partner-admin"

# payment.alipay.alipayPublicKey — alipay：支付宝平台公钥，用于验签
# 约束：字符串；最小字符数 1
# HAI_PAYMENT_ALIPAY_ALIPAYPUBLICKEY=""

# payment.alipay.appId — alipay：商户应用 ID
# 约束：字符串；最小字符数 1
# HAI_PAYMENT_ALIPAY_APPID=""

# payment.alipay.privateKey — alipay：商户签名私钥（PEM）
# 约束：字符串；最小字符数 1
# HAI_PAYMENT_ALIPAY_PRIVATEKEY=""

# payment.alipay.returnUrl — 手机网站支付完成后返回的可信 HTTPS 地址；仅用于页面导航，不能证明付款。
# 约束：字符串；格式 uri
# HAI_PAYMENT_ALIPAY_RETURNURL=""

# payment.alipay.sandbox — alipay：是否使用沙箱网关
# 约束：true | false
# HAI_PAYMENT_ALIPAY_SANDBOX="false"

# payment.alipay.sellerId — alipay：支付宝卖家 ID，通知 seller_id 必须与之匹配
# 约束：字符串；最小字符数 1
# HAI_PAYMENT_ALIPAY_SELLERID=""

# payment.alipay.signType — alipay：请求和通知允许的签名算法
# 约束：字符串；取值：RSA2 | RSA
# HAI_PAYMENT_ALIPAY_SIGNTYPE="RSA2"

# payment.stripe.cancelUrl — 托管 Checkout 取消按钮的可信跳转地址；省略时不显示返回按钮。
# 约束：字符串；格式 uri
# HAI_PAYMENT_STRIPE_CANCELURL=""

# payment.stripe.secretKey — stripe：Stripe 服务端密钥
# 约束：字符串；正则 ^(?:sk|rk)_(?:test|live)_\S+$
# HAI_PAYMENT_STRIPE_SECRETKEY=""

# payment.stripe.successUrl — 托管 Checkout 完成后的可信跳转地址，可含 {CHECKOUT_SESSION_ID}。
# 约束：字符串；格式 uri
# HAI_PAYMENT_STRIPE_SUCCESSURL=""

# payment.stripe.webhookSecret — stripe：Stripe Webhook 验签密钥
# 约束：字符串；最小字符数 1
# HAI_PAYMENT_STRIPE_WEBHOOKSECRET=""

# payment.stripe.webhookToleranceSeconds — stripe：Webhook 时间戳允许偏差，单位秒
# 约束：整数；<= 9007199254740991；> 0
# HAI_PAYMENT_STRIPE_WEBHOOKTOLERANCESECONDS="300"

# payment.wechat.apiV3Key — wechat：微信支付 API v3 密钥
# 约束：字符串；最小字符数 1
# HAI_PAYMENT_WECHAT_APIV3KEY=""

# payment.wechat.appId — wechat：商户应用 ID
# 约束：字符串；最小字符数 1
# HAI_PAYMENT_WECHAT_APPID=""

# payment.wechat.mchId — wechat：微信支付商户号
# 约束：字符串；最小字符数 1
# HAI_PAYMENT_WECHAT_MCHID=""

# payment.wechat.platformKeys — 精确按 Wechatpay-Serial 选择平台证书/公钥，轮换期间同时配置新旧标识。
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_PAYMENT_WECHAT_PLATFORMKEYS=""

# payment.wechat.privateKey — wechat：商户签名私钥（PEM）
# 约束：字符串；最小字符数 1
# HAI_PAYMENT_WECHAT_PRIVATEKEY=""

# payment.wechat.serialNo — wechat：商户 API 证书序列号
# 约束：字符串；最小字符数 1
# HAI_PAYMENT_WECHAT_SERIALNO=""

# reach.dnd.enabled — 是否启用免打扰（默认 false）
# 约束：true | false
# HAI_REACH_DND_ENABLED="false"

# reach.dnd.end — 免打扰结束时间（HH:mm 格式）
# 约束：字符串；正则 ^([01]\d|2[0-3]):[0-5]\d$
# HAI_REACH_DND_END="00:00"

# reach.dnd.start — 免打扰开始时间（HH:mm 格式）
# 约束：字符串；正则 ^([01]\d|2[0-3]):[0-5]\d$
# HAI_REACH_DND_START="00:00"

# reach.dnd.strategy — discard 丢弃；delay 要求数据库队列就绪并确认入队（默认 discard）。
# 约束：字符串；取值：discard | delay
# HAI_REACH_DND_STRATEGY="discard"

# reach.providers.0.accessKeyId — 阿里云 AccessKey ID
# 约束：字符串；最小字符数 1
# HAI_REACH_PROVIDERS_0_ACCESSKEYID=""

# reach.providers.0.accessKeySecret — 阿里云 AccessKey Secret
# 约束：字符串；最小字符数 1
# HAI_REACH_PROVIDERS_0_ACCESSKEYSECRET=""

# reach.providers.0.endpoint — API 端点（默认 dysmsapi.aliyuncs.com）
# 约束：字符串
# HAI_REACH_PROVIDERS_0_ENDPOINT="dysmsapi.aliyuncs.com"

# reach.providers.0.from — 发件人地址
# 约束：字符串；最小字符数 1
# HAI_REACH_PROVIDERS_0_FROM="noreply@example.com"

# reach.providers.0.headers — 自定义请求头
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_REACH_PROVIDERS_0_HEADERS=""

# reach.providers.0.host — SMTP 服务器地址
# 约束：字符串；最小字符数 1
# HAI_REACH_PROVIDERS_0_HOST="smtp.example.com"

# reach.providers.0.idempotent — 接收端按 Idempotency-Key 原子持久去重，且覆盖所有重试与旧节点迟到请求时才启用；默认 false。
# 约束：true | false
# HAI_REACH_PROVIDERS_0_IDEMPOTENT="false"

# reach.providers.0.method — HTTP 方法（默认 POST）
# 约束：字符串；取值：POST | PUT
# HAI_REACH_PROVIDERS_0_METHOD="POST"

# reach.providers.0.name — Provider 唯一名称
# 约束：字符串；最小字符数 1
# HAI_REACH_PROVIDERS_0_NAME=""

# reach.providers.0.pass — SMTP 认证密码
# 约束：字符串
# HAI_REACH_PROVIDERS_0_PASS=""

# reach.providers.0.port — SMTP 端口（默认 465）
# 约束：整数；>= 1；<= 65535
# HAI_REACH_PROVIDERS_0_PORT="465"

# reach.providers.0.redirect — HTTP 重定向策略；默认拒绝。敏感发送始终拒绝，即使普通发送显式允许。
# 约束：字符串；取值：error | follow
# HAI_REACH_PROVIDERS_0_REDIRECT="error"

# reach.providers.0.requireHttps — 强制 HTTPS；省略时生产敏感发送要求 HTTPS，显式 false 仅用于受信内网传输。
# 约束：true | false
# HAI_REACH_PROVIDERS_0_REQUIREHTTPS=""

# reach.providers.0.secure — 是否使用 TLS（默认 true）
# 约束：true | false
# HAI_REACH_PROVIDERS_0_SECURE="true"

# reach.providers.0.signName — 短信签名
# 约束：字符串；最小字符数 1
# HAI_REACH_PROVIDERS_0_SIGNNAME=""

# reach.providers.0.timeout — 请求超时毫秒数（默认 10000）
# 约束：整数；>= 0；<= 9007199254740991
# HAI_REACH_PROVIDERS_0_TIMEOUT="10000"

# reach.providers.0.type — 后端或功能类型，按枚举选择
# 约束：字符串；取值：console | smtp | aliyun-sms | api
# HAI_REACH_PROVIDERS_0_TYPE="console"

# reach.providers.0.url — 回调 URL
# 约束：字符串；格式 uri
# HAI_REACH_PROVIDERS_0_URL=""

# reach.providers.0.user — SMTP 认证用户名
# 约束：字符串
# HAI_REACH_PROVIDERS_0_USER=""

# HAI_REACH_PROVIDERS_1_ACCESSKEYID — 阿里云 AccessKey ID
# 约束：字符串；最小字符数 1
# HAI_REACH_PROVIDERS_1_ACCESSKEYID=""

# HAI_REACH_PROVIDERS_1_ACCESSKEYSECRET — 阿里云 AccessKey Secret
# 约束：字符串；最小字符数 1
# HAI_REACH_PROVIDERS_1_ACCESSKEYSECRET=""

# HAI_REACH_PROVIDERS_1_TYPE — 后端或功能类型，按枚举选择
# 约束：字符串；取值：console | smtp | aliyun-sms | api
# HAI_REACH_PROVIDERS_1_TYPE="console"

# HAI_REACH_PROVIDERS_2_HEADERS_AUTHORIZATION — 凭据输入；使用位置 packages/cli/src/commands/cli-config-templates.ts
# 约束：敏感字符串；启用相应功能时必填，不得提交真实值
# HAI_REACH_PROVIDERS_2_HEADERS_AUTHORIZATION=""

# HAI_REACH_PROVIDERS_2_IDEMPOTENT — 接收端按 Idempotency-Key 原子持久去重，且覆盖所有重试与旧节点迟到请求时才启用；默认 false。
# 约束：true | false
# HAI_REACH_PROVIDERS_2_IDEMPOTENT="false"

# reach.queue.maxAttempts — 每条队列消息最多处理多少次，包含首次发送、失败重试和异常退出后的重新处理；默认 5，范围 1–100。
# 约束：整数；>= 1；<= 100
# HAI_REACH_QUEUE_MAXATTEMPTS="5"

# reach.queue.maxRetryDelayMs — 后续失败时等待时间逐次加倍，但不超过此值；默认 3600000（1 小时），不得小于 retryDelayMs。
# 约束：整数；>= 1000；<= 86400000
# HAI_REACH_QUEUE_MAXRETRYDELAYMS="3600000"

# reach.queue.retryDelayMs — 第一次发送失败后，等待多少毫秒再试；默认 60000（1 分钟），范围 1000–86400000。
# 约束：整数；>= 1000；<= 86400000
# HAI_REACH_QUEUE_RETRYDELAYMS="60000"

# reach.templates.0.body — 正文模板
# 约束：字符串；最小字符数 1
# HAI_REACH_TEMPLATES_0_BODY=""

# reach.templates.0.name — 模板名称
# 约束：字符串；最小字符数 1
# HAI_REACH_TEMPLATES_0_NAME=""

# reach.templates.0.provider — 绑定的 Provider 名称
# 约束：字符串；最小字符数 1
# HAI_REACH_TEMPLATES_0_PROVIDER=""

# reach.templates.0.subject — 邮件主题模板
# 约束：字符串
# HAI_REACH_TEMPLATES_0_SUBJECT=""

# ADMIN_E2E_BASE_URL — 管理台独立 E2E 服务地址，可由根验收透传以避开其它工作区端口
# 约束：本机 HTTP(S) URL；直接运行时 BASE_URL 优先
# ADMIN_E2E_BASE_URL=""

# ALL_PROXY — 构建下载的其他代理入口；仅 inherit 模式原样传递，其他模式清空
# 约束：代理 URL；协议支持由下载工具决定；小写 all_proxy 也受支持
# ALL_PROXY=""

# ANTHROPIC_API_KEY — ANTHROPIC 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# ANTHROPIC_API_KEY=""

# ANTHROPIC_BASE_URL — 厂商 SDK 服务基础地址回退
# 约束：有效 HTTP(S) URL
# ANTHROPIC_BASE_URL=""

# ARK_API_KEY — ARK 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# ARK_API_KEY=""

# BASE_URL — Playwright 验收访问的前端基础地址
# 约束：有效 HTTP(S) URL；按项目 Playwright 配置选择默认端口
# BASE_URL=""

# CAPACITOR_SERVER_URL — Capacitor 开发时的前端热加载地址
# 约束：有效 HTTP(S) URL；发布原生包时不设置
# CAPACITOR_SERVER_URL=""

# CI — 持续集成环境标记
# 约束：true 或 1 启用；未设置为本地运行
# CI=""

# COMPUTE_TYPE — faster-whisper 计算精度
# 约束：auto | default | float32 | float16 | bfloat16 | int16 | int8 | int8_float32 | int8_float16 | int8_bfloat16；须受当前设备支持
# COMPUTE_TYPE="auto"

# DASHSCOPE_API_KEY — DASHSCOPE 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# DASHSCOPE_API_KEY=""

# DASHSCOPE_WORKSPACE_ID — DashScope 厂商工作空间标识
# 约束：字符串，由厂商控制台提供
# DASHSCOPE_WORKSPACE_ID=""

# DEVICE — 本地语音模型运行设备
# 约束：auto | cpu | cuda；auto 按 CUDA 可用性选择
# DEVICE="auto"

# E2E_ADMIN_PASSWORD — 端到端测试创建的管理员密码
# 约束：满足 IAM 密码策略；仅测试进程使用
# E2E_ADMIN_PASSWORD=""

# E2E_AUDIT_ADMIN_PASSWORD — Fullstack端到端测试的audit_admin初始密码
# 约束：仅测试进程使用；验收已部署服务时与该环境HAI_AUDIT_ADMIN_PASSWORD一致
# E2E_AUDIT_ADMIN_PASSWORD=""

# E2E_BUILD_COMMIT — 环境入口；使用位置 packages/cli/templates/apps/fullstack/e2e/fullstack.spec.ts.hbs
# 约束：字符串；按使用位置的校验规则填写
# E2E_BUILD_COMMIT=""

# E2E_BUSINESS_OPERATOR_PASSWORD — Fullstack端到端测试的business_operator初始密码
# 约束：仅测试进程使用；验收已部署服务时与该环境HAI_BUSINESS_OPERATOR_PASSWORD一致
# E2E_BUSINESS_OPERATOR_PASSWORD=""

# E2E_CONFIG_ADMIN_PASSWORD — Fullstack端到端测试的config_admin初始密码
# 约束：仅测试进程使用；验收已部署服务时与该环境HAI_CONFIG_ADMIN_PASSWORD一致
# E2E_CONFIG_ADMIN_PASSWORD=""

# E2E_PORT — 端到端测试 Web 服务监听端口
# 约束：整数 1–65535
# E2E_PORT=""

# FTP_PROXY — 构建下载的 FTP 代理入口；仅 inherit 模式原样传递，其他模式清空
# 约束：代理 URL；协议支持由下载工具决定；小写 ftp_proxy 也受支持
# FTP_PROXY=""

# GEMINI_API_KEY — GEMINI 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# GEMINI_API_KEY=""

# GITHUB_API_URL — 发布检查使用的 GitHub API 基础地址
# 约束：有效 HTTP(S) URL；默认 https://api.github.com
# GITHUB_API_URL=""

# GITHUB_OUTPUT — GitHub Actions 步骤输出文件
# 约束：由工作流自动注入的可写文件路径
# GITHUB_OUTPUT=""

# GITHUB_REF_NAME — 发布检查使用的 Git 分支或标签名
# 约束：由 GitHub Actions 注入的引用名称
# GITHUB_REF_NAME=""

# GITHUB_REPOSITORY — 发布检查使用的 GitHub 仓库
# 约束：owner/repo 格式
# GITHUB_REPOSITORY=""

# GITHUB_TOKEN — 发布检查调用 GitHub API 的认证令牌
# 约束：敏感字符串；权限由目标仓库与工作流决定
# GITHUB_TOKEN=""

# HAI_AUDIT_ADMIN_PASSWORD — 首次创建审计管理员的独立密码
# 约束：满足 IAM 密码策略；仅在本地或目标进程注入；已有账号不改密
# HAI_AUDIT_ADMIN_PASSWORD=""

# HAI_BUSINESS_OPERATOR_PASSWORD — 首次创建业务操作员的独立密码
# 约束：满足 IAM 密码策略；仅在本地或目标进程注入；已有账号不改密
# HAI_BUSINESS_OPERATOR_PASSWORD=""

# HAI_CONFIG_ADMIN_PASSWORD — 首次创建配置管理员的独立密码
# 约束：满足 IAM 密码策略；仅在本地或目标进程注入；已有账号不改密
# HAI_CONFIG_ADMIN_PASSWORD=""

# HAI_CRYPTO_TRANSPORT_SERVERKEYRING — 服务端受管版本化传输密钥环；仅私有环境或 Secret Manager 注入
# 约束：JSON 对象 {activeKeyId,keys:{id:{publicKey,privateKey}}}；所有节点共享，ID 为 1-64 个字母/数字/下划线/连字符；禁止 PUBLIC_/VITE_/公开 YAML/日志
# HAI_CRYPTO_TRANSPORT_SERVERKEYRING=""

# HAI_NGINX_IMAGE — Dockerfile 的 Nginx 基础镜像构建参数，由 CLI 按 build.sources.image 或 --image-source 注入
# 约束：OCI 镜像引用；不是应用 .env 配置项
# HAI_NGINX_IMAGE=""

# HAI_NODE_IMAGE — Dockerfile 的 Node 基础镜像构建参数，由 CLI 按 build.sources.image 或 --image-source 注入
# 约束：OCI 镜像引用；不是应用 .env 配置项
# HAI_NODE_IMAGE=""

# HF_ENDPOINT — Hugging Face 下载服务基础地址
# 约束：有效 HTTP(S) URL；本地模型下载回退默认 https://hf-mirror.com
# HF_ENDPOINT="https://hf-mirror.com"

# HF_HUB_OFFLINE — 本地模型是否只使用已存在的离线权重
# 约束：1 启用；其余值关闭；离线权重缺失时启动失败
# HF_HUB_OFFLINE=""

# HOST — 部署平台 HTTP 监听地址，覆盖 serv/kit server.host
# 约束：主机名或 IP
# HOST="0.0.0.0"

# HTTP_PROXY — 构建下载的 HTTP 代理；inherit 模式继承进程环境，system/custom/none 模式由 CLI 覆盖
# 约束：HTTP(S) 代理 URL；小写 http_proxy 也受支持；镜像拉取仍取决于引擎代理
# HTTP_PROXY=""

# HTTPS_PROXY — 构建下载的 HTTPS 代理；未提供时回退 HTTP_PROXY；system/custom/none 模式由 CLI 覆盖
# 约束：HTTP(S) 代理 URL；小写 https_proxy 也受支持；镜像拉取仍取决于引擎代理
# HTTPS_PROXY=""

# IAM_FIXTURE_LDAP — 通知测试服务是否启用 LDAP fixture
# 约束：0 关闭；1 启用
# IAM_FIXTURE_LDAP=""

# IAM_NOTIFICATION_PORT — 通知测试服务监听端口
# 约束：整数 1–65535
# IAM_NOTIFICATION_PORT=""

# IAM_NOTIFICATION_URL — 确定性通知测试服务地址
# 约束：有效 HTTP(S) URL
# IAM_NOTIFICATION_URL=""

# LANG — 子进程默认语言与字符集
# 约束：操作系统支持的 locale，例如 en_US.UTF-8
# LANG=""

# LC_ALL — 子进程所有 locale 分类的覆盖值
# 约束：操作系统支持的 locale，例如 en_US.UTF-8
# LC_ALL=""

# LC_MESSAGES — CLI 消息语言；HAI_CORE_DEFAULTLOCALE、LC_ALL 优先，LANG 后备
# 约束：操作系统支持的 locale，例如 en_US.UTF-8
# LC_MESSAGES=""

# LEAK_WORDS — 提交检查禁止出现的词语
# 约束：JSON 字符串数组，或逗号/换行分隔的词语列表
# LEAK_WORDS=""

# MIMO_API_KEY — MIMO 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# MIMO_API_KEY=""

# MOBILE_E2E_PORT — 移动示例独立 E2E 预览端口，可由根验收透传
# 约束：整数 1–65535；默认 5175，直接运行时 E2E_PORT 优先
# MOBILE_E2E_PORT=""

# MODEL_PATH — 模型容器内的权重目录或模型仓库 ID
# 约束：可读取的模型路径或有效仓库 ID；默认 /opt/models
# MODEL_PATH="/opt/models"

# NO_PROXY — 构建下载的代理绕过列表；inherit 模式继承，可由 build.proxy.bypass 或 --proxy-bypass 覆盖
# 约束：逗号分隔的主机或地址；小写 no_proxy 也受支持；none 模式清空
# NO_PROXY=""

# NODE_ENV — Node/Vite 运行模式
# 约束：development | test | production
# NODE_ENV=""

# OPENAI_API_KEY — OPENAI 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# OPENAI_API_KEY=""

# OPENAI_BASE_URL — 厂商 SDK 服务基础地址回退
# 约束：有效 HTTP(S) URL
# OPENAI_BASE_URL=""

# PATH — 操作系统提供的可执行程序搜索路径；CLI 用于定位已安装的 pnpm
# 约束：保留系统原值；由操作系统路径分隔符连接，不要在 .env 中置空或作为应用配置覆盖
# PATH=""

# PLAYWRIGHT_HTML_OUTPUT_DIR — 环境入口；使用位置 packages/cli/templates/shared/run-e2e.mjs
# 约束：字符串；按使用位置的校验规则填写
# PLAYWRIGHT_HTML_OUTPUT_DIR=""

# PLAYWRIGHT_HTML_REPORT — 环境入口；使用位置 packages/cli/templates/shared/run-e2e.mjs
# 约束：字符串；按使用位置的校验规则填写
# PLAYWRIGHT_HTML_REPORT=""

# POLLINATIONS_API_KEY — POLLINATIONS 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# POLLINATIONS_API_KEY=""

# PORT — 部署平台 HTTP 监听端口，覆盖 serv/kit server.port
# 约束：整数 1–65535
# PORT="8000"

# PUBLIC_API_BASE — 浏览器/原生客户端 API 地址，不能含凭据
# 约束：有效 HTTP(S) URL；是否含 /api/v1 以对应客户端为准
# PUBLIC_API_BASE="-"

# PUBLIC_API_BASE_BASE64 — 容器生成前端运行时配置时使用的 API 地址编码
# 约束：PUBLIC_API_BASE 的 Base64 编码，不含凭据
# PUBLIC_API_BASE_BASE64=""

# PUBLIC_API_KEY_EXCHANGE_PATH — 公开密钥交换端点，须与服务端一致
# 约束：以 / 开头的路径
# PUBLIC_API_KEY_EXCHANGE_PATH=""

# PUBLIC_API_TRANSPORT — 客户端传输加密开关，须与服务端一致
# 约束：on | off
# PUBLIC_API_TRANSPORT=""

# PUBLIC_BASE_PATH — 构建进程公开网站目录；SvelteKit编译base及Vite固定基址，Docker网站制品保留此值
# 约束：默认空字符串表示根路径；各段仅ASCII字母、数字、_、.、-，以/开头且无末尾/、查询、片段、外部地址和单独.或..段；原生目标拒绝
# PUBLIC_BASE_PATH=""

# SERVED_MODEL_NAME — vLLM 对外报告的模型名
# 约束：非空字符串；客户端请求 model 须与之匹配
# SERVED_MODEL_NAME="qwen3-4b"

# SERVICE_BASE_URL — Fullstack 开发代理访问服务端的地址
# 约束：有效 HTTP(S) URL
# SERVICE_BASE_URL=""

# TAURI_DEV_HOST — Tauri 开发时 HMR 可访问的宿主机地址
# 约束：主机名或 IP，由 Tauri 开发工具注入
# TAURI_DEV_HOST=""

# VITE_ADAPTER — SvelteKit 构建适配器
# 约束：node | static；未识别的值回退 node
# VITE_ADAPTER=""

# VITEST — Vitest 自动注入的测试运行标记
# 约束：true 表示运行测试；通常无需手动设置
# VITEST=""

# VLLM_EXTRA_ARGS — 追加到 vLLM 服务的启动参数
# 约束：按 shell 参数语法拆分的字符串；参数由当前 vLLM 版本校验
# VLLM_EXTRA_ARGS=""

# VLLM_USE_MODELSCOPE — vLLM 是否通过 ModelScope 下载权重
# 约束：1 | true | yes 启用（忽略大小写）；其余值关闭
# VLLM_USE_MODELSCOPE=""

# VOLC_ACCESS_KEY — VOLC 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# VOLC_ACCESS_KEY=""

# VOLC_API_KEY — VOLC 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# VOLC_API_KEY=""

# VOLC_APP_KEY — VOLC 厂商凭据回退；优先在模型项配置 apiKey
# 约束：敏感字符串，启用对应厂商时注入
# VOLC_APP_KEY=""

# scheduler.enableDb — 必须使用共享数据库保存执行状态；false 不再允许，需要先初始化
# 约束：true；取值：true
# HAI_SCHEDULER_ENABLEDB="true"

# scheduler.leaseMs — 执行租约毫秒数（默认 300000，范围 1000–86400000），在途每三分之一周期续期。
# 约束：整数；>= 1000；<= 86400000
# HAI_SCHEDULER_LEASEMS="300000"

# scheduler.maxLogs — 执行日志最大保留条数（启用 DB 时生效）
# 约束：整数；>= 1；<= 9007199254740991
# HAI_SCHEDULER_MAXLOGS=""

# scheduler.nodeId — 节点标识（默认自动生成 UUID，多节点部署时建议设置固定标识以便审计）
# 约束：字符串；最小字符数 1
# HAI_SCHEDULER_NODEID=""

# scheduler.retentionDays — 执行日志保留天数（启用 DB 时生效）
# 约束：整数；>= 1；<= 9007199254740991
# HAI_SCHEDULER_RETENTIONDAYS=""

# scheduler.tickInterval — 调度检查间隔，单位毫秒（默认 1000，即每秒检查一次）
# 约束：整数；>= 100；<= 9007199254740991
# HAI_SCHEDULER_TICKINTERVAL="1000"

# serv.cors.allowedHeaders — CORS 允许客户端发送的请求头
# 约束：JSON 数组；索引可按 0、1、2 扩展
# HAI_SERV_CORS_ALLOWEDHEADERS="[\"Authorization\",\"Content-Type\",\"X-Requested-With\",\"X-Hai-Reauthentication\",\"X-Hai-Terminal\"]"

# serv.cors.credentials — 是否允许跨域请求携带凭据
# 约束：true | false
# HAI_SERV_CORS_CREDENTIALS="false"

# serv.cors.exposedHeaders — CORS 允许客户端读取的响应头
# 约束：JSON 数组；索引可按 0、1、2 扩展
# HAI_SERV_CORS_EXPOSEDHEADERS="[]"

# serv.cors.nativeOrigins — 允许使用原生凭据通道的完整 Origin 列表
# 约束：字符串
# HAI_SERV_CORS_NATIVEORIGINS="http://localhost,https://tauri.localhost,tauri://localhost,capacitor://localhost"

# serv.cors.origin — CORS 允许的 Origin，星号表示任意来源
# 约束：字符串
# HAI_SERV_CORS_ORIGIN="*"

# serv.http.access — 每次请求的路径/IP/时间策略；false 关闭，内联规则与独立 YAML 文件引用不能混用
# 约束：true | false；false；JSON 对象；整体覆盖时替换该节点；取值：false
# HAI_SERV_HTTP_ACCESS="false"

# serv.http.access.file — 独立 yml/yaml 策略文件；按工作目录解析，启动读一次，最大 1 MiB
# 约束：字符串；最小字符数 1；最大字符数 4096；正则 \.ya?ml$
# HAI_SERV_HTTP_ACCESS_FILE=""

# serv.http.access.global.allowIps — 允许的 IPv4/IPv6 地址或 CIDR；空数组不限，最多 1000 项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 1000
# HAI_SERV_HTTP_ACCESS_GLOBAL_ALLOWIPS="[]"

# serv.http.access.global.denyIps — 拒绝的 IP/CIDR；拒绝优先，空数组不限，最多 1000 项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 1000
# HAI_SERV_HTTP_ACCESS_GLOBAL_DENYIPS="[]"

# serv.http.access.global.timezone — 访问时间窗口使用的 IANA 时区，默认 UTC，使用服务器时钟
# 约束：字符串
# HAI_SERV_HTTP_ACCESS_GLOBAL_TIMEZONE="UTC"

# serv.http.access.global.windows.0.days — 允许窗口的开始日，周一 1 至周日 7，至少一项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最少项数 1；最多项数 7
# HAI_SERV_HTTP_ACCESS_GLOBAL_WINDOWS_0_DAYS=""

# serv.http.access.global.windows.0.end — 允许窗口结束时间 HH:mm，不含结束；早于开始表示跨午夜，不得与开始相同
# 约束：字符串；正则 ^(?:[01]\d|2[0-3]):[0-5]\d$
# HAI_SERV_HTTP_ACCESS_GLOBAL_WINDOWS_0_END=""

# serv.http.access.global.windows.0.start — 允许窗口开始时间 HH:mm，包含开始时刻
# 约束：字符串；正则 ^(?:[01]\d|2[0-3]):[0-5]\d$
# HAI_SERV_HTTP_ACCESS_GLOBAL_WINDOWS_0_START=""

# serv.http.access.rules.0.allowIps — 允许的 IPv4/IPv6 地址或 CIDR；空数组不限，最多 1000 项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 1000
# HAI_SERV_HTTP_ACCESS_RULES_0_ALLOWIPS="[]"

# serv.http.access.rules.0.denyIps — 拒绝的 IP/CIDR；拒绝优先，空数组不限，最多 1000 项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 1000
# HAI_SERV_HTTP_ACCESS_RULES_0_DENYIPS="[]"

# serv.http.access.rules.0.encryption — 路径的应用层加解密模式；省略沿用宿主，required 强制加密，disabled 明文；重叠路径和方法不得冲突
# 约束：字符串；取值：required | disabled
# HAI_SERV_HTTP_ACCESS_RULES_0_ENCRYPTION="required"

# serv.http.access.rules.0.id — 唯一规则编号，用于日志定位；1–64 个字母数字下划线、点或连字符
# 约束：字符串；最小字符数 1；最大字符数 64；正则 ^[\w.-]+$
# HAI_SERV_HTTP_ACCESS_RULES_0_ID=""

# serv.http.access.rules.0.methods — 受该规则约束的 HTTP 方法；空数组全部方法，GET 不隐含 HEAD
# 约束：JSON 数组；索引可按 0、1、2 扩展；最多项数 9
# HAI_SERV_HTTP_ACCESS_RULES_0_METHODS="[]"

# serv.http.access.rules.0.paths — 完整请求路径列表，包含部署前缀；精确或末尾 /**，最多 100 项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最少项数 1；最多项数 100
# HAI_SERV_HTTP_ACCESS_RULES_0_PATHS=""

# serv.http.access.rules.0.timezone — 访问时间窗口使用的 IANA 时区，默认 UTC，使用服务器时钟
# 约束：字符串
# HAI_SERV_HTTP_ACCESS_RULES_0_TIMEZONE="UTC"

# serv.http.access.rules.0.windows.0.days — 允许窗口的开始日，周一 1 至周日 7，至少一项
# 约束：JSON 数组；索引可按 0、1、2 扩展；最少项数 1；最多项数 7
# HAI_SERV_HTTP_ACCESS_RULES_0_WINDOWS_0_DAYS=""

# serv.http.access.rules.0.windows.0.end — 允许窗口结束时间 HH:mm，不含结束；早于开始表示跨午夜，不得与开始相同
# 约束：字符串；正则 ^(?:[01]\d|2[0-3]):[0-5]\d$
# HAI_SERV_HTTP_ACCESS_RULES_0_WINDOWS_0_END=""

# serv.http.access.rules.0.windows.0.start — 允许窗口开始时间 HH:mm，包含开始时刻
# 约束：字符串；正则 ^(?:[01]\d|2[0-3]):[0-5]\d$
# HAI_SERV_HTTP_ACCESS_RULES_0_WINDOWS_0_START=""

# serv.http.apiPrefix — 业务 HTTP API 的基础路径前缀
# 约束：字符串
# HAI_SERV_HTTP_APIPREFIX="/api/v1"

# serv.http.docs — HTTP API 文档功能开关或文档访问配置
# 约束：true | false；false；JSON 对象；整体覆盖时替换该节点；取值：false
# HAI_SERV_HTTP_DOCS="false"

# serv.http.docs.path — 当前 HTTP 功能的端点路径
# 约束：字符串；以 / 开头的路径字符串
# HAI_SERV_HTTP_DOCS_PATH="/docs"

# serv.http.docs.requireAuth — 是否要求认证后访问接口文档
# 约束：true | false
# HAI_SERV_HTTP_DOCS_REQUIREAUTH=""

# serv.http.health — HTTP 健康检查开关或检查配置
# 约束：JSON 对象；false；JSON 对象；整体覆盖时替换该节点；取值：false
# HAI_SERV_HTTP_HEALTH="{\"path\":\"/health\",\"readyPath\":\"/ready\"}"

# serv.http.health.path — 当前 HTTP 功能的端点路径
# 约束：字符串；以 / 开头的路径字符串
# HAI_SERV_HTTP_HEALTH_PATH="/health"

# serv.http.health.readyPath — 服务就绪检查的端点路径
# 约束：字符串；以 / 开头的路径字符串
# HAI_SERV_HTTP_HEALTH_READYPATH="/ready"

# serv.http.openapi — OpenAPI 端点开关或端点配置
# 约束：true | false；false；JSON 对象；整体覆盖时替换该节点；取值：false
# HAI_SERV_HTTP_OPENAPI="false"

# serv.http.openapi.path — 当前 HTTP 功能的端点路径
# 约束：字符串；以 / 开头的路径字符串
# HAI_SERV_HTTP_OPENAPI_PATH="/openapi.json"

# serv.http.trustedProxies — 可信代理 IP/CIDR；默认 auto 在普通宿主忽略转发头，仅受管私有 Compose 采用容器网段
# 约束：字符串；JSON 数组；索引可按 0、1、2 扩展；最多项数 1000；取值：auto
# HAI_SERV_HTTP_TRUSTEDPROXIES="auto"

# serv.server.host — HTTP 监听主机名或 IP
# 约束：字符串；最小字符数 1
# HAI_SERV_SERVER_HOST="127.0.0.1"

# serv.server.port — HTTP 监听端口
# 约束：整数；>= 1；<= 65535
# HAI_SERV_SERVER_PORT="3000"

# serv.transport — 传输加密开关或密钥协商配置
# 约束：false；JSON 对象；整体覆盖时替换该节点；取值：false
# HAI_SERV_TRANSPORT="false"

# serv.transport.excludePaths — 不进入传输加密管道的路径
# 约束：JSON 数组；索引可按 0、1、2 扩展
# HAI_SERV_TRANSPORT_EXCLUDEPATHS="[]"

# serv.transport.keyExchangePath — 客户端与服务端约定的密钥交换端点
# 约束：字符串；以 / 开头的路径字符串
# HAI_SERV_TRANSPORT_KEYEXCHANGEPATH="/_hai/key-exchange"

# serv.transport.maxPlaintextBytes — 普通业务双向明文上限；auto 为 1 MiB；大材料使用 routePlaintextBytes 单独声明
# 约束：整数；>= 1024；<= 67108864；字符串；取值：auto
# HAI_SERV_TRANSPORT_MAXPLAINTEXTBYTES="1048576"

# serv.transport.routePlaintextBytes — 完整路径段到双向明文字节上限的映射；星号匹配单段，供附件和归档独立容量
# 约束：JSON 对象；整体覆盖时替换该节点
# HAI_SERV_TRANSPORT_ROUTEPLAINTEXTBYTES=""

# storage.accessKeyId — Access Key ID
# 约束：字符串；最小字符数 1
# HAI_STORAGE_ACCESSKEYID=""

# storage.bucket — 存储桶名称
# 约束：字符串；最小字符数 1
# HAI_STORAGE_BUCKET=""

# storage.createBucket — 初始化时检查并创建缺失的桶；默认关闭，启用后凭据须有建桶权限。
# 约束：true | false
# HAI_STORAGE_CREATEBUCKET="false"

# storage.directoryMode — 目录创建权限
# 约束：数字
# HAI_STORAGE_DIRECTORYMODE="493"

# storage.endpoint — 自定义端点（用于 MinIO、RustFS、阿里云 OSS 等）
# 约束：字符串；格式 uri
# HAI_STORAGE_ENDPOINT="https://s3.amazonaws.com"

# storage.fileMode — 文件创建权限
# 约束：数字
# HAI_STORAGE_FILEMODE="420"

# storage.forcePathStyle — 强制使用路径风格 URL（某些 S3 兼容服务需要）
# 约束：true | false
# HAI_STORAGE_FORCEPATHSTYLE="false"

# storage.operationLog.level — 操作日志的输出级别
# 约束：字符串；取值：info | debug | trace
# HAI_STORAGE_OPERATIONLOG_LEVEL="debug"

# storage.operationLog.maxLength — 操作日志字段的最大字符数，0 表示不截断
# 约束：整数；>= 0；<= 9007199254740991
# HAI_STORAGE_OPERATIONLOG_MAXLENGTH="1000"

# storage.operationLog.read — 是否记录读取操作
# 约束：true | false
# HAI_STORAGE_OPERATIONLOG_READ="false"

# storage.operationLog.write — 是否记录写入操作
# 约束：true | false
# HAI_STORAGE_OPERATIONLOG_WRITE="false"

# storage.prefix — 路径前缀（所有操作都会加上此前缀）
# 约束：字符串
# HAI_STORAGE_PREFIX=""

# storage.publicEndpoint — 浏览器预签名端点，可含代理目录（如 /delivery/files），不含桶名、凭据或查询；代理须去除目录并保留 Host。
# 约束：字符串；格式 uri
# HAI_STORAGE_PUBLICENDPOINT="https://files.example.com"

# storage.publicUrl — 公开访问基础 URL（用于生成公开 URL）
# 约束：字符串；格式 uri
# HAI_STORAGE_PUBLICURL=""

# storage.region — 区域
# 约束：字符串；最小字符数 1
# HAI_STORAGE_REGION="us-east-1"

# storage.root — 根目录路径
# 约束：字符串；最小字符数 1
# HAI_STORAGE_ROOT="./data/uploads"

# storage.secretAccessKey — Secret Access Key
# 约束：字符串；最小字符数 1
# HAI_STORAGE_SECRETACCESSKEY=""

# storage.type — 存储类型
# 约束：字符串；取值：s3 | local
# HAI_STORAGE_TYPE="local"

# HAI_TEST_IMAGE_LEDGER — 环境入口；使用位置 packages/cli/src/commands/cli-build.ts
# 约束：字符串；按使用位置的校验规则填写
# HAI_TEST_IMAGE_LEDGER=""

# HAI_TEST_IMAGE_RUN — 环境入口；使用位置 packages/cli/src/commands/cli-build.ts
# 约束：字符串；按使用位置的校验规则填写
# HAI_TEST_IMAGE_RUN=""

# vecdb.apiKey — Qdrant：API key；Chroma：Authorization Bearer token，用于同协议的自托管服务/网关，不提供 Chroma Cloud 契约
# 约束：字符串；Qdrant API key；Chroma 为空串或无空白的可打印 ASCII Bearer token
# HAI_VECDB_APIKEY=""

# vecdb.database — 数据库名称
# 约束：字符串；最小字符数 1
# HAI_VECDB_DATABASE=""

# vecdb.host — 主机（默认 localhost）
# 约束：字符串
# HAI_VECDB_HOST="localhost"

# vecdb.indexType — 索引类型（默认 hnsw）
# 约束：字符串；取值：ivfflat | hnsw
# HAI_VECDB_INDEXTYPE="hnsw"

# vecdb.metric — 距离度量（默认 cosine）
# 约束：字符串；取值：cosine | euclidean | dot
# HAI_VECDB_METRIC="cosine"

# vecdb.operationLog.level — 操作日志的输出级别
# 约束：字符串；取值：info | debug | trace
# HAI_VECDB_OPERATIONLOG_LEVEL="debug"

# vecdb.operationLog.maxLength — 操作日志字段的最大字符数，0 表示不截断
# 约束：整数；>= 0；<= 9007199254740991
# HAI_VECDB_OPERATIONLOG_MAXLENGTH="1000"

# vecdb.operationLog.read — 是否记录读取操作
# 约束：true | false
# HAI_VECDB_OPERATIONLOG_READ="false"

# vecdb.operationLog.write — 是否记录写入操作
# 约束：true | false
# HAI_VECDB_OPERATIONLOG_WRITE="false"

# vecdb.password — 密码
# 约束：字符串
# HAI_VECDB_PASSWORD=""

# vecdb.path — 本地持久化路径（嵌入式模式：提供且无 url 时自动拉起本地服务）
# 约束：字符串；最小字符数 1
# HAI_VECDB_PATH="./data/vecdb"

# vecdb.port — 端口（默认 8000）
# 约束：整数；>= 1；<= 65535
# HAI_VECDB_PORT="5432"

# vecdb.serverCommand — 拉起本地服务的可执行命令（默认 'chroma'，可指定绝对路径）
# 约束：字符串
# HAI_VECDB_SERVERCOMMAND="chroma"

# vecdb.startupTimeout — 拉起本地服务的就绪等待超时（毫秒，默认 30000）
# 约束：整数；<= 9007199254740991；> 0
# HAI_VECDB_STARTUPTIMEOUT="30000"

# vecdb.tablePrefix — 表名前缀（默认 'vec_'）
# 约束：字符串
# HAI_VECDB_TABLEPREFIX="vec_"

# vecdb.type — 后端或功能类型，按枚举选择
# 约束：字符串；取值：lancedb | pgvector | qdrant | chroma
# HAI_VECDB_TYPE="lancedb"

# vecdb.url — pgvector：连接串；Qdrant：HTTP(S) 服务地址；Chroma：HTTP(S) 根端点，优先于 host/port，不允许凭据、路径前缀、query 或 fragment
# 约束：字符串；格式 uri
# HAI_VECDB_URL="http://localhost:6333"

# vecdb.user — 用户名
# 约束：字符串
# HAI_VECDB_USER=""
